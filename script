        repeat Sleep(2) w = w + 2 until IsInDungeon() or w > 120
        if IsInDungeon() then
            Farm.Start()
        else
            print("[DQR] Timed out. Press F5 once inside dungeon.")
        end
    else
        print("[DQR] Waiting for dungeon...")
        repeat Sleep(3) until IsInDungeon()
        Farm.Start()
    end

    task.spawn(DungeonWatcher)
end)

