-- ============================================================
--  GRAPHICS NUKE
-- ============================================================
local function NukeGraphics()
    if not CONFIG.LowerGraphics then return end
    local Lighting = game:GetService("Lighting")
    local Settings = settings()

    -- Rendering quality floor
    pcall(function() Settings.Rendering.QualityLevel = 1 end)
    pcall(function()
        game:GetService("UserGameSettings").SavedQualityLevel =
            Enum.SavedQualitySetting.QualityLevel01
    end)

    -- Lighting kills
    Lighting.GlobalShadows    = false
    Lighting.FogEnd           = 9e8
    Lighting.Brightness       = 0
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0

    -- Nuke all post-processing effects
    for _, fx in ipairs(Lighting:GetChildren()) do
        if fx:IsA("PostEffect") then fx.Enabled = false end
    end

    -- Kill decorative particles / beams NOT used for combat detection
    -- (we preserve Neon + Beam on mob parts for threat detection)
    for _, obj in ipairs(workspace:GetDescendants()) do
        pcall(function()
            if obj:IsA("ParticleEmitter") then obj.Enabled = false end
            if obj:IsA("Trail")           then obj.Enabled = false end
            if obj:IsA("Smoke")           then obj.Enabled = false end
            if obj:IsA("Fire")            then obj.Enabled = false end
            if obj:IsA("Sparkles")        then obj.Enabled = false end
        end)
    end

    print("[DQR] Graphics nuked.")
end

-- ============================================================
--  HELPERS
-- ============================================================
local function GetChar()  return LP.Character end
local function GetRoot()
    local c = GetChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function GetHuman()
    local c = GetChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function FireSpell(slot)
    local kc = slot == "Q" and Enum.KeyCode.Q or Enum.KeyCode.E
    pcall(function()
        game:GetService("VirtualInputManager"):SendKeyEvent(true,  kc, false, game)
        task.wait(0.06)
        game:GetService("VirtualInputManager"):SendKeyEvent(false, kc, false, game)
    end)
end

-- Always face a world position, even while moving
local function FacePosition(pos)
    local root = GetRoot()
    if not root then return end
    local dir = Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z)
    if dir.Magnitude < 0.1 then return end
    root.CFrame = CFrame.new(root.Position, root.Position + dir)
end

local function WalkTo(pos)
    local hum = GetHuman()
    if hum then hum:MoveTo(pos) end
end

local function StopWalk()
    local root = GetRoot()
    local hum  = GetHuman()
    if hum and root then hum:MoveTo(root.Position) end
end

-- ============================================================
--  VISUAL LINE — shows where AI is walking
-- ============================================================
local WalkLine = nil

local function ShowWalkLine(fromPos, toPos)
    -- Remove old
    if WalkLine and WalkLine.Parent then WalkLine:Destroy() end

    local mid    = (fromPos + toPos) / 2
    local length = (toPos - fromPos).Magnitude
    if length < 1 then return end

    local part = Instance.new("Part")
    part.Name             = "DQR_WalkLine"
    part.Anchored         = true
    part.CanCollide       = false
    part.CastShadow       = false
    part.Material         = Enum.Material.Neon
    part.Color            = Color3.fromRGB(100, 220, 255)
    part.Transparency     = 0.35
    part.Size             = Vector3.new(0.12, 0.12, length)
    part.CFrame           = CFrame.lookAt(mid, toPos)
    part.Parent           = workspace

    WalkLine = part
end

local function ClearWalkLine()
    if WalkLine and WalkLine.Parent then
        WalkLine:Destroy()
        WalkLine = nil
    end
end

-- ============================================================
--  MOB DETECTION
-- ============================================================
local function IsMob(model)
    if not model:IsA("Model") then return false end
    local hum  = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return false end
    if hum.Health <= 0 then return false end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character == model then return false end
    end
    return true
end

local function GetAllMobs()
    local root = GetRoot()
    if not root then return {} end
    local mobs = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and IsMob(obj) then
            local mobRoot = obj:FindFirstChild("HumanoidRootPart")
            if mobRoot then
                table.insert(mobs, {
                    Model    = obj,
                    Root     = mobRoot,
                    Humanoid = obj:FindFirstChildOfClass("Humanoid"),
                    Distance = (mobRoot.Position - root.Position).Magnitude,
                })
            end
        end
    end
    table.sort(mobs, function(a, b) return a.Distance < b.Distance end)
    return mobs
end

-- ============================================================
--  THREAT DETECTION
--  Detects red/neon beams or fast projectiles aimed at player
-- ============================================================
local function ColorIsThreat(c)
    -- Bias toward red spectrum + purple boss beams
    return (c.R > 0.6 and c.G < 0.35 and c.B < 0.35)    -- reds
        or (c.R > 0.6 and c.G < 0.35 and c.B > 0.5)     -- purples
        or (c.R > 0.7 and c.G > 0.3  and c.B < 0.1)     -- orange
end

local function IsHeadingToUs(part)
    local root = GetRoot()
    if not root then return false end
    local dist = (part.Position - root.Position).Magnitude
    if dist > CONFIG.DodgeRange then return false end
    local vel = part.AssemblyLinearVelocity
    if vel.Magnitude < 8 then return false end
    local dot = vel.Unit:Dot((root.Position - part.Position).Unit)
    return dot > 0.55
end

local function ScanThreats()
    local root = GetRoot()
    if not root then return false, nil end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart")
        and (not LP.Character or not obj:IsDescendantOf(LP.Character)) then
            local neon    = obj.Material == Enum.Material.Neon
            local threat  = ColorIsThreat(obj.Color)
            if neon or threat then
                if IsHeadingToUs(obj) then
                    return true, obj.Position
                end
            end
            -- Beam check — beam on a nearby part = telegraph
            for _, child in ipairs(obj:GetChildren()) do
                if child:IsA("Beam") then
                    local dist = (obj.Position - root.Position).Magnitude
                    if dist < CONFIG.DodgeRange then
                        return true, obj.Position
                    end
                end
            end
        end
    end
    return false, nil
end

local function GetStrafePos(threatOrigin)
    local root = GetRoot()
    if not root then return nil end
    local toward = (threatOrigin - root.Position)
    toward = Vector3.new(toward.X, 0, toward.Z).Unit
    local perp  = Vector3.new(-toward.Z, 0, toward.X)
    local sign  = math.random() > 0.5 and 1 or -1
    return root.Position
        + perp  * sign * CONFIG.DodgeStep
        + toward * -CONFIG.DodgeStep * 0.4
end

