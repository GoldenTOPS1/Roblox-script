-- ============================================================
--  GRAPHICS NUKE
-- ============================================================
local function NukeGraphics()
    if not CONFIG.LowerGraphics then return end
    local Lighting = game:GetService("Lighting")
    pcall(function() settings().Rendering.QualityLevel = 1 end)
    pcall(function()
        game:GetService("UserGameSettings").SavedQualityLevel =
            Enum.SavedQualitySetting.QualityLevel01
    end)
    Lighting.GlobalShadows            = false
    Lighting.FogEnd                   = 9e8
    Lighting.Brightness               = 0
    Lighting.EnvironmentDiffuseScale  = 0
    Lighting.EnvironmentSpecularScale = 0
    for _, fx in ipairs(Lighting:GetChildren()) do
        if fx:IsA("PostEffect") then fx.Enabled = false end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        pcall(function()
            if obj:IsA("ParticleEmitter") then obj.Enabled = false end
            if obj:IsA("Trail")           then obj.Enabled = false end
            if obj:IsA("Smoke")           then obj.Enabled = false end
            if obj:IsA("Fire")            then obj.Enabled = false end
            if obj:IsA("Sparkles")        then obj.Enabled = false end
        end)
    end
    print("[DQR] Graphics nuked.")
end

-- ============================================================
--  HELPERS
-- ============================================================
local function GetChar()  return LP.Character end
local function GetRoot()
    local c = GetChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function GetHuman()
    local c = GetChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end

-- ============================================================
--  SPELL CASTING
-- ============================================================
local spellSlot  = false
local lastAttack = 0

local function FireKey(kc)
    pcall(function() VIM:SendKeyEvent(true,  kc, false, game) end)
    task.wait(0.05)
    pcall(function() VIM:SendKeyEvent(false, kc, false, game) end)
end

local function TryCast()
    local now = tick()
    if now - lastAttack < CONFIG.AttackRate then return end
    lastAttack = now
    spellSlot  = not spellSlot
    task.spawn(function()
        FireKey(spellSlot and Enum.KeyCode.Q or Enum.KeyCode.E)
    end)
end

-- ============================================================
--  FACE LOCK
-- ============================================================
local FaceLock = { Active = false, Thread = nil }

local function StartFaceLock(getPos)
    FaceLock.Active = true
    if FaceLock.Thread then task.cancel(FaceLock.Thread) end
    FaceLock.Thread = task.spawn(function()
        while FaceLock.Active do
            local root = GetRoot()
            local pos  = getPos()
            if root and pos then
                local dir = Vector3.new(
                    pos.X - root.Position.X,
                    0,
                    pos.Z - root.Position.Z
                )
                if dir.Magnitude > 0.5 then
                    root.CFrame = CFrame.new(root.Position)
                        * CFrame.Angles(0, math.atan2(dir.X, dir.Z) + math.pi, 0)
                end
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

local function StopFaceLock()
    FaceLock.Active = false
    if FaceLock.Thread then
        task.cancel(FaceLock.Thread)
        FaceLock.Thread = nil
    end
end

-- ============================================================
--  VISUAL WALK LINE
-- ============================================================
local WalkLinePart = nil

local function ShowWalkLine(from, to)
    if WalkLinePart and WalkLinePart.Parent then
        WalkLinePart:Destroy()
    end
    local len = (to - from).Magnitude
    if len < 0.5 then return end
    local part        = Instance.new("Part")
    part.Name         = "DQR_WalkLine"
    part.Anchored     = true
    part.CanCollide   = false
    part.CastShadow   = false
    part.Material     = Enum.Material.Neon
    part.Color        = Color3.fromRGB(80, 200, 255)
    part.Transparency = 0.3
    part.Size         = Vector3.new(0.1, 0.1, len)
    part.CFrame       = CFrame.lookAt((from + to) / 2, to)
    part.Parent       = workspace
    WalkLinePart      = part
end

local function ClearWalkLine()
    if WalkLinePart and WalkLinePart.Parent then
        WalkLinePart:Destroy()
        WalkLinePart = nil
    end
end

-- ============================================================
--  OBSTACLE DETECTION
-- ============================================================
local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude

local function ObstacleCheck(from, to)
    local char = GetChar()
    if char then RayParams.FilterDescendantsInstances = {char} end
    local dir  = to - from
    local dist = dir.Magnitude
    if dist < 0.1 then return to end
    local result = workspace:Raycast(
        from + Vector3.new(0, 2, 0),
        dir.Unit * math.min(dist, 8),
        RayParams
    )
    if result then
        local normal = result.Normal
        local slide  = dir - normal * dir:Dot(normal)
        if slide.Magnitude > 0.1 then
            return from + slide.Unit * math.min(dist, 12)
        end
        return from + Vector3.new(-dir.Unit.Z, 0, dir.Unit.X) * 8
    end
    return to
end

-- ============================================================
--  STRICT MOB DETECTION
-- ============================================================
local function IsMob(model)
    if not model:IsA("Model") then return false end

    local hum  = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return false end

    -- Must be alive with valid health values
    if hum.Health    <= 0 then return false end
    if hum.MaxHealth <= 0 then return false end

    -- Must not be a player character
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character == model then return false end
    end

    -- Must have multiple parts (lobby decorations are usually minimal)
    local partCount = 0
    for _, obj in ipairs(model:GetChildren()) do
        if obj:IsA("BasePart") or obj:IsA("MeshPart")
        or obj:IsA("UnionOperation") then
            partCount = partCount + 1
        end
    end
    if partCount < 2 then return false end

    -- Must have a BillboardGui or Highlight (DQR mobs always do)
    local hasBillboard = false
    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("BillboardGui") or obj:IsA("Highlight") then
            hasBillboard = true
            break
        end
    end
    if not hasBillboard then return false end

    -- Root must not be anchored (lobby decorations are anchored)
    if root.Anchored then return false end

    return true
end

local function GetNearestMob()
    local root = GetRoot()
    if not root then return nil end
    local best, bestDist = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and IsMob(obj) then
            local mr = obj:FindFirstChild("HumanoidRootPart")
            if mr then
                local d = (mr.Position - root.Position).Magnitude
                if d < bestDist then
                    bestDist = d
                    best     = {
                        Model    = obj,
                        Root     = mr,
                        Humanoid = obj:FindFirstChildOfClass("Humanoid"),
                        Distance = d,
                    }
                end
            end
        end
    end
    return best
end

-- ============================================================
--  STRICT DUNGEON DETECTION
-- ============================================================
local function IsInDungeon()
    local count = 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and IsMob(obj) then
            count = count + 1
            if count >= 2 then return true end
        end
    end
    return false
end

-- Boot-time version — double checks after a settle delay
local function IsInDungeonSafe()
    if not IsInDungeon() then return false end
    task.wait(2)
    return IsInDungeon()
end

-- ============================================================
--  THREAT DETECTION
-- ============================================================
local function ColorIsThreat(c)
    return (c.R > 0.6 and c.G < 0.35 and c.B < 0.35)
        or (c.R > 0.6 and c.G < 0.35 and c.B > 0.5)
        or (c.R > 0.7 and c.G > 0.3  and c.B < 0.1)
end

local function ScanThreats()
    local root = GetRoot()
    if not root then return false, nil end
    local char = GetChar()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart")
        and (not char or not obj:IsDescendantOf(char)) then
            local neon   = obj.Material == Enum.Material.Neon
            local threat = ColorIsThreat(obj.Color)
            if neon or threat then
                local dist = (obj.Position - root.Position).Magnitude
                if dist < CONFIG.DodgeRange then
                    local vel = obj.AssemblyLinearVelocity
                    if vel.Magnitude > 8 then
                        local dot = vel.Unit:Dot(
                            (root.Position - obj.Position).Unit)
                        if dot > 0.55 then
                            return true, obj.Position
                        end
                    end
                end
            end
            for _, child in ipairs(obj:GetChildren()) do
                if child:IsA("Beam") then
                    if (obj.Position - root.Position).Magnitude
                        < CONFIG.DodgeRange then
                        return true, obj.Position
                    end
                end
            end
        end
    end
    return false, nil
end

-- ============================================================
--  CIRCULAR KITE
-- ============================================================
local orbitAngle = 0
local lastDodge  = 0

local function SeedOrbit(mobPos)
    local root = GetRoot()
    if not root then return end
    local rel  = root.Position - mobPos
    orbitAngle = math.atan2(rel.Z, rel.X)
end

local function GetOrbitPos(mobPos, radius)
    return Vector3.new(
        mobPos.X + math.cos(orbitAngle) * radius,
        mobPos.Y,
        mobPos.Z + math.sin(orbitAngle) * radius
    )
end

-- ============================================================
--  MAIN FARM LOOP
-- ============================================================
local Farm = {
    Running     = false,
    MainThread  = nil,
    DodgeThread = nil,
}

local lastFrame = tick()
local seeded    = false

local function MainLoop()
    local hum = GetHuman()
    if hum then hum.WalkSpeed = CONFIG.WalkSpeed end
    seeded = false

    while Farm.Running do
        local now = tick()
        local dt  = now - lastFrame
        lastFrame = now

        local root  = GetRoot()
        local human = GetHuman()

        if not root or not human or human.Health <= 0 then
            ClearWalkLine()
            StopFaceLock()
            task.wait(0.5)
            continue
        end

        -- Enforce full walkspeed every tick
        if human.WalkSpeed < CONFIG.WalkSpeed then
            human.WalkSpeed = CONFIG.WalkSpeed
        end

        local target = GetNearestMob()

        if not target then
            ClearWalkLine()
            StopFaceLock()
            human:MoveTo(root.Position)
            task.wait(CONFIG.ScanRate)
            continue
        end

        local mobPos = target.Root.Position
        local dist   = target.Distance

        -- Start face lock if not already running
        if not FaceLock.Active then
            StartFaceLock(function()
                local t = GetNearestMob()
                return t and t.Root.Position or nil
            end)
        end

        -- Always try to cast
        TryCast()

        -- Seed orbit once per new target
        if not seeded then
            SeedOrbit(mobPos)
            seeded = true
        end

        -- Dodge check
        local threatened, threatOrigin = ScanThreats()
        if threatened and (now - lastDodge) > CONFIG.DodgeCooldown then
            lastDodge  = now
            local toward = Vector3.new(
                threatOrigin.X - root.Position.X,
                0,
                threatOrigin.Z - root.Position.Z
            ).Unit
            local perp  = Vector3.new(-toward.Z, 0, toward.X)
            local sign  = math.cos(orbitAngle) > 0 and 1 or -1
            local dodge = root.Position + perp * sign * CONFIG.DodgeStep
            dodge       = ObstacleCheck(root.Position, dodge)
            dodge       = Vector3.new(dodge.X, root.Position.Y, dodge.Z)
            ShowWalkLine(root.Position, dodge)
            human:MoveTo(dodge)
            orbitAngle  = orbitAngle + sign * 0.6
            task.wait(CONFIG.ScanRate)
            continue
        end

        -- Advance orbit
        orbitAngle = orbitAngle + CONFIG.CircleSpeed * dt
        if orbitAngle > math.pi * 2 then
            orbitAngle = orbitAngle - math.pi * 2
        end

        -- Radius scaling based on current distance
        local radius = CONFIG.CircleRadius
        if dist < CONFIG.MinRange then
            radius = CONFIG.CircleRadius * 1.6
        elseif dist > CONFIG.MaxRange then
            radius = CONFIG.CircleRadius * 0.5
        end

        -- Compute and walk to orbit point
        local dest = GetOrbitPos(mobPos, radius)
        dest = ObstacleCheck(root.Position, dest)
        dest = Vector3.new(dest.X, root.Position.Y, dest.Z)
        ShowWalkLine(root.Position, dest)
        human:MoveTo(dest)

        task.wait(CONFIG.ScanRate)
    end

    ClearWalkLine()
    StopFaceLock()
end

-- ============================================================
--  DODGE WATCHER 20hz
-- ============================================================
local function DodgeWatcher()
    local lastDW = 0
    while Farm.Running do
        task.wait(0.05)
        local root  = GetRoot()
        local human = GetHuman()
        if not root or not human then continue end
        local threatened, origin = ScanThreats()
        local now = tick()
        if threatened and (now - lastDW) > CONFIG.DodgeCooldown then
            lastDW = now
            local toward = Vector3.new(
                origin.X - root.Position.X,
                0,
                origin.Z - root.Position.Z
            ).Unit
            local perp  = Vector3.new(-toward.Z, 0, toward.X)
            local sign  = math.cos(orbitAngle) > 0 and 1 or -1
            local dodge = root.Position + perp * sign * CONFIG.DodgeStep
            human:MoveTo(dodge)
        end
    end
end

-- ============================================================
--  START / STOP
-- ============================================================
function Farm.Start()
    if Farm.Running then return end
    Farm.Running     = true
    lastFrame        = tick()
    Farm.MainThread  = task.spawn(MainLoop)
    Farm.DodgeThread = task.spawn(DodgeWatcher)
    print("[DQR] Farm started.")
end

function Farm.Stop()
    Farm.Running = false
    ClearWalkLine()
    StopFaceLock()
    local hum  = GetHuman()
    local root = GetRoot()
    if hum and root then hum:MoveTo(root.Position) end
    print("[DQR] Farm stopped.")
end

LP.CharacterAdded:Connect(function()
    task.wait(2)
    if Farm.Running then
        Farm.Stop()
        task.wait(0.5)
        Farm.Start()
    end
end)

