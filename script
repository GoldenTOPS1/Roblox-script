local function Flat(v) return Vector3.new(v.X, 0, v.Z) end
local function FlatDist(a, b)
    local dx, dz = a.X - b.X, a.Z - b.Z
    return math.sqrt(dx * dx + dz * dz)
end

-- Renamed from Blacklist in 2022; support both.
local EXCLUDE = (function()
    local ok, v = pcall(function() return Enum.RaycastFilterType.Exclude end)
    if ok and v then return v end
    return Enum.RaycastFilterType.Blacklist
end)()

-- Our character and our own marker parts, excluded from every query.
local function RayParams(ignoreWater)
    local rp = RaycastParams.new()
    rp.FilterType = EXCLUDE
    rp.FilterDescendantsInstances = {GetChar()}
    rp.IgnoreWater = ignoreWater and true or false
    return rp
end

local function NearbyParts(pos, radius)
    local op = OverlapParams.new()
    op.FilterType = EXCLUDE
    op.FilterDescendantsInstances = {GetChar()}
    op.MaxParts = CONFIG.MaxQueryParts
    local ok, parts = pcall(function()
        return workspace:GetPartBoundsInRadius(pos, radius, op)
    end)
    return (ok and parts) or {}
end

-- Body-width clearance at two heights. One thin centre ray squeaks
-- past corners the character cannot fit through.
local function LineClear(from, to)
    local d = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
    if d.Magnitude < 1 then return true end
    local rp   = RayParams()
    local side = Vector3.new(-d.Unit.Z, 0, d.Unit.X) * CONFIG.AgentWidth
    local full = to - from
    for _, h in ipairs({1.5, 3.5}) do
        for _, off in ipairs({Vector3.zero, side, -side}) do
            local hit = workspace:Raycast(from + off + Vector3.new(0, h, 0), full, rp)
            if hit and hit.Instance.CanCollide then return false end
        end
    end
    return true
end

-- Floor under a spot, and its height.
local function HasGround(p)
    local hit = workspace:Raycast(p + Vector3.new(0, 6, 0),
        Vector3.new(0, -CONFIG.GroundProbe, 0), RayParams(true))
    if not hit then return false, nil end
    return true, hit.Position.Y
end

-- Continuous floor from a to b, with no drop bigger than DropMax.
local function GroundOnPath(a, b)
    local d = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
    local len = d.Magnitude
    if len < 0.5 then return true end
    local u, prev, s = d / len, a.Y, 2
    while s <= len do
        local ok, y = HasGround(a + u * s)
        if not ok then return false end
        if prev - y > CONFIG.DropMax then return false end
        prev, s = y, s + 2
    end
    return true
end

-- The floor under `p`, found from well above it (a staircase landing
-- is above us; a probe from our own height only finds our own floor).
-- Terrain water is not floor: under an Aquatic Temple bridge the sea
-- would otherwise answer every probe.
local function GroundAt(p)
    local hit = workspace:Raycast(p + Vector3.new(0, 60, 0),
        Vector3.new(0, -160, 0), RayParams(true))
    return hit and hit.Position + Vector3.new(0, 3, 0) or nil
end

