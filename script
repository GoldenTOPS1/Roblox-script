local function Env(name)
    local ok, v = pcall(function()
        if getfenv then return getfenv()[name] end
        return (_G)[name]
    end)
    if ok then return v end
    return nil
end

-- ============================================================
--  ON-SCREEN LOG  (F7 toggles, Copy puts it on the clipboard)
-- ============================================================
local rawprint = print
local LOG      = {}
local MAX_LOG  = 600
local LogGui, LogBox, LogScroll, LogCount

local function LogRender()
    if not LogBox then return end
    LogBox.Text = table.concat(LOG, "\n")
    local h = #LOG * 15 + 12
    LogBox.Size = UDim2.new(1, -12, 0, math.max(h, 1))
    if LogScroll then
        LogScroll.CanvasSize = UDim2.new(0, 0, 0, h)
        LogScroll.CanvasPosition = Vector2.new(0,
            math.max(0, h - LogScroll.AbsoluteSize.Y))
    end
    if LogCount then LogCount.Text = #LOG .. " lines" end
end

local function Log(...)
    local parts = {}
    for i = 1, select("#", ...) do
        parts[#parts + 1] = tostring((select(i, ...)))
    end
    local line = os.date("%H:%M:%S") .. "  " .. table.concat(parts, " ")
    LOG[#LOG + 1] = line
    if #LOG > MAX_LOG then table.remove(LOG, 1) end
    pcall(rawprint, line)
    pcall(LogRender)
end

-- Every print() below this line goes to the GUI as well as the console.
local print = Log

local function Copy(text)
    for _, n in ipairs({"setclipboard", "toclipboard", "set_clipboard"}) do
        local fn = Env(n)
        if typeof(fn) == "function" then
            local ok = pcall(fn, text)
            if ok then return true end
        end
    end
    return false
end

