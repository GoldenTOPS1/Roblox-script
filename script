-- Red bar laid out in front of the character, pointing at the current
-- mob. Its length IS the distance to that mob, so it shrinks as you
-- close in and stretches as the mob runs away.
local function ShowRangeBar(root, mobPos, dist)
    if not CONFIG.ShowRangeBar then return end
    if not RangeBarPart or not RangeBarPart.Parent then
        local p = Instance.new("Part")
        p.Name        = "DQR_RangeBar"
        p.Anchored    = true
        p.CanCollide  = false
        p.CanQuery    = false
        p.CanTouch    = false
        p.CastShadow  = false
        p.Material    = Enum.Material.Neon
        p.Color       = Color3.fromRGB(255, 45, 45)
        p.Transparency = 0.3
        p.Parent      = workspace
        RangeBarPart  = p
    end

    local dir = Vector3.new(mobPos.X - root.Position.X, 0,
                            mobPos.Z - root.Position.Z)
    if dir.Magnitude < 0.1 then return end
    dir = dir.Unit

    local len  = math.clamp(dist, 1, CONFIG.BarMaxLen)
    local base = root.Position - Vector3.new(0, 2.6, 0)
    local mid  = base + dir * (len / 2)

    RangeBarPart.Size  = Vector3.new(CONFIG.BarWidth, 0.12, len)
    RangeBarPart.CFrame = CFrame.lookAt(mid, mid + dir)
end

local function ClearRangeBar()
    if RangeBarPart and RangeBarPart.Parent then
        RangeBarPart:Destroy()
    end
    RangeBarPart = nil
end

-- ============================================================
--  REMOTE SCANNER - finds RemoteEvents / RemoteFunctions
--  DQR uses remotes for dungeon queuing under ReplicatedStorage
-- ============================================================
local RS = game:GetService("ReplicatedStorage")

local function FindRemote(name)
    -- Search ReplicatedStorage recursively
    for _, obj in ipairs(RS:GetDescendants()) do
        if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction"))
        and obj.Name:lower():find(name:lower()) then
            return obj
        end
    end
    return nil
end

local function PrintRemotes()
    print("[DQR] === REMOTE SCAN ===")
    for _, obj in ipairs(RS:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            print("[Remote] " .. obj.ClassName .. " | " .. obj:GetFullName())
        end
    end
    print("[DQR] === END ===")
end

-- ============================================================
--  DUNGEON QUEUE - via RemoteEvent fire instead of clicking
--  DQR remote names discovered at runtime via PrintRemotes()
-- ============================================================
local KNOWN_DUNGEON_REMOTES = {
    -- Common patterns in DQR - will match whichever exists
    "CreateDungeon",
    "createDungeon",
    "StartDungeon",
    "startDungeon",
    "JoinDungeon",
    "DungeonCreate",
    "LobbyCreate",
    "CreateLobby",
}

local DIFFICULTY_MAP = {
    Easy      = 1,
    Medium    = 2,
    Hard      = 3,
    Insane    = 4,
    Nightmare = 5,
}

local function TryFireDungeonRemote()
    local diffNum = DIFFICULTY_MAP[CONFIG.Difficulty] or 1

    -- Try each known remote pattern
    for _, name in ipairs(KNOWN_DUNGEON_REMOTES) do
        local remote = FindRemote(name)
        if remote then
            print("[DQR] Found remote: " .. remote:GetFullName())
            if remote:IsA("RemoteEvent") then
                -- Try common argument patterns DQR uses
                pcall(function()
                    remote:FireServer(CONFIG.TargetDungeon, CONFIG.Difficulty)
                end)
                S(0.3)
                pcall(function()
                    remote:FireServer(CONFIG.TargetDungeon, diffNum)
                end)
                S(0.3)
                pcall(function()
                    remote:FireServer({
                        dungeon    = CONFIG.TargetDungeon,
                        difficulty = CONFIG.Difficulty,
                    })
                end)
            elseif remote:IsA("RemoteFunction") then
                pcall(function()
                    remote:InvokeServer(CONFIG.TargetDungeon, CONFIG.Difficulty)
                end)
            end
            return true
        end
    end
    return false
end

-- ============================================================
--  DUNGEON QUEUE - fallback button fire (no click, direct signal)
-- ============================================================
-- ============================================================
--  BUTTON PRESS - the real one.
--  `signal:Fire()` does NOT exist on RBXScriptSignal; every
--  `pcall(function() btn.MouseButton1Click:Fire() end)` in v4.3
--  threw and was silently swallowed, so nothing was ever clicked.
--  Three real strategies, in order of reliability:
--    1. executor firesignal()
--    2. executor getconnections() -> :Fire() on each connection
--    3. VirtualInputManager click at the button's real screen position
-- ============================================================
local function VisibleOnScreen(gui)
    if not gui.Visible or gui.AbsoluteSize.X < 1 then return false end
    local p = gui.Parent
    while p and not p:IsA("PlayerGui") do
        if p:IsA("GuiObject") and not p.Visible then return false end
        if p:IsA("ScreenGui") and not p.Enabled then return false end
        p = p.Parent
    end
    return true
end

local function Norm(s) return (s or ""):lower():gsub("%s+", "") end

-- The label of a Roblox button is very often a child TextLabel, not the
-- button's own .Text. v4.4 only read TextButton.Text, so an ImageButton
-- named "frame" wrapping a TextLabel reading "PLAY" matched nothing -
-- which is exactly why the main-screen Play button was never pressed.
local function ButtonTokens(btn)
    local t = {}
    if btn:IsA("TextButton") then t[#t+1] = Norm(btn.Text) end
    for _, d in ipairs(btn:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            t[#t+1] = Norm(d.Text)
        end
    end
    return t
end

local function ButtonText(btn)
    return table.concat(ButtonTokens(btn), "|")
end

-- EXACT by default. Substring matching is what made "play" match the
-- "Show Players" button in the top-right HUD - which is on screen inside
-- a dungeon too, so InLobby() was always true and the script kept
-- queueing new runs mid-dungeon. Pass contains=true to opt back in.
local function ButtonMatches(btn, m)
    local want = m.text and Norm(m.text) or nil
    if want and want ~= "" then
        for _, tok in ipairs(ButtonTokens(btn)) do
            if m.contains then
                if tok:find(want, 1, true) then return true end
            elseif tok == want then
                return true
            end
        end
    end
    local wn = m.name and Norm(m.name) or nil
    if wn and wn ~= "" then
        local nm = Norm(btn.Name)
        if m.contains then
            if nm:find(wn, 1, true) then return true end
        elseif nm == wn then
            return true
        end
    end
    return false
end

-- AbsolutePosition is measured below the topbar unless the owning
-- ScreenGui sets IgnoreGuiInset. VirtualInputManager wants true viewport
-- coordinates, so the inset must be added *conditionally* - adding it
-- always put the click ~36px below buttons like Create Lobby and missed.
local function ScreenPointOf(gui)
    local ignore = false
    local p = gui.Parent
    while p do
        if p:IsA("ScreenGui") then ignore = p.IgnoreGuiInset break end
        p = p.Parent
    end
    local x = gui.AbsolutePosition.X + gui.AbsoluteSize.X / 2
    local y = gui.AbsolutePosition.Y + gui.AbsoluteSize.Y / 2
    if not ignore then y = y + GuiService:GetGuiInset().Y end
    return x, y
end

local function ClickButton(btn)
    -- Prefer a genuine click when the button is on screen: it triggers
    -- whatever the game actually listens on (MouseButton1Down, InputBegan
    -- on the frame, TouchTap...), not just MouseButton1Click.
    if VisibleOnScreen(btn) then
        local x, y = ScreenPointOf(btn)
        -- The log window would swallow a click landing underneath it.
        -- Blink it off for the duration rather than making you drag it.
        local wasOpen = LogGui and LogGui.Enabled
        if wasOpen then LogGui.Enabled = false end
        local ok = pcall(function()
            VIM:SendMouseMoveEvent(x, y, game)
            S(0.08)
            VIM:SendMouseButtonEvent(x, y, 0, true,  game, 0)
            S(0.08)
            VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end)
        if wasOpen then LogGui.Enabled = true end
        print(("[DQR]   click @ %d,%d ok=%s"):format(x, y, tostring(ok)))
        if ok then return true end
    end

    -- Hidden or input blocked - drive the signal directly. getconnections
    -- first because it is verifiable: we can count the handlers we fired.
    local gc = Env("getconnections")
    if typeof(gc) == "function" then
        local fired = 0
        for _, sig in ipairs({btn.MouseButton1Click, btn.Activated,
                              btn.MouseButton1Down, btn.MouseButton1Up}) do
            pcall(function()
                for _, c in ipairs(gc(sig)) do
                    c:Fire()
                    fired = fired + 1
                end
            end)
        end
        if fired > 0 then return true end
    end

    local fs = Env("firesignal")
    if typeof(fs) == "function" then
        local ok = pcall(fs, btn.MouseButton1Click)
        pcall(fs, btn.Activated)
        if ok then return true end
    end

    return false
end

-- Returns every button matching, visible ones first. A hidden "play" in
-- some other closed menu must never win over the one on screen.
local function FindButtons(matches)
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return {} end
    local vis, hid = {}, {}
    for _, obj in ipairs(pg:GetDescendants()) do
        if (obj:IsA("TextButton") or obj:IsA("ImageButton"))
        and not obj.Name:find("DQRui_")
        and not (LogGui and obj:IsDescendantOf(LogGui)) then
            for _, m in ipairs(matches) do
                if ButtonMatches(obj, m) then
                    if VisibleOnScreen(obj) then
                        vis[#vis+1] = obj
                    else
                        hid[#hid+1] = obj
                    end
                    break
                end
            end
        end
    end
    for _, o in ipairs(hid) do vis[#vis+1] = o end
    return vis
end

-- `verify` (optional) returns true once the click has visibly taken
-- effect. Without it a click counts as done the moment input is sent,
-- which is how "Create Lobby" could report success while nothing moved.
local function FindAndFireBtn(matches, timeout, verify)
    timeout = timeout or 8
    local elapsed = 0
    repeat
        local found = FindButtons(matches)
        for _, obj in ipairs(found) do
            print(("[DQR] Clicking %s  text='%s'  visible=%s")
                :format(obj:GetFullName(), ButtonText(obj),
                        tostring(VisibleOnScreen(obj))))
            ClickButton(obj)
            if not verify then return true end
            local w = 0
            repeat S(0.25) w = w + 0.25 until verify() or w >= 1.5
            if verify() then
                print("[DQR]   verified.")
                return true
            end
            print("[DQR]   click had no effect, trying next candidate.")
        end
        if #found == 0 then print("[DQR]   (no candidates yet)") end
        S(0.5)
        elapsed = elapsed + 0.5
    until elapsed >= timeout
    print("[DQR] No button worked after " .. timeout .. "s.")
    return false
end

-- Prints every button in PlayerGui. Run this in the lobby and paste the
-- output if a step still misses - it gives the real names to match on.
local function DumpGui()
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    print("[DQR] === GUI BUTTON DUMP ===")
    for _, obj in ipairs(pg:GetDescendants()) do
        if obj:IsA("TextButton") or obj:IsA("ImageButton") then
            print(("%s | text='%s' | visible=%s")
                :format(obj:GetFullName(), ButtonText(obj),
                        tostring(VisibleOnScreen(obj))))
        end
    end
    print("[DQR] === END DUMP ===")
end

-- Wire the log window's Dump button now that DumpGui exists
if LogGui then
    local b = LogGui:FindFirstChild("DQRui_DumpBtn", true)
    if b then b.MouseButton1Click:Connect(function() task.spawn(DumpGui) end) end
