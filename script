-- ============================================================
--  DUNGEON COMPLETE WATCHER
--  When all mobs are dead and no new ones spawn → re-queue
-- ============================================================
local function DungeonWatcher()
    local emptyTicks = 0
    while true do
        task.wait(3)
        if not Farm.Running then continue end

        local mobs = GetAllMobs()
        if #mobs == 0 then
            emptyTicks = emptyTicks + 1
            -- If no mobs for 9 seconds straight → dungeon cleared
            if emptyTicks >= 3 then
                emptyTicks = 0
                print("[DQR] Dungeon cleared. Re-queuing...")
                Farm.Stop()
                task.wait(5)   -- wait for results screen / lobby return
                if CONFIG.AutoRunDungeon then
                    TryQueueDungeon()
                    -- Wait for next dungeon to load
                    task.wait(8)
                end
                Farm.Start()
            end
        else
            emptyTicks = 0
        end
    end
end

-- ============================================================
--  BOOT SEQUENCE
-- ============================================================
task.spawn(function()
    print("[DQR] Script loaded.")

    -- 1. Nuke graphics
    NukeGraphics()

    -- 2. Check if already in a dungeon
    task.wait(1.5)
    if IsInDungeon() then
        print("[DQR] Already in dungeon — starting farm.")
        Farm.Start()
    elseif CONFIG.AutoRunDungeon then
        print("[DQR] In lobby — queuing " .. CONFIG.TargetDungeon)
        TryQueueDungeon()
        -- Wait for dungeon to load in
        local waited = 0
        repeat
            task.wait(2)
            waited = waited + 2
        until IsInDungeon() or waited > 60
        if IsInDungeon() then
            Farm.Start()
        else
            print("[DQR] Timed out waiting for dungeon. Start manually.")
        end
    else
        print("[DQR] AutoRunDungeon = false. Waiting for dungeon...")
        -- Poll until inside
        repeat task.wait(3) until IsInDungeon()
        Farm.Start()
    end

    -- 3. Dungeon loop watcher
    task.spawn(DungeonWatcher)
end)

