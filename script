local function NukeGraphics()
    if not CONFIG.LowerGraphics then return end
    local L = game:GetService("Lighting")
    pcall(function() settings().Rendering.QualityLevel = 1 end)
    pcall(function()
        game:GetService("UserGameSettings").SavedQualityLevel =
            Enum.SavedQualitySetting.QualityLevel01
    end)
    pcall(function()
        L.GlobalShadows, L.FogEnd, L.Brightness = false, 9e8, 0
        L.EnvironmentDiffuseScale, L.EnvironmentSpecularScale = 0, 0
    end)
    for _, fx in ipairs(L:GetChildren()) do
        if fx:IsA("PostEffect") then pcall(function() fx.Enabled = false end) end
    end
    local stripped = 0
    for _, o in ipairs(workspace:GetDescendants()) do pcall(function()
        if o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Smoke")
        or o:IsA("Fire") or o:IsA("Sparkles") then
            o.Enabled = false
        elseif CONFIG.StripTextures and (o:IsA("Decal") or o:IsA("Texture")) then
            o.Transparency = 1
            stripped = stripped + 1
        elseif o:IsA("BasePart") then
            o.CastShadow, o.Reflectance = false, 0
        end
    end) end
    print("[DQR] Graphics nuked. " .. stripped .. " textures stripped.")
end

local BODY_PARTS = {
    Head = true, Torso = true, HumanoidRootPart = true,
    ["Left Arm"] = true, ["Right Arm"] = true,
    ["Left Leg"] = true, ["Right Leg"] = true,
    UpperTorso = true, LowerTorso = true,
    LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
    RightUpperArm = true, RightLowerArm = true, RightHand = true,
    LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true,
    RightUpperLeg = true, RightLowerLeg = true, RightFoot = true,
}

local function HideArmour(char)
    if not CONFIG.HideArmour or not char then return end
    local function InTool(o)
        local p = o.Parent
        while p and p ~= workspace do
            if p:IsA("Tool") then return true end
            p = p.Parent
        end
        return false
    end
    for _, o in ipairs(char:GetDescendants()) do pcall(function()
        if o:IsA("Accessory") or o:IsA("Hat") then
            for _, d in ipairs(o:GetDescendants()) do pcall(function()
                if d:IsA("BasePart") then
                    d.Transparency, d.LocalTransparencyModifier = 1, 1
                elseif d:IsA("Decal") or d:IsA("Texture") then
                    d.Transparency = 1
                elseif d:IsA("ParticleEmitter") or d:IsA("Trail") then
                    d.Enabled = false
                end
            end) end
        elseif o:IsA("BasePart") and not BODY_PARTS[o.Name] then
            if CONFIG.HideWeapon or not InTool(o) then
                o.Transparency, o.LocalTransparencyModifier = 1, 1
            end
        elseif o:IsA("Decal") or o:IsA("Texture") then
            o.Transparency = 1
        elseif o:IsA("ParticleEmitter") or o:IsA("Trail")
            or o:IsA("Fire") or o:IsA("Sparkles") then
            o.Enabled = false
        end
    end) end
end

local function VanityPass()
    local real, disp = LP.Name, LP.DisplayName
    local lvl = nil
    local ls = LP:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            local n = v.Name:lower()
            if (n:find("level") or n:find("lvl")) and v:IsA("ValueBase") then
                lvl = tostring(v.Value)
            end
        end
    end
    local roots = {LP:FindFirstChildOfClass("PlayerGui"), GetChar()}
    for _, r in pairs(roots) do
        for _, o in ipairs(r:GetDescendants()) do
            if (o:IsA("TextLabel") or o:IsA("TextButton"))
            and not (LogGui and o:IsDescendantOf(LogGui)) then pcall(function()
                local t = o.Text
                if t == "" then return end
                if CONFIG.SpoofName then
                    if t == real or t == disp then
                        o.Text = CONFIG.FakeName
                    elseif t:find(real, 1, true) then
                        o.Text = t:gsub((real:gsub("%W", "%%%0")), CONFIG.FakeName)
                    end
                end
                if CONFIG.SpoofLevel and t:match("^%d+$") then
                    local nm = (o.Name .. " " .. (o.Parent and o.Parent.Name or "")):lower()
                    if nm:find("level") or nm:find("lvl") or (lvl and t == lvl) then
                        o.Text = CONFIG.FakeLevel
                    end
                end
            end) end
        end
    end
end

local function VanityWatcher()
    while true do
