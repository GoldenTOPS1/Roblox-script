    ["Enchanted Forest"] = {Keywords = {"Enchant", "Forest"}},
}

-- ============================================================
--  BUTTON CLICKER
-- ============================================================
local function ClickButton(btn)
    if not btn then return false end
    pcall(function()
        local pos = btn.AbsolutePosition + btn.AbsoluteSize / 2
        VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, true,  game, 0)
        task.wait(0.1)
        VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
    end)
    task.wait(0.3)
    pcall(function() btn.MouseButton1Click:Fire() end)
    task.wait(0.2)
    pcall(function()
        GuiService.SelectedObject = btn
        VIM:SendKeyEvent(true,  Enum.KeyCode.Return, false, game)
        task.wait(0.1)
        VIM:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
    end)
    return true
end

-- ============================================================
--  FIND DUNGEON TILE
-- ============================================================
local function FindDungeonButton(mapName)
    local data = DUNGEON_DATA[mapName]
    if not data then return nil end
    local function Search(parent)
        for _, obj in ipairs(parent:GetDescendants()) do
            if (obj:IsA("TextButton") or obj:IsA("ImageButton"))
            and obj.Visible then
                local txt = obj:IsA("TextButton") and obj.Text:lower() or ""
                local nm  = obj.Name:lower()
                for _, kw in ipairs(data.Keywords) do
                    if txt:find(kw:lower()) or nm:find(kw:lower()) then
                        return obj
                    end
                end
            end
        end
        return nil
    end
    local btn = Search(LP:WaitForChild("PlayerGui"))
    if not btn then pcall(function()
        btn = Search(game:GetService("CoreGui"))
    end) end
    return btn
end

-- ============================================================
--  FIND PLAY BUTTON
--  Hardcoded: ImageButton Name='playButton' Parent='buttons'
--  Full path: PlayerGui.mainInterface.buttons.playButton
-- ============================================================
local function FindPlayBtn()
    -- Primary: direct hardcoded path
    local direct = nil
    pcall(function()
        direct = LP.PlayerGui
            :WaitForChild("mainInterface", 5)
            :WaitForChild("buttons", 5)
            :WaitForChild("playButton", 5)
    end)
    if direct then return direct end

    -- Secondary: name scan PlayerGui
    for _, obj in ipairs(LP:WaitForChild("PlayerGui"):GetDescendants()) do
        if obj.Name == "playButton"
        and (obj:IsA("ImageButton") or obj:IsA("TextButton")) then
            return obj
        end
    end

    -- Tertiary: CoreGui
    local cg = nil
    pcall(function()
        for _, obj in ipairs(game:GetService("CoreGui"):GetDescendants()) do
            if obj.Name == "playButton" then cg = obj break end
        end
    end)
    if cg then return cg end

    -- Last resort: any button with play in name
    for _, obj in ipairs(LP:WaitForChild("PlayerGui"):GetDescendants()) do
        if (obj:IsA("ImageButton") or obj:IsA("TextButton"))
        and obj.Name:lower():find("play") then
            return obj
        end
    end

    return nil
end

-- ============================================================
--  QUEUE DUNGEON
-- ============================================================
local function TryQueueDungeon()
    if not CONFIG.AutoRunDungeon then return end
    print("[DQR] Queuing: " .. CONFIG.TargetDungeon)

    -- Find and click dungeon tile
    local tileBtn, tries = nil, 0
    repeat
        tileBtn = FindDungeonButton(CONFIG.TargetDungeon)
        tries   = tries + 1
        if not tileBtn then task.wait(2) end
    until tileBtn or tries > 15

    if not tileBtn then
        print("[DQR] Dungeon tile not found after " .. tries .. " tries.")
        return
    end

    print("[DQR] Clicking dungeon tile...")
    ClickButton(tileBtn)
    task.wait(1.5)

    -- Wait for and click Play button
    local playBtn, waited = nil, 0
    repeat
        task.wait(0.5)
        waited  = waited + 0.5
        playBtn = FindPlayBtn()
    until playBtn or waited > 12

    if playBtn then
        print("[DQR] Found playButton — clicking.")
        ClickButton(playBtn)
        task.wait(0.8)
        -- Re-click loop for vote-based lobbies
        for i = 1, 4 do
            task.wait(0.8)
            local again = FindPlayBtn()
            if again then
                print("[DQR] Re-clicking play (" .. i .. ")")
                ClickButton(again)
            end
        end
    else
        print("[DQR] playButton not found after " .. waited .. "s")
    end
end

-- ============================================================
--  DUNGEON COMPLETE WATCHER
-- ============================================================
local function DungeonWatcher()
    local emptyTicks = 0
    while true do
        task.wait(3)
        if not Farm.Running then continue end
        if GetNearestMob() == nil then
            emptyTicks = emptyTicks + 1
            if emptyTicks >= 3 then
                emptyTicks = 0
                print("[DQR] Dungeon cleared — re-queuing.")
                Farm.Stop()
                task.wait(6)
                if CONFIG.AutoRunDungeon then
                    TryQueueDungeon()
                    local w = 0
                    repeat task.wait(2) w = w + 2
                    until IsInDungeon() or w > 90
                end
                if IsInDungeon() then Farm.Start() end
            end
        else
            emptyTicks = 0
        end
    end
end

-- ============================================================
--  BOOT SEQUENCE
-- ============================================================
task.spawn(function()
    print("[DQR] v4.1 loaded.")
    NukeGraphics()
    task.wait(2.5)  -- let lobby fully settle before any detection

    if IsInDungeonSafe() then
        print("[DQR] Already in dungeon — starting farm.")
        Farm.Start()
    elseif CONFIG.AutoRunDungeon then
        -- Check if Play button already visible (on title/lobby screen)
        local existingPlay = FindPlayBtn()
        if existingPlay then
            print("[DQR] Play button visible on boot — clicking.")
            ClickButton(existingPlay)
            task.wait(1)
        else
            TryQueueDungeon()
        end
        -- Wait for dungeon to load
        local w = 0
        repeat task.wait(2) w = w + 2 until IsInDungeon() or w > 90
        if IsInDungeon() then
            Farm.Start()
        else
            print("[DQR] Timed out. Go into dungeon manually then press F5.")
        end
    else
        print("[DQR] AutoRunDungeon off — waiting for dungeon...")
        repeat task.wait(3) until IsInDungeon()
        Farm.Start()
    end

    task.spawn(DungeonWatcher)
end)

