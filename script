-- ============================================================
--  DQR AUTO FARM — FULL REWRITE v3
--  Smooth circular kiting, always face mob, full speed,
--  attacks while moving, obstacle awareness, no shaking
-- ============================================================

-- ============================================================
--  USER CONFIG
-- ============================================================
local CONFIG = {
    TargetDungeon  = "Desert Temple",
    AutoRunDungeon = true,
    LowerGraphics  = true,

    -- Combat
    IdealRange     = 20,     -- try to stay this far from mob
    MinRange       = 12,     -- back off if closer than this
    MaxRange       = 28,     -- close in if farther than this
    DodgeRange     = 45,     -- projectile scan radius
    DodgeCooldown  = 0.8,
    DodgeStep      = 20,
    AttackRate     = 0.28,   -- seconds between spell casts

    -- Movement
    WalkSpeed      = 16,     -- humanoid walkspeed (set to your actual speed)
    CircleRadius   = 20,     -- radius of orbit around mob
    CircleSpeed    = 0.9,    -- how fast angle advances per second (radians)
    ScanRate       = 0.05,   -- main loop hz (20hz)
}
-- ============================================================

local Players            = game:GetService("Players")
local RunService         = game:GetService("RunService")
local UserInputService   = game:GetService("UserInputService")
local LP                 = Players.LocalPlayer

-- ============================================================
--  GRAPHICS NUKE
-- ============================================================
local function NukeGraphics()
    if not CONFIG.LowerGraphics then return end
    local Lighting = game:GetService("Lighting")
    pcall(function() settings().Rendering.QualityLevel = 1 end)
    pcall(function()
        game:GetService("UserGameSettings").SavedQualityLevel =
            Enum.SavedQualitySetting.QualityLevel01
    end)
    Lighting.GlobalShadows             = false
    Lighting.FogEnd                    = 9e8
    Lighting.Brightness                = 0
    Lighting.EnvironmentDiffuseScale   = 0
    Lighting.EnvironmentSpecularScale  = 0
    for _, fx in ipairs(Lighting:GetChildren()) do
        if fx:IsA("PostEffect") then fx.Enabled = false end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        pcall(function()
            if obj:IsA("ParticleEmitter") then obj.Enabled = false end
            if obj:IsA("Trail")           then obj.Enabled = false end
            if obj:IsA("Smoke")           then obj.Enabled = false end
            if obj:IsA("Fire")            then obj.Enabled = false end
            if obj:IsA("Sparkles")        then obj.Enabled = false end
        end)
    end
    print("[DQR] Graphics nuked.")
end

-- ============================================================
--  HELPERS
-- ============================================================
local function GetChar()  return LP.Character end
local function GetRoot()
    local c = GetChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function GetHuman()
    local c = GetChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end

-- ============================================================
--  SPELL CASTING
--  Uses VirtualInputManager — most reliable method in Delta
-- ============================================================
local VIM = game:GetService("VirtualInputManager")

local function FireKey(kc)
    pcall(function()
        VIM:SendKeyEvent(true,  kc, false, game)
    end)
    task.wait(0.05)
    pcall(function()
        VIM:SendKeyEvent(false, kc, false, game)
    end)
end

local spellSlot  = false
local lastAttack = 0

local function TryCast()
    local now = tick()
    if now - lastAttack < CONFIG.AttackRate then return end
    lastAttack = now
    spellSlot  = not spellSlot
    -- Fire on separate thread so it never blocks movement
    task.spawn(function()
        FireKey(spellSlot and Enum.KeyCode.Q or Enum.KeyCode.E)
    end)
end

-- ============================================================
--  FORCE FACE MOB — CFrame lock toward target every frame
--  Bypasses camera shift-lock, works regardless of controls
-- ============================================================
local FaceLock = {
    Active    = false,
    TargetPos = nil,
    Thread    = nil,
}

local function StartFaceLock(getTargetPos)
    FaceLock.Active = true
    if FaceLock.Thread then
        task.cancel(FaceLock.Thread)
    end
    FaceLock.Thread = task.spawn(function()
        while FaceLock.Active do
            local root = GetRoot()
            local pos  = getTargetPos()
            if root and pos then
                local dir = Vector3.new(
                    pos.X - root.Position.X,
                    0,
                    pos.Z - root.Position.Z
                )
                if dir.Magnitude > 0.5 then
                    -- Only rotate Y axis — don't flip the character over
                    local cf = root.CFrame
                    root.CFrame = CFrame.new(cf.Position)
                        * CFrame.Angles(0, math.atan2(dir.X, dir.Z) + math.pi, 0)
                end
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

local function StopFaceLock()
    FaceLock.Active = false
    if FaceLock.Thread then
        task.cancel(FaceLock.Thread)
        FaceLock.Thread = nil
    end
end

-- ============================================================
--  VISUAL WALK LINE
-- ============================================================
local WalkLinePart = nil

local function ShowWalkLine(from, to)
    if WalkLinePart and WalkLinePart.Parent then
        WalkLinePart:Destroy()
    end
    local len = (to - from).Magnitude
    if len < 0.5 then return end
    local mid  = (from + to) / 2
    local part = Instance.new("Part")
    part.Name          = "DQR_WalkLine"
    part.Anchored      = true
    part.CanCollide    = false
    part.CastShadow    = false
    part.Material      = Enum.Material.Neon
    part.Color         = Color3.fromRGB(80, 200, 255)
    part.Transparency  = 0.3
    part.Size          = Vector3.new(0.1, 0.1, len)
    part.CFrame        = CFrame.lookAt(mid, to)
    part.Parent        = workspace
    WalkLinePart       = part
end

local function ClearWalkLine()
    if WalkLinePart and WalkLinePart.Parent then
        WalkLinePart:Destroy()
        WalkLinePart = nil
    end
end

-- ============================================================
--  OBSTACLE DETECTION
--  Raycasts in movement direction — finds walls/floors
-- ============================================================
local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude

local function GetObstacleAwareTarget(from, to)
    local root = GetRoot()
    if not root then return to end

    -- Exclude character parts from raycast
    local char = GetChar()
    if char then
        RayParams.FilterDescendantsInstances = {char}
    end

    local dir    = (to - from)
    local dist   = dir.Magnitude
    if dist < 0.1 then return to end

    -- Cast ray from chest height
    local origin = from + Vector3.new(0, 2, 0)
    local result = workspace:Raycast(origin, dir.Unit * math.min(dist, 8), RayParams)

    if result then
        -- Wall detected — slide along it instead of stopping
        local normal    = result.Normal
        local slideDir  = dir - normal * dir:Dot(normal)
        if slideDir.Magnitude > 0.1 then
            return from + slideDir.Unit * math.min(dist, 12)
        end
        -- Can't slide — step perpendicular
        local perp = Vector3.new(-dir.Unit.Z, 0, dir.Unit.X)
        return from + perp * 8
    end

    return to
end

-- ============================================================
--  MOB DETECTION
-- ============================================================
local function IsMob(model)
    if not model:IsA("Model") then return false end
    local hum  = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return false end
    if hum.Health <= 0 then return false end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character == model then return false end
    end
    return true
end

local function GetNearestMob()
    local root = GetRoot()
    if not root then return nil end
    local best, bestDist = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and IsMob(obj) then
            local mobRoot = obj:FindFirstChild("HumanoidRootPart")
            if mobRoot then
                local d = (mobRoot.Position - root.Position).Magnitude
                if d < bestDist then
                    bestDist = d
                    best     = {
                        Model    = obj,
                        Root     = mobRoot,
                        Humanoid = obj:FindFirstChildOfClass("Humanoid"),
                        Distance = d,
                    }
                end
            end
        end
    end
    return best
end

-- ============================================================
--  THREAT DETECTION
-- ============================================================
local function ColorIsThreat(c)
    return (c.R > 0.6 and c.G < 0.35 and c.B < 0.35)
        or (c.R > 0.6 and c.G < 0.35 and c.B > 0.5)
        or (c.R > 0.7 and c.G > 0.3  and c.B < 0.1)
end

local function ScanThreats()
    local root = GetRoot()
    if not root then return false, nil end
    local char = GetChar()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (not char or not obj:IsDescendantOf(char)) then
            local neon   = obj.Material == Enum.Material.Neon
            local threat = ColorIsThreat(obj.Color)
            if neon or threat then
                local dist = (obj.Position - root.Position).Magnitude
                if dist < CONFIG.DodgeRange then
                    local vel = obj.AssemblyLinearVelocity
                    if vel.Magnitude > 8 then
                        local dot = vel.Unit:Dot((root.Position - obj.Position).Unit)
                        if dot > 0.55 then
                            return true, obj.Position
                        end
                    end
                end
            end
            for _, child in ipairs(obj:GetChildren()) do
                if child:IsA("Beam") then
                    local dist = (obj.Position - root.Position).Magnitude
                    if dist < CONFIG.DodgeRange then
                        return true, obj.Position
                    end
                end
            end
        end
    end
    return false, nil
end

-- ============================================================
--  CIRCULAR KITE MOVEMENT
--  Orbits the mob at IdealRange, no back-and-forth shaking
--  Angle advances continuously so player circles like a pro
-- ============================================================
local orbitAngle = 0
local lastDodge  = 0

local function GetOrbitPosition(mobPos, radius, angle)
    return Vector3.new(
        mobPos.X + math.cos(angle) * radius,
        mobPos.Y,                              -- snap to mob Y, humanoid handles ground
        mobPos.Z + math.sin(angle) * radius
    )
end

local function AdvanceOrbit(dt)
    orbitAngle = orbitAngle + CONFIG.CircleSpeed * dt
    if orbitAngle > math.pi * 2 then
        orbitAngle = orbitAngle - math.pi * 2
    end
end

-- Seed orbit angle to current player position relative to mob
local function SeedOrbitAngle(mobPos)
    local root = GetRoot()
    if not root then return end
    local rel  = root.Position - mobPos
    orbitAngle = math.atan2(rel.Z, rel.X)
end

-- ============================================================
--  MAIN FARM LOOP
-- ============================================================
local Farm = {
    Running    = false,
    MainThread = nil,
    DodgeThread = nil,
}

local lastFrameTime = tick()

local function MainLoop()
    local hum = GetHuman()
    if hum then
        hum.WalkSpeed = CONFIG.WalkSpeed
    end

    local seeded = false

    while Farm.Running do
        local now = tick()
        local dt  = now - lastFrameTime
        lastFrameTime = now

        local root  = GetRoot()
        local human = GetHuman()

        if not root or not human or human.Health <= 0 then
            ClearWalkLine()
            StopFaceLock()
            task.wait(0.5)
            continue
        end

        -- Ensure full speed every tick
        if human.WalkSpeed < CONFIG.WalkSpeed then
            human.WalkSpeed = CONFIG.WalkSpeed
        end

        local target = GetNearestMob()

        if not target then
            ClearWalkLine()
            StopFaceLock()
            human:MoveTo(root.Position)
            task.wait(CONFIG.ScanRate)
            continue
        end

        local mobPos = target.Root.Position
        local dist   = target.Distance

        -- Lock face to mob every frame via dedicated thread
        if not FaceLock.Active then
            StartFaceLock(function()
                local t = GetNearestMob()
                return t and t.Root.Position or nil
            end)
        end

        -- Always try to cast — happens regardless of move state
        TryCast()

        -- Seed orbit angle once per target acquisition
        if not seeded then
            SeedOrbitAngle(mobPos)
            seeded = true
        end

        -- Check dodge
        local threatened, threatOrigin = ScanThreats()
        if threatened and (now - lastDodge) > CONFIG.DodgeCooldown then
            lastDodge = now
            -- Dodge perpendicular to threat, keep circling direction
            local toward = (threatOrigin - root.Position)
            toward       = Vector3.new(toward.X, 0, toward.Z).Unit
            local perp   = Vector3.new(-toward.Z, 0, toward.X)
            local sign   = math.cos(orbitAngle) > 0 and 1 or -1
            local dodge  = root.Position + perp * sign * CONFIG.DodgeStep
            dodge        = GetObstacleAwareTarget(root.Position, dodge)
            ShowWalkLine(root.Position, dodge)
            human:MoveTo(dodge)
            -- Advance orbit angle to match dodge direction
            orbitAngle = orbitAngle + (sign * 0.6)
            task.wait(CONFIG.ScanRate)
            continue
        end

        -- Advance orbit angle
        AdvanceOrbit(dt)

        -- Compute next orbit position
        local targetRadius = CONFIG.CircleRadius

        if dist < CONFIG.MinRange then
            -- Inside min range — increase radius to push out faster
            targetRadius = CONFIG.CircleRadius * 1.5
        elseif dist > CONFIG.MaxRange then
            -- Too far — decrease radius to pull in
            targetRadius = CONFIG.CircleRadius * 0.6
        end

        local orbitPos = GetOrbitPosition(mobPos, targetRadius, orbitAngle)

        -- Obstacle check on orbit destination
        orbitPos = GetObstacleAwareTarget(root.Position, orbitPos)

        -- Clamp Y to root Y — let Roblox humanoid handle elevation
        orbitPos = Vector3.new(orbitPos.X, root.Position.Y, orbitPos.Z)

        ShowWalkLine(root.Position, orbitPos)
        human:MoveTo(orbitPos)

        task.wait(CONFIG.ScanRate)
    end

    ClearWalkLine()
    StopFaceLock()
end

-- ============================================================
--  DEDICATED DODGE WATCHER — 20hz
-- ============================================================
local function DodgeWatcher()
    local lastDW = 0
    while Farm.Running do
        task.wait(0.05)
        local root  = GetRoot()
        local human = GetHuman()
        if not root or not human then continue end

        local threatened, origin = ScanThreats()
        local now = tick()
        if threatened and (now - lastDW) > CONFIG.DodgeCooldown then
            lastDW = now
            local toward = (origin - root.Position)
            toward       = Vector3.new(toward.X, 0, toward.Z).Unit
            local perp   = Vector3.new(-toward.Z, 0, toward.X)
            local sign   = math.cos(orbitAngle) > 0 and 1 or -1
            local dodge  = root.Position + perp * sign * CONFIG.DodgeStep
            human:MoveTo(dodge)
        end
    end
end

-- ============================================================
--  START / STOP
-- ============================================================
function Farm.Start()
    if Farm.Running then return end
    Farm.Running      = true
    lastFrameTime     = tick()
    Farm.MainThread   = task.spawn(MainLoop)
    Farm.DodgeThread  = task.spawn(DodgeWatcher)
    print("[DQR] Farm started.")
end

function Farm.Stop()
    Farm.Running = false
    ClearWalkLine()
    StopFaceLock()
    local hum = GetHuman()
    if hum then hum:MoveTo(GetRoot() and GetRoot().Position or Vector3.new()) end
    print("[DQR] Farm stopped.")
end

LP.CharacterAdded:Connect(function()
    task.wait(2)
    if Farm.Running then
        Farm.Stop()
        task.wait(0.5)
        Farm.Start()
    end
end)

-- ============================================================
--  DUNGEON DETECTION
-- ============================================================
local function IsInDungeon()
    return GetNearestMob() ~= nil
end

-- ============================================================
--  DUNGEON DATA
-- ============================================================
local DUNGEON_DATA = {
    ["Desert Temple"]    = {Keywords = {"Desert",  "Temple"}},
    ["Winter Outpost"]   = {Keywords = {"Winter",  "Outpost"}},
    ["Pirate Island"]    = {Keywords = {"Pirate",  "Island"}},
    ["King's Castle"]    = {Keywords = {"King",    "Castle"}},
    ["Underworld"]       = {Keywords = {"Under",   "world"}},
    ["Samurai Palace"]   = {Keywords = {"Samurai", "Palace"}},
    ["Ghastly Harbor"]   = {Keywords = {"Ghastly", "Harbor"}},
    ["Enchanted Forest"] = {Keywords = {"Enchant", "Forest"}},
}

local function FindDungeonButton(mapName)
    local data = DUNGEON_DATA[mapName]
    if not data then return nil end
    local function Search(parent)
        for _, obj in ipairs(parent:GetDescendants()) do
            if obj:IsA("TextButton") and obj.Visible then
                local txt = obj.Text:lower()
                local nm  = obj.Name:lower()
                for _, kw in ipairs(data.Keywords) do
                    if txt:find(kw:lower()) or nm:find(kw:lower()) then
                        return obj
                    end
                end
            end
        end
        return nil
    end
    local btn = Search(LP:WaitForChild("PlayerGui"))
    if not btn then pcall(function()
        btn = Search(game:GetService("CoreGui"))
    end) end
    return btn
end

local function ClickButton(btn)
    if not btn then return false end
    pcall(function()
        local pos = btn.AbsolutePosition + btn.AbsoluteSize / 2
        VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, true,  game, 0)
        task.wait(0.08)
        VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
    end)
    return true
end

local function FindPlayBtn(parent)
    -- HARDCODED: DQR uses an ImageButton named 'playButton' inside 'buttons'
    for _, obj in ipairs(parent:GetDescendants()) do
        -- Primary: exact match on what the scanner found
        if obj.Name == "playButton" and obj.Visible then
            return obj
        end
        -- Secondary: DnD frame play button (also spotted in scan)
        if obj.Name == "playButton" then
            return obj  -- try even if not visible, game might flip it late
        end
    end

    -- Fallback: any ImageButton or TextButton with play in name
    for _, obj in ipairs(parent:GetDescendants()) do
        if (obj:IsA("ImageButton") or obj:IsA("TextButton")) and obj.Visible then
            local nm = obj.Name:lower()
            local tx = obj:IsA("TextButton") and obj.Text:lower():gsub("%s+","") or ""
            if nm:find("play") or tx == "play" then
                return obj
            end
        end
    end

    return nil
end

local function TryQueueDungeon()
    if not CONFIG.AutoRunDungeon then return end
    print("[DQR] Queuing: " .. CONFIG.TargetDungeon)

    -- Find dungeon tile
    local btn, tries = nil, 0
    repeat
        btn   = FindDungeonButton(CONFIG.TargetDungeon)
        tries = tries + 1
        if not btn then task.wait(2) end
    until btn or tries > 15

    if not btn then
        print("[DQR] Dungeon tile not found.")
        return
    end

    print("[DQR] Clicking dungeon tile...")
    ClickButton(btn)
    task.wait(1.5)

    -- Wait for Play button and click it
        -- Wait for playButton to appear then hardclick it
    local playBtn, waited = nil, 0
    repeat
        task.wait(0.5)
        waited = waited + 0.5

        -- Check PlayerGui
        playBtn = FindPlayBtn(LP:WaitForChild("PlayerGui"))

        -- Check CoreGui fallback
        if not playBtn then
            pcall(function()
                playBtn = FindPlayBtn(game:GetService("CoreGui"))
            end)
        end

        -- Also try direct path since we know exactly where it is
        if not playBtn then
            pcall(function()
                local buttons = LP.PlayerGui:FindFirstChild("mainInterface")
                    and LP.PlayerGui.mainInterface:FindFirstChild("buttons")
                if buttons then
                    playBtn = buttons:FindFirstChild("playButton")
                end
            end)
        end

    until playBtn or waited > 12

    if playBtn then
        print("[DQR] Found playButton — clicking.")

        -- Method 1: VirtualInputManager mouse click on button position
        pcall(function()
            local pos = playBtn.AbsolutePosition + playBtn.AbsoluteSize / 2
            VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, true,  game, 0)
            task.wait(0.1)
            VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
        end)

        task.wait(0.5)

        -- Method 2: fire MouseButton1Click directly on the object
        pcall(function()
            playBtn.MouseButton1Click:Fire()
        end)

        task.wait(0.5)

        -- Method 3: activate via GuiService
        pcall(function()
            game:GetService("GuiService").SelectedObject = playBtn
            VIM:SendKeyEvent(true,  Enum.KeyCode.Return, false, game)
            task.wait(0.1)
            VIM:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
        end)

        print("[DQR] Play button fired — waiting for dungeon load.")
    else
        print("[DQR] playButton not found after " .. waited .. "s")
    end

-- ============================================================
--  DUNGEON COMPLETE WATCHER
-- ============================================================
local function DungeonWatcher()
    local emptyTicks = 0
    while true do
        task.wait(3)
        if not Farm.Running then continue end
        if GetNearestMob() == nil then
            emptyTicks = emptyTicks + 1
            if emptyTicks >= 3 then
                emptyTicks = 0
                print("[DQR] Dungeon cleared. Re-queuing...")
                Farm.Stop()
                task.wait(6)
                if CONFIG.AutoRunDungeon then
                    TryQueueDungeon()
                    local w = 0
                    repeat task.wait(2) w = w + 2 until IsInDungeon() or w > 60
                end
                if IsInDungeon() then Farm.Start() end
            end
        else
            emptyTicks = 0
        end
    end
end

-- ============================================================
--  BOOT
-- ============================================================
task.spawn(function()
    print("[DQR] Loaded.")
    NukeGraphics()
    task.wait(1.5)

    if IsInDungeon() then
        print("[DQR] Already in dungeon — starting.")
        Farm.Start()
    elseif CONFIG.AutoRunDungeon then
        TryQueueDungeon()
        local w = 0
        repeat task.wait(2) w = w + 2 until IsInDungeon() or w > 60
        if IsInDungeon() then Farm.Start()
        else print("[DQR] Timed out. Enter dungeon manually.") end
    else
        print("[DQR] Waiting for dungeon...")
        repeat task.wait(3) until IsInDungeon()
        Farm.Start()
    end

    task.spawn(DungeonWatcher)
end)

