--  F5 TOGGLE
-- ============================================================
UserInputService.InputBegan:Connect(function(inp, gpe)
    if gpe then return end
    if inp.KeyCode == Enum.KeyCode.F5 then
        if Farm.Running then Farm.Stop() else Farm.Start() end
    elseif inp.KeyCode == Enum.KeyCode.F6 then
        DumpGui()
        print("[DQR] InLobby() = " .. tostring(InLobby())
            .. "  MobsPresent() = " .. tostring(MobsPresent()))
    elseif inp.KeyCode == Enum.KeyCode.F7 then
        if LogGui then LogGui.Enabled = not LogGui.Enabled end
    elseif inp.KeyCode == Enum.KeyCode.F8 then
        MobDiag()
    elseif inp.KeyCode == Enum.KeyCode.F9 then
        HazardDiag()
    end
end)

