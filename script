local function AddToggle(page, id, label, default, callback)
    State.Toggles[id] = default or false

    local row = Instance.new("Frame")
    row.Size             = UDim2.new(1, 0, 0, 34)
    row.BackgroundColor3 = CFG.ThirdBg
    row.BorderSizePixel  = 0
    row.Parent           = page
    MakeCorner(row, 6)
    MakeStroke(row, CFG.BorderColor)

    local lbl = MakeLabel(row, label, 12, CFG.TextColor)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.Size     = UDim2.new(1, -60, 1, 0)

    local trackBg = Instance.new("Frame")
    trackBg.Size             = UDim2.new(0, 36, 0, 18)
    trackBg.Position         = UDim2.new(1, -46, 0.5, -9)
    trackBg.BackgroundColor3 = State.Toggles[id] and CFG.ToggleOn or CFG.ToggleOff
    trackBg.BorderSizePixel  = 0
    trackBg.Parent           = row
    MakeCorner(trackBg, 99)

    local thumb = Instance.new("Frame")
    thumb.Size             = UDim2.new(0, 12, 0, 12)
    thumb.Position         = State.Toggles[id]
        and UDim2.new(0, 21, 0.5, -6)
        or  UDim2.new(0, 3,  0.5, -6)
    thumb.BackgroundColor3 = Color3.fromRGB(255,255,255)
    thumb.BorderSizePixel  = 0
    thumb.Parent           = trackBg
    MakeCorner(thumb, 99)

    local clickArea = Instance.new("TextButton")
    clickArea.Size                  = UDim2.new(1, 0, 1, 0)
    clickArea.BackgroundTransparency = 1
    clickArea.Text                  = ""
    clickArea.Parent                = row

    clickArea.MouseButton1Click:Connect(function()
        State.Toggles[id] = not State.Toggles[id]
        local on = State.Toggles[id]
        Tween(trackBg, {BackgroundColor3 = on and CFG.ToggleOn or CFG.ToggleOff}, 0.2)
        Tween(thumb,   {Position = on and UDim2.new(0,21,0.5,-6) or UDim2.new(0,3,0.5,-6)}, 0.2)
        if callback then callback(on) end
    end)

    return {
        Set = function(val)
            State.Toggles[id] = val
            Tween(trackBg, {BackgroundColor3 = val and CFG.ToggleOn or CFG.ToggleOff}, 0.15)
            Tween(thumb,   {Position = val and UDim2.new(0,21,0.5,-6) or UDim2.new(0,3,0.5,-6)}, 0.15)
        end,
        Get = function() return State.Toggles[id] end,
    }
end

local function AddSlider(page, id, label, min, max, default, callback)
    State.Sliders[id] = default or min

    local container = Instance.new("Frame")
    container.Size             = UDim2.new(1, 0, 0, 50)
    container.BackgroundColor3 = CFG.ThirdBg
    container.BorderSizePixel  = 0
    container.Parent           = page
    MakeCorner(container, 6)
    MakeStroke(container, CFG.BorderColor)

    local topRow = Instance.new("Frame")
    topRow.Size                  = UDim2.new(1, 0, 0, 24)
    topRow.BackgroundTransparency = 1
    topRow.Parent                = container

    local lbl = MakeLabel(topRow, label, 12, CFG.TextColor)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.Size     = UDim2.new(1, -60, 1, 0)

    local valLbl = MakeLabel(topRow, tostring(default), 11, CFG.AccentColor, true, Enum.TextXAlignment.Right)
    valLbl.Position = UDim2.new(1, -14, 0, 0)
    valLbl.Size     = UDim2.new(0, 40, 1, 0)

    local track = Instance.new("Frame")
    track.Size             = UDim2.new(1, -20, 0, 4)
    track.Position         = UDim2.new(0, 10, 0, 34)
    track.BackgroundColor3 = CFG.SecondBg
    track.BorderSizePixel  = 0
    track.Parent           = container
    MakeCorner(track, 99)

    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = CFG.AccentColor
    fill.BorderSizePixel  = 0
    fill.Parent           = track
    MakeCorner(fill, 99)

    local knob = Instance.new("Frame")
    knob.Size             = UDim2.new(0, 12, 0, 12)
    knob.Position         = UDim2.new((default - min) / (max - min), -6, 0.5, -6)
    knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
    knob.BorderSizePixel  = 0
    knob.Parent           = track
    MakeCorner(knob, 99)

    local dragging = false
    local function UpdateSlider(inputX)
        local rel = math.clamp((inputX - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * rel)
        State.Sliders[id] = val
        valLbl.Text = tostring(val)
        Tween(fill, {Size     = UDim2.new(rel, 0, 1, 0)},       0.05)
        Tween(knob, {Position = UDim2.new(rel, -6, 0.5, -6)},   0.05)
        if callback then callback(val) end
    end

    track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            UpdateSlider(inp.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            UpdateSlider(inp.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    return {
        Get = function() return State.Sliders[id] end,
        Set = function(val)
            State.Sliders[id] = val
            local rel = (val - min) / (max - min)
            valLbl.Text = tostring(val)
            Tween(fill, {Size     = UDim2.new(rel, 0, 1, 0)},     0.1)
            Tween(knob, {Position = UDim2.new(rel, -6, 0.5, -6)}, 0.1)
        end,
    }
end

