    for _, o in ipairs(char:GetDescendants()) do pcall(function()
        if o:IsA("Accessory") or o:IsA("Hat") then
            for _, d in ipairs(o:GetDescendants()) do pcall(function()
                if d:IsA("BasePart") then
                    d.Transparency, d.LocalTransparencyModifier = 1, 1
                elseif d:IsA("Decal") or d:IsA("Texture") then
                    d.Transparency = 1
                elseif d:IsA("ParticleEmitter") or d:IsA("Trail") then
                    d.Enabled = false
                end
            end) end
        elseif o:IsA("BasePart") and not BODY_PARTS[o.Name] then
            if CONFIG.HideWeapon or not InTool(o) then
                o.Transparency, o.LocalTransparencyModifier = 1, 1
            end
        elseif o:IsA("Decal") or o:IsA("Texture") then
            o.Transparency = 1
        elseif o:IsA("ParticleEmitter") or o:IsA("Trail")
            or o:IsA("Fire") or o:IsA("Sparkles") then
            o.Enabled = false
        end
    end) end
end

local function VanityPass()
    local real, disp = LP.Name, LP.DisplayName
    local lvl = nil
    local ls = LP:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            local n = v.Name:lower()
            if (n:find("level") or n:find("lvl")) and v:IsA("ValueBase") then
                lvl = tostring(v.Value)
            end
        end
    end
    local roots = {LP:FindFirstChildOfClass("PlayerGui"), GetChar()}
    for _, r in pairs(roots) do
        for _, o in ipairs(r:GetDescendants()) do
            if (o:IsA("TextLabel") or o:IsA("TextButton"))
            and not (LogGui and o:IsDescendantOf(LogGui)) then pcall(function()
                local t = o.Text
                if t == "" then return end
                if CONFIG.SpoofName then
                    if t == real or t == disp then
                        o.Text = CONFIG.FakeName
                    elseif t:find(real, 1, true) then
                        o.Text = t:gsub((real:gsub("%W", "%%%0")), CONFIG.FakeName)
                    end
                end
                if CONFIG.SpoofLevel and t:match("^%d+$") then
                    local nm = (o.Name .. " " .. (o.Parent and o.Parent.Name or "")):lower()
                    if nm:find("level") or nm:find("lvl") or (lvl and t == lvl) then
                        o.Text = CONFIG.FakeLevel
                    end
                end
            end) end
        end
    end
end

local function VanityWatcher()
    while true do
        S(0.5)
        if CONFIG.SpoofName or CONFIG.SpoofLevel then pcall(VanityPass) end
        if CONFIG.HideArmour then pcall(HideArmour, GetChar()) end
    end
end

-- ============================================================
--  WORLD REGISTRIES  (event driven)
--  When a part APPEARED is the best evidence of whether it is an
--  attack or the map. Beam instances belong to the caster and its
--  target, so a search near us never finds the one passing through
--  us - track them all. Handle adornments are drawn, not built, and
--  can live anywhere (PlayerGui, Camera), so watch the whole game.
-- ============================================================
local recentParts  = setmetatable({}, {__mode = "k"})  -- part -> born
local beamObjects  = setmetatable({}, {__mode = "k"})  -- Beam -> true
local adornObjects = setmetatable({}, {__mode = "k"})  -- adornment -> true
local hiddenParts  = setmetatable({}, {__mode = "k"})  -- CanQuery-off effects

local function IsAdorn(o)
    return o:IsA("LineHandleAdornment") or o:IsA("CylinderHandleAdornment")
        or o:IsA("BoxHandleAdornment") or o:IsA("SphereHandleAdornment")
        or o:IsA("ImageHandleAdornment")
end

workspace.DescendantAdded:Connect(function(o)
    if o:IsA("Beam") then
        beamObjects[o] = true
    elseif o:IsA("BasePart") then
        recentParts[o] = tick()
        -- The broadphase never returns CanQuery-off parts, and effect
        -- parts very often have it off. Haz.Track filters out the map
        -- decor so this stays a short list.
        if not o.CanQuery and Haz.Track and Haz.Track(o) then
            hiddenParts[o] = true
        end
    end
end)
workspace.DescendantRemoving:Connect(function(o)
    beamObjects[o], recentParts[o], hiddenParts[o] = nil, nil, nil
end)
pcall(function()
    game.DescendantAdded:Connect(function(o)
        if IsAdorn(o) then adornObjects[o] = true end
    end)
    game.DescendantRemoving:Connect(function(o) adornObjects[o] = nil end)
end)
task.spawn(function()
    S(1)
    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("Beam") then
            beamObjects[o] = true
        elseif o:IsA("BasePart") and not o.CanQuery
        and Haz.Track and Haz.Track(o) then
            hiddenParts[o] = true
        elseif IsAdorn(o) then
            adornObjects[o] = true
        end
    end
    for _, name in ipairs({"PlayerGui", "CoreGui"}) do pcall(function()
        local root = LP:FindFirstChildOfClass(name) or game:FindFirstChildOfClass(name)
        for _, o in ipairs(root and root:GetDescendants() or {}) do
            if IsAdorn(o) then adornObjects[o] = true end
        end
    end) end
end)

-- ============================================================
--  PART BEHAVIOUR
--  Games pool their effects: a ring is built once and CFramed into
--  place each cast, so it is never "new". What gives it away is that
--  it moves, grows, fades in or lights up - scenery does none of those.
-- ============================================================
local PartSize, LooksActive
do
local seen   = setmetatable({}, {__mode = "k"})
local meshOf = setmetatable({}, {__mode = "k"})

-- Size as drawn: older effects scale a SpecialMesh and leave the Part
-- itself at 1x1x1.
function PartSize(o)
    local m = meshOf[o]
    if m == nil then
        m = o:IsA("Part") and o:FindFirstChildOfClass("SpecialMesh") or false
        meshOf[o] = m
    end
    if m and m.Parent then return o.Size * m.Scale end
    return o.Size
end

-- Returns active?, why ("new", "moved", "faded", "grew", "lit", "fresh").
-- `fresh`: the caller saw it first well inside the scan radius, where
-- scenery never enters (it always comes in at the edge as we walk).
function LooksActive(o, fresh)
    local now  = tick()
    local born = recentParts[o]
    local new  = born ~= nil and now - born < CONFIG.RecentWindow
    fresh = fresh == true and CONFIG.FreshSightRule == true

    local rec = seen[o]
    -- Out of sight for a while and back: a pooled spoke fired at the
    -- same angle as last time would otherwise read as "never moved".
    if rec and now - rec.seen > 3 then rec = nil end
    if not rec then
        local why = new and "new" or fresh and "fresh" or nil
        seen[o] = {pos = o.Position, tr = o.Transparency, size = PartSize(o),
                   col = o.Color, moved = why and now or 0, why = why, seen = now}
        return why ~= nil, why
    end
    rec.seen = now
    local size, tr, col = PartSize(o), o.Transparency, o.Color
    local why = nil
    if (o.Position - rec.pos).Magnitude > 1 then
        why = "moved"
    elseif rec.tr > 0.9 and tr <= 0.9 then
        why = "faded"
    elseif (size - rec.size).Magnitude > 1 then
        why = "grew"
    -- A floor panel that turns lethal does not move - it lights up.
    -- (Aquatic Temple's second boss walkway.)
    elseif math.abs(col.R - rec.col.R) + math.abs(col.G - rec.col.G)
         + math.abs(col.B - rec.col.B) > 0.2 then
        why = "lit"
    end
    if why then rec.moved, rec.why = now, why end
    rec.pos, rec.tr, rec.size, rec.col = o.Position, tr, size, col
    if new then return true, "new" end
    -- A live telegraph keeps changing; one that has stopped is over.
    if now - rec.moved < CONFIG.ActiveLinger then return true, rec.why end
    return false, nil
end
end

-- ============================================================
--  BUTTONS
--  A synthetic click goes to whatever is under the pixel, so every
--  click checks first that the button we mean is actually there -
--  otherwise it drives the button's signal directly. That is what
--  stopped the Inventory opening itself.
-- ============================================================
local function VisibleOnScreen(gui)
    if not gui.Visible or gui.AbsoluteSize.X < 1 then return false end
    local p = gui.Parent
    while p and not p:IsA("PlayerGui") do
        if p:IsA("GuiObject") and not p.Visible then return false end
        if p:IsA("ScreenGui") and not p.Enabled then return false end
        p = p.Parent
    end
    return true
end

local function Norm(s) return (s or ""):lower():gsub("%s+", "") end

-- A button's label is very often a child TextLabel, not its own .Text.
local function ButtonTokens(btn)
    local t = {}
    if btn:IsA("TextButton") then t[#t + 1] = Norm(btn.Text) end
    for _, d in ipairs(btn:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then t[#t + 1] = Norm(d.Text) end
    end
    return t
end
local function ButtonText(btn) return table.concat(ButtonTokens(btn), "|") end

-- EXACT match by default: substring "play" matched "Show Players".
local function ButtonMatches(btn, m)
    local want = m.text and Norm(m.text) or nil
    if want and want ~= "" then
        for _, tok in ipairs(ButtonTokens(btn)) do
            if (m.contains and tok:find(want, 1, true)) or tok == want then
                return true
            end
        end
    end
    local wn = m.name and Norm(m.name) or nil
    if wn and wn ~= "" then
        local nm = Norm(btn.Name)
        if (m.contains and nm:find(wn, 1, true)) or nm == wn then return true end
    end
    return false
end

-- Viewport coordinates: the topbar inset only applies when the owning
-- ScreenGui does not ignore it.
local function ScreenPointOf(gui)
    local ignore, p = false, gui.Parent
    while p do
        if p:IsA("ScreenGui") then ignore = p.IgnoreGuiInset break end
        p = p.Parent
    end
    local x = gui.AbsolutePosition.X + gui.AbsoluteSize.X / 2
    local y = gui.AbsolutePosition.Y + gui.AbsoluteSize.Y / 2
    if not ignore then y = y + GuiService:GetGuiInset().Y end
    return x, y
end

local function ButtonsAtPoint(x, y)
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return {} end
    local out = {}
    local ok, list = pcall(function()
        return pg:GetGuiObjectsAtPosition(x, y - GuiService:GetGuiInset().Y)
    end)
    for _, o in ipairs((ok and list) or {}) do
        if (o:IsA("TextButton") or o:IsA("ImageButton"))
        and not (LogGui and o:IsDescendantOf(LogGui)) then
            out[#out + 1] = o
        end
    end
    return out
end

local function ClickButton(btn)
    if VisibleOnScreen(btn) then
        local x, y = ScreenPointOf(btn)
        local wasOpen = LogGui and LogGui.Enabled
        if wasOpen then LogGui.Enabled = false end
        local hit  = ButtonsAtPoint(x, y)[1]
        local mine = hit and (hit == btn or hit:IsDescendantOf(btn)
                              or btn:IsDescendantOf(hit))
        if hit and not mine then
            if wasOpen then LogGui.Enabled = true end
            print(("[DQR]   %s is under that point, not %s - firing the "
                .. "signal instead."):format(hit.Name, btn.Name))
        else
            local ok = pcall(function()
                VIM:SendMouseMoveEvent(x, y, game)
                S(0.08)
                VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
                S(0.08)
                VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
            end)
            if wasOpen then LogGui.Enabled = true end
            print(("[DQR]   click @ %d,%d ok=%s"):format(x, y, tostring(ok)))
            if ok then return true end
        end
    end
    local gc = Env("getconnections")
    if typeof(gc) == "function" then
        local fired = 0
        for _, sig in ipairs({btn.MouseButton1Click, btn.Activated,
                              btn.MouseButton1Down, btn.MouseButton1Up}) do
            pcall(function()
                for _, c in ipairs(gc(sig)) do c:Fire() fired = fired + 1 end
            end)
        end
        if fired > 0 then return true end
    end
    local fs = Env("firesignal")
    if typeof(fs) == "function" then
        local ok = pcall(fs, btn.MouseButton1Click)
        pcall(fs, btn.Activated)
        if ok then return true end
    end
    return false
end

-- Every matching button, visible ones first.
local function FindButtons(matches)
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return {} end
    local vis, hid = {}, {}
    for _, obj in ipairs(pg:GetDescendants()) do
        if (obj:IsA("TextButton") or obj:IsA("ImageButton"))
        and not obj.Name:find("DQRui_")
        and not (LogGui and obj:IsDescendantOf(LogGui)) then
            for _, m in ipairs(matches) do
                if ButtonMatches(obj, m) then
                    if VisibleOnScreen(obj) then vis[#vis + 1] = obj
                    else hid[#hid + 1] = obj end
                    break
                end
            end
        end
    end
    for _, o in ipairs(hid) do vis[#vis + 1] = o end
    return vis
end

local function AnyVisible(matches)
    for _, b in ipairs(FindButtons(matches)) do
        if VisibleOnScreen(b) then return b end
    end
    return nil
end

local function DumpGui()
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    print("[DQR] === GUI BUTTON DUMP ===")
    for _, obj in ipairs(pg:GetDescendants()) do
        if obj:IsA("TextButton") or obj:IsA("ImageButton") then
            print(("%s | text='%s' | visible=%s"):format(obj:GetFullName(),
                ButtonText(obj), tostring(VisibleOnScreen(obj))))
        end
    end
    print("[DQR] === END DUMP ===")
end

-- ============================================================
--  EXACT UI PATHS  (from a live GUI dump of this game)
--  The dungeon rows and difficulty buttons are all named "TextButton"
--  with empty text; the identifying name is on the parent frame.
-- ============================================================
UI.IntroPlay   = {"introGui", "title", "Frame", "TextButton"}
UI.LobbyPlay   = {"mainInterface", "buttons", "playButton"}
UI.SelectPanel = {"queueGui", "selectOption"}
UI.CreateGame  = {"queueGui", "selectOption", "Frame", "createGame"}
UI.ChoosePanel = {"queueGui", "chooseDungeon"}
UI.DungeonList = {"queueGui", "chooseDungeon", "backgroundFillLeft", "ScrollingFrame"}
UI.DiffRoot    = {"queueGui", "chooseDungeon", "backgroundFillRight"}
UI.Hardcore    = {"queueGui", "chooseDungeon", "backgroundFillRight",
                  "hardcoreSection", "hardcore"}
UI.CreateLobby = {"queueGui", "chooseDungeon", "backgroundFillMiddle",
                  "startMain", "TextButton"}
UI.LobbyInfo   = {"queueGui", "lobbyInfo"}
UI.ShowFriends = {"friendsList", "buttonMain", "TextButton"}
UI.ShowPlayers = {"leaderboard", "buttonMain", "TextButton"}
UI.StartRun    = {"queueGui", "lobbyInfo", "startBackground", "startFrame", "startButton"}
UI.Replay      = {"ReplayDungeonButton", "Replay"}

local function Path(parts)
    local node = LP:FindFirstChildOfClass("PlayerGui")
    for _, n in ipairs(parts) do
        if not node then return nil end
        node = node:FindFirstChild(n)
    end
    return node
end

local function PathVisible(parts)
    local o = Path(parts)
    if o and VisibleOnScreen(o) then return o end
    return nil
end

-- A row / difficulty button: the TextButton under a frame with that
-- name. Case- and space-insensitive, up to two levels deep (the
-- difficulties sit inside a difficultyPanel wrapper).
local function RowIn(parent, name)
    if not parent then return nil end
    local want = Norm(name)
    local function Find(node, depth)
        for _, c in ipairs(node:GetChildren()) do
            if Norm(c.Name) == want then
                local b = c:FindFirstChildWhichIsA("TextButton")
                if b then return b end
            end
        end
        if depth <= 0 then return nil end
        for _, c in ipairs(node:GetChildren()) do
            if c:IsA("GuiObject") then
                local b = Find(c, depth - 1)
                if b then return b end
            end
        end
        return nil
    end
    return Find(parent, 2)
end

-- What IS there, two levels deep, for a miss message worth reading.
local function NamesIn(parent)
    if not parent then return "(panel not found)" end
    local names = {}
    for _, c in ipairs(parent:GetChildren()) do
        local kids = {}
        for _, g in ipairs(c:GetChildren()) do
            if g:IsA("GuiObject") then kids[#kids + 1] = g.Name end
        end
        names[#names + 1] = #kids > 0
            and (c.Name .. " {" .. table.concat(kids, ", ") .. "}") or c.Name
    end
    return #names > 0 and table.concat(names, ", ") or "(empty)"
end

local function ScrollIntoView(btn)
    local sf = btn
    while sf and not sf:IsA("ScrollingFrame") do sf = sf.Parent end
    if not sf then return end
    local delta = btn.AbsolutePosition.Y - sf.AbsolutePosition.Y
    if delta < 0 or delta > sf.AbsoluteSize.Y - btn.AbsoluteSize.Y then
        sf.CanvasPosition = Vector2.new(sf.CanvasPosition.X,
            math.max(0, sf.CanvasPosition.Y + delta - sf.AbsoluteSize.Y / 2))
        S(0.35)
    end
end

-- ============================================================
--  LOBBY DETECTION
--  Both GUIs exist everywhere; only visibility counts. These markers
--  are on screen in the lobby and never in a dungeon.
-- ============================================================
local LOBBY_MARKERS = {"LobbyPlay", "IntroPlay", "SelectPanel", "ChoosePanel",
                       "LobbyInfo", "Replay", "ShowFriends", "ShowPlayers"}
local lobbySeenAt = tick()

-- The in-dungeon START button, when it is up. Never the lobby party
-- screen's own start button, which lives under queueGui. Cached for a
-- second: it walks the whole PlayerGui.
local DungeonStartButton
do
local at, btn = 0, nil
function DungeonStartButton()
    local now = tick()
    if now - at < 1 then
        if btn and not (btn.Parent and VisibleOnScreen(btn)) then btn = nil end
        return btn
    end
    at, btn = now, nil
    local q = Path({"queueGui"})
    for _, b in ipairs(FindButtons({{text = "start"}, {text = "startdungeon"},
                                    {name = "startbutton"}})) do
        if VisibleOnScreen(b) and not (q and b:IsDescendantOf(q)) then
            btn = b
            break
        end
    end
    return btn
end
end

-- Which lobby-only thing is on screen, or nil. The in-dungeon START
-- button overrides everything: the dungeon's GUI briefly shows the
-- lobby's Play button while it loads, and in Enchanted Forest that was
-- enough to make the bot queue a run from inside the dungeon, never
-- press START, and sit there.
local function LobbyMarker()
    if DungeonStartButton() then return nil end
    for _, k in ipairs(LOBBY_MARKERS) do
        if PathVisible(UI[k]) then
            lobbySeenAt = tick()
            return k
        end
    end
    return nil
end
local function InLobby() return LobbyMarker() ~= nil end

-- "No lobby marker" is briefly true at boot and during the queue
-- transition, so farming waits for it to STAY gone.
local function NotLobbyFor()
    LobbyMarker()
    return tick() - lobbySeenAt
end
local function DungeonConfirmed() return NotLobbyFor() >= CONFIG.LobbyGrace end

task.spawn(function()
    while true do S(0.5) pcall(LobbyMarker) end
end)

-- ============================================================
--  LOBBY QUEUE FLOW
-- ============================================================
local lobbyFlowActive = false

local function RunLobbyFlow()
    if not CONFIG.AutoRunDungeon then return end
    if not InLobby() then
        print("[DQR] Not in the lobby - refusing to queue a dungeon.")
        return
    end
    if lobbyFlowActive then return end
    lobbyFlowActive = true
    print("[DQR] Lobby detected. Driving the queue UI.")

    local function Step(n, label, parts, wait)
        print(("[DQR] Step %d: %s"):format(n, label))
        local w, o = 0, PathVisible(parts)
        while not o and w < (wait or 8) do
            -- A dungeon START button means this was never the lobby.
            if DungeonStartButton() then
                print("[DQR]   The dungeon START button is up - this is not the "
                    .. "lobby. Dropping the queue flow.")
                return false
            end
            S(0.4) w = w + 0.4
            o = PathVisible(parts)
        end
        if not o then
            print(("[DQR]   MISS - %s (%s)"):format(table.concat(parts, "."),
                Path(parts) and "exists but hidden" or "does not exist"))
            return false
        end
        ClickButton(o)
        return true
    end
    local function Abort() lobbyFlowActive = false end

    -- Step 0: the title splash has its own Play button.
    if PathVisible(UI.IntroPlay) then
        Step(0, "Intro splash Play", UI.IntroPlay, 3)
        local w = 0
        repeat S(0.5) w = w + 0.5 until PathVisible(UI.LobbyPlay) or w > 15
    end

    if not Step(1, "Lobby Play", UI.LobbyPlay, 10) then return Abort() end
    S(1.0)
    if not Step(2, "Create Dungeon", UI.CreateGame, 8) then return Abort() end
    S(1.0)

    print("[DQR] Step 3: Select " .. CONFIG.TargetDungeon)
    local db, w = nil, 0
    repeat
        db = RowIn(Path(UI.DungeonList), CONFIG.TargetDungeon)
        if not db then S(0.4) w = w + 0.4 end
    until db or w >= 8
    if not db then
        print("[DQR]   MISS - no row named '" .. CONFIG.TargetDungeon .. "'.")
        print("[DQR]   Available: " .. NamesIn(Path(UI.DungeonList)))
        return Abort()
    end
    ScrollIntoView(db)
    ClickButton(db)
    S(0.8)

    -- The difficulty buttons are built after the dungeon is picked,
    -- so wait for them.
    print("[DQR] Step 4: Difficulty " .. CONFIG.Difficulty)
    local fb, dw = nil, 0
    repeat
        fb = RowIn(Path(UI.DiffRoot), CONFIG.Difficulty)
        if not fb then S(0.4) dw = dw + 0.4 end
    until fb or dw >= 8
    if fb then
        ClickButton(fb)
    else
        print("[DQR]   MISS - no difficulty named '" .. CONFIG.Difficulty .. "'.")
        print("[DQR]   Available: " .. NamesIn(Path(UI.DiffRoot)))
    end
    S(0.8)

    if CONFIG.Hardcore then
        print("[DQR] Step 4b: Hardcore mode")
        local f = Path(UI.Hardcore)
        local hc = f and f:FindFirstChildWhichIsA("TextButton")
        if hc then
            ClickButton(hc)
            print("[DQR]   Hardcore toggled (it is a toggle - verify).")
        else
            print("[DQR]   MISS - no hardcore button.")
        end
        S(0.6)
    end

    -- Create Lobby, verified by the panel actually closing.
    print("[DQR] Step 5: Create Lobby")
    local made = false
    for attempt = 1, 4 do
        local cl = PathVisible(UI.CreateLobby)
        if not cl then S(0.5) else
            ClickButton(cl)
            local t = 0
            repeat S(0.3) t = t + 0.3 until not PathVisible(UI.ChoosePanel) or t > 2.5
            if not PathVisible(UI.ChoosePanel) then made = true break end
            print("[DQR]   attempt " .. attempt .. " did not close the panel.")
        end
    end
    if not made then
        print("[DQR] Create Lobby did not take. Press Copy and send the log.")
        return Abort()
    end
    S(1.2)

    -- CARRY MODE: read the party panel itself - Players:GetPlayers()
    -- is the whole server, not this lobby.
    if CONFIG.CarryMode and CONFIG.CarryFor and #CONFIG.CarryFor > 0 then
        local function InParty(who)
            local info = Path(UI.LobbyInfo)
            if not info then return false end
            local want = Norm(who)
            if want == "" then return true end
            for _, o in ipairs(info:GetDescendants()) do
                if (o:IsA("TextLabel") or o:IsA("TextButton")) and o.Text ~= ""
                and Norm(o.Text):find(want, 1, true) then
                    return true
                end
            end
            return false
        end
        print(("[DQR] Step 5b: Carry mode - waiting for %s.")
            :format(table.concat(CONFIG.CarryFor, ", ")))
        local waited, said = 0, -10
        while true do
            local missing = {}
            for _, who in ipairs(CONFIG.CarryFor) do
                if not InParty(who) then missing[#missing + 1] = who end
            end
            if #missing == 0 then
                print("[DQR]   Everyone is here - starting.")
                break
            end
            if not Path(UI.LobbyInfo) then
                print("[DQR]   Party screen closed while waiting - carrying on.")
                break
            end
            if CONFIG.CarryWait > 0 and waited >= CONFIG.CarryWait then
                print(("[DQR]   Waited %ds for %s - starting without them.")
                    :format(waited, table.concat(missing, ", ")))
                break
            end
            if waited - said >= 10 then
                said = waited
                print(("[DQR]   Still waiting for: %s (%ds)")
                    :format(table.concat(missing, ", "), waited))
            end
            S(1)
            waited = waited + 1
        end
    end

    Step(6, "Start run", UI.StartRun, 10)
    print("[DQR] Lobby flow complete.")
    lobbyFlowActive = false
end

-- ============================================================
--  MOBS
--  One scan, cached briefly, shared by everything. Each record:
--    Model, Root, Humanoid, Boss, Radius, Aim, Dist, Flat
--  Aim is where to point attacks and measure range from: the root,
--  except that a root far above or below us is a model quirk (the
--  Ancient Enchanted Tree's sits 116 studs underground) - then it is
--  the root's horizontal position at our own height.
-- ============================================================
do
Mobs.list, Mobs.at, Mobs.current = {}, 0, nil
local banned = {}                                   -- model -> until
local knownBoss = setmetatable({}, {__mode = "k"})  -- bosses seen this run
local discoverAt = 0
local shape  = setmetatable({}, {__mode = "k"})     -- model -> {ok, bb}
local radius = setmetatable({}, {__mode = "k"})     -- model -> studs

function Mobs.Ban(model, secs)
    if model then banned[model] = tick() + (secs or CONFIG.UnreachableFor) end
end
function Mobs.Banned(model)
    local t = banned[model]
    if t and tick() > t then banned[model] = nil t = nil end
    return t ~= nil
end

local function IsPlayerChar(obj)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character == obj then return true end
    end
    return false
end

local function Record(obj, prt, me)
    local hum = obj:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 or hum.MaxHealth <= 0 then return nil end
    local mr = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart or prt
    -- Anchored skips decorative NPCs, but big boss rigs are often
    -- anchored too - waive it for boss-sized health.
    local bossy = hum.MaxHealth >= CONFIG.BossHealthHint
    if mr.Anchored and not bossy then return nil end
    if IsPlayerChar(obj) then return nil end

    local sh = shape[obj]
    if sh == nil then
        local hasBB = false
        for _, c in ipairs(obj:GetDescendants()) do
            if c:IsA("BillboardGui") or c:IsA("Highlight") then hasBB = true break end
        end
        local pc = 0
        for _, c in ipairs(obj:GetChildren()) do
            if c:IsA("BasePart") then pc = pc + 1 end
        end
        -- Mobs carry a health bar overhead; a boss's bar is at the top
        -- of the screen instead, so it is known by its health pool.
        sh = {ok = (hasBB and pc >= 2) or (bossy and pc >= 1), bb = hasBB}
        shape[obj] = sh
    end
    if not sh.ok then return nil end

    local rad = radius[obj]
    if rad == nil then
        local ok, sz = pcall(function() return obj:GetExtentsSize() end)
        rad = (ok and sz) and math.max(0, math.max(sz.X, sz.Z) / 2 - 2) or 0
        -- Clamped: one stray effect parented to the rig makes a mob
        -- read hundreds of studs wide, and every range is base+radius.
        rad = math.min(rad, CONFIG.MobRadiusMax)
        radius[obj] = rad
    end

    local aim = mr.Position
    if math.abs(aim.Y - me.Y) > CONFIG.AimMaxDrop then
        aim = Vector3.new(aim.X, me.Y, aim.Z)
    end
    return {Model = obj, Root = mr, Humanoid = hum, Boss = bossy and not sh.bb,
            Radius = rad, Aim = aim, Dist = (aim - me).Magnitude,
            Flat = FlatDist(aim, me)}
end

-- Rebuilds Mobs.list. Searches outward in rings and stops at the first
-- that finds a mob: one big query gets truncated arbitrarily past
-- MaxQueryParts, and the mob next to us could be the one dropped.
function Mobs.Scan(force)
    local now = tick()
    if not force and now - Mobs.at < 0.15 then return Mobs.list end
    Mobs.at = now
    local root = GetRoot()
    if not root then Mobs.list = {} return Mobs.list end
    local me, list, seen = root.Position, {}, {}

    local function Consider(prt, deep)
        local obj = nil
        if prt.Name == "HumanoidRootPart" then
            obj = prt.Parent
        elseif deep then
            local n = prt
            for _ = 1, 3 do
                if not n or n == workspace then break end
                if n:IsA("Model") and n:FindFirstChildOfClass("Humanoid") then
                    obj = n break
                end
                n = n.Parent
            end
        end
        if obj and obj:IsA("Model") and not seen[obj] then
            seen[obj] = true
            local rec = Record(obj, prt, me)
            if rec then list[#list + 1] = rec end
        end
    end

    for _, r in ipairs({60, 140, CONFIG.MobScanRadius}) do
        local parts = NearbyParts(me, r)
        for _, prt in ipairs(parts) do Consider(prt, false) end
        if #list == 0 then
            seen = {}
            for _, prt in ipairs(parts) do Consider(prt, true) end
        end
        if #list > 0 then break end
    end
    -- Nothing at any radius: walk the models directly. Slow, but only
    -- when the map looks empty, and missing a live boss is far worse.
    if #list == 0 then
        seen = {}
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                local a = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                       or obj:FindFirstChildWhichIsA("BasePart")
                if a then Consider(a, true) end
            end
        end
    end

    -- Bosses the overhead-bar test misses. The Ancient Enchanted Tree
    -- has a small bar over its head AND the big one at the top of the
    -- screen, so "big health, no overhead bar" called it an ordinary
    -- mob - no PreferBoss, no casting from range, and adds picked over
    -- it. Two more signals, either one enough:
    --   * its name is on screen - the top-of-screen boss bar is a
    --     ScreenGui label, while mob bars live in BillboardGuis
    --   * it has 20x the health of a typical mob in the fight
    -- Bosses the overhead-bar test misses (the Tree has a bar over its
    -- head as well as the one at the top of the screen): anything with
    -- BossHealthRatio times the health of a typical mob around it.
    if #list >= 3 then
        local hp = {}
        for _, rec in ipairs(list) do hp[#hp + 1] = rec.Humanoid.MaxHealth end
        table.sort(hp)
        local median = hp[math.ceil(#hp / 2)]
        for _, rec in ipairs(list) do
            if rec.Humanoid.MaxHealth >= median * CONFIG.BossHealthRatio then
                rec.Boss = true
            end
        end
    end
    for _, rec in ipairs(list) do
        if rec.Boss then knownBoss[rec.Model] = rec.Humanoid end
    end

    -- The ring search above stops at the first ring with anything in
    -- it, and finds mobs by their root. The Ancient Enchanted Tree's
    -- root is ~116 studs under the floor, so with a single spirit within
    -- 140 studs the search ended before ever reaching the Tree - which
    -- is why the bot fought spirits all fight and never once targeted
    -- the boss. Bosses are found separately, by a full sweep every few
    -- seconds, and once known are added to every scan wherever their
    -- root happens to be.
    if now - discoverAt > 5 then
        discoverAt = now
        local hums = {}
        for _, h in ipairs(workspace:GetDescendants()) do
            if h:IsA("Humanoid") and h.Health > 0
            and h.MaxHealth >= CONFIG.BossHealthHint
            and h.Parent and h.Parent:IsA("Model") and not IsPlayerChar(h.Parent) then
                hums[#hums + 1] = h
            end
        end
        local hp = {}
        for _, h in ipairs(hums) do hp[#hp + 1] = h.MaxHealth end
        table.sort(hp)
        local median = hp[math.ceil(#hp / 2)] or 0
        for _, h in ipairs(hums) do
            local m = h.Parent
            if not knownBoss[m] and #hp >= 3
            and h.MaxHealth >= median * CONFIG.BossHealthRatio then
                knownBoss[m] = h
                print(("[DQR] Boss found: %s (%s health)."):format(m.Name, Hud.Short(h.MaxHealth)))
            end
        end
    end
    -- Known bosses join the list when their BODY is within BossRange -
    -- not before, or a final boss parked in a later room would drag the
    -- bot across the map at the start of the run. Built without the
    -- ordinary checks, which assume parts sitting directly in the model;
    -- a big boss's parts are usually nested, and that alone kept the
    -- Tree out of the list after it had been found.
    local inList = {}
    for _, rec in ipairs(list) do inList[rec.Model] = true end
    for m, h in pairs(knownBoss) do
        if not inList[m] and m.Parent and h.Parent == m and h.Health > 0 then
            local mr = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
                    or m:FindFirstChildWhichIsA("BasePart", true)
            if mr then
                local rad = radius[m]
                if rad == nil then
                    local ok, sz = pcall(function() return m:GetExtentsSize() end)
                    rad = (ok and sz) and math.max(0, math.max(sz.X, sz.Z) / 2 - 2) or 0
                    rad = math.min(rad, CONFIG.MobRadiusMax)
                    radius[m] = rad
                end
                local aim = Vector3.new(mr.Position.X, me.Y, mr.Position.Z)
                local rec = {Model = m, Root = mr, Humanoid = h, Boss = true, Radius = rad,
                             Aim = aim, Dist = (aim - me).Magnitude, Flat = FlatDist(aim, me)}
                local _, d = Mobs.Body(rec, me)
                if d <= CONFIG.BossRange then list[#list + 1] = rec end
            end
        end
    end
    Mobs.list = list
    return list
end

-- Where a big mob's BODY is, rather than where its rig keeps the root.
-- The Ancient Enchanted Tree's root is under the floor and nowhere near
-- the trunk, so every distance measured to it was wrong - and spells
-- only fire inside range, so the bot never cast at it once. Returns
-- the nearest point on any visible part of the model, its distance,
-- and the middle of the model (for facing). The part list is rebuilt
-- every few seconds, the nearest point every 0.2s.
do
local cache = setmetatable({}, {__mode = "k"})
function Mobs.Body(rec, me)
    local now = tick()
    local c = cache[rec.Model]
    if not c or now - c.t > 5 then
        local parts = {}
        -- Invisible parts count: a static boss's looks are often map
        -- decor, and what its rig holds is an invisible hitbox - which
        -- is exactly what a spell has to reach.
        for _, p in ipairs(rec.Model:GetDescendants()) do
            if p:IsA("BasePart") then
                local s = p.Size
                if s.X < 400 and s.Y < 400 and s.Z < 400 then parts[#parts + 1] = p end
            end
        end
        if #parts == 0 then parts[1] = rec.Root end
        local ok, cf = pcall(function() return rec.Model:GetBoundingBox() end)
        -- Kept as an offset from the root so it follows a mob that moves.
        c = {t = now, parts = parts, at = 0,
             off = (ok and cf) and (cf.Position - rec.Root.Position) or Vector3.zero}
        cache[rec.Model] = c
    end
    if not c.q or now - c.at > 0.2 then
        local best, bestD = rec.Root.Position, (rec.Root.Position - me).Magnitude
        for _, p in ipairs(c.parts) do
            if p.Parent then
                local cf, h = p.CFrame, p.Size / 2
                local rel = cf:PointToObjectSpace(me)
                local q = cf:PointToWorldSpace(Vector3.new(
                    math.clamp(rel.X, -h.X, h.X), math.clamp(rel.Y, -h.Y, h.Y),
                    math.clamp(rel.Z, -h.Z, h.Z)))
                local d = (q - me).Magnitude
                if d < bestD then best, bestD = q, d end
            end
        end
        c.at, c.q, c.d = now, best, bestD
    end
    return c.q, c.d, rec.Root.Position + c.off
end
end

-- The mob to fight. Sticky: the current target is kept unless it dies,
-- is banned, a boss turns up, or something is SwitchMargin studs
-- closer. Re-picking the nearest every scan made the bot turn on the
-- spot between two mobs and walk nowhere.
function Mobs.Target()
    local list = Mobs.Scan()
    local open = {}
    for _, rec in ipairs(list) do
        if not Mobs.Banned(rec.Model) then open[#open + 1] = rec end
    end
    -- Everything banned but something is right next to us: the ban is
    -- wrong about that one.
    if #open == 0 then
        for _, rec in ipairs(list) do
            if rec.Flat < CONFIG.MobRadiusMax * 3 then
                banned[rec.Model] = nil
                open[#open + 1] = rec
            end
        end
    end
    if #open == 0 then Mobs.current = nil return nil end

    -- Best by rule: boss first, then the middle of a pack, then nearest.
    local best = nil
    if CONFIG.PreferBoss then
        for _, rec in ipairs(open) do
            if rec.Boss and (not best or rec.Flat < best.Flat) then best = rec end
        end
    end
    if not best and CONFIG.PreferGroups and #open > 1 then
        local bestScore = -math.huge
        for _, rec in ipairs(open) do
            local mates = 0
            for _, o in ipairs(open) do
                if o ~= rec and FlatDist(o.Root.Position, rec.Root.Position)
                               < CONFIG.GroupRadius then
                    mates = mates + 1
                end
            end
            local score = mates * CONFIG.GroupWeight - rec.Flat
            if score > bestScore then bestScore, best = score, rec end
        end
    end
    if not best then
        for _, rec in ipairs(open) do
            if not best or rec.Flat < best.Flat then best = rec end
        end
    end

    -- Stickiness.
    local cur = Mobs.current
    if cur and best.Model ~= cur then
        local keep = nil
        for _, rec in ipairs(open) do
            if rec.Model == cur then keep = rec break end
        end
        if keep and not (best.Boss and not keep.Boss)
        and best.Flat > keep.Flat - CONFIG.SwitchMargin then
            best = keep
        end
    end
    Mobs.current = best.Model
    return best
end

function Mobs.Diag()
    local root = GetRoot()
    if not root then print("[DQR] No character.") return end
    print("[DQR] === MOB DIAG ===")
    local n = 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local mr  = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                     or obj:FindFirstChildWhichIsA("BasePart")
            local d = mr and (mr.Position - root.Position).Magnitude or -1
            if hum and d >= 0 and d < 400 then
                n = n + 1
                local sh = shape[obj]
                -- The verdict the targeting actually used, from the last scan.
                local boss = nil
                for _, rec in ipairs(Mobs.list) do
                    if rec.Model == obj then boss = rec.Boss break end
                end
                print(("%s | d=%d hp=%d/%d root=%s rootdY=%d anchored=%s ok=%s boss=%s banned=%s")
                    :format(obj:GetFullName(), d, hum.Health, hum.MaxHealth,
                            mr.Name, mr.Position.Y - root.Position.Y,
                            tostring(mr.Anchored), tostring(sh and sh.ok),
                            boss == nil and "not in scan" or tostring(boss),
                            tostring(Mobs.Banned(obj))))
            end
        end
    end
    -- Every boss the sweep has found, wherever its root is.
    for m, h in pairs(knownBoss) do
        local listed = false
        for _, rec in ipairs(Mobs.list) do
            if rec.Model == m then listed = true break end
        end
        local mr = m.Parent and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
                                 or m:FindFirstChildWhichIsA("BasePart", true))
        local body = "no parts"
        if mr then
            local _, d = Mobs.Body({Model = m, Root = mr}, root.Position)
            body = ("%d studs (root %d away)"):format(d, (mr.Position - root.Position).Magnitude)
        end
        print(("[Boss] %s | hp=%s/%s | body %s | in list=%s banned=%s")
            :format(m.Name, Hud.Short(h.Health), Hud.Short(h.MaxHealth), body,
                    tostring(listed), tostring(Mobs.Banned(m))))
    end
    print(("[DQR] === END (%d humanoid models) ==="):format(n))
end
end

-- In a dungeon = the lobby UI is gone and there are mobs about.
local function IsInDungeon()
    if InLobby() then return false end
    return #Mobs.Scan() >= 2
end

-- ============================================================
--  HAZARDS
--  Each sweep rebuilds Haz.shapes: plain numbers describing where the
--  danger is, so "is this spot safe" is pure maths afterwards.
--    disc  a round marker        (x,y,z, r, hy)
--    box   a strip / rectangle   (cf level at the centre, hx, hz, hy)
--    line  a beam / laser        (a, b, r)
--    ball  a sphere of damage    (x,y,z, r) - measured in 3D, so a big
--          orb floating overhead is dangerous all the way round, not
--          just in a thin slice through its middle
--
--  What counts, in order:
--   1. Named by the game: "<attack>.precast" / ".hitBox". Always.
--   2. Built map (under a MapFolders container) that was there when we
--      arrived: never.
--   3. A walk-through ball that just appeared / moved / lit up.
--   4. A flat marker: warning-coloured, or non-solid and doing
--      something. Solid scenery only counts if it moved, grew, faded in
--      or lit up - floors do none of those.
--   5. A laser: long in one axis, thin in the other two, at body
--      height, and either active or laser-coloured.
--   Plus every Beam instance and handle adornment near us.
-- ============================================================
do
Haz.shapes, Haz.t, Haz.inSince, Haz.muteUntil = {}, 0, 0, 0
local HUGE = 100          -- radius past which a footprint cannot be left
local chars = {}          -- every player's character, refreshed per sweep
local mapMemo = setmetatable({}, {__mode = "k"})
local mapLower = nil
local warnAt, censusAt = setmetatable({}, {__mode = "k"}), setmetatable({}, {__mode = "k"})
local srcFirst, srcLast, srcBan = setmetatable({}, {__mode = "k"}),
    setmetatable({}, {__mode = "k"}), setmetatable({}, {__mode = "k"})

local function IsMapPart(o)
    local known = mapMemo[o]
    if known ~= nil then return known end
    if not mapLower then
        mapLower = {}
        for k in pairs(CONFIG.MapFolders) do mapLower[k:lower()] = true end
    end
    local n, depth, found = o.Parent, 0, false
    while n and n ~= workspace and depth < 10 do
        if mapLower[n.Name:lower()] then found = true break end
        -- A creature's own body and weapons are not attacks either
        -- (Lord Varosh's greatsword read as a laser).
        if n:IsA("Model") and n:FindFirstChildOfClass("Humanoid") then
            found = true break
        end
        n, depth = n.Parent, depth + 1
    end
    mapMemo[o] = found
    return found
end

local function NameHas(o, list)
    local n = o.Name:lower()
    local pn = o.Parent and o.Parent.Name:lower() or ""
    for _, frag in ipairs(list) do
        if n:find(frag, 1, true) or pn:find(frag, 1, true) then return true end
    end
    return false
end

-- Anything this script made, our own spells, and anything on any
-- player's character.
local function IsOurs(o)
    if o.Name:sub(1, 4) == "DQR_" then return true end
    if NameHas(o, CONFIG.IgnoreNames) then return true end
    for _, c in ipairs(chars) do
        if o:IsDescendantOf(c) then return true end
    end
    return false
end

-- This game's "about to be hit" colours, or nil. Being one does NOT
-- make a part a hazard; it relaxes the size caps from marker-sized to
-- attack-sized. Brightness keeps muted floors (tan planks, navy
-- walkways) out whatever their hue.
local function WarnColor(c)
    if c.R > 0.55 and c.G < 0.45 and c.B < 0.45 then return "red" end
    local h, s, v = c:ToHSV()
    if h >= 0.04 and h <= 0.19 and s >= 0.65 and v >= 0.8 then return "orange" end
    if h >= 0.70 and h <= 0.97 and s >= 0.18 and v >= 0.35 then return "purple" end
    if h >= 0.20 and h <= 0.45 and s >= 0.30 and v >= 0.45 then return "green" end
    if h >= 0.45 and h <= 0.62 and s >= 0.35 and v >= 0.55 then return "cyan" end
    return nil
end

-- A part's shape in world terms: its height, and its two horizontal
-- extents with the first one's direction. Size.Y is wrong for anything
-- rotated - a ring painted on the floor is a cylinder on its side.
local function Footprint(o)
    local cf, s = o.CFrame, PartSize(o)
    local rx = math.abs(cf.RightVector.Y)
    local uy = math.abs(cf.UpVector.Y)
    local lz = math.abs(cf.LookVector.Y)
    local height = rx * s.X + uy * s.Y + lz * s.Z
    if rx >= uy and rx >= lz then return height, s.Y, s.Z, cf.UpVector end
    if uy >= rx and uy >= lz then return height, s.X, s.Z, cf.RightVector end
    return height, s.X, s.Y, cf.RightVector
end

-- A part's long axis as a segment.
local function Segment(o)
    local s, cf = PartSize(o), o.CFrame
    local axis, half
    if s.X >= s.Y and s.X >= s.Z then axis, half = cf.RightVector, s.X / 2
    elseif s.Y >= s.Z then axis, half = cf.UpVector, s.Y / 2
    else axis, half = cf.LookVector, s.Z / 2 end
    return o.Position - axis * half, o.Position + axis * half,
           math.min(s.X, s.Y, s.Z)
end

local function SegDistFlat(p, a, b)
    local ab = b - a
    local len2 = ab:Dot(ab)
    local t = len2 > 0.01 and math.clamp((p - a):Dot(ab) / len2, 0, 1) or 0
    return FlatDist(p, a + ab * t)
end

-- Distance to the part's long axis, not its centre: the centre of a
-- 150-stud spoke sits 75 studs away while the spoke is under our feet.
local function NearDist(o, pos)
    local a, b = Segment(o)
    return SegDistFlat(pos, a, b)
end

local function WarnReject(o, warn, why)
    if warn and CONFIG.HazardDebug then
        local now = tick()
        if not warnAt[o] or now - warnAt[o] > 5 then
            warnAt[o] = now
            print(("[DQR] %s part rejected (%s): %s size=%s")
                :format(warn, why, o:GetFullName(), tostring(PartSize(o))))
        end
    end
    return false
end

-- A source producing a footprint without a break for HazardMaxAge is
-- decoration - no attack marker lasts that long - and is ignored for
-- HazardBanTime. The ban has to stick: the capped broadphase drops a
-- part for a sweep now and then, and that must not reset its clock.
local function TooOld(src)
    if not src then return false end
    local now = tick()
    local ban = srcBan[src]
    if ban then
        if now < ban then return true end
        srcBan[src], srcFirst[src], srcLast[src] = nil, nil, nil
    end
    local last = srcLast[src]
    if not last or now - last > 3 then srcFirst[src] = now end
    srcLast[src] = now
    if now - srcFirst[src] > CONFIG.HazardMaxAge then
        srcBan[src] = now + CONFIG.HazardBanTime
        if CONFIG.HazardDebug then
            print(("[DQR] Hazard aged out - decoration, ignored for %ds: %s")
                :format(CONFIG.HazardBanTime, src:GetFullName()))
        end
        return true
    end
    return false
end

local function Describe(h)
    if h.kind == "disc" then return ("disc r=%d"):format(h.r) end
    if h.kind == "ball" then return ("ball r=%d"):format(h.r) end
    if h.kind == "box" then return ("box %dx%d"):format(h.hx * 2, h.hz * 2) end
    return ("line len=%d r=%d"):format((h.b - h.a).Magnitude, h.r)
end

local function Add(h)
    if TooOld(h.src) then return end
    Haz.shapes[#Haz.shapes + 1] = h
    if CONFIG.HazardDebug and h.src then
        local now = tick()
        if not censusAt[h.src] or now - censusAt[h.src] > 5 then
            censusAt[h.src] = now
            print(("[DQR] Hazard %s <- %s (%s)")
                :format(Describe(h), h.src:GetFullName(), h.src.ClassName))
        end
    end
end

local function AddDisc(c, r, hy, src)
    Add({kind = "disc", x = c.X, y = c.Y, z = c.Z, r = r, hy = hy or 0,
         huge = r > HUGE, src = src})
end
local function AddBox(c, dir, hx, hz, hy, src)
    local ax = Vector3.new(dir.X, 0, dir.Z)
    if ax.Magnitude < 0.01 then ax = Vector3.new(1, 0, 0) end
    local cf = CFrame.fromMatrix(c, ax.Unit, Vector3.new(0, 1, 0))
    Add({kind = "box", cf = cf, y = c.Y, hx = hx, hz = hz, hy = hy or 0,
         huge = math.min(hx, hz) > HUGE, src = src})
end
local function AddLine(a, b, r, src)
    Add({kind = "line", a = a, b = b, r = r, huge = r > HUGE, src = src})
end
local function AddBall(c, r, src)
    Add({kind = "ball", x = c.X, y = c.Y, z = c.Z, r = r, huge = r > HUGE, src = src})
end

-- A part's flat footprint, padded: a disc when round, a box otherwise.
local function AddFootprint(o, pad)
    local height, a, b, va = Footprint(o)
    if math.abs(a - b) < 2 then
        AddDisc(o.Position, math.max(a, b) / 2 + pad, height / 2, o)
    else
        AddBox(o.Position, va, a / 2 + pad, b / 2 + pad, height / 2, o)
    end
end

-- 3. A ball of damage: round from above and tall enough to be a body
-- rather than a painted marker. Any colour.
local function IsBlob(o)
    if o.CanCollide or o.Transparency > 0.9 then return false end
    local s = PartSize(o)
    local w, d = s.X, s.Z
    if math.max(w, d) < CONFIG.TelegraphMinLen or math.max(w, d) > CONFIG.RedMaxWide then
        return false
    end
    if math.abs(w - d) > math.max(w, d) * 0.35 then return false end
    if s.Y < math.max(w, d) * 0.3 then return false end
    return LooksActive(o) or WarnColor(o.Color) ~= nil
end

-- 4. A flat marker.
local function IsTelegraph(o, pos, reach)
    local warn = WarnColor(o.Color)
    local maxY    = warn and CONFIG.RedMaxY    or CONFIG.TelegraphMaxY
    local maxWide = warn and CONFIG.RedMaxWide or CONFIG.TelegraphMaxWide
    local s = PartSize(o)
    if math.min(s.X, s.Y, s.Z) > maxY then return WarnReject(o, warn, "too thick") end
    if math.max(s.X, s.Y, s.Z) < CONFIG.TelegraphMinLen then return false end
    local height, a, b = Footprint(o)
    if height > maxY then return WarnReject(o, warn, "too tall") end
    if math.max(a, b) < CONFIG.TelegraphMinLen then return false end
    if math.min(a, b) > maxWide then return WarnReject(o, warn, "too wide") end
    -- Asked before the visibility test, so a marker fading in from
    -- invisible has a parked reading on record to compare against.
    local fresh = NearDist(o, pos) < reach * 0.6
    local active, why = LooksActive(o, fresh)
    if o.Transparency > 0.95 then return false end
    if warn == "red" then return true end
    if o.CanCollide then
        if why == "moved" or why == "faded" or why == "grew" or why == "lit" then
            return true
        end
        return WarnReject(o, warn, "solid and never moved - scenery")
    end
    return active
end

-- 5. Laser-shaped: long in exactly one axis, thin in the other two.
local function BeamShaped(o)
    local s = PartSize(o)
    local minLen, maxThick = CONFIG.BeamMinLen, CONFIG.BeamMaxThick
    local long = (s.X >= minLen and 1 or 0) + (s.Y >= minLen and 1 or 0)
               + (s.Z >= minLen and 1 or 0)
    local thin = (s.X <= maxThick and 1 or 0) + (s.Y <= maxThick and 1 or 0)
               + (s.Z <= maxThick and 1 or 0)
    return long == 1 and thin >= 2
end
local function BeamColoured(o)
    local c = o.Color
    return o.Material == Enum.Material.Neon
        or (c.B > 0.5 and c.R < 0.5 and c.G > 0.35)          -- cyan
        or (c.B > 0.55 and c.R < 0.45 and c.G < 0.55)        -- blue
        or WarnColor(c) ~= nil
end
-- Painted floor stripes are laser-shaped too, but lie flat; a laser
-- passes through the body.
local function AtBodyHeight(o, pos)
    local height = Footprint(o)
    return o.Position.Y + height / 2 > pos.Y - CONFIG.FootOffset + CONFIG.BeamMinHeight
end

local function Classify(o, pos, reach)
    if not o:IsA("BasePart") or IsOurs(o) then return end
    -- 1. The game says it is an attack. Believe it - wherever it is
    -- parented, and however big or invisible (a hitBox is often both).
    if NameHas(o, CONFIG.HazardNames) then
        AddFootprint(o, CONFIG.TelegraphPad)
        return
    end
    -- 2. The built map, unless it was added mid-run.
    if IsMapPart(o) and not recentParts[o] then return end
    -- 3.
    if IsBlob(o) then
        local s = PartSize(o)
        if math.abs(o.Position.Y - pos.Y) < 20 + s.Y / 2 then
            AddBall(o.Position, math.max(s.X, s.Y, s.Z) / 2 + CONFIG.TelegraphPad, o)
        end
        return
    end
    -- 4.
    if IsTelegraph(o, pos, reach) then
        AddFootprint(o, CONFIG.TelegraphPad)
        return
    end
    -- 5.
    if BeamShaped(o) and not o.CanCollide and o.Transparency <= 0.9 then
        if LooksActive(o) or (BeamColoured(o) and AtBodyHeight(o, pos)) then
            local a, b, thin = Segment(o)
            AddLine(a, b, thin / 2 + CONFIG.BeamPad, o)
        end
    end
end

-- Beam instances: a laser is thin, visible and not absurdly long. Games
-- also use Beams for wide texture strips and leave invisible ones on.
local function ScanBeams(pos, reach)
    for beam in pairs(beamObjects) do
        if beam.Parent and beam.Enabled and beam.Attachment0 and beam.Attachment1
        and not IsOurs(beam) then pcall(function()
            local a, b = beam.Attachment0.WorldPosition, beam.Attachment1.WorldPosition
            local w = math.max(beam.Width0, beam.Width1)
            if w <= 0 or w > 16 then return end
            local len = (b - a).Magnitude
            if len < 1 or len > 300 or SegDistFlat(pos, a, b) > reach then return end
            local minT = 1
            for _, k in ipairs(beam.Transparency.Keypoints) do
                if k.Value < minT then minT = k.Value end
            end
            if minT < 0.9 then AddLine(a, b, w / 2 + CONFIG.BeamPad, beam) end
        end) end
    end
end

-- Handle adornments: the Ice Elemental's hairline telegraph spokes are
-- LineHandleAdornments - one pixel wide at any distance, and not parts.
local function ScanAdorns(pos, reach)
    local pad, bpad = CONFIG.TelegraphPad, CONFIG.BeamPad
    for ad in pairs(adornObjects) do pcall(function()
        local adornee = ad.Adornee
        if not ad.Parent or not ad.Visible or not adornee or ad.Transparency > 0.9 then
            return
        end
        local cf = (adornee:IsA("Model") and adornee:GetPivot() or adornee.CFrame) * ad.CFrame
        local c = cf.Position
        if ad:IsA("LineHandleAdornment") then
            local b = c + cf.LookVector * ad.Length
            if ad.Length >= CONFIG.BeamMinLen and SegDistFlat(pos, c, b) < reach then
                AddLine(c, b, bpad, ad)
            end
        elseif ad:IsA("CylinderHandleAdornment") then
            if math.abs(cf.LookVector.Y) > 0.7 then
                -- Standing on end: a disc on the floor.
                if FlatDist(c, pos) < reach + ad.Radius then
                    AddDisc(c, ad.Radius + pad, ad.Height / 2, ad)
                end
            else
                local h = ad.Height / 2
                local a, b = c - cf.LookVector * h, c + cf.LookVector * h
                if ad.Height >= CONFIG.BeamMinLen and SegDistFlat(pos, a, b) < reach then
                    AddLine(a, b, ad.Radius + bpad, ad)
                end
            end
        elseif ad:IsA("SphereHandleAdornment") then
            if ad.Radius * 2 >= CONFIG.TelegraphMinLen and FlatDist(c, pos) < reach + ad.Radius then
                AddBall(c, ad.Radius + pad, ad)
            end
        elseif ad:IsA("ImageHandleAdornment") then
            if math.abs(cf.LookVector.Y) < 0.7 then return end   -- not on the floor
            local sx, sy = ad.Size.X, ad.Size.Y
            if math.max(sx, sy) < CONFIG.TelegraphMinLen
            or FlatDist(c, pos) > reach + math.max(sx, sy) then return end
            if math.abs(sx - sy) < 2 then
                AddDisc(c, math.max(sx, sy) / 2 + pad, 0, ad)
            else
                AddBox(c, cf.RightVector, sx / 2 + pad, sy / 2 + pad, 0, ad)
            end
        else -- BoxHandleAdornment
            local s = ad.Size
            local axis, half
            if s.X >= s.Y and s.X >= s.Z then axis, half = cf.RightVector, s.X / 2
            elseif s.Y >= s.Z then axis, half = cf.UpVector, s.Y / 2
            else axis, half = cf.LookVector, s.Z / 2 end
            local thin = math.min(s.X, s.Y, s.Z)
            if thin <= CONFIG.BeamMaxThick and half * 2 >= CONFIG.BeamMinLen then
                local a, b = c - axis * half, c + axis * half
                if SegDistFlat(pos, a, b) < reach then AddLine(a, b, thin / 2 + bpad, ad) end
                return
            end
            -- Flat and wide: a strip or ring on the floor.
            local height = math.abs(cf.RightVector.Y) * s.X + math.abs(cf.UpVector.Y) * s.Y
                         + math.abs(cf.LookVector.Y) * s.Z
            if height > CONFIG.RedMaxY then return end
            local fa, fb, va
            if math.abs(cf.RightVector.Y) >= 0.7 then fa, fb, va = s.Y, s.Z, cf.UpVector
            elseif math.abs(cf.UpVector.Y) >= 0.7 then fa, fb, va = s.X, s.Z, cf.RightVector
            else fa, fb, va = s.X, s.Y, cf.RightVector end
            if math.max(fa, fb) < CONFIG.TelegraphMinLen
            or FlatDist(c, pos) > reach + math.max(fa, fb) then return end
            if math.abs(fa - fb) < 2 then
                AddDisc(c, math.max(fa, fb) / 2 + pad, height / 2, ad)
            else
                AddBox(c, va, fa / 2 + pad, fb / 2 + pad, height / 2, ad)
            end
        end
    end) end
end

-- For the registry of CanQuery-off parts: worth watching at all?
function Haz.Track(o)
    if o.Name:sub(1, 4) == "DQR_" then return false end
    local s = PartSize(o)
    local mx = math.max(s.X, s.Y, s.Z)
    if mx < CONFIG.TelegraphMinLen or mx > CONFIG.RedMaxWide * 2 then return false end
    return not IsMapPart(o)
end

Haz.IsOurs = IsOurs

-- Rebuild the shape list around `pos`. Cheap to call every tick.
function Haz.Scan(pos)
    local now = tick()
    if now - Haz.t < CONFIG.HazardTTL then return end
    Haz.t = now
    table.clear(Haz.shapes)
    if not CONFIG.DodgeHazards or now < Haz.muteUntil then return end

    table.clear(chars)
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character then chars[#chars + 1] = pl.Character end
    end

    local reach, done = CONFIG.DodgeRange, {}
    local function Try(o)
        if done[o] then return end
        done[o] = true
        pcall(Classify, o, pos, reach)
    end
    -- A small query first: the wide one is capped and truncates
    -- arbitrarily, and the ring under our feet must never be the part
    -- that gets dropped.
    for _, o in ipairs(NearbyParts(pos, 10)) do Try(o) end
    for _, o in ipairs(NearbyParts(pos, reach)) do Try(o) end
    for p, born in pairs(recentParts) do
        if not p.Parent or now - born > CONFIG.RecentWindow then
            recentParts[p] = nil
        elseif not done[p] and not p.CanQuery then
            local ok, d = pcall(NearDist, p, pos)
            if ok and d < reach then Try(p) end
        end
    end
    for p in pairs(hiddenParts) do
        if not p.Parent then
            hiddenParts[p] = nil
        elseif not done[p] then
            local ok, d = pcall(NearDist, p, pos)
            if ok and d < reach then Try(p) end
        end
    end
    ScanBeams(pos, reach)
    ScanAdorns(pos, reach)
    if CONFIG.HazardDebug then pcall(Haz.Draw) end
end

-- How far `p` is from the nearest hazard edge; negative = inside.
-- Discs and boxes count within their own height plus a body; lasers
-- within chest height; balls in true 3D against the body's height.
function Haz.Clear(p, ignoreHuge)
    local best = math.huge
    for _, h in ipairs(Haz.shapes) do
        local c = nil
        if ignoreHuge and h.huge then
            -- too big to step out of
        elseif h.kind == "disc" then
            if math.abs(p.Y - h.y) < math.max(8, h.hy + 5) then
                local dx, dz = p.X - h.x, p.Z - h.z
                c = math.sqrt(dx * dx + dz * dz) - h.r
            end
        elseif h.kind == "box" then
            local rel = h.cf:PointToObjectSpace(p)
            if math.abs(rel.Y) < math.max(8, h.hy + 5) then
                c = math.max(math.abs(rel.X) - h.hx, math.abs(rel.Z) - h.hz)
            end
        elseif h.kind == "ball" then
            local cy = math.clamp(h.y, p.Y - 3, p.Y + 2)
            local dx, dy, dz = p.X - h.x, cy - h.y, p.Z - h.z
            c = math.sqrt(dx * dx + dy * dy + dz * dz) - h.r
        else
            local ab = h.b - h.a
            local len2 = ab:Dot(ab)
            if len2 > 0.01 then
                local t = math.clamp((p - h.a):Dot(ab) / len2, 0, 1)
                local n = h.a + ab * t
                if math.abs(p.Y - n.Y) < 8 then c = FlatDist(p, n) - h.r end
            end
        end
        if c and c < best then best = c end
    end
    return best
end

-- Inside something we could actually step out of?
function Haz.At(p) return Haz.Clear(p, true) < 0 end

-- Does walking a -> b enter a hazard (or end in one)? Samples every
-- 3 studs. Leaving the one we start in does not count.
function Haz.OnPath(a, b)
    local d = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
    local len = d.Magnitude
    if len < 0.5 then return Haz.At(b) end
    local u, inside, s = d / len, Haz.At(a), 3
    while s < len do
        local h = Haz.At(a + u * s)
        if h and not inside then return true end
        inside, s = h, s + 3
    end
    return Haz.At(b)
end

-- Share of the ground within 30 studs that is covered.
function Haz.Coverage(pos)
    if #Haz.shapes == 0 then return 0 end
    local hit, total = 0, 0
    for i = 0, 15 do
        local a = i * math.pi / 8
        local u = Vector3.new(math.cos(a), 0, math.sin(a))
        for _, d in ipairs({6, 12, 20, 30}) do
            total = total + 1
            if Haz.At(pos + u * d) then hit = hit + 1 end
        end
    end
    return hit / total
end

-- HazardDebug: every footprint drawn as a translucent red shape.
local pool = {}
function Haz.Draw()
    local n = 0
    for _, h in ipairs(Haz.shapes) do
        if n >= 40 then break end
        n = n + 1
        local p = pool[n]
        if not p or not p.Parent then
            p = Instance.new("Part")
            p.Name = "DQR_Hz"
            p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
            p.CastShadow, p.Material = false, Enum.Material.Neon
            p.Color, p.Transparency = Color3.fromRGB(255, 60, 60), 0.55
            p.Parent = workspace
            pool[n] = p
        end
        local shapeWant = h.kind == "ball" and Enum.PartType.Ball or Enum.PartType.Block
        if p.Shape ~= shapeWant then p.Shape = shapeWant end
        if h.kind == "line" then
            local d = (h.b - h.a).Magnitude
            if d > 0.1 then
                p.Size = Vector3.new(h.r * 2, 0.3, d)
                p.CFrame = CFrame.lookAt((h.a + h.b) / 2 + Vector3.new(0, 0.3, 0), h.b)
            end
        elseif h.kind == "disc" then
            p.Size = Vector3.new(h.r * 2, 0.3, h.r * 2)
            p.CFrame = CFrame.new(h.x, h.y + 0.3, h.z)
        elseif h.kind == "ball" then
            p.Size = Vector3.new(h.r * 2, h.r * 2, h.r * 2)
            p.CFrame = CFrame.new(h.x, h.y, h.z)
        else
            p.Size = Vector3.new(h.hx * 2, 0.3, h.hz * 2)
            p.CFrame = h.cf + Vector3.new(0, 0.3, 0)
        end
    end
    for i = n + 1, #pool do
        local p = pool[i]
        if p and p.Parent and p.Position.Y > -400 then p.CFrame = CFrame.new(0, -500, 0) end
    end
end

function Haz.Diag()
    local root = GetRoot()
    if not root then print("[DQR] No character.") return end
    local pos = root.Position
    Haz.t = 0
    Haz.Scan(pos)
    print("[DQR] === HAZARD DIAG ===")
    print(("[DQR] Brain: %s. %d footprint(s); ground %d%% covered; standing in one: %s.")
        :format(tostring(Brain.state), #Haz.shapes,
                math.floor(Haz.Coverage(pos) * 100), tostring(Haz.At(pos))))
    if tick() < Haz.muteUntil then
        print(("[DQR] Hazards MUTED for another %ds."):format(Haz.muteUntil - tick()))
    end
    for i, h in ipairs(Haz.shapes) do
        if i > 40 then break end
        print(("[Hazard] %s <- %s"):format(Describe(h),
            h.src and h.src:GetFullName() or "?"))
    end
    print("[DQR] === END HAZARD DIAG ===")
end

-- ============================================================
--  PROJECTILES
--  Recognised by motion, not looks: small, not map, not a creature,
--  and actually going to pass within a few studs of us. Velocity is
--  measured from where the part was last time - most projectiles are
--  moved by CFrame and report zero physics velocity.
-- ============================================================
local tseen = setmetatable({}, {__mode = "k"})
local tcache = {t = 0}
function Haz.Threat()
    local now = tick()
    if now - tcache.t < CONFIG.ThreatTTL then
        return tcache.hit, tcache.pos, tcache.tti, tcache.vel, tcache.rad
    end
    tcache.t, tcache.hit = now, false
    if not CONFIG.DodgeProjectiles then return false end
    local root = GetRoot()
    if not root then return false end
    local me = root.Position
    local best, bestT, bestV, bestR = nil, math.huge, nil, 0
    local function Consider(obj)
        if not obj:IsA("BasePart") or obj.CanCollide or IsOurs(obj) then return end
        local s = obj.Size
        local rad = math.max(s.X, s.Y, s.Z) / 2
        if rad * 2 > CONFIG.ThreatMaxSize then return end
        local owner = obj:FindFirstAncestorOfClass("Model")
        if owner and owner:FindFirstChildOfClass("Humanoid") then return end
        local vel = obj.AssemblyLinearVelocity
        local rec = tseen[obj]
        if vel.Magnitude < 8 and rec and now - rec.t > 0.02 then
            vel = (obj.Position - rec.pos) / (now - rec.t)
        end
        tseen[obj] = {pos = obj.Position, t = now}
        local speed = vel.Magnitude
        if speed < 8 or speed > 400 then return end
        local d = me - obj.Position
        local u = vel / speed
        local along = d:Dot(u)
        if along <= 0 then return end                                  -- going away
        if (d - u * along).Magnitude > 7 + rad then return end         -- passes wide
        local tti = along / speed
        if tti < 2.5 and tti < bestT then best, bestT, bestV, bestR = obj, tti, vel, rad end
    end
    for _, obj in ipairs(NearbyParts(me, CONFIG.DodgeRange)) do pcall(Consider, obj) end
    for p, born in pairs(recentParts) do
        if p.Parent and now - born < CONFIG.RecentWindow and not p.CanQuery
        and (p.Position - me).Magnitude < CONFIG.DodgeRange then
            pcall(Consider, p)
        end
    end
    if best then
        tcache.hit, tcache.pos, tcache.tti, tcache.vel, tcache.rad =
            true, best.Position, bestT, bestV, bestR
    end
    return tcache.hit, tcache.pos, tcache.tti, tcache.vel, tcache.rad
end
end

-- ============================================================
--  MOVEMENT
--  Nav.goal is the only input: the brain sets it, nothing else does.
--  A Heartbeat walks toward it with Humanoid:Move (real walking, so
--  collision, animation and wall-sliding all work), following a
--  PathfindingService route when a wall is in the way. Nav.face is
--  where the body turns to look.
--
--  Roblox's control module calls Humanoid:Move itself every frame -
--  with zero when no key is held - so it has to be disabled, and it
--  re-enables itself whenever the input type changes (a single tap on
--  a phone), so the disable is re-asserted rather than set once.
-- ============================================================
do
Nav.goal, Nav.face = nil, nil
Nav.queue, Nav.qGoal, Nav.force = {}, nil, false
Nav.steer, Nav.steerUntil = nil, 0
Nav.unstick, Nav.unstickUntil = nil, 0
Nav.descendUntil, Nav.pathFail = 0, 0
Nav.progressAt = 0      -- when a route waypoint was last reached

local conn, gen = nil, 0     -- gen: a restarted mover's old worker retires
local controls, controlsOff, wantDisabled = nil, false, false
local mode, cmdSince, diagCount = "humanoid", 0, 0
local stuckAt, stuckSince, stuckCount = nil, 0, 0
local wpStuck, clearStreak = 0, 0

local function SetControls(enabled)
    pcall(function()
        if not controls then
            local pm = LP:FindFirstChild("PlayerScripts")
            pm = pm and pm:FindFirstChild("PlayerModule")
            if not pm then return end
            controls = require(pm):GetControls()
        end
        if not controls then return end
        if enabled then controls:Enable() else controls:Disable() end
        controlsOff = not enabled
    end)
end
local function Reassert()
    if not wantDisabled then return end
    local pm = LP:FindFirstChild("PlayerScripts")
    if not (pm and pm:FindFirstChild("PlayerModule")) then controls = nil end
    SetControls(false)
end
UserInputService.LastInputTypeChanged:Connect(function()
    if wantDisabled then task.defer(Reassert) end
end)
task.spawn(function()
    while true do S(0.5) if wantDisabled then Reassert() end end
end)

function Nav.Diag()
    local r, h = GetRoot(), GetHuman()
    if not r or not h then return "no character" end
    return ("state=%s ws=%.1f md=%.2f vel=%.1f anchored=%s sit=%s floor=%s ctrlOff=%s")
        :format((tostring(h:GetState()):gsub("Enum.HumanoidStateType%.", "")),
                h.WalkSpeed, h.MoveDirection.Magnitude,
                r.AssemblyLinearVelocity.Magnitude, tostring(r.Anchored),
                tostring(h.Sit), tostring(h.FloorMaterial), tostring(controlsOff))
end

local function ClearPath() Nav.queue, Nav.qGoal = {}, nil end
Nav.ClearPath = ClearPath

-- The nearest heading to `dir` that is walkable for `dist` studs and
-- crosses no hazard, or nil when boxed in.
function Nav.SafeStep(pos, dir, dist)
    dir = Flat(dir)
    if dir.Magnitude < 0.01 then return nil end
    dir, dist = dir.Unit, math.max(dist, 3)
    for _, deg in ipairs({0, 20, -20, 40, -40, 65, -65, 90, -90, 120, -120, 150, -150, 180}) do
        local a = math.rad(deg)
        local d = Vector3.new(dir.X * math.cos(a) - dir.Z * math.sin(a), 0,
                              dir.X * math.sin(a) + dir.Z * math.cos(a))
        local p = pos + d * dist
        if not Haz.OnPath(pos, p) and LineClear(pos, p)
        and HasGround(p) and GroundOnPath(pos, p) then
            return p
        end
    end
    return nil
end

-- No route and the straight line is blocked: the most target-ward
-- heading that is actually clear.
local function ClearDirection(pos, target)
    local base = Vector3.new(target.X - pos.X, 0, target.Z - pos.Z)
    if base.Magnitude < 1 then return nil end
    base = base.Unit
    for _, deg in ipairs({0, 25, -25, 50, -50, 75, -75, 100, -100, 135, -135}) do
        local a = math.rad(deg)
        local d = Vector3.new(base.X * math.cos(a) - base.Z * math.sin(a), 0,
                              base.X * math.sin(a) + base.Z * math.cos(a))
        if LineClear(pos, pos + d * CONFIG.ProbeDist) then return d end
    end
    return nil
end

-- ---- pathfinding ----------------------------------------------
local pathFails, nextDetour = 0, 0
local detourTo, detourAt = nil, 0

local function Route(from, to, tries)
    for _, try in ipairs(tries) do
        local path = PathfindingService:CreatePath({
            AgentRadius = try[1], AgentHeight = 5,
            AgentCanJump = true, AgentMaxSlope = try[2],
        })
        local ok = pcall(function() path:ComputeAsync(from, to) end)
        if ok and path.Status == Enum.PathStatus.Success then
            local wps, out = path:GetWaypoints(), {}
            for i = 2, #wps do out[#out + 1] = wps[i] end   -- [1] is where we are
            if #out > 0 then return out end
        end
    end
    return nil
end

-- A route to `to`, or, when there is none, a route to somewhere
-- reachable and closer: the stairs off to one side, a ramp behind us.
-- It is hill-climbing on the navmesh, one leg at a time. The strictest
-- agent goes first (it keeps the bot off mountainsides); 70 degrees is
-- the loosest - 89 is a wall, and Roblox will route straight up one.
local function ComputePath(from, to)
    local direct = Route(from, to, {{3, CONFIG.AgentMaxSlope}, {2, 60}, {1.5, 70}})
    if direct then
        pathFails, detourTo = 0, nil
        return direct
    end
    pathFails = pathFails + 1
    local now = tick()
    if pathFails < 2 then return nil end

    -- On a detour already: re-aim at the same spot rather than search
    -- again, or each search from a slightly different position picks a
    -- different "best" and none of them gets walked.
    if detourTo and now - detourAt < 8 and FlatDist(detourTo, from) > 12 then
        local r = Route(from, detourTo, {{1.5, 70}})
        if r then return r end
        detourTo = nil
    end
    if now < nextDetour then return nil end
    nextDetour = now + 1.2

    local mid, soft = {{2, 60}}, {{1.5, 70}}
    local flat = FlatDist(to, from)

    -- 1. The endpoint may just be off the navmesh (a mob on a rock).
    local base = GroundAt(to)
    if base then
        local r = Route(from, base, {{2, 60}, {1.5, 70}})
        if r then return r end
    end
    for _, deg in ipairs({0, 90, 180, 270}) do
        local a = math.rad(deg)
        local p = GroundAt(to + Vector3.new(math.cos(a), 0, math.sin(a)) * 7)
        local r = p and Route(from, p, mid)
        if r then return r end
    end
    -- 2. Too far in one call; the ground partway is often fine.
    if flat > 60 then
        for _, f in ipairs({0.66, 0.4}) do
            local p = GroundAt(from:Lerp(to, f))
            local r = p and Route(from, p, mid)
            if r then return r end
        end
    end
    -- 3. Fan out. Height gained toward a target above us is worth more
    -- than horizontal progress: that is what a staircase looks like.
    local up, cands = to.Y - from.Y, {}
    local w = math.abs(up) > 25 and 4 or 2
    for deg = 0, 345, 15 do
        local a = math.rad(deg)
        for _, dist in ipairs({20, 35, 55, 80}) do
            local p = GroundAt(from + Vector3.new(math.cos(a), 0, math.sin(a)) * dist)
            if p then
                local d = FlatDist(p, to)
                local gain = 0
                if math.abs(up) > 6 then
                    gain = math.clamp((p.Y - from.Y) * (up > 0 and 1 or -1), -30, 30)
                end
                if d < flat - 4 or gain > 3 then
                    cands[#cands + 1] = {p = p, d = d, score = d - gain * w}
                end
            end
        end
    end
    table.sort(cands, function(x, y) return x.score < y.score end)
    for i = 1, math.min(#cands, 8) do
        local r = Route(from, cands[i].p, soft)
        if r then
            detourTo, detourAt = cands[i].p, now
            print(("[DQR] No direct route - detouring via ground %d studs from the goal.")
                :format(cands[i].d))
            return r
        end
    end
    return nil
end

-- Runs on its own thread: ComputeAsync yields.
local function Worker(myGen)
    while conn and myGen == gen do
        S(0.3)
        local root, human, goal = GetRoot(), GetHuman(), Nav.goal
        if human and human.Health <= 0 then goal = nil end
        if not (root and goal) then
            if #Nav.queue > 0 then ClearPath() end
            Nav.steer = nil
            continue
        end
        local pos = root.Position
        local flat, rise = FlatDist(goal, pos), goal.Y - pos.Y
        -- A clear straight line means nothing when the goal is well
        -- above us: on a staircase the line clears through the open air
        -- over the steps, and dropping the route walks us into the side
        -- of the flight.
        local need = Nav.force or (flat > CONFIG.PathMinDist
                     and (rise > CONFIG.JumpMax or not LineClear(pos, goal)))
        if need then
            local moved = Nav.qGoal and (goal - Nav.qGoal).Magnitude or 1e9
            if Nav.force or moved > CONFIG.RepathDist or #Nav.queue == 0 then
                Nav.force = false
                local wps = ComputePath(pos, goal)
                if wps then
                    Nav.queue, Nav.qGoal, Nav.pathFail, Nav.steer = wps, goal, 0, nil
                elseif #Nav.queue > 0 then
                    -- Keep walking the route we have; an empty recompute
                    -- for a goal that shuffled is no reason to drop it.
                    Nav.qGoal = goal
                else
                    Nav.pathFail = Nav.pathFail + 1
                    ClearPath()
                    if not Nav.steer or tick() > Nav.steerUntil
                    or not LineClear(pos, pos + Nav.steer * CONFIG.ProbeDist) then
                        Nav.steer = ClearDirection(pos, goal)
                        Nav.steerUntil = tick() + CONFIG.SteerDwell
                    end
                    -- Below us and unroutable: the pathfinder never
                    -- routes off a ledge, but a humanoid can walk off one.
                    if goal.Y < pos.Y - CONFIG.DescendDrop and flat > 1 then
                        Nav.steer = Flat(goal - pos).Unit
                        Nav.steerUntil, Nav.descendUntil = tick() + CONFIG.SteerDwell, tick() + 3
                    end
                    if Nav.pathFail % 5 == 1 then
                        print(("[DQR] No path (%d) - %s."):format(Nav.pathFail,
                            Nav.steer and "steering around" or "no clear heading"))
                    end
                end
            end
        else
            Nav.steer = nil
            -- Only drop a working route after a few clear readings, and
            -- never while it is still climbing.
            local climbing = false
            for i = 1, math.min(#Nav.queue, 4) do
                if Nav.queue[i].Position.Y - pos.Y > 3 then climbing = true break end
            end
            if #Nav.queue > 0 and not climbing then
                clearStreak = clearStreak + 1
                if clearStreak >= CONFIG.PathHoldClear then
                    ClearPath()
                    clearStreak = 0
                end
            else
                clearStreak = 0
            end
        end
    end
end

local function Heartbeat(dt)
    local root, human = GetRoot(), GetHuman()
    if not root or not human then return end
    if human.Health <= 0 then
        if #Nav.queue > 0 then ClearPath() end
        stuckAt, cmdSince = nil, 0
        ShowDest(nil, nil)
        return
    end
    if human.AutoRotate then human.AutoRotate = false end
    if CONFIG.SetWalkSpeed and human.WalkSpeed ~= CONFIG.WalkSpeed then
        human.WalkSpeed = CONFIG.WalkSpeed
    end

    local now, pos, goal = tick(), root.Position, Nav.goal
    -- A route computed for somewhere else (the brain changed its mind):
    -- drop it now, not after the worker notices.
    if goal and Nav.qGoal and #Nav.queue > 0
    and (goal - Nav.qGoal).Magnitude > CONFIG.RepathDist then
        ClearPath()
    end
    if not goal and #Nav.queue > 0 then ClearPath() end

    local step = goal
    if Nav.unstick and now < Nav.unstickUntil then
        step = pos + Nav.unstick * CONFIG.UnstickDist
    elseif goal and #Nav.queue > 0 then
        local wp = Nav.queue[1]
        -- Reached only when close in BOTH axes: judging on X/Z alone
        -- popped the waypoint on top of a ledge while we stood under it.
        if FlatDist(wp.Position, pos) < CONFIG.WaypointReach
        and math.abs(wp.Position.Y - pos.Y) < CONFIG.WaypointReachY then
            table.remove(Nav.queue, 1)
            wpStuck, wp = 0, Nav.queue[1]
            Nav.progressAt = now
        else
            wpStuck = wpStuck + dt
            if wpStuck > CONFIG.WaypointTimeout then
                table.remove(Nav.queue, 1)
                wpStuck, Nav.force, wp = 0, true, Nav.queue[1]
            end
        end
        if wp then
            step = wp.Position
            local rise = wp.Position.Y - pos.Y
            if rise > CONFIG.JumpMax then
                -- Taller than a jump: a wall the route misjudged.
                table.remove(Nav.queue, 1)
                Nav.force, wpStuck = true, 0
            elseif wp.Action == Enum.PathWaypointAction.Jump or rise > 3 then
                human.Jump = true
            end
        end
    elseif goal and Nav.steer and FlatDist(goal, pos) > CONFIG.PathMinDist then
        step = pos + Nav.steer * CONFIG.ProbeDist
    end

    ShowDest(goal, step)

    local dir = nil
    if step then
        local d = Vector3.new(step.X - pos.X, 0, step.Z - pos.Z)
        if d.Magnitude > 1 then dir = d.Unit end
    end
    if dir then
        if cmdSince == 0 then cmdSince = now end
        if mode == "humanoid" then
            human:Move(dir, false)
            -- Commanding for a second with no MoveDirection: something
            -- is still eating the command. Drive velocity instead.
            if now - cmdSince > 1 and human.MoveDirection.Magnitude < 0.1 then
                Reassert()
                mode = "velocity"
                print("[DQR] Humanoid:Move is being overridden - velocity mode. " .. Nav.Diag())
            end
        else
            if human.MoveDirection.Magnitude > 0.1 then
                mode, cmdSince = "humanoid", now
                print("[DQR] Humanoid responding again - back to walk mode.")
            end
            local spd = human.WalkSpeed > 0 and human.WalkSpeed or 16
            local v = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(dir.X * spd, v.Y, dir.Z * spd)
            human:Move(dir, false)
        end
    else
        cmdSince = 0
        if mode == "humanoid" then
            human:Move(Vector3.zero, false)
        else
            local v = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
        end
    end

    -- Wedged: trying to go somewhere and not moving. Jump, back out to
    -- one side (alternating), and ask for a fresh route. Not while
    -- deliberately walking off a ledge - that looks exactly the same.
    if goal and FlatDist(goal, pos) > CONFIG.WaypointReach and now >= Nav.descendUntil then
        if not stuckAt or (pos - stuckAt).Magnitude > CONFIG.StuckDist then
            stuckAt, stuckSince = pos, now
        elseif now - stuckSince > CONFIG.StuckTime then
            stuckAt, stuckSince, stuckCount = pos, now, stuckCount + 1
            human.Jump = true
            pcall(function() human:ChangeState(Enum.HumanoidStateType.Jumping) end)
            ClearPath()
            Nav.force = true
            local back = Flat(-root.CFrame.LookVector)
            if back.Magnitude < 0.01 then back = Vector3.new(1, 0, 0) end
            back = back.Unit
            local side = Vector3.new(-back.Z, 0, back.X) * ((stuckCount % 2 == 0) and 1 or -1)
            local spot = Nav.SafeStep(pos, (back * 0.7 + side).Unit, CONFIG.UnstickDist)
            Nav.unstick = spot and Flat(spot - pos).Unit or back
            Nav.unstickUntil = now + CONFIG.UnstickTime
            if diagCount < 3 then
                diagCount = diagCount + 1
                print("[DQR] Stuck - backing out. " .. Nav.Diag())
            elseif diagCount == 3 then
                diagCount = 4
                print("[DQR] Stuck (further diagnostics suppressed).")
            end
        end
    else
        stuckAt, stuckCount = nil, 0
    end

    -- Turn to face the target (or where we are walking).
    local look = nil
    local fp = Nav.face
    if fp then
        local d = Vector3.new(fp.X - pos.X, 0, fp.Z - pos.Z)
        if d.Magnitude > 0.5 then look = d.Unit end
    end
    if not look and dir then look = dir end
    if look then root.CFrame = CFrame.lookAt(pos, pos + look) end

    local cam = workspace.CurrentCamera
    if cam then
        if CONFIG.AimMode == "camera" and fp and look then
            if cam.CameraType ~= Enum.CameraType.Scriptable then
                cam.CameraType = Enum.CameraType.Scriptable
            end
            cam.CFrame = CFrame.lookAt(pos - look * CONFIG.CameraBack
                + Vector3.new(0, CONFIG.CameraHeight, 0), fp)
        elseif cam.CameraType == Enum.CameraType.Scriptable then
            cam.CameraType = Enum.CameraType.Custom
            pcall(function() cam.CameraSubject = human end)
        end
    end
end

function Nav.Start()
    if conn then conn:Disconnect() end
    ClearPath()
    Nav.goal, Nav.face, Nav.force = nil, nil, false
    Nav.steer, Nav.unstick, Nav.unstickUntil = nil, nil, 0
    stuckAt, stuckCount, wpStuck, clearStreak = nil, 0, 0, 0
    mode, cmdSince, diagCount = "humanoid", 0, 0
    wantDisabled = true
    SetControls(false)
    local h = GetHuman()
    if h then
        pcall(function() h.AutoRotate = false end)
        if CONFIG.SetWalkSpeed then pcall(function() h.WalkSpeed = CONFIG.WalkSpeed end) end
        pcall(function() h:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end)
    end
    print("[DQR] Move start: " .. Nav.Diag())
    conn = RunService.Heartbeat:Connect(Heartbeat)
    gen = gen + 1
    task.spawn(Worker, gen)
end

function Nav.Stop()
    if conn then conn:Disconnect() conn = nil end
    ClearPath()
    ClearDest()
    Nav.goal, Nav.face = nil, nil
    local h = GetHuman()
    if h then pcall(function() h:Move(Vector3.zero, false) h.AutoRotate = true end) end
    wantDisabled = false
    SetControls(true)
    local cam = workspace.CurrentCamera
    if cam and cam.CameraType == Enum.CameraType.Scriptable then
        cam.CameraType = Enum.CameraType.Custom
        pcall(function() cam.CameraSubject = GetHuman() end)
    end
end
end

-- ============================================================
--  EXPLORE
--  Dungeon Quest is a corridor: clear a wave and the next is further
--  along. There is no map to read, so the heading is learned from the
--  way the bot has been travelling, plus a coarse memory of where it
--  has already stood - "forward, somewhere new".
-- ============================================================
do
local dir, dirFrom = nil, nil
local visited = {}
local pick, pickAt, idleSince = nil, 0, 0

local function Cell(p)
    local c = CONFIG.ExploreCell
    return math.floor(p.X / c) * 8192 + math.floor(p.Z / c)
end

function Nav.ExploreSeen(pos)
    visited[Cell(pos)] = true
    if not dirFrom then dirFrom = pos return end
    local d = Flat(pos - dirFrom)
    if d.Magnitude > CONFIG.ExploreCell then dir, dirFrom = d.Unit, pos end
end

function Nav.ExploreReset() pick, pickAt, idleSince = nil, 0, 0 end

function Nav.Explore(pos)
    if not CONFIG.AutoExplore then return nil end
    local now = tick()
    -- Stand a moment first: waves often spawn where the last one died.
    if idleSince == 0 then idleSince = now end
    if now - idleSince < CONFIG.ExploreWait then return nil end
    if pick and FlatDist(pick, pos) > CONFIG.WaypointReach * 2
    and now - pickAt < CONFIG.ExploreEvery then
        return pick
    end
    if now - pickAt < 1.5 then return pick end     -- 48 raycasts: not at 20Hz
    pickAt = now
    local best, bestScore = nil, -1e9
    for deg = 0, 345, 15 do
        local a = math.rad(deg)
        local u = Vector3.new(math.cos(a), 0, math.sin(a))
        for _, d in ipairs({35, 70}) do
            local p = GroundAt(pos + u * d)
            if p and math.abs(p.Y - pos.Y) < 40 and not Haz.At(p) then
                local score = d * 0.3
                if dir then score = score + u:Dot(dir) * 45 end
                if not visited[Cell(p)] then score = score + 40 end
                if score > bestScore then best, bestScore = p, score end
            end
        end
    end
    pick = best
    if best then
        print(("[DQR] Nothing to fight - walking on, %d studs %s.")
            :format((best - pos).Magnitude, dir and "ahead" or "to open ground"))
    end
    return pick
end
end

-- ============================================================
--  COMBAT
--  Spells are Q/E key presses, alternated every AttackRate - the game
--  handles the cooldowns. Nothing here waits on movement.
-- ============================================================
local DoMelee, DoSpell
do
local spellSlot, lastSpell, lastMelee = false, 0, 0

local function FireKey(kc)
    pcall(function() VIM:SendKeyEvent(true, kc, false, game) end)
    S(0.05)
    pcall(function() VIM:SendKeyEvent(false, kc, false, game) end)
end

-- Screen point to aim at: the target's own screen position in "mouse"
-- mode (when on screen), otherwise the middle of the view.
local function AimPoint(aimAt)
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
    local x, y = vp.X / 2, vp.Y / 2
    if cam and aimAt and CONFIG.AimMode == "mouse" then
        local ok, sp, on = pcall(function()
            local p, v = cam:WorldToViewportPoint(aimAt)
            return p, v
        end)
        if ok and on and sp then x, y = sp.X, sp.Y end
    end
    return x, y
end

function DoMelee(aimAt)
    local now = tick()
    if now - lastMelee < CONFIG.MeleeRate then return end
    lastMelee = now
    if CONFIG.MeleeMode ~= "click" then
        local c = GetChar()
        local tool = c and c:FindFirstChildOfClass("Tool")
        if tool then
            task.spawn(function() pcall(function() tool:Activate() end) end)
            if CONFIG.MeleeMode == "tool" then return end
        end
    end
    task.spawn(function() pcall(function()
        local x, y = AimPoint(aimAt)
        -- A HUD button under that pixel would be pressed instead.
        if ButtonsAtPoint(x, y)[1] then return end
        VIM:SendMouseMoveEvent(x, y, game)
        VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
        S(0.05)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end) end)
end

function DoSpell(dist, range, aimAt)
    if dist > range then return end
    local now = tick()
    if now - lastSpell < CONFIG.AttackRate then return end
    lastSpell, spellSlot = now, not spellSlot
    task.spawn(function()
        if CONFIG.AimMode == "mouse" and aimAt then pcall(function()
            local x, y = AimPoint(aimAt)
            if not ButtonsAtPoint(x, y)[1] then VIM:SendMouseMoveEvent(x, y, game) end
        end) end
        FireKey(spellSlot and Enum.KeyCode.Q or Enum.KeyCode.E)
    end)
end
end

-- ============================================================
--  BRAIN
--  One loop, 20 times a second, and the only thing that sets
--  Nav.goal. Each tick:
--    1. Attack. Every tick there is a target in range - spells are
--       never held back by anything movement is doing.
--    2. Decide where to stand, first match wins:
--         a projectile about to land      -> sidestep it
--         standing in a hazard, clean exit close by -> step out
--         target too close / too far      -> back off / walk in
--         can't get closer                -> fight from here
--         nothing to fight                -> walk on to the next wave
--  A standing-in-a-hazard with no clean exit is not special: it just
--  falls through to fighting.
-- ============================================================
do
Brain.state, Brain.target = "Idle", nil
local evade, dodge = nil, nil          -- committed moves: {goal, untilT}
local lastDodge, lastPick, settleUntil = 0, 0, 0
local prog = nil                       -- per-target progress, see below
local said, saidAt = "", 0
local lastNoTarget = 0
local lastPos, lastTarget = nil, nil

-- Forget everything decided about the last position: after a death, a
-- respawn or any teleport. A "can't get closer" verdict reached beside
-- the Crystal Golem, read again at the spawn point 176 studs away, had
-- the bot standing at spawn casting at a boss it could not possibly
-- hit - forever, since standing still never changes the distance.
function Brain.Reset()
    prog, evade, dodge, lastPos, lastTarget = nil, nil, nil, nil, nil
    settleUntil, lastPick = 0, 0
end

-- State changes go to the log, at most one every 1.5s so a busy fight
-- stays readable. Decisions that matter use print directly.
local function Say(s)
    local now = tick()
    if s ~= said and now - saidAt > 1.5 then
        print("[DQR] " .. s)
        said, saidAt = s, now
    end
end

-- Where to aim and measure range from. A boss is always taken at our
-- own height: they are huge, and where the rig keeps its root says
-- nothing about where the body is - the Tree's is under the floor, and
-- aiming at it sent the bot walking off the edge "toward" it. Anything
-- else keeps its real height unless that is absurd (see AimMaxDrop).
local function AimOf(rec, me)
    local a = rec.Root.Position
    if rec.Boss or math.abs(a.Y - me.Y) > CONFIG.AimMaxDrop then
        a = Vector3.new(a.X, me.Y, a.Z)
    end
    return a
end

-- The way out of a hazard: the first clear spot along each of sixteen
-- headings, best first - short, in the direction we were already going
-- (so a strip across our path is crossed, not backed out of), and
-- still within casting range. The walk there must not enter a second
-- hazard, hit a wall, or go off a ledge.
local function PickExit(pos, aim, keepR, heading)
    local cands = {}
    for i = 0, 15 do
        local a = i * math.pi / 8
        local u = Vector3.new(math.cos(a), 0, math.sin(a))
        for d = 3, CONFIG.EvadeMax, 3 do
            local p = pos + u * d
            if Haz.Clear(p, true) >= CONFIG.EvadeClear then
                local score = d
                if heading then score = score - u:Dot(heading) * 10 end
                if aim and keepR then
                    local f = FlatDist(p, aim)
                    if f > keepR then score = score + (f - keepR) * 2 end
                end
                cands[#cands + 1] = {p = p, s = score}
                break
            end
        end
    end
    table.sort(cands, function(x, y) return x.s < y.s end)
    for i = 1, math.min(#cands, 5) do
        local p = cands[i].p
        if not Haz.OnPath(pos, p) and LineClear(pos, p)
        and HasGround(p) and GroundOnPath(pos, p) then
            return p
        end
    end
    return nil
end

-- Out of a projectile's line: to the side it is NOT drifting toward.
local function Sidestep(pos, origin, vel, rad)
    local toward = Vector3.new(origin.X - pos.X, 0, origin.Z - pos.Z)
    if toward.Magnitude < 0.5 then return nil end
    toward = toward.Unit
    local perp = Vector3.new(-toward.Z, 0, toward.X)
    local lat = vel and perp:Dot(Flat(vel)) or 0
    local sign = lat > 1 and -1 or lat < -1 and 1 or (math.random() < 0.5 and 1 or -1)
    local step = math.max(CONFIG.DodgeStep, (rad or 0) + 6)
    return Nav.SafeStep(pos, perp * sign, step) or Nav.SafeStep(pos, perp * -sign, step)
end

-- The spot on the fighting ring nearest us whose straight walk crosses
-- no hazard; if every angle crosses one, the direct spot and `true`.
local function RingPoint(pos, aim, ring)
    local base = math.atan2(pos.Z - aim.Z, pos.X - aim.X)
    for _, off in ipairs({0, 0.35, -0.35, 0.7, -0.7, 1.05, -1.05}) do
        local a = base + off
        local p = Vector3.new(aim.X + math.cos(a) * ring, aim.Y, aim.Z + math.sin(a) * ring)
        if #Haz.shapes == 0 or not Haz.OnPath(pos, p) then return p, false end
    end
    return Vector3.new(aim.X + math.cos(base) * ring, aim.Y,
                       aim.Z + math.sin(base) * ring), true
end

function Brain.Tick(root)
    local now, pos = tick(), root.Position
    -- Moved further in one tick than anyone can walk: respawned or
    -- teleported. Nothing decided at the old spot applies here.
    if lastPos and (pos - lastPos).Magnitude > 50 then
        print("[DQR] Position jumped - respawn or teleport. Starting fresh.")
        Brain.Reset()
    end
    lastPos = pos
    Nav.ExploreSeen(pos)
    Haz.Scan(pos)

    -- ---- target and attack ----------------------------------
    local tgt = Mobs.Target()
    Brain.target = tgt
    -- aim: where to face and throw. anchor: what distance is measured
    -- from and the fighting ring is drawn around. reach: how far the
    -- surface is from the anchor.
    local aim, anchor, flat, dist, spellR, ring, reach, name
    local blocked, stranded = false, false
    if tgt then
        Nav.ExploreReset()
        name = tgt.Model.Name
        -- Small mobs: from the root plus a radius, as always. Bosses and
        -- big mobs: to the nearest point of the body itself (Mobs.Body),
        -- facing the middle of the model. A rig's root can be anywhere -
        -- the Tree's is under the floor - and a radius clamped at 25
        -- studs says nothing about a canopy twice that wide.
        if tgt.Boss or tgt.Radius >= 10 then
            local q, d, mid = Mobs.Body(tgt, pos)
            reach = 0
            aim = Vector3.new(mid.X, pos.Y, mid.Z)
            local absurd = math.abs(q.Y - pos.Y) > CONFIG.AimMaxDrop
            anchor = Vector3.new(q.X, absurd and pos.Y or q.Y, q.Z)
            flat = FlatDist(q, pos)
            -- Still far above or below even at its nearest: the height
            -- is the rig's quirk, not a real gap. Judge range flat.
            dist = absurd and flat or d
        else
            reach  = tgt.Radius
            aim    = AimOf(tgt, pos)
            anchor = aim
            dist, flat = (aim - pos).Magnitude, FlatDist(aim, pos)
        end
        spellR = CONFIG.AttackRange + reach + (tgt.Boss and CONFIG.BossReach or 0)
        ring   = CONFIG.CircleRadius + reach
        -- Say what a new big target looks like, so a log shows at once
        -- whether the distances make sense.
        if tgt.Model ~= lastTarget then
            lastTarget = tgt.Model
            if reach == 0 then
                local r = tgt.Root.Position
                print(("[DQR] Target %s%s: body %d studs away, casting under %d "
                    .. "(its root is %d across and %d %s).")
                    :format(name, tgt.Boss and " [boss]" or "", dist, spellR,
                            FlatDist(r, pos), math.abs(r.Y - pos.Y),
                            r.Y < pos.Y and "below" or "above"))
            end
        end

        -- Progress while trying to close in. `since` is the last time
        -- the distance actually came down. Out of time and already in
        -- range: stand here ("blocked"). Out of time and out of range:
        -- a boss gets cast at from here ("stranded" - the Ancient
        -- Enchanted Tree is across a moat), anything else is skipped
        -- for a while. The decision latches until the distance changes
        -- by itself, or it would flip back every tick.
        if not prog or prog.model ~= tgt.Model then
            prog = {model = tgt.Model, best = flat, since = now}
        end
        -- A verdict lasts until the distance changes by itself, and never
        -- longer than LatchTime: then it tries to walk in again. No bad
        -- call gets to stand for the rest of the run.
        if prog.latch and (math.abs(flat - prog.latchAt) > 8 or now > prog.latchUntil) then
            prog.latch, prog.best, prog.since = nil, flat, now
        end
        local wantClose = flat > ring + CONFIG.HoldSlack
        if not wantClose then
            prog.best, prog.since = flat, now
        elseif flat < prog.best - 2 then
            prog.best, prog.since = flat, now
        elseif Nav.progressAt > prog.since then
            -- Walking a route is progress even when the straight-line
            -- distance does not move: a detour around a wall, or up a
            -- staircase off to one side, is SUPPOSED to go sideways.
            prog.since = Nav.progressAt
        end
        if not prog.latch and wantClose then
            local held = now - prog.since
            if held > CONFIG.CloseGiveUp and dist <= spellR then
                prog.latch, prog.latchAt = "blocked", flat
                prog.latchUntil = now + CONFIG.LatchTime
                print(("[DQR] Cannot get closer to %s than %d studs - fighting from here.")
                    :format(name, flat))
            elseif held > CONFIG.StrandedTime then
                -- Casting from where we are only makes sense when a
                -- spell could plausibly land. Further off than that, a
                -- boss is skipped like anything else: the bot goes and
                -- does something else, and comes back to it later.
                if tgt.Boss and flat <= CONFIG.StrandedMaxRange then
                    prog.latch, prog.latchAt = "stranded", flat
                    prog.latchUntil = now + CONFIG.LatchTime
                    print(("[DQR] Cannot reach %s (%d studs) - casting at it from here.")
                        :format(name, flat))
                else
                    Mobs.Ban(tgt.Model)
                    print(("[DQR] %s unreachable at %d studs - skipping it for %ds.")
                        :format(name, flat, CONFIG.UnreachableFor))
                    prog = nil
                end
            end
        end
        blocked  = prog ~= nil and prog.latch == "blocked"
        stranded = prog ~= nil and prog.latch == "stranded"

        if dist <= CONFIG.MeleeRange + reach then DoMelee(aim) end
        DoSpell(dist, stranded and math.max(spellR, dist + 5) or spellR, aim)
        Nav.face = aim
    else
        Nav.face = nil
        prog = nil
    end

    -- ---- where to stand ---------------------------------------
    local goal, state = nil, nil
    local inHaz = #Haz.shapes > 0 and Haz.At(pos)

    -- In a "hazard" far longer than any real attack lasts: the scanner
    -- is misreading something. Stop listening to it for a while.
    if inHaz then
        if Haz.inSince == 0 then Haz.inSince = now end
        if now - Haz.inSince > CONFIG.HazardStuckTime then
            Haz.inSince, Haz.muteUntil = 0, now + CONFIG.HazardMute
            table.clear(Haz.shapes)
            evade, inHaz = nil, false
            print(("[DQR] In a 'hazard' for %ds straight - treating it as a misreading "
                .. "and ignoring hazards for %ds. HazardDebug will name it.")
                :format(CONFIG.HazardStuckTime, CONFIG.HazardMute))
        end
    else
        Haz.inSince = 0
    end

    -- 1. A projectile about to land.
    if dodge and (now > dodge.untilT or FlatDist(dodge.goal, pos) < 1.5) then dodge = nil end
    if dodge then
        goal, state = dodge.goal, "Dodging a projectile"
    elseif now - lastDodge > CONFIG.DodgeCooldown then
        local hit, origin, tti, vel, rad = Haz.Threat()
        if hit and tti < 1.2 then
            lastDodge = now
            local p = Sidestep(pos, origin, vel, rad)
            if p then
                dodge = {goal = p, untilT = now + 0.7}
                goal, state = p, "Dodging a projectile"
            end
        end
    end

    -- 2. Standing in a hazard with a clean way out.
    if not goal and evade then
        local reached = FlatDist(evade.goal, pos) <= 2
        if reached then settleUntil = now + 1.5 end
        if reached or now > evade.untilT or Haz.Clear(evade.goal, true) < 0 then
            evade = nil
        else
            goal, state = evade.goal, "Stepping out of a hazard"
        end
    end
    if not goal and inHaz and now - lastPick > 0.25 then
        lastPick = now
        local heading = nil
        if Nav.goal then
            local d = Flat(Nav.goal - pos)
            if d.Magnitude > 1 then heading = d.Unit end
        end
        local p = PickExit(pos, anchor, spellR, heading)
        if p then
            evade = {goal = p, untilT = now + 2.5}
            goal, state = p, "Stepping out of a hazard"
        end
    end

    -- 3. Positioning against the target.
    if not goal and tgt then
        local minR = CONFIG.MinRange + reach
        if blocked or stranded then
            state = stranded and ("Casting at " .. name .. " from range")
                              or ("Fighting " .. name .. " from here")
        elseif flat < minR then
            local away = Flat(pos - anchor)
            if away.Magnitude < 0.5 then away = Flat(-root.CFrame.LookVector) end
            goal = Nav.SafeStep(pos, away, ring - flat + 2)
            state = goal and ("Backing off " .. name) or ("Fighting " .. name)
        elseif flat > ring + CONFIG.HoldSlack then
            local pt, crosses = RingPoint(pos, anchor, ring)
            -- Already in range, and walking in would cross a hazard or
            -- undo a dodge we just made: cast from here instead.
            if dist <= spellR and (crosses or now < settleUntil) then
                state = "Fighting " .. name
            else
                goal = pt
                state = ("Approaching %s (%d studs)"):format(name, math.floor(dist / 5) * 5)
            end
        else
            state = "Fighting " .. name
        end
    end

    -- 4. Nothing to fight: walk on.
    if not tgt then
        if now - lastNoTarget > 5 then
            lastNoTarget = now
            print(("[DQR] No target. %d mob(s) in the scan."):format(#Mobs.list))
        end
        if not goal then
            goal = Nav.Explore(pos)
            state = goal and "Exploring for the next wave" or "Waiting for mobs"
        end
    end

    state = state or "Idle"
    if inHaz and not evade and not dodge then
        state = state .. " (in a hazard, no clean exit)"
    end
    Nav.goal = goal
    Brain.state = state
    Say(state)
end

-- ============================================================
--  FARM LOOP
-- ============================================================
function Brain.Loop()
    Brain.Reset()
    Nav.Start()
    local lastLobby, lastStart, startVisible = 0, 0, false
    while Farm.Running do
        local now = tick()
        Farm.beat = now
        local root, human = GetRoot(), GetHuman()
        if not root or not human or human.Health <= 0 then
            Nav.goal, Nav.face = nil, nil
            Brain.state = "Dead - waiting to respawn"
            S(0.5)
            continue
        end
        -- Never fight in the lobby: its NPCs pass every mob test.
        if now - lastLobby > 0.5 then
            lastLobby = now
            if InLobby() then
                print("[DQR] In the lobby (" .. tostring(LobbyMarker()) .. ") - stopping.")
                Farm.Running = false
                break
            end
        end
        -- The run has not begun while START is on screen; players are
        -- frozen, so walking only trips the stuck detector.
        if now - lastStart > 1 then
            lastStart = now
            startVisible = DungeonStartButton() ~= nil
        end
        if startVisible then
            Nav.goal, Nav.face = nil, nil
            Brain.state = "Waiting for the run to start"
            S(0.5)
            continue
        end
        Brain.Tick(root)
        S(0.05)
    end
    Nav.Stop()
end
end

-- ============================================================
--  DISCORD LOOT WEBHOOK  +  LIVE STATUS EMBED
--  (ported unchanged from v10)
-- ============================================================
local ReportLoot, LootDump, LootWatcher
do

-- The executor's HTTP function, under whichever name it uses. The
-- game's own HttpService cannot be used from a client.
local function HttpRequest(opts)
    for _, name in ipairs({"request", "http_request"}) do
        local fn = Env(name)
        if typeof(fn) == "function" then
            local ok, res = pcall(fn, opts)
            if ok then return res end
            return nil, tostring(res)
        end
    end
    for _, ns in ipairs({"syn", "http", "fluxus"}) do
        local t = Env(ns)
        if typeof(t) == "table" and typeof(t.request) == "function" then
            local ok, res = pcall(t.request, opts)
            if ok then return res end
            return nil, tostring(res)
        end
    end
    return nil, "this executor has no request function"
end

-- Every GUI object actually on screen, at any depth, as a set. Walks
-- down from each enabled ScreenGui and stops at the first invisible
-- frame, since nothing under one can show - far cheaper than testing
-- every descendant's ancestry. Our own log window is left out.
local function VisibleSet()
    local out = {}
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return out end
    local function Walk(o)
        for _, c in ipairs(o:GetChildren()) do
            if c:IsA("GuiObject") then
                if c.Visible and c.AbsoluteSize.X >= 1 then
                    out[c] = true
                    Walk(c)
                end
            else
                Walk(c)
            end
        end
    end
    for _, sg in ipairs(pg:GetChildren()) do
        if sg:IsA("ScreenGui") and sg.Enabled and sg ~= LogGui then Walk(sg) end
    end
    return out
end

-- The Dungeon Quest reward panel, as dumped on 2026-09-21:
--   rewardGuiHolder.holder
--     reward            slot background (x one per item)
--       glow            ImageLabel tinted with the item's rarity colour
--       itemPicture     ImageLabel: the item's icon
--   rewardGuiHolder.Frame.Gold   the gold earned
-- No name labels anywhere, so names cannot be reported; the glow's
-- tint is read as the rarity instead. Returns one record per item.
-- Dungeon Quest's tiers, by colour: Common grey, Uncommon green, Rare
-- blue, Epic purple, Legendary yellow, Ultimate red.
local function ItemSlots(panel)
    local function Rarity(c)
        if not c then return nil end
        local h, s = c:ToHSV()
        if s < 0.25 then return "Common" end          -- grey
        if h < 0.04 or h > 0.93 then return "Ultimate" end  -- red
        if h < 0.2 then return "Legendary" end        -- yellow / orange
        if h < 0.47 then return "Uncommon" end        -- green
        if h < 0.72 then return "Rare" end            -- blue
        return "Epic"                                 -- purple
    end
    local items = {}
    for _, o in ipairs(panel:GetDescendants()) do
        if o.Name == "itemPicture"
        and (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.Image ~= "" then
            local img = tostring(o.Image)
            local id = img:match("id=(%d+)") or img:match("(%d+)%s*$")
            if id then
                local glow = o.Parent and o.Parent:FindFirstChild("glow")
                local col = glow and glow:IsA("ImageLabel") and glow.ImageColor3 or nil
                items[#items + 1] = {id = id, color = col, rarity = Rarity(col)}
            end
        end
    end
    return items
end

-- The candidates for the reward panel, best first: whatever is on
-- screen now that was NOT on screen during the fight (`during`, the
-- set the watcher collected), grouped under the nearest ancestor that
-- WAS - because the panel is either a frame that just appeared, or an
-- old frame that just had its item slots cloned into it - scored by
-- how many item slots each group holds. Looking only at a ScreenGui's
-- direct children missed a panel nested inside an always-on container.
local function LootCandidates(during)
    -- The lobby's own GUIs are hidden during a run and back
    -- afterwards, so they read as "new" too - and the main menu is
    -- full of icons.
    local lobbyGuis = {introGui = true, mainInterface = true, queueGui = true,
                       friendsList = true, leaderboard = true}
    local vis = VisibleSet()
    -- Item slots under a frame: 3D previews and pictures, on screen.
    local function SlotCount(frame)
        local n = 0
        for _, o in ipairs(frame:GetDescendants()) do
            if vis[o] and (o:IsA("ViewportFrame")
               or ((o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.Image ~= "")) then
                n = n + 1
            end
        end
        return n
    end
    local roots, byParent = {}, {}
    for o in pairs(vis) do
        if not (during and during[o]) then
            local p = o.Parent
            local parentNew = p and p:IsA("GuiObject") and vis[p]
                              and not (during and during[p])
            if not parentNew then
                local sg = o
                while sg and not sg:IsA("ScreenGui") do sg = sg.Parent end
                if sg and not lobbyGuis[sg.Name] then
                    roots[#roots + 1] = o
                    if p and p:IsA("GuiObject") then
                        byParent[p] = (byParent[p] or 0) + 1
                    end
                end
            end
        end
    end
    -- Several new siblings under one old frame: that frame is the
    -- panel. A lone new frame is the panel itself.
    local cands, seen = {}, {}
    for _, o in ipairs(roots) do
        local p = o.Parent
        local frame = (p and byParent[p] and byParent[p] >= 2) and p or o
        if not seen[frame] then
            seen[frame] = true
            cands[#cands + 1] = {frame = frame, slots = SlotCount(frame)}
        end
    end
    table.sort(cands, function(a, b) return a.slots > b.slots end)
    return cands
end

local function FindLootPanel(during)
    if CONFIG.LootPanelPath and #CONFIG.LootPanelPath > 0 then
        return PathVisible(CONFIG.LootPanelPath)
    end
    local c = LootCandidates(during)[1]
    if c and c.slots >= 2 then return c.frame end   -- one slot is a button icon
    return nil
end

-- Everything on the panel worth reporting: distinct icon asset ids,
-- distinct bits of text, and how many 3D previews there were. Our own
-- name is left out of the text.
local function CollectLoot(panel)
    local icons, names, seen, viewports = {}, {}, {}, 0
    local me1, me2 = LP.Name:lower(), LP.DisplayName:lower()
    for _, o in ipairs(panel:GetDescendants()) do
        if (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.Image ~= "" then
            local img = tostring(o.Image)
            local id = img:match("id=(%d+)") or img:match("(%d+)%s*$")
            if id and not seen["i" .. id] then
                seen["i" .. id] = true
                icons[#icons + 1] = id
            end
        elseif o:IsA("ViewportFrame") then
            viewports = viewports + 1
        elseif o:IsA("TextLabel") or o:IsA("TextButton") then
            local t = o.Text:gsub("^%s+", ""):gsub("%s+$", "")
            local lt = t:lower()
            if #t > 1 and t:find("%a")
            and not lt:find(me1, 1, true) and not lt:find(me2, 1, true)
            and not seen["t" .. t] then
                seen["t" .. t] = true
                names[#names + 1] = t
            end
        end
    end
    return icons, names, viewports
end

-- Post the panel's contents. With no panel, posts a test message so
-- the URL can be checked without finishing a run.
function ReportLoot(panel)
    local url = CONFIG.DiscordWebhook
    if type(url) ~= "string" or not url:find("^https://") then
        print("[DQR] Loot: no webhook URL set.")
        return false
    end
    local HttpS = game:GetService("HttpService")
    local icons, names, viewports = {}, {}, 0
    local items, color = {}, nil
    local dropped, hidden = 0, 0
    if panel then
        items = ItemSlots(panel)
        dropped = #items

        -- Rarity filter. An item whose rarity could not be read is
        -- kept: a colour the script does not recognise should never
        -- silently swallow a drop.
        if dropped > 0 and type(CONFIG.LootRarities) == "table" then
            local keep = {}
            for _, it in ipairs(items) do
                local want = CONFIG.LootRarities[it.rarity or ""]
                if want == nil then want = true end
                if want then
                    keep[#keep + 1] = it
                else
                    hidden = hidden + 1
                end
            end
            items = keep
        end

        if dropped > 0 then
            -- One embed per item, so each picture carries its own
            -- rarity: a merged gallery puts every icon in one block
            -- with a single caption above it, and there is then no way
            -- to tell which of three items was the Epic one.
            for _, it in ipairs(items) do
                icons[#icons + 1] = it.id
                local c = it.color
                if c and not color then
                    color = math.floor(c.R * 255) * 65536
                          + math.floor(c.G * 255) * 256 + math.floor(c.B * 255)
                end
            end
            -- The gold (and anything else with a number) shown beside
            -- the items, in rewardGuiHolder.Frame.
            local side = panel.Parent and panel.Parent:FindFirstChild("Frame")
            if side then
                local seen = {}
                for _, o in ipairs(side:GetDescendants()) do
                    if o:IsA("TextLabel") and o.Text:find("%d") and not seen[o.Text] then
                        seen[o.Text] = true
                        local label = o.Parent and o.Parent.Name or "Reward"
                        names[#names + 1] = ("%s: %s"):format(label, o.Text)
                        if #names > 12 then break end
                    end
                end
            end
        else
            icons, names, viewports = CollectLoot(panel)
        end
    end

    -- Everything that dropped was a rarity you have switched off.
    -- Bail before the thumbnail lookup and the post: that is the whole
    -- point of the filter, and it keeps the channel for real drops.
    if panel and dropped > 0 and #items == 0 and not CONFIG.LootPostIfEmpty then
        print(("[DQR] Loot: %d item(s) dropped, all filtered out by "
            .. "LootRarities - not posting."):format(hidden))
        return true
    end

    -- Asset id -> a CDN picture URL Discord can fetch. The thumbnail
    -- API answers for decals and images alike; the older
    -- asset-thumbnail endpoint is the fallback if it does not.
    local thumbs = {}
    if #icons > 0 then
        local res = HttpRequest({
            Url = "https://thumbnails.roblox.com/v1/assets?assetIds="
                .. table.concat(icons, ",") .. "&size=420x420&format=Png",
            Method = "GET",
        })
        if res and res.Body then
            local ok, data = pcall(function() return HttpS:JSONDecode(res.Body) end)
            if ok and type(data) == "table" and type(data.data) == "table" then
                for _, e in ipairs(data.data) do
                    if e.imageUrl and e.imageUrl ~= "" then
                        thumbs[tostring(e.targetId)] = e.imageUrl
                    end
                end
            end
        end
        for _, id in ipairs(icons) do
            if not thumbs[id] then
                thumbs[id] = "https://www.roblox.com/asset-thumbnail/image?assetId="
                    .. id .. "&width=420&height=420&format=png"
            end
        end
    end

    local desc = {}
    if panel then
        if #items > 0 then
            desc[#desc + 1] = ("**%d item%s**%s"):format(
                #items, #items == 1 and "" or "s",
                hidden > 0 and (" *(%d hidden by the rarity filter)*"):format(hidden) or "")
        elseif hidden > 0 then
            desc[#desc + 1] = ("*%d item%s dropped, all below your rarity filter.*")
                :format(hidden, hidden == 1 and "" or "s")
        end
        if #names > 0 then
            desc[#desc + 1] = table.concat(names, "\n")
        elseif dropped == 0 then
            desc[#desc + 1] = "(nothing readable on the panel - press F10 on the reward screen)"
        end
        if viewports > 0 and #icons == 0 then
            desc[#desc + 1] = ("(%d item icon(s) are 3D previews - no picture possible)")
                :format(viewports)
        end
    else
        desc[#desc + 1] = "Webhook test from DQR - the URL works."
    end

    local title = panel
        and ("Dungeon complete - %s (%s)"):format(CONFIG.TargetDungeon, CONFIG.Difficulty)
        or "DQR webhook test"
    -- A header embed, then one per item. Deliberately NOT sharing a
    -- `url`: embeds that do are merged into a single gallery, and a
    -- gallery has one caption for all of its pictures.
    local embeds = {{
        title = title,
        description = table.concat(desc, "\n"),
        color = color or 5763719,
    }}
    for i, it in ipairs(items) do
        if i > 9 then break end          -- Discord allows ten embeds
        local c = it.color
        local hex = c and ("#%02X%02X%02X"):format(c.R * 255, c.G * 255, c.B * 255)
                      or "?"
        embeds[#embeds + 1] = {
            title = ("%d.  %s"):format(i, it.rarity or "Unknown rarity"),
            description = hex,
            color = c and (math.floor(c.R * 255) * 65536
                         + math.floor(c.G * 255) * 256
                         + math.floor(c.B * 255)) or 5763719,
            image = thumbs[it.id] and {url = thumbs[it.id]} or nil,
        }
    end
    -- The fallback scan has no per-item rarity, only a pile of icons.
    if #items == 0 then
        for i = 1, math.min(#icons, 4) do
            embeds[#embeds + 1] = {image = {url = thumbs[icons[i]]}}
        end
    end
    embeds[#embeds].footer = {text = os.date("%Y-%m-%d %H:%M:%S") .. "  -  DQR"}

    local body = HttpS:JSONEncode({username = "DQR", embeds = embeds})
    local res, err = HttpRequest({
        Url = url, Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = body,
    })
    if not res then
        print("[DQR] Loot post failed: " .. tostring(err))
        return false
    end
    local code = res.StatusCode or res.Status or "?"
    print(("[DQR] Loot posted (%s): %d item(s) shown, %d hidden, %d icon(s), %d preview(s).")
        :format(tostring(code), #items, hidden, #icons, viewports))
    return true
end

-- Frames seen on screen while the farm was running: whatever is up
-- at the end and NOT in here is new, and the reward panel is new.
local during = {}

-- F10: every frame on screen with its slot count and whether it was
-- up during the fight, then the contents of the one the scan would
-- choose. Run it on the reward screen; if it picks the wrong frame,
-- the right one's path goes in LootPanelPath.
function LootDump()
    print("[DQR] === NEW SINCE THE FIGHT (best first) ===")
    local cands = LootCandidates(during)
    for i, c in ipairs(cands) do
        if i > 15 then break end
        print(("%s | slots=%d"):format(c.frame:GetFullName(), c.slots))
    end
    if #cands == 0 then
        print("[DQR] Nothing on screen is new since the fight.")
    end
    local panel = FindLootPanel(during)
    if not panel then
        print("[DQR] No candidate has 2+ item slots, so none qualifies as the reward panel.")
        return
    end
    print("[DQR] === LOOT PANEL: " .. panel:GetFullName() .. " ===")
    for i, it in ipairs(ItemSlots(panel)) do
        local c = it.color
        print(("[Item %d] icon=%s rarity=%s glow=%s"):format(i, it.id,
            tostring(it.rarity),
            c and ("#%02X%02X%02X"):format(c.R * 255, c.G * 255, c.B * 255) or "none"))
    end
    for _, o in ipairs(panel:GetDescendants()) do
        local extra = ""
        if o:IsA("TextLabel") or o:IsA("TextButton") then
            extra = " text='" .. o.Text .. "'"
        elseif o:IsA("ImageLabel") or o:IsA("ImageButton") then
            extra = " image=" .. o.Image
        elseif o:IsA("ViewportFrame") then
            extra = " (3D preview)"
        end
        if extra ~= "" then
            print(("%s | %s | visible=%s%s"):format(
                o:GetFullName():sub(#panel:GetFullName() + 2), o.ClassName,
                tostring(o:IsA("GuiObject") and VisibleOnScreen(o)), extra))
        end
    end
    print("[DQR] === END LOOT PANEL ===")
end

-- While there is something to fight, remembers what is on screen.
-- The moment there is not - the last mob is down - looks for a frame
-- that is new since, with item slots on it, and posts it. Recording
-- used to run for as long as the FARM was running, but the reward
-- panel comes up before the farm notices the lobby is back, so it
-- was recorded as "seen during the fight" and then ruled out.
function LootWatcher()
    local ran, stoppedAt, warned = false, 0, false
    while true do
        S(0.5)
        local fighting = Farm.Running and Brain.target ~= nil
        if fighting then
            if not ran then
                during, warned = {}, false
                if CONFIG.DiscordWebhook == "" then
                    print("[DQR] Loot: DiscordWebhook is empty - nothing will be posted.")
                end
            end
            ran, stoppedAt = true, 0
            for o in pairs(VisibleSet()) do during[o] = true end
        elseif ran then
            if stoppedAt == 0 then
                stoppedAt = tick()
                print("[DQR] Loot: fighting stopped - watching for the reward panel.")
            end
            if tick() - stoppedAt > 45 then
                -- Give up rather than mistake some later menu for it,
                -- and say what was there so the path can be set.
                ran = false
                print("[DQR] Loot: no reward panel found in 45s. New since the fight now:")
                for i, c in ipairs(LootCandidates(during)) do
                    if i > 15 then break end
                    print(("  %s | slots=%d"):format(c.frame:GetFullName(), c.slots))
                end
            elseif CONFIG.DiscordWebhook ~= "" then
                local ok, panel = pcall(FindLootPanel, during)
                -- `holder` is on screen the whole run; the item slots
                -- are only cloned into it at the end. Until they are,
                -- it is not the reward panel yet - two empty posts
                -- went out between rooms before this check.
                if ok and panel and #ItemSlots(panel) == 0
                and #CONFIG.LootPanelPath > 0 then
                    panel = nil
                end
                if ok and panel then
                    ran = false
                    print("[DQR] Loot: reward panel = " .. panel:GetFullName())
                    local okR, err = pcall(ReportLoot, panel)
                    if not okR then print("[DQR] Loot: post crashed: " .. tostring(err)) end
                elseif not ok and not warned then
                    warned = true
                    print("[DQR] Loot: panel search failed: " .. tostring(panel))
                end
            end
        end
    end
end

-- The three helpers live on one table rather than as three locals,
-- and the two entry points hang off Farm rather than being
-- forward-declared: the main chunk is a handful of locals short of
-- Luau's limit of 200, and this section would have crossed it.
-- (Hud is the module table declared at the top.)

-- 1300000 -> "1.30M", the way the HUD writes it.
function Hud.Short(n)
    n = tonumber(n) or 0
    for _, p in ipairs({{1e12, "T"}, {1e9, "B"}, {1e6, "M"}, {1e3, "K"}}) do
        if n >= p[1] then return ("%.2f%s"):format(n / p[1], p[2]) end
    end
    return ("%d"):format(n)
end

-- A TextLabel under the HUD panel, found by its own name or its
-- parent's - the level one lives at playerStatus.Frame.levelBorder.level,
-- so both halves matter. Returns the text, or nil.
function Hud.Text(frag)
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    local root = pg and pg:FindFirstChild("playerStatus")
    if not root then return nil end
    local hit = nil
    pcall(function()
        for _, o in ipairs(root:GetDescendants()) do
            if o:IsA("TextLabel") and o.Text ~= "" then
                local n  = o.Name:lower()
                local pn = (o.Parent and o.Parent.Name or ""):lower()
                if n:find(frag, 1, true) or pn:find(frag, 1, true) then
                    hit = o.Text
                    return
                end
            end
        end
    end)
    return hit
end

-- leaderstats first (the real value), the HUD label second. The
-- vanity spoofer rewrites HUD text, so a spoofed name or level would
-- otherwise end up in the status post.
function Hud.Real(frag)
    local ls = LP:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            if v.Name:lower():find(frag, 1, true) and v:IsA("ValueBase") then
                return tostring(v.Value)
            end
        end
    end
    return Hud.Text(frag)
end

-- Console helper: every label on the HUD panel, so a number that
-- comes out wrong can be traced to the label it should have used.
function Farm.StatusDump()
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    local root = pg and pg:FindFirstChild("playerStatus")
    if not root then
        print("[DQR] No playerStatus GUI found.")
        return
    end
    print("[DQR] === HUD PANEL ===")
    for _, o in ipairs(root:GetDescendants()) do
        if o:IsA("TextLabel") then
            print(("%s = '%s'"):format(
                o:GetFullName():gsub("^.*playerStatus%.", ""), o.Text))
        end
    end
    print("[DQR] === END HUD PANEL ===")
end

-- The status message id, kept somewhere it survives the script being
-- executed again - a new run, a rejoin, a manual re-execute. Without
-- this every fresh start posts a brand new embed and leaves the last
-- one frozen in the channel. File first (survives anything), then the
-- executor's shared global table (survives a re-execute in the same
-- session). The webhook is stored beside the id, so pointing the
-- script at a different channel does not try to edit a message that
-- lives in the old one.
local STATUS_KEY = "DQR_status.txt"

function Hud.LoadId(url)
    local raw
    local rf = Env("readfile")
    if typeof(rf) == "function" then
        local ok, v = pcall(rf, STATUS_KEY)
        if ok and type(v) == "string" then raw = v end
    end
    if not raw then
        local g = Env("getgenv")
        if typeof(g) == "function" then
            local ok, t = pcall(g)
            if ok and type(t) == "table" and type(t.DQR_Status) == "string" then
                raw = t.DQR_Status
            end
        end
    end
    if type(raw) ~= "string" then return nil end
    local u, id = raw:match("^(.-)\n(.+)$")
    if u == url and id then
        id = id:gsub("%s", "")
        if id ~= "" then return id end
    end
    return nil
end

function Hud.SaveId(url, id)
    local data = tostring(url) .. "\n" .. tostring(id or "")
    local wf = Env("writefile")
    if typeof(wf) == "function" then pcall(wf, STATUS_KEY, data) end
    local g = Env("getgenv")
    if typeof(g) == "function" then
        local ok, t = pcall(g)
        if ok and type(t) == "table" then t.DQR_Status = data end
    end
end

-- Remove a status message we are about to replace, so old embeds do
-- not pile up in the channel.
function Hud.DeleteMsg(url, id)
    if not id or not url then return end
    pcall(function()
        HttpRequest({Url = url .. "/messages/" .. id, Method = "DELETE"})
    end)
end

function Farm.StatusWatcher()
    local msgId, base, startedAt = nil, nil, tick()
    local said, lastErr, loaded = false, 0, false
    while true do
        S(math.max(2, CONFIG.StatusInterval or 5))
        local url = CONFIG.StatusWebhook
        if type(url) ~= "string" or url == "" then
            if not said then
                said = true
                print("[DQR] Status: StatusWebhook is empty - no status posts.")
            end
        elseif not url:find("^https://") then
            if not said then
                said = true
                print("[DQR] Status: StatusWebhook does not look like a URL.")
            end
        else
            -- First tick: pick up the message this script was editing
            -- before it was restarted, so a new run keeps updating the
            -- same embed instead of posting another one.
            if not loaded then
                loaded = true
                msgId  = Hud.LoadId(url)
                if msgId then
                    print("[DQR] Status: continuing the message from the "
                        .. "previous run.")
                end
            end
            -- A different webhook means a different channel. Clear the
            -- old message out rather than orphan it there.
            if base ~= nil and base ~= url then
                Hud.DeleteMsg(base, msgId)
                msgId = nil
            end
            base = url
            -- Errors here used to vanish into the pcall, so a single
            -- nil index meant silence forever with nothing to go on.
            local ok, err = pcall(function()
                local HttpS = game:GetService("HttpService")
                local human = GetHuman()
                local dead  = not human or human.Health <= 0
                local tgt   = (not dead) and Brain.target or nil

                -- What it is doing: the brain's own description.
                local doing
                if dead then                   doing = "Dead - waiting to respawn"
                elseif InLobby() then          doing = "In the lobby"
                elseif lobbyFlowActive then    doing = "Queueing a dungeon"
                elseif not Farm.Running then   doing = "Idle"
                else                           doing = tostring(Brain.state)
                end

                local fields = {}
                local function F(n, v)
                    if v and v ~= "" then
                        fields[#fields + 1] = {name = n, value = tostring(v),
                                               inline = true}
                    end
                end
                -- HP from the Humanoid, not the HUD: always accurate,
                -- and never touched by the vanity spoofer.
                if human then
                    F("HP", ("%s / %s"):format(
                        Hud.Short(human.Health), Hud.Short(human.MaxHealth)))
                end
                F("EXP",   Hud.Text("exp"))
                F("Gold",  Hud.Real("gold"))
                F("Gems",  Hud.Real("gem") or Hud.Real("diamond"))
                F("Mobs near", #Mobs.list)
                if tgt then
                    local h = tgt.Humanoid
                    F("Target", ("%s\n%d%% at %d studs"):format(tgt.Model.Name,
                        h.MaxHealth > 0 and h.Health / h.MaxHealth * 100 or 0,
                        tgt.Dist))
                end
                local up = tick() - startedAt
                F("Uptime", ("%dh %02dm"):format(up / 3600, (up % 3600) / 60))

                local lvl = Hud.Real("level") or Hud.Real("lvl")
                local col = 5763719
                if dead then col = 15548997
                elseif human and human.MaxHealth > 0
                and human.Health / human.MaxHealth < 0.4 then col = 16426522 end

                local body = HttpS:JSONEncode({
                    username = "DQR",
                    embeds = {{
                        title = ("%s%s"):format(LP.DisplayName,
                            lvl and ("   -   Level " .. lvl) or ""),
                        description = ("**%s**\n%s (%s)"):format(doing,
                            CONFIG.TargetDungeon, CONFIG.Difficulty),
                        color = col,
                        fields = fields,
                        footer = {text = "updated " .. os.date("%H:%M:%S")},
                    }},
                })

                -- Edit the one message when we have its id, else post a
                -- fresh one. ?wait=true makes Discord hand back the
                -- message it created, which is the only way to learn
                -- the id needed to edit it later.
                local res
                if msgId then
                    res = HttpRequest({
                        Url = base .. "/messages/" .. msgId, Method = "PATCH",
                        Headers = {["Content-Type"] = "application/json"},
                        Body = body,
                    })
                    local code = res and (res.StatusCode or res.Status)
                    -- 404 is the ONLY code meaning the message is gone.
                    -- 400 means Discord rejected this particular
                    -- payload, and treating that as "gone" abandoned a
                    -- perfectly good message and started a second one -
                    -- which is why a run ending left one frozen embed
                    -- and a new one beside it. Keep the id and say what
                    -- Discord objected to instead.
                    if code == 404 then
                        msgId = nil
                        Hud.SaveId(base, nil)
                        print("[DQR] Status message is gone - posting a new one.")
                    elseif code == 400 then
                        if tick() - lastErr > 15 then
                            lastErr = tick()
                            print("[DQR] Status: Discord rejected the update: "
                                .. tostring(res and res.Body))
                        end
                    elseif code == 429 then
                        -- Rate limited. Skip a beat rather than hammer.
                        S(2)
                    end
                else
                    res = HttpRequest({
                        Url = base .. "?wait=true", Method = "POST",
                        Headers = {["Content-Type"] = "application/json"},
                        Body = body,
                    })
                    if res and res.Body then
                        local okj, data = pcall(function()
                            return HttpS:JSONDecode(res.Body) end)
                        if okj and type(data) == "table" and data.id then
                            msgId = tostring(data.id)
                            -- Remembered, so the next run edits this
                            -- one instead of posting another.
                            Hud.SaveId(base, msgId)
                            print(("[DQR] Status embed posted - updating "
                                .. "every %ss from now on."):format(
                                tostring(CONFIG.StatusInterval)))
                        else
                            print("[DQR] Status: posted but could not read the "
                                .. "message id - it will repost each tick.")
                        end
                    else
                        print("[DQR] Status: no reply from the webhook - does "
                            .. "this executor have a request function?")
                    end
                end
            end)
            if not ok and tick() - lastErr > 15 then
                lastErr = tick()
                print("[DQR] Status update failed: " .. tostring(err))
            end
        end
    end
end

