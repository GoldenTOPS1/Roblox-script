--  BOOT
-- ============================================================
task.spawn(function()
    print("[DQR] v10.41 loaded.  F5 farm  F6 gui dump  F7 log  F8 mob diag  F9 hazard diag  F10 loot panel")
    -- The status feed starts HERE, not at the end of boot. It is how
    -- you check on the bot, so it has to be running before the bot is:
    -- the end of boot is not reached until a dungeon is up, and if the
    -- queue stalls it is never reached at all - which is why nothing
    -- was ever posting.
    task.spawn(Farm.StatusWatcher)
    ApplyClass()
    NukeGraphics()
    S(2.5)

    -- Sample for a few seconds before deciding. PlayerGui is still
    -- populating right after injection, so a single read taken now can
    -- report "no lobby" purely because the buttons have not appeared
    -- yet - and then the bot starts farming the lobby's NPCs.
    local marker = nil
    for _ = 1, 8 do
        marker = LobbyMarker()
        if marker then break end
        S(0.5)
    end
    print("[DQR] Lobby marker: " .. tostring(marker or "none"))

    if not marker then
        -- Still nothing after several seconds: genuinely in a run.
        print("[DQR] No lobby UI after 4s - assuming already in a dungeon.")
        Farm.Start()
    elseif CONFIG.AutoRunDungeon then
        RunLobbyFlow()
        local w = 0
        repeat S(2) w = w + 2 until IsInDungeon() or w > 120
        if IsInDungeon() then
            Farm.Start()
        else
            print("[DQR] Timed out. Press F5 when inside dungeon.")
        end
    else
        print("[DQR] Waiting for dungeon...")
        repeat S(3) until IsInDungeon()
        Farm.Start()
    end

    task.spawn(DungeonWatcher)
    task.spawn(Supervisor)
    task.spawn(StartWatcher)
    task.spawn(VanityWatcher)
    task.spawn(LootWatcher)
end)

-- ============================================================
--  F5 TOGGLE
-- ============================================================
UserInputService.InputBegan:Connect(function(inp, gpe)
    if gpe then return end
    if inp.KeyCode == Enum.KeyCode.F5 then
        if Farm.Running then Farm.Stop() else Farm.Start() end
    elseif inp.KeyCode == Enum.KeyCode.F6 then
        DumpGui()
        print("[DQR] InLobby() = " .. tostring(InLobby())
            .. "  MobsPresent() = " .. tostring(MobsPresent()))
    elseif inp.KeyCode == Enum.KeyCode.F7 then
        if LogGui then LogGui.Enabled = not LogGui.Enabled end
    elseif inp.KeyCode == Enum.KeyCode.F8 then
        MobDiag()
    elseif inp.KeyCode == Enum.KeyCode.F9 then
        HazardDiag()
    elseif inp.KeyCode == Enum.KeyCode.F10 then
        LootDump()
    end
end)

