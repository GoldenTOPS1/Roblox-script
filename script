    -- VirtualUser fires the key into the game input stream
    -- Delta's executor keeps this functional
    VU:Button1Down(Vector2.new(0,0), CFrame.new())   -- focus guard
    pcall(function()
        game:GetService("VirtualInputManager"):SendKeyEvent(
            true, keycode, false, game)
