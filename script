-- ============================================================
--  GRAPHICS NUKE
-- ============================================================
local function NukeGraphics()
    if not CONFIG.LowerGraphics then return end
    local L = game:GetService("Lighting")
    pcall(function() settings().Rendering.QualityLevel = 1 end)
    pcall(function()
        game:GetService("UserGameSettings").SavedQualityLevel =
            Enum.SavedQualitySetting.QualityLevel01
    end)
    L.GlobalShadows            = false
    L.FogEnd                   = 9e8
    L.Brightness               = 0
    L.EnvironmentDiffuseScale  = 0
    L.EnvironmentSpecularScale = 0
    for _, fx in ipairs(L:GetChildren()) do
        if fx:IsA("PostEffect") then fx.Enabled = false end
    end
    for _, o in ipairs(workspace:GetDescendants()) do pcall(function()
        if o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Smoke")
        or o:IsA("Fire") or o:IsA("Sparkles") then o.Enabled = false end
    end) end
    print("[DQR] Graphics nuked.")
end

-- ============================================================
--  HELPERS
-- ============================================================
local function S(t) task.wait(t) end
local function GetChar()  return LP.Character end
local function GetRoot()
    local c = GetChar() return c and c:FindFirstChild("HumanoidRootPart")
end
local function GetHuman()
    local c = GetChar() return c and c:FindFirstChildOfClass("Humanoid")
end

-- ============================================================
--  MOVEMENT — pure CFrame stepping, no MoveTo, no velocity
--  Delta blocks MoveTo in dungeons — CFrame teleport is
--  the only reliable way to move in executor context
-- ============================================================
--  ONE connection owns the root CFrame. Two connections both writing
--  root.CFrame fight each other every frame — that was why the character
--  ended up staring off into space instead of at the mob.
local moveConn   = nil
local faceTarget = nil   -- function returning the Vector3 to look at, or nil

local function StartMoving(getDestFn)
    if moveConn then moveConn:Disconnect() end

    -- Humanoid.AutoRotate re-orients the character from its own move
    -- direction every frame and overwrites our facing. Kill it.
    local h0 = GetHuman()
    if h0 then pcall(function() h0.AutoRotate = false end) end

    moveConn = RunService.Heartbeat:Connect(function(dt)
        local root  = GetRoot()
        local human = GetHuman()
        if not root or not human then return end
        if human.AutoRotate then human.AutoRotate = false end

        local pos = root.Position

        -- Step toward destination at WalkSpeed (position only)
        local dest = getDestFn()
        if dest then
            local dir  = Vector3.new(dest.X - pos.X, 0, dest.Z - pos.Z)
            local dist = dir.Magnitude
            if dist > 1 then
                local step = math.min(dist, CONFIG.WalkSpeed * dt)
                local np   = pos + dir.Unit * step
                pos = Vector3.new(np.X, pos.Y, np.Z)
            end
        end

        -- Look direction: at the mob if we have one, else along travel
        local look = nil
        local fp = faceTarget and faceTarget() or nil
        if fp then
            local d = Vector3.new(fp.X - pos.X, 0, fp.Z - pos.Z)
            if d.Magnitude > 0.5 then look = d.Unit end
        end
        if not look and dest then
            local d = Vector3.new(dest.X - pos.X, 0, dest.Z - pos.Z)
            if d.Magnitude > 0.5 then look = d.Unit end
        end

        if look then
            root.CFrame = CFrame.lookAt(pos, pos + look)
        else
            root.CFrame = root.CFrame - root.CFrame.Position + pos
        end

        -- Aim the camera at the mob too — DQR resolves attacks from the
        -- camera/mouse ray, not from the character's own facing.
        if CONFIG.AimCamera and fp then
            local cam = workspace.CurrentCamera
            if cam then
                if cam.CameraType ~= Enum.CameraType.Scriptable then
                    cam.CameraType = Enum.CameraType.Scriptable
                end
                local back = Vector3.new(-look.X, 0, -look.Z) * CONFIG.CameraBack
                cam.CFrame = CFrame.lookAt(
                    pos + back + Vector3.new(0, CONFIG.CameraHeight, 0), fp)
            end
        end
    end)
end

local function StopMoving()
    if moveConn then
        moveConn:Disconnect()
        moveConn = nil
    end
    local h = GetHuman()
    if h then pcall(function() h.AutoRotate = true end) end
    local cam = workspace.CurrentCamera
    if cam and cam.CameraType == Enum.CameraType.Scriptable then
        cam.CameraType = Enum.CameraType.Custom
        pcall(function() cam.CameraSubject = GetHuman() end)
    end
end

-- ============================================================
--  FACE MOB — feeds the single movement connection above
-- ============================================================
local function StartFacing(getPosFn) faceTarget = getPosFn end
local function StopFacing()          faceTarget = nil     end

-- ============================================================
--  WALK LINE
-- ============================================================
local WalkLinePart = nil
local function ShowWalkLine(from, to)
    if WalkLinePart and WalkLinePart.Parent then WalkLinePart:Destroy() end
    local len = (to - from).Magnitude
    if len < 0.5 then return end
    local p = Instance.new("Part")
    p.Name = "DQR_Line" p.Anchored = true p.CanCollide = false
    p.CastShadow = false p.Material = Enum.Material.Neon
    p.Color = Color3.fromRGB(80, 200, 255) p.Transparency = 0.3
    p.Size = Vector3.new(0.1, 0.1, len)
    p.CFrame = CFrame.lookAt((from+to)/2, to)
    p.Parent = workspace WalkLinePart = p
end
local function ClearWalkLine()
    if WalkLinePart and WalkLinePart.Parent then
        WalkLinePart:Destroy() WalkLinePart = nil
    end
end

-- ============================================================
--  REMOTE SCANNER — finds RemoteEvents / RemoteFunctions
--  DQR uses remotes for dungeon queuing under ReplicatedStorage
-- ============================================================
local RS = game:GetService("ReplicatedStorage")

local function FindRemote(name)
    -- Search ReplicatedStorage recursively
    for _, obj in ipairs(RS:GetDescendants()) do
        if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction"))
        and obj.Name:lower():find(name:lower()) then
            return obj
        end
    end
    return nil
end

local function PrintRemotes()
    print("[DQR] === REMOTE SCAN ===")
    for _, obj in ipairs(RS:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            print("[Remote] " .. obj.ClassName .. " | " .. obj:GetFullName())
        end
    end
    print("[DQR] === END ===")
end

-- ============================================================
--  DUNGEON QUEUE — via RemoteEvent fire instead of clicking
--  DQR remote names discovered at runtime via PrintRemotes()
-- ============================================================
local KNOWN_DUNGEON_REMOTES = {
    -- Common patterns in DQR — will match whichever exists
    "CreateDungeon",
    "createDungeon",
    "StartDungeon",
    "startDungeon",
    "JoinDungeon",
    "DungeonCreate",
    "LobbyCreate",
    "CreateLobby",
}

local DIFFICULTY_MAP = {
    Easy      = 1,
    Medium    = 2,
    Hard      = 3,
    Insane    = 4,
    Nightmare = 5,
}

local function TryFireDungeonRemote()
    local diffNum = DIFFICULTY_MAP[CONFIG.Difficulty] or 1

    -- Try each known remote pattern
    for _, name in ipairs(KNOWN_DUNGEON_REMOTES) do
        local remote = FindRemote(name)
        if remote then
            print("[DQR] Found remote: " .. remote:GetFullName())
            if remote:IsA("RemoteEvent") then
                -- Try common argument patterns DQR uses
                pcall(function()
                    remote:FireServer(CONFIG.TargetDungeon, CONFIG.Difficulty)
                end)
                S(0.3)
                pcall(function()
                    remote:FireServer(CONFIG.TargetDungeon, diffNum)
                end)
                S(0.3)
                pcall(function()
                    remote:FireServer({
                        dungeon    = CONFIG.TargetDungeon,
                        difficulty = CONFIG.Difficulty,
                    })
                end)
            elseif remote:IsA("RemoteFunction") then
                pcall(function()
                    remote:InvokeServer(CONFIG.TargetDungeon, CONFIG.Difficulty)
                end)
            end
            return true
        end
    end
    return false
end

-- ============================================================
--  DUNGEON QUEUE — fallback button fire (no click, direct signal)
-- ============================================================
-- ============================================================
--  BUTTON PRESS — the real one.
--  `signal:Fire()` does NOT exist on RBXScriptSignal; every
--  `pcall(function() btn.MouseButton1Click:Fire() end)` in v4.3
--  threw and was silently swallowed, so nothing was ever clicked.
--  Three real strategies, in order of reliability:
--    1. executor firesignal()
--    2. executor getconnections() -> :Fire() on each connection
--    3. VirtualInputManager click at the button's real screen position
-- ============================================================
local GuiService = game:GetService("GuiService")

local function VisibleOnScreen(gui)
    if not gui.Visible or gui.AbsoluteSize.X < 1 then return false end
    local p = gui.Parent
    while p and not p:IsA("PlayerGui") do
        if p:IsA("GuiObject") and not p.Visible then return false end
        if p:IsA("ScreenGui") and not p.Enabled then return false end
        p = p.Parent
    end
    return true
end

local function Env(name)
    local ok, v = pcall(function()
        if getfenv then return getfenv()[name] end
        return (_G)[name]
    end)
    if ok then return v end
    return nil
end

local function ClickButton(btn)
    local fs = Env("firesignal")
    if typeof(fs) == "function" then
        local ok = pcall(fs, btn.MouseButton1Click)
        pcall(fs, btn.Activated)
        if ok then return true end
    end

    local gc = Env("getconnections")
    if typeof(gc) == "function" then
        local fired = false
        for _, sig in ipairs({btn.MouseButton1Click, btn.Activated}) do
            pcall(function()
                for _, c in ipairs(gc(sig)) do
                    c:Fire()
                    fired = true
                end
            end)
        end
        if fired then return true end
    end

    -- Real mouse input at the button's centre (needs it on screen)
    if not VisibleOnScreen(btn) then return false end
    local inset = GuiService:GetGuiInset()
    local x = btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2
    local y = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2 + inset.Y
    pcall(function()
        VIM:SendMouseMoveEvent(x, y, game)
        S(0.05)
        VIM:SendMouseButtonEvent(x, y, 0, true,  game, 0)
        S(0.05)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
    return true
end

local function FindAndFireBtn(matches, timeout)
    timeout = timeout or 8
    local elapsed = 0
    repeat
        S(0.5)
        elapsed = elapsed + 0.5
        local pg = LP:WaitForChild("PlayerGui")
        for _, obj in ipairs(pg:GetDescendants()) do
            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                local t  = obj:IsA("TextButton")
                    and obj.Text:lower():gsub("%s+","") or ""
                local nm = obj.Name:lower():gsub("%s+","")
                for _, m in ipairs(matches) do
                    local mt = m.text and m.text:lower():gsub("%s+","") or nil
                    local mn = m.name and m.name:lower():gsub("%s+","") or nil
                    if (mt and (t == mt or t:find(mt)))
                    or (mn and (nm == mn or nm:find(mn))) then
                        print("[DQR] Firing button: " .. obj.Name
                            .. " Text: '" .. (obj:IsA("TextButton")
                            and obj.Text or "") .. "'")
                        if ClickButton(obj) then return true end
                    end
                end
            end
        end
    until elapsed >= timeout
    return false
end

local function RunLobbyFlow()
    if not CONFIG.AutoRunDungeon then return end
    print("[DQR] Starting lobby flow — no mouse clicks.")

    -- Remotes are only a hint here. TryFireDungeonRemote returned true as
    -- soon as it found *any* name-matching remote and blind-fired guessed
    -- arguments at it — and the old code then `return`ed, skipping the whole
    -- button flow. That is why the match never started. Now it is opt-in and
    -- never short-circuits the UI path.
    if CONFIG.UseRemotes then
        print("[DQR] Scanning for dungeon remotes...")
        PrintRemotes()
        S(0.5)
        TryFireDungeonRemote()
        S(2)
    end

    print("[DQR] Driving the lobby UI.")

    -- Step 1: Play button
    print("[DQR] Step 1: Play button")
    local playFired = false
    -- Direct path fire
    pcall(function()
        local btn = LP.PlayerGui
            :WaitForChild("mainInterface", 4)
            :WaitForChild("buttons", 4)
            :WaitForChild("playButton", 4)
        playFired = ClickButton(btn)
        print("[DQR] playButton fired via direct path.")
    end)
    if not playFired then
        FindAndFireBtn({
            {name = "playbutton"}, {name = "playBtn"},
            {text = "play"},
        }, 8)
    end
    S(1.2)

    -- Step 2: Create Dungeon popup
    print("[DQR] Step 2: Create Dungeon")
    FindAndFireBtn({
        {text = "createdungeon"},
        {name = "createdungeon"},
        {name = "createDungeon"},
    }, 6)
    S(1.0)

    -- Step 3: Select dungeon from list
    print("[DQR] Step 3: Select " .. CONFIG.TargetDungeon)
    -- Try exact text match first
    local dunFired = FindAndFireBtn({
        {text = CONFIG.TargetDungeon:lower():gsub("%s+","")},
        {text = CONFIG.TargetDungeon:lower()},
    }, 6)
    if not dunFired then
        -- Keyword fallback
        local kw = CONFIG.TargetDungeon:match("(%a+)"):lower()
        local pg = LP:WaitForChild("PlayerGui")
        for _, obj in ipairs(pg:GetDescendants()) do
            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                local t = obj:IsA("TextButton") and obj.Text:lower() or ""
                local n = obj.Name:lower()
                if t:find(kw) or n:find(kw) then
                    if ClickButton(obj) then
                        print("[DQR] Dungeon via keyword: " .. kw)
                        dunFired = true
                        break
                    end
                end
            end
        end
    end
    S(0.8)

    -- Step 4: Difficulty
    print("[DQR] Step 4: Difficulty " .. CONFIG.Difficulty)
    FindAndFireBtn({
        {text = CONFIG.Difficulty:lower()},
        {name = CONFIG.Difficulty:lower()},
    }, 5)
    S(0.6)

    -- Step 5: Create Lobby
    print("[DQR] Step 5: Create Lobby")
    FindAndFireBtn({
        {text = "createlobby"},
        {name = "createlobby"},
        {name = "createLobby"},
        {name = "CreateLobby"},
    }, 6)
    S(1.5)

    -- Step 6: Start (party screen)
    print("[DQR] Step 6: Start")
    FindAndFireBtn({
        {text = "start"},
        {name = "start"},
        {name = "startButton"},
        {name = "Start"},
    }, 8)
    S(1.5)

    -- Step 7: In-dungeon START
    print("[DQR] Step 7: In-dungeon START")
    FindAndFireBtn({
        {text = "start"},
        {name = "start"},
        {name = "startButton"},
    }, 12)

    print("[DQR] Lobby flow complete.")
end

-- ============================================================
--  MOB DETECTION — strict, cached
-- ============================================================
local cachedTarget = nil
local lastScan     = 0
local CACHE_TTL    = 0.15

local function GetNearestMob()
    local root = GetRoot()
    if not root then return nil end
    local now = tick()

    -- Return cache if valid
    if cachedTarget and (now - lastScan) < CACHE_TTL then
        local h = cachedTarget.Humanoid
        if h and h.Health > 0 and cachedTarget.Root.Parent then
            cachedTarget.Distance =
                (cachedTarget.Root.Position - root.Position).Magnitude
            return cachedTarget
        end
    end

    lastScan = now
    local best, bestD = nil, math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local mr  = obj:FindFirstChild("HumanoidRootPart")
            if hum and mr and hum.Health > 0
            and hum.MaxHealth > 0 and not mr.Anchored then
                local isPlayer = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character == obj then isPlayer = true break end
                end
                if not isPlayer then
                    local hasBB = false
                    for _, c in ipairs(obj:GetDescendants()) do
                        if c:IsA("BillboardGui") or c:IsA("Highlight") then
                            hasBB = true break
                        end
                    end
                    local pc = 0
                    for _, c in ipairs(obj:GetChildren()) do
                        if c:IsA("BasePart") or c:IsA("MeshPart")
                        or c:IsA("UnionOperation") then pc = pc + 1 end
                    end
                    if hasBB and pc >= 2 then
                        local d = (mr.Position - root.Position).Magnitude
                        if d < bestD then
                            bestD = d
                            best = {Model=obj, Root=mr, Humanoid=hum, Distance=d}
                        end
                    end
                end
            end
        end
    end

    cachedTarget = best
    return best
end

-- ============================================================
--  DUNGEON DETECTION
-- ============================================================
local function IsInDungeon()
    local count = 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local mr  = obj:FindFirstChild("HumanoidRootPart")
            if hum and mr and hum.Health > 0
            and hum.MaxHealth > 0 and not mr.Anchored then
                local isP = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character == obj then isP = true break end
                end
                if not isP then
                    for _, c in ipairs(obj:GetDescendants()) do
                        if c:IsA("BillboardGui") or c:IsA("Highlight") then
                            count = count + 1 break
                        end
                    end
                    if count >= 2 then return true end
                end
            end
        end
    end
    return false
end

local function IsInDungeonSafe()
    if not IsInDungeon() then return false end
    S(2) return IsInDungeon()
end

-- ============================================================
--  COMBAT — spells + melee swing
-- ============================================================
local spellSlot   = false
local lastSpell   = 0
local lastMelee   = 0

local function FireKey(kc)
    pcall(function() VIM:SendKeyEvent(true,  kc, false, game) end)
    S(0.05)
    pcall(function() VIM:SendKeyEvent(false, kc, false, game) end)
end

local function DoMelee()
    -- Left click swing — DQR auto-attacks on left mouse
    local now = tick()
    if now - lastMelee < CONFIG.MeleeRate then return end
    lastMelee = now
    task.spawn(function()
        pcall(function()
            -- Aim at screen centre, not (0,0). The camera is pointed at the
            -- mob, so the centre of the viewport is the mob.
            local cam = workspace.CurrentCamera
            local vp  = cam and cam.ViewportSize or Vector2.new(800, 600)
            local x, y = vp.X / 2, vp.Y / 2
            VIM:SendMouseMoveEvent(x, y, game)
            VIM:SendMouseButtonEvent(x, y, 0, true,  game, 0)
            S(0.05)
            VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end)
    end)
end

local function DoSpell(dist)
    if dist > CONFIG.AttackRange then return end
    local now = tick()
    if now - lastSpell < CONFIG.AttackRate then return end
    lastSpell = now
    spellSlot = not spellSlot
    task.spawn(function()
        FireKey(spellSlot and Enum.KeyCode.Q or Enum.KeyCode.E)
    end)
end

-- ============================================================
--  THREAT DETECTION
-- ============================================================
local function ColorIsThreat(c)
    return (c.R > 0.6 and c.G < 0.35 and c.B < 0.35)
        or (c.R > 0.6 and c.G < 0.35 and c.B > 0.5)
        or (c.R > 0.7 and c.G > 0.3  and c.B < 0.1)
end

local function ScanThreats()
    local root = GetRoot()
    if not root then return false, nil end
    local char = GetChar()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart")
        and (not char or not obj:IsDescendantOf(char)) then
            if obj.Material == Enum.Material.Neon
            or ColorIsThreat(obj.Color) then
                local d = (obj.Position - root.Position).Magnitude
                if d < CONFIG.DodgeRange then
                    local vel = obj.AssemblyLinearVelocity
                    if vel.Magnitude > 8 then
                        if vel.Unit:Dot(
                            (root.Position - obj.Position).Unit) > 0.55 then
                            return true, obj.Position
                        end
                    end
                end
            end
            for _, ch in ipairs(obj:GetChildren()) do
                if ch:IsA("Beam") then
                    if (obj.Position - root.Position).Magnitude
                        < CONFIG.DodgeRange then
                        return true, obj.Position
                    end
                end
            end
        end
    end
    return false, nil
end

-- ============================================================
--  CIRCULAR ORBIT
-- ============================================================
local orbitAngle = 0
local seeded     = false
local lastDodge  = 0

local function SeedOrbit(mobPos)
    local root = GetRoot()
    if not root then return end
    orbitAngle = math.atan2(
        root.Position.Z - mobPos.Z,
        root.Position.X - mobPos.X)
    seeded = true
end

local function GetOrbitPos(mobPos, radius)
    return Vector3.new(
        mobPos.X + math.cos(orbitAngle) * radius,
        mobPos.Y,
        mobPos.Z + math.sin(orbitAngle) * radius)
end

-- ============================================================
--  MAIN FARM LOOP
-- ============================================================
local Farm = {Running = false, Thread = nil, DodgeThread = nil}
local lastFrame = tick()
local currentDest = nil

local function MainLoop()
    seeded = false
    lastFrame = tick()

    -- Start movement engine — reads currentDest every heartbeat
    StartMoving(function() return currentDest end)

    while Farm.Running do
        local now = tick()
        local dt  = math.min(now - lastFrame, 0.1)
        lastFrame = now

        local root  = GetRoot()
        local human = GetHuman()

        if not root or not human or human.Health <= 0 then
            currentDest = nil
            ClearWalkLine()
            StopFacing()
            S(0.5)
            continue
        end

        local target = GetNearestMob()

        if not target then
            currentDest = nil
            ClearWalkLine()
            StopFacing()
            seeded = false
            S(CONFIG.ScanRate)
            continue
        end

        local mobPos = target.Root.Position
        local dist   = target.Distance

        -- Always face mob
        if not faceTarget then
            StartFacing(function()
                local t = GetNearestMob()
                return t and t.Root.Position or nil
            end)
        end

        -- MELEE when very close
        if dist <= CONFIG.MeleeRange then
            DoMelee()
        end

        -- SPELLS when in range
        DoSpell(dist)

        -- Seed orbit on new target
        if not seeded then SeedOrbit(mobPos) end

        -- Dodge — highest movement priority
        local threatened, tOrigin = ScanThreats()
        if threatened and (now - lastDodge) > CONFIG.DodgeCooldown then
            lastDodge = now
            local toward = Vector3.new(
                tOrigin.X - root.Position.X, 0,
                tOrigin.Z - root.Position.Z).Unit
            local perp = Vector3.new(-toward.Z, 0, toward.X)
            local sign = math.cos(orbitAngle) > 0 and 1 or -1
            local dodge = root.Position + perp * sign * CONFIG.DodgeStep
            currentDest = Vector3.new(dodge.X, root.Position.Y, dodge.Z)
            ShowWalkLine(root.Position, currentDest)
            orbitAngle = orbitAngle + sign * 0.5
            S(CONFIG.ScanRate)
            continue
        end

        -- Advance orbit
        orbitAngle = orbitAngle + CONFIG.CircleSpeed * dt
        if orbitAngle > math.pi * 2 then
            orbitAngle = orbitAngle - math.pi * 2
        end

        -- Scale orbit radius by current distance
        local radius = CONFIG.CircleRadius
        if dist < CONFIG.MinRange then
            radius = CONFIG.CircleRadius * 1.6
        elseif dist > CONFIG.MaxRange then
            radius = CONFIG.CircleRadius * 0.5
        end

        local dest = GetOrbitPos(mobPos, radius)
        currentDest = Vector3.new(dest.X, root.Position.Y, dest.Z)
        ShowWalkLine(root.Position, currentDest)

        S(CONFIG.ScanRate)
    end

    currentDest = nil
    StopMoving()
    StopFacing()
    ClearWalkLine()
end

-- ============================================================
--  DODGE WATCHER 20hz
-- ============================================================
local function DodgeWatcher()
    local lastDW = 0
    while Farm.Running do
        S(0.05)
        local root = GetRoot()
        if not root then continue end
        local ok, origin = ScanThreats()
        local now = tick()
        if ok and (now - lastDW) > CONFIG.DodgeCooldown then
            lastDW = now
            local toward = Vector3.new(
                origin.X - root.Position.X, 0,
                origin.Z - root.Position.Z).Unit
            local perp = Vector3.new(-toward.Z, 0, toward.X)
            local sign = math.cos(orbitAngle) > 0 and 1 or -1
            currentDest = root.Position + perp * sign * CONFIG.DodgeStep
        end
    end
end

-- ============================================================
--  START / STOP
-- ============================================================
function Farm.Start()
    if Farm.Running then return end
    Farm.Running     = true
    Farm.Thread      = task.spawn(MainLoop)
    Farm.DodgeThread = task.spawn(DodgeWatcher)
    print("[DQR] Farm started.")
end

function Farm.Stop()
    Farm.Running = false
    currentDest  = nil
    StopMoving()
    StopFacing()
    ClearWalkLine()
    print("[DQR] Farm stopped.")
end

LP.CharacterAdded:Connect(function()
    S(2)
    if Farm.Running then
        Farm.Stop() S(0.5) Farm.Start()
    end
end)

-- ============================================================
--  DUNGEON COMPLETE WATCHER
-- ============================================================
local function DungeonWatcher()
    local empty = 0
    while true do
        S(3)
        if not Farm.Running then continue end
        if not GetNearestMob() then
            empty = empty + 1
            if empty >= 3 then
                empty = 0
                print("[DQR] Dungeon cleared.")
                Farm.Stop()
                S(6)
                if CONFIG.AutoRunDungeon then
                    task.spawn(RunLobbyFlow)
                    local w = 0
                    repeat S(2) w = w + 2 until IsInDungeon() or w > 90
                end
                if IsInDungeon() then Farm.Start() end
            end
        else
            empty = 0
        end
    end
end

