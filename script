-- ============================================================
--  WALK LINE
-- ============================================================
-- Red bar laid out in front of the character, pointing at the current
-- mob. Its length IS the distance to that mob, so it shrinks as you
-- close in and stretches as the mob runs away.
local function ShowRangeBar(root, mobPos, dist)
    if not CONFIG.ShowRangeBar then return end
    if not RangeBarPart or not RangeBarPart.Parent then
        local p = Instance.new("Part")
        p.Name        = "DQR_RangeBar"
        p.Anchored    = true
        p.CanCollide  = false
        p.CanQuery    = false
        p.CanTouch    = false
        p.CastShadow  = false
        p.Material    = Enum.Material.Neon
        p.Color       = Color3.fromRGB(255, 45, 45)
        p.Transparency = 0.3
        p.Parent      = workspace
        RangeBarPart  = p
    end

    local dir = Vector3.new(mobPos.X - root.Position.X, 0,
                            mobPos.Z - root.Position.Z)
    if dir.Magnitude < 0.1 then return end
    dir = dir.Unit

    local len  = math.clamp(dist, 1, CONFIG.BarMaxLen)
    local base = root.Position - Vector3.new(0, 2.6, 0)
    local mid  = base + dir * (len / 2)

    RangeBarPart.Size  = Vector3.new(CONFIG.BarWidth, 0.12, len)
    RangeBarPart.CFrame = CFrame.lookAt(mid, mid + dir)
end

local function ClearRangeBar()
    if RangeBarPart and RangeBarPart.Parent then
        RangeBarPart:Destroy()
    end
    RangeBarPart = nil
end

-- ============================================================
--  REMOTE SCANNER - finds RemoteEvents / RemoteFunctions
--  DQR uses remotes for dungeon queuing under ReplicatedStorage
-- ============================================================
local RS = game:GetService("ReplicatedStorage")

local function FindRemote(name)
    -- Search ReplicatedStorage recursively
    for _, obj in ipairs(RS:GetDescendants()) do
        if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction"))
        and obj.Name:lower():find(name:lower()) then
            return obj
        end
    end
    return nil
end

local function PrintRemotes()
    print("[DQR] === REMOTE SCAN ===")
    for _, obj in ipairs(RS:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            print("[Remote] " .. obj.ClassName .. " | " .. obj:GetFullName())
        end
    end
    print("[DQR] === END ===")
end

-- ============================================================
--  DUNGEON QUEUE - via RemoteEvent fire instead of clicking
--  DQR remote names discovered at runtime via PrintRemotes()
-- ============================================================
local KNOWN_DUNGEON_REMOTES = {
    -- Common patterns in DQR - will match whichever exists
    "CreateDungeon",
    "createDungeon",
    "StartDungeon",
    "startDungeon",
    "JoinDungeon",
    "DungeonCreate",
    "LobbyCreate",
    "CreateLobby",
}

local DIFFICULTY_MAP = {
    Easy      = 1,
    Medium    = 2,
    Hard      = 3,
    Insane    = 4,
    Nightmare = 5,
}

local function TryFireDungeonRemote()
    local diffNum = DIFFICULTY_MAP[CONFIG.Difficulty] or 1

    -- Try each known remote pattern
    for _, name in ipairs(KNOWN_DUNGEON_REMOTES) do
        local remote = FindRemote(name)
        if remote then
            print("[DQR] Found remote: " .. remote:GetFullName())
            if remote:IsA("RemoteEvent") then
                -- Try common argument patterns DQR uses
                pcall(function()
                    remote:FireServer(CONFIG.TargetDungeon, CONFIG.Difficulty)
                end)
                S(0.3)
                pcall(function()
                    remote:FireServer(CONFIG.TargetDungeon, diffNum)
                end)
                S(0.3)
                pcall(function()
                    remote:FireServer({
                        dungeon    = CONFIG.TargetDungeon,
                        difficulty = CONFIG.Difficulty,
                    })
                end)
            elseif remote:IsA("RemoteFunction") then
                pcall(function()
                    remote:InvokeServer(CONFIG.TargetDungeon, CONFIG.Difficulty)
                end)
            end
            return true
        end
    end
    return false
end

-- ============================================================
--  DUNGEON QUEUE - fallback button fire (no click, direct signal)
-- ============================================================
-- ============================================================
--  BUTTON PRESS - the real one.
--  `signal:Fire()` does NOT exist on RBXScriptSignal; every
--  `pcall(function() btn.MouseButton1Click:Fire() end)` in v4.3
--  threw and was silently swallowed, so nothing was ever clicked.
--  Three real strategies, in order of reliability:
--    1. executor firesignal()
--    2. executor getconnections() -> :Fire() on each connection
--    3. VirtualInputManager click at the button's real screen position
-- ============================================================
local function VisibleOnScreen(gui)
    if not gui.Visible or gui.AbsoluteSize.X < 1 then return false end
    local p = gui.Parent
    while p and not p:IsA("PlayerGui") do
        if p:IsA("GuiObject") and not p.Visible then return false end
        if p:IsA("ScreenGui") and not p.Enabled then return false end
        p = p.Parent
    end
    return true
end

local function Norm(s) return (s or ""):lower():gsub("%s+", "") end

-- The label of a Roblox button is very often a child TextLabel, not the
-- button's own .Text. v4.4 only read TextButton.Text, so an ImageButton
-- named "frame" wrapping a TextLabel reading "PLAY" matched nothing -
-- which is exactly why the main-screen Play button was never pressed.
local function ButtonTokens(btn)
    local t = {}
    if btn:IsA("TextButton") then t[#t+1] = Norm(btn.Text) end
    for _, d in ipairs(btn:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            t[#t+1] = Norm(d.Text)
        end
    end
    return t
end

local function ButtonText(btn)
    return table.concat(ButtonTokens(btn), "|")
end

-- EXACT by default. Substring matching is what made "play" match the
-- "Show Players" button in the top-right HUD - which is on screen inside
-- a dungeon too, so InLobby() was always true and the script kept
-- queueing new runs mid-dungeon. Pass contains=true to opt back in.
local function ButtonMatches(btn, m)
    local want = m.text and Norm(m.text) or nil
    if want and want ~= "" then
        for _, tok in ipairs(ButtonTokens(btn)) do
            if m.contains then
                if tok:find(want, 1, true) then return true end
            elseif tok == want then
                return true
            end
        end
    end
    local wn = m.name and Norm(m.name) or nil
    if wn and wn ~= "" then
        local nm = Norm(btn.Name)
        if m.contains then
            if nm:find(wn, 1, true) then return true end
        elseif nm == wn then
            return true
        end
    end
    return false
end

-- AbsolutePosition is measured below the topbar unless the owning
-- ScreenGui sets IgnoreGuiInset. VirtualInputManager wants true viewport
-- coordinates, so the inset must be added *conditionally* - adding it
-- always put the click ~36px below buttons like Create Lobby and missed.
local function ScreenPointOf(gui)
    local ignore = false
    local p = gui.Parent
    while p do
        if p:IsA("ScreenGui") then ignore = p.IgnoreGuiInset break end
        p = p.Parent
    end
    local x = gui.AbsolutePosition.X + gui.AbsoluteSize.X / 2
    local y = gui.AbsolutePosition.Y + gui.AbsoluteSize.Y / 2
    if not ignore then y = y + GuiService:GetGuiInset().Y end
    return x, y
end

local function ClickButton(btn)
    -- Prefer a genuine click when the button is on screen: it triggers
    -- whatever the game actually listens on (MouseButton1Down, InputBegan
    -- on the frame, TouchTap...), not just MouseButton1Click.
    if VisibleOnScreen(btn) then
        local x, y = ScreenPointOf(btn)
        -- The log window would swallow a click landing underneath it.
        -- Blink it off for the duration rather than making you drag it.
        local wasOpen = LogGui and LogGui.Enabled
        if wasOpen then LogGui.Enabled = false end
        local ok = pcall(function()
            VIM:SendMouseMoveEvent(x, y, game)
            S(0.08)
            VIM:SendMouseButtonEvent(x, y, 0, true,  game, 0)
            S(0.08)
            VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end)
        if wasOpen then LogGui.Enabled = true end
        print(("[DQR]   click @ %d,%d ok=%s"):format(x, y, tostring(ok)))
        if ok then return true end
    end

    -- Hidden or input blocked - drive the signal directly. getconnections
    -- first because it is verifiable: we can count the handlers we fired.
    local gc = Env("getconnections")
    if typeof(gc) == "function" then
        local fired = 0
        for _, sig in ipairs({btn.MouseButton1Click, btn.Activated,
                              btn.MouseButton1Down, btn.MouseButton1Up}) do
            pcall(function()
                for _, c in ipairs(gc(sig)) do
                    c:Fire()
                    fired = fired + 1
                end
            end)
        end
        if fired > 0 then return true end
    end

    local fs = Env("firesignal")
    if typeof(fs) == "function" then
        local ok = pcall(fs, btn.MouseButton1Click)
        pcall(fs, btn.Activated)
        if ok then return true end
    end

    return false
end

-- Returns every button matching, visible ones first. A hidden "play" in
-- some other closed menu must never win over the one on screen.
local function FindButtons(matches)
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return {} end
    local vis, hid = {}, {}
    for _, obj in ipairs(pg:GetDescendants()) do
        if (obj:IsA("TextButton") or obj:IsA("ImageButton"))
        and not obj.Name:find("DQRui_")
        and not (LogGui and obj:IsDescendantOf(LogGui)) then
            for _, m in ipairs(matches) do
                if ButtonMatches(obj, m) then
                    if VisibleOnScreen(obj) then
                        vis[#vis+1] = obj
                    else
                        hid[#hid+1] = obj
                    end
                    break
                end
            end
        end
    end
    for _, o in ipairs(hid) do vis[#vis+1] = o end
    return vis
end

-- `verify` (optional) returns true once the click has visibly taken
-- effect. Without it a click counts as done the moment input is sent,
-- which is how "Create Lobby" could report success while nothing moved.
local function FindAndFireBtn(matches, timeout, verify)
    timeout = timeout or 8
    local elapsed = 0
    repeat
        local found = FindButtons(matches)
        for _, obj in ipairs(found) do
            print(("[DQR] Clicking %s  text='%s'  visible=%s")
                :format(obj:GetFullName(), ButtonText(obj),
                        tostring(VisibleOnScreen(obj))))
            ClickButton(obj)
            if not verify then return true end
            local w = 0
            repeat S(0.25) w = w + 0.25 until verify() or w >= 1.5
            if verify() then
                print("[DQR]   verified.")
                return true
            end
            print("[DQR]   click had no effect, trying next candidate.")
        end
        if #found == 0 then print("[DQR]   (no candidates yet)") end
        S(0.5)
        elapsed = elapsed + 0.5
    until elapsed >= timeout
    print("[DQR] No button worked after " .. timeout .. "s.")
    return false
end

-- Prints every button in PlayerGui. Run this in the lobby and paste the
-- output if a step still misses - it gives the real names to match on.
local function DumpGui()
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    print("[DQR] === GUI BUTTON DUMP ===")
    for _, obj in ipairs(pg:GetDescendants()) do
        if obj:IsA("TextButton") or obj:IsA("ImageButton") then
            print(("%s | text='%s' | visible=%s")
                :format(obj:GetFullName(), ButtonText(obj),
                        tostring(VisibleOnScreen(obj))))
        end
    end
    print("[DQR] === END DUMP ===")
end

-- Wire the log window's Dump button now that DumpGui exists
if LogGui then
    local b = LogGui:FindFirstChild("DQRui_DumpBtn", true)
    if b then b.MouseButton1Click:Connect(function() task.spawn(DumpGui) end) end
end

-- ============================================================
--  LOBBY DETECTION
--  "Am I in a dungeon?" was inferred from mob count, so any quiet
--  moment in a dungeon (between rooms, mobs not matching the strict
--  filter) read as "not in a dungeon" and the watcher happily started
--  queueing another one mid-run. Seeing the lobby's own Play button on
--  screen is a positive, unambiguous signal - use that instead.
-- ============================================================
local function AnyVisible(matches)
    for _, b in ipairs(FindButtons(matches)) do
        if VisibleOnScreen(b) then return b end
    end
    return nil
end

-- ============================================================
--  EXACT UI PATHS  (taken from a live GUI dump of this game)
--
--  Keyword matching could never work for the dungeon list or the
--  difficulty buttons: every one of them is *named* "TextButton" and
--  has EMPTY text. The identifying name sits on the parent frame -
--  chooseDungeon.backgroundFillLeft.ScrollingFrame["Desert Temple"]
--  .TextButton, chooseDungeon.backgroundFillRight.Easy.TextButton.
--  Exact paths remove all the guessing.
-- ============================================================
local UI = {
    IntroPlay   = {"introGui", "title", "Frame", "TextButton"},
    LobbyPlay   = {"mainInterface", "buttons", "playButton"},
    SelectPanel = {"queueGui", "selectOption"},
    CreateGame  = {"queueGui", "selectOption", "Frame", "createGame"},
    ChoosePanel = {"queueGui", "chooseDungeon"},
    DungeonList = {"queueGui", "chooseDungeon", "backgroundFillLeft",
                   "ScrollingFrame"},
    DiffRoot    = {"queueGui", "chooseDungeon", "backgroundFillRight"},
    Hardcore    = {"queueGui", "chooseDungeon", "backgroundFillRight",
                   "hardcoreSection", "hardcore"},
    CreateLobby = {"queueGui", "chooseDungeon", "backgroundFillMiddle",
                   "startMain", "TextButton"},
    LobbyInfo   = {"queueGui", "lobbyInfo"},
    StartRun    = {"queueGui", "lobbyInfo", "startBackground", "startFrame",
                   "startButton"},
    Replay      = {"ReplayDungeonButton", "Replay"},
}

local function Path(parts)
    local node = LP:FindFirstChildOfClass("PlayerGui")
    if not node then return nil end
    for _, n in ipairs(parts) do
        node = node:FindFirstChild(n)
        if not node then return nil end
    end
    return node
end

local function PathVisible(parts)
    local o = Path(parts)
    if o and VisibleOnScreen(o) then return o end
    return nil
end

-- A dungeon row / difficulty button: the clickable TextButton is a child
-- of a frame named after the dungeon or difficulty.
local function DungeonBtn(name)
    local list = Path(UI.DungeonList)
    if not list then return nil end
    local row = list:FindFirstChild(name)
    return row and row:FindFirstChildWhichIsA("TextButton") or nil
end

local function DifficultyBtn(name)
    local root = Path(UI.DiffRoot)
    if not root then return nil end
    local row = root:FindFirstChild(name)
    return row and row:FindFirstChildWhichIsA("TextButton") or nil
end

-- Rows live in a ScrollingFrame; a row scrolled out of view has a valid
-- AbsolutePosition but cannot be clicked. Bring it into view first.
local function ScrollIntoView(btn)
    local sf = btn
    while sf and not sf:IsA("ScrollingFrame") do sf = sf.Parent end
    if not sf then return end
    local delta = btn.AbsolutePosition.Y - sf.AbsolutePosition.Y
    if delta < 0 or delta > sf.AbsoluteSize.Y - btn.AbsoluteSize.Y then
        sf.CanvasPosition = Vector2.new(sf.CanvasPosition.X,
            math.max(0, sf.CanvasPosition.Y + delta - sf.AbsoluteSize.Y / 2))
        S(0.35)
    end
end

-- In the lobby exactly when the lobby's own UI is on screen. All of
-- these belong to the lobby place and are gone inside a dungeon.
local function InLobby()
    return PathVisible(UI.LobbyPlay)   ~= nil
        or PathVisible(UI.IntroPlay)   ~= nil
        or PathVisible(UI.SelectPanel) ~= nil
        or PathVisible(UI.ChoosePanel) ~= nil
        or PathVisible(UI.LobbyInfo)   ~= nil
        -- The end-of-run screen. When a dungeon is failed you land back
        -- in the lobby with this showing and the normal lobby buttons
        -- hidden behind it - which used to read as "not the lobby", so
        -- the script sat there believing it was still in the dungeon.
        or PathVisible(UI.Replay)      ~= nil
end

-- Do the lobby's GUIs exist at all, visible or not? Survives popups
-- covering the whole lobby interface.
local function InLobbyPlace()
    return Path(UI.LobbyPlay) ~= nil or Path(UI.ChoosePanel) ~= nil
end

local lobbyFlowActive = false

local function RunLobbyFlow()
    if not CONFIG.AutoRunDungeon then return end

    -- Hard guard: never queue a dungeon unless the lobby is actually up.
    if not InLobby() then
        print("[DQR] Not in the lobby - refusing to queue a dungeon.")
        return
    end
    if lobbyFlowActive then
        print("[DQR] Lobby flow already running.")
        return
    end
    lobbyFlowActive = true

    print("[DQR] Lobby detected. Starting queue flow.")
    if CONFIG.DebugGui then DumpGui() end

    -- Remotes are only a hint here. TryFireDungeonRemote returned true as
    -- soon as it found *any* name-matching remote and blind-fired guessed
    -- arguments at it - and the old code then `return`ed, skipping the whole
    -- button flow. That is why the match never started. Now it is opt-in and
    -- never short-circuits the UI path.
    if CONFIG.UseRemotes then
        print("[DQR] Scanning for dungeon remotes...")
        PrintRemotes()
        S(0.5)
        TryFireDungeonRemote()
        S(2)
    end

    print("[DQR] Driving the lobby UI.")

    -- Waits for a path to become visible, then clicks it.
    local function Step(n, label, parts, wait)
        print(("[DQR] Step %d: %s"):format(n, label))
        local w = 0
        local o = PathVisible(parts)
        while not o and w < (wait or 8) do
            S(0.4) w = w + 0.4
            o = PathVisible(parts)
        end
        if not o then
            local exists = Path(parts)
            print(("[DQR]   MISS - %s (%s)"):format(
                table.concat(parts, "."),
                exists and "exists but hidden" or "does not exist"))
            return false
        end
        ClickButton(o)
        return true
    end

    -- Step 0: the intro/title splash. This is a DIFFERENT Play button
    -- (introGui.title.Frame.TextButton) from the lobby's
    -- mainInterface.buttons.playButton - the flow has to pass both.
    if PathVisible(UI.IntroPlay) then
        Step(0, "Intro splash Play", UI.IntroPlay, 3)
        local w = 0
        repeat S(0.5) w = w + 0.5 until PathVisible(UI.LobbyPlay) or w > 15
    end

    -- Step 1: lobby Play -> opens the Join/Create chooser
    if not Step(1, "Lobby Play", UI.LobbyPlay, 10) then
        lobbyFlowActive = false
        return
    end
    S(1.0)

    -- Step 2: "Create Dungeon" in the Join/Create chooser
    if not Step(2, "Create Dungeon", UI.CreateGame, 8) then
        lobbyFlowActive = false
        return
    end
    S(1.0)

    -- Step 3: pick the dungeon. Named frame, empty-text child button.
    print("[DQR] Step 3: Select " .. CONFIG.TargetDungeon)
    local db, w = DungeonBtn(CONFIG.TargetDungeon), 0
    while not db and w < 8 do
        S(0.4) w = w + 0.4
        db = DungeonBtn(CONFIG.TargetDungeon)
    end
    if db then
        ScrollIntoView(db)
        ClickButton(db)
    else
        local list = Path(UI.DungeonList)
        print("[DQR]   MISS - no row named '" .. CONFIG.TargetDungeon .. "'.")
        if list then
            local names = {}
            for _, c in ipairs(list:GetChildren()) do names[#names+1] = c.Name end
            print("[DQR]   Available: " .. table.concat(names, ", "))
        end
        lobbyFlowActive = false
        return
    end
    S(0.8)

    -- Step 4: difficulty - same shape, frame named Easy/Medium/Hard/...
    print("[DQR] Step 4: Difficulty " .. CONFIG.Difficulty)
    local fb = DifficultyBtn(CONFIG.Difficulty)
    if fb then
        ClickButton(fb)
    else
        print("[DQR]   MISS - no difficulty frame named '"
            .. CONFIG.Difficulty .. "'.")
    end
    S(0.8)

    -- Step 4b: HARDCORE MODE. Same shape as the difficulty buttons -
    -- a frame named "hardcore" holding the clickable TextButton.
    if CONFIG.Hardcore then
        print("[DQR] Step 4b: Hardcore mode")
        local hcFrame = Path(UI.Hardcore)
        local hc = hcFrame
            and hcFrame:FindFirstChildWhichIsA("TextButton") or nil
        if hc then
            ClickButton(hc)
            -- It is a toggle, not a radio button: if the game remembers
            -- the setting between runs this click could turn it back
            -- OFF. Watch the first couple of queues and say so if it
            -- alternates - the fix is to read its state before clicking.
            print("[DQR]   Hardcore toggled (toggle, not radio - verify).")
        else
            print("[DQR]   MISS - no hardcore button at "
                .. table.concat(UI.Hardcore, "."))
        end
        S(0.6)
    end

    -- Step 5: Create Lobby - verified by the panel actually closing
    print("[DQR] Step 5: Create Lobby")
    local made = false
    for attempt = 1, 4 do
        local cl = PathVisible(UI.CreateLobby)
        if not cl then S(0.5) else
            ClickButton(cl)
            local t = 0
            repeat S(0.3) t = t + 0.3
            until not PathVisible(UI.ChoosePanel) or t > 2.5
            if not PathVisible(UI.ChoosePanel) then made = true break end
            print("[DQR]   attempt " .. attempt .. " did not close the panel.")
        end
    end
    if not made then
        print("[DQR] Create Lobby did not take. Press Copy and send the log.")
        lobbyFlowActive = false
        return
    end
    S(1.2)

    -- Step 6: Start the run from the party screen
    Step(6, "Start run", UI.StartRun, 10)

    print("[DQR] Lobby flow complete.")
    lobbyFlowActive = false
end

-- ============================================================
--  MOB DETECTION - strict, cached
-- ============================================================
local cachedTarget = nil
local cachedMobs   = nil
local lastScan     = 0
local CACHE_TTL    = 0.15
-- Weak keys: entries vanish when the mob model is collected.
local mobShape = setmetatable({}, {__mode = "k"})

local function GetNearestMob()
    local root = GetRoot()
    if not root then return nil end
    local now = tick()

    -- Return cache if valid
    if cachedTarget and (now - lastScan) < CACHE_TTL then
        local h = cachedTarget.Humanoid
        if h and h.Health > 0 and cachedTarget.Root.Parent then
            cachedTarget.Distance =
                (cachedTarget.Root.Position - root.Position).Magnitude
            return cachedTarget
        end
    end

    lastScan = now
    local best, bestD = nil, math.huge
    local mobList = {}
    local seen = {}

    -- Find mobs by their HumanoidRootPart through the broadphase rather
    -- than walking every instance in the map.
    --
    -- Search outward in rings, stopping at the first that finds
    -- anything. A single 300-stud query returns far more than MaxParts
    -- in a dungeon and gets TRUNCATED - and not by distance, so the mob
    -- standing next to you could simply be missing from the results
    -- while one across the room was included. That is why it kept
    -- walking past near groups to reach far ones.
    local parts = {}
    for _, r in ipairs({60, 140, CONFIG.MobScanRadius}) do
        parts = NearbyParts(root.Position, r)
        local any = false
        for _, prt in ipairs(parts) do
            if prt.Name == "HumanoidRootPart" then
                local m = prt.Parent
                if m and m:IsA("Model") and mobShape[m] ~= false then
                    local isP = false
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p.Character == m then isP = true break end
                    end
                    if not isP then any = true break end
                end
            end
        end
        if any then break end
    end

    for _, prt in ipairs(parts) do
        local obj = prt.Name == "HumanoidRootPart" and prt.Parent or nil
        if obj and obj:IsA("Model") and not seen[obj] then
            seen[obj] = true
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local mr  = prt
            if hum and hum.Health > 0
            and hum.MaxHealth > 0 and not mr.Anchored then
                local isPlayer = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character == obj then isPlayer = true break end
                end
                if not isPlayer then
                    -- The shape test (health bar present, more than one
                    -- part) never changes for a given model, so do it
                    -- once and remember it. Running GetDescendants on
                    -- every model on every scan was the expensive half.
                    local verdict = mobShape[obj]
                    if verdict == nil then
                        local hasBB = false
                        for _, c in ipairs(obj:GetDescendants()) do
                            if c:IsA("BillboardGui") or c:IsA("Highlight") then
                                hasBB = true break
                            end
                        end
                        local pc = 0
                        for _, c in ipairs(obj:GetChildren()) do
                            if c:IsA("BasePart") or c:IsA("MeshPart")
                            or c:IsA("UnionOperation") then pc = pc + 1 end
                        end
                        verdict = (hasBB and pc >= 2)
                        mobShape[obj] = verdict
                    end
                    -- Skip anything the path worker has given up on, so
                    -- we stop pressing into a mountain at a mob on the
                    -- far side of it and go fight something reachable.
                    local blocked = unreachable[obj]
                    if blocked and tick() > blocked then
                        unreachable[obj] = nil
                        blocked = nil
                    end

                    if verdict then
                        local d = (mr.Position - root.Position).Magnitude
                        local rec = {Model=obj, Root=mr, Humanoid=hum, Distance=d}
                        -- Every live mob goes in the list, blacklisted or
                        -- not: we still need to steer around one we have
                        -- given up on attacking.
                        mobList[#mobList + 1] = rec
                        if not blocked and d < bestD then
                            bestD = d
                            best  = rec
                        end
                    end
                end
            end
        end
    end

    -- Failsafe: if everything in range is blacklisted we would return
    -- nil and the bot would stand idle being beaten on. Mobs being
    -- present but all "unreachable" means the blacklist is wrong, not
    -- that there is nothing to fight - so drop it and take the nearest.
    if not best and #mobList > 0 then
        table.clear(unreachable)
        for _, rec in ipairs(mobList) do
            if rec.Distance < bestD then
                bestD, best = rec.Distance, rec
            end
        end
        if best then
            print("[DQR] All targets were blacklisted - clearing and "
                .. "taking the nearest.")
        end
    end

    cachedMobs  = mobList
    cachedTarget = best
    return best
end

-- Everything the last scan saw. Shares the scan with GetNearestMob so
-- crowd avoidance costs nothing extra.
local function GetMobs()
    return cachedMobs or {}
end

-- ============================================================
--  DUNGEON DETECTION
-- ============================================================
-- Reuses the mob scan rather than walking the map again. GetNearestMob
-- refreshes the cache when it is stale, so this costs one broadphase
-- query at most, and usually nothing at all.
local function MobsPresent()
    GetNearestMob()
    return #GetMobs() >= 2
end

-- In a dungeon = the lobby UI is gone. Mobs are corroborating evidence,
-- not the test: a cleared room has no mobs but you are still in the run.
local function IsInDungeon()
    if InLobby() then return false end
    -- Back in the lobby place with nothing to fight is not a dungeon,
    -- even when a popup is hiding the lobby's own buttons.
    if InLobbyPlace() and not MobsPresent() then return false end
    return MobsPresent()
end

local function IsInDungeonSafe()
    if not IsInDungeon() then return false end
    S(2) return IsInDungeon()
end

-- ============================================================
--  COMBAT - spells + melee swing
-- ============================================================
local spellSlot   = false
local lastSpell   = 0
local lastMelee   = 0

local function FireKey(kc)
    pcall(function() VIM:SendKeyEvent(true,  kc, false, game) end)
    S(0.05)
    pcall(function() VIM:SendKeyEvent(false, kc, false, game) end)
end

local function DoMelee()
    -- Left click swing - DQR auto-attacks on left mouse
    local now = tick()
    if now - lastMelee < CONFIG.MeleeRate then return end
    lastMelee = now
    task.spawn(function()
        pcall(function()
            -- Aim at screen centre, not (0,0). The camera is pointed at the
            -- mob, so the centre of the viewport is the mob.
            local cam = workspace.CurrentCamera
            local vp  = cam and cam.ViewportSize or Vector2.new(800, 600)
            local x, y = vp.X / 2, vp.Y / 2
            VIM:SendMouseMoveEvent(x, y, game)
            VIM:SendMouseButtonEvent(x, y, 0, true,  game, 0)
            S(0.05)
            VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end)
    end)
end

local function DoSpell(dist)
    if dist > CONFIG.AttackRange then return end
    local now = tick()
    if now - lastSpell < CONFIG.AttackRate then return end
    lastSpell = now
    spellSlot = not spellSlot
    task.spawn(function()
        FireKey(spellSlot and Enum.KeyCode.Q or Enum.KeyCode.E)
    end)
end

-- ============================================================
--  THREAT DETECTION
-- ============================================================
local function ColorIsThreat(c)
    return (c.R > 0.6 and c.G < 0.35 and c.B < 0.35)
        or (c.R > 0.6 and c.G < 0.35 and c.B > 0.5)
        or (c.R > 0.7 and c.G > 0.3  and c.B < 0.1)
end

-- Anything this script spawned into the world. The range bar is red,
-- flat and long, i.e. it matches the telegraph test perfectly - and you
-- stand at one end of it, so without this the bot dodges its own line
-- forever.
local function IsOurs(o)
    return o == RangeBarPart or o.Name:sub(1, 4) == "DQR_"
end

local function ScanThreatsRaw()
    local root = GetRoot()
    if not root then return false, nil end
    for _, obj in ipairs(NearbyParts(root.Position, CONFIG.DodgeRange)) do
        if not IsOurs(obj) then
            if obj.Material == Enum.Material.Neon
            or ColorIsThreat(obj.Color) then
                local vel = obj.AssemblyLinearVelocity
                if vel.Magnitude > 8 then
                    if vel.Unit:Dot(
                        (root.Position - obj.Position).Unit) > 0.55 then
                        return true, obj.Position
                    end
                end
            end
            -- Beams used to be handled here by fleeing the part's centre,
            -- which is wrong for a line: the way out of a laser is
            -- sideways, not backwards. ScanBeams below does it properly.
        end
    end
    return false, nil
end

-- The farm loop and the dodge watcher both poll this at 20Hz. Cache the
-- verdict briefly so the work happens ~10x a second, not 40.
local threatCache = {t = 0, hit = false, pos = nil}
local function ScanThreats()
    local now = tick()
    if now - threatCache.t < CONFIG.ThreatTTL then
        return threatCache.hit, threatCache.pos
    end
    threatCache.t = now
    threatCache.hit, threatCache.pos = ScanThreatsRaw()
    return threatCache.hit, threatCache.pos
end

-- ============================================================
--  GROUND TELEGRAPHS
--  The red strips a boss paints on the floor before it strikes are
--  ANCHORED and STATIONARY, so ScanThreats above - which only reacts
--  to parts moving at you faster than 8 studs/s - is blind to them.
--  These need a different test: am I standing inside the rectangle?
--  If so, leave across its NARROW axis, which is the shortest way out.
-- ============================================================
local function IsTelegraph(o)
    if not o:IsA("BasePart") then return false end
    if IsOurs(o) then return false end
    if o.Transparency > 0.9 then return false end
    local s = o.Size
    if s.Y > CONFIG.TelegraphMaxY then return false end          -- a prop
    if math.max(s.X, s.Z) < CONFIG.TelegraphMinLen then return false end
    local c = o.Color
    return c.R > 0.55 and c.G < 0.45 and c.B < 0.45              -- red-ish
end

-- Returns a world position to run to, or nil when we are standing clear.
local function ScanTelegraphs()
    if not CONFIG.DodgeTelegraph then return nil end
    local root = GetRoot()
    if not root then return nil end
    local char = GetChar()
    local pos  = root.Position

    local worstDepth, escape = 0, nil

    for _, o in ipairs(NearbyParts(pos, CONFIG.DodgeRange)) do
        if IsTelegraph(o) then
            do
                -- Where do we stand in the strip's own axes?
                local rel = o.CFrame:PointToObjectSpace(pos)
                local hx  = o.Size.X / 2 + CONFIG.TelegraphPad
                local hz  = o.Size.Z / 2 + CONFIG.TelegraphPad
                if math.abs(rel.X) < hx and math.abs(rel.Z) < hz
                and math.abs(rel.Y) < 14 then
                    local outX = hx - math.abs(rel.X)  -- cost to leave sideways
                    local outZ = hz - math.abs(rel.Z)  -- cost to leave endwise
                    local depth = math.min(outX, outZ)
                    if depth > worstDepth then
                        local axis, sign
                        if outX <= outZ then
                            axis = o.CFrame:VectorToWorldSpace(Vector3.new(1, 0, 0))
                            sign = rel.X >= 0 and 1 or -1
                        else
                            axis = o.CFrame:VectorToWorldSpace(Vector3.new(0, 0, 1))
                            sign = rel.Z >= 0 and 1 or -1
                        end
                        local d = Vector3.new(axis.X, 0, axis.Z) * sign
                        -- Only accept an exit we can actually walk.
                        local p = SafeStep(pos, d, depth + 4)
                        if p then
                            worstDepth = depth
                            escape = p
                        end
                    end
                end
            end
        end
    end
    return escape
end

-- ============================================================
--  BEAMS / LASERS
--  A beam is a LINE, not a footprint, so neither of the scanners
--  above fits: ScanThreats wants something flying at you, and the
--  telegraph test wants you inside a rectangle. What matters here is
--  perpendicular distance to the line - and the way out of a laser is
--  sideways, never backwards along it.
--
--  Shape is what separates a laser from scenery: a beam is long in
--  EXACTLY ONE axis and thin in the other two. A wall is long in two.
--  That matters in Winter Outpost, where half the map is blue.
-- ============================================================
local function ColorIsBeam(c)
    -- cyan / blue, but not pale blue ice (which has high red too)
    if c.B > 0.5 and c.R < 0.5 and c.G > 0.35 then return true end   -- cyan
    if c.B > 0.55 and c.R < 0.45 and c.G < 0.55 then return true end -- blue
    return false
end

local function IsBeamPart(o)
    if not o:IsA("BasePart") then return false end
    if IsOurs(o) then return false end
    if o.Transparency > 0.9 then return false end

    local s = o.Size
    local long, thin = 0, 0
    for _, d in ipairs({s.X, s.Y, s.Z}) do
        if d >= CONFIG.BeamMinLen   then long = long + 1 end
        if d <= CONFIG.BeamMaxThick then thin = thin + 1 end
    end
    if long ~= 1 or thin < 2 then return false end

    return o.Material == Enum.Material.Neon or ColorIsBeam(o.Color)
end

-- Sideways escape from a line through `c` along `axis`, half-length `half`.
local function EscapeFromLine(pos, c, axis, half, clear)
    local toUs  = pos - c
    local along = toUs:Dot(axis)
    if math.abs(along) > half + CONFIG.BeamPad then return nil end  -- past the end

    local perp = toUs - axis * along
    perp = Vector3.new(perp.X, 0, perp.Z)
    local d = perp.Magnitude
    if d > clear then return nil end

    local out
    if d < 0.1 then
        -- Standing dead on the line: any perpendicular will do.
        out = Vector3.new(-axis.Z, 0, axis.X)
        if out.Magnitude < 0.01 then out = Vector3.new(1, 0, 0) end
    else
        out = perp
    end
    -- Sidestep only somewhere there is actually room to stand.
    return SafeStep(pos, out, clear - d + 4)
end

local function ScanBeams()
    if not CONFIG.DodgeBeams then return nil end
    local root = GetRoot()
    if not root then return nil end
    local char = GetChar()
    local pos  = root.Position

    -- Beam objects hang off nearby parts (or their attachments), so the
    -- spatial query finds them without walking the whole map.
    local near = NearbyParts(pos, CONFIG.DodgeRange * 2)

    for _, host in ipairs(near) do
        for _, c in ipairs(host:GetChildren()) do
            local beam = nil
            if c:IsA("Beam") then
                beam = c
            elseif c:IsA("Attachment") then
                beam = c:FindFirstChildWhichIsA("Beam")
            end
            if beam and beam.Enabled
            and beam.Attachment0 and beam.Attachment1 then
                local a = beam.Attachment0.WorldPosition
                local b = beam.Attachment1.WorldPosition
                local seg = b - a
                if seg.Magnitude > 1 then
                    local esc = EscapeFromLine(pos, (a + b) / 2,
                        seg.Unit, seg.Magnitude / 2, CONFIG.BeamPad)
                    if esc then return esc end
                end
            end
        end
    end

    for _, o in ipairs(near) do
        if IsBeamPart(o) then
            do
                local s = o.Size
                local axis, half
                if s.X >= s.Y and s.X >= s.Z then
                    axis = o.CFrame:VectorToWorldSpace(Vector3.new(1, 0, 0))
                    half = s.X / 2
                elseif s.Y >= s.X and s.Y >= s.Z then
                    axis = o.CFrame:VectorToWorldSpace(Vector3.new(0, 1, 0))
                    half = s.Y / 2
                else
                    axis = o.CFrame:VectorToWorldSpace(Vector3.new(0, 0, 1))
                    half = s.Z / 2
                end
                local esc = EscapeFromLine(pos, o.Position, axis, half,
                    CONFIG.BeamMaxThick / 2 + CONFIG.BeamPad)
                if esc then return esc end
            end
        end
    end
    return nil
end

-- One call for every "get out of the way" test, in priority order.
-- Cached: two 20Hz threads poll this, and re-running both scans 40
-- times a second was a large part of the in-combat lag.
local hazardCache = {t = 0, escape = nil}
local function ScanHazards()
    local now = tick()
    if now - hazardCache.t < CONFIG.HazardTTL then
        return hazardCache.escape
    end
    hazardCache.t = now
    hazardCache.escape = ScanTelegraphs() or ScanBeams()
    return hazardCache.escape
end

-- ============================================================
--  CIRCULAR ORBIT
-- ============================================================
local orbitAngle = 0
local seeded     = false
local lastDodge  = 0
local lastTeleWarn = 0
local lastCrowdWarn = 0
local retreating   = false
local lastStartCheck = 0
local startVisible = false

-- Tracks how long the current target has held position
local stillModel = nil
local stillPos   = Vector3.zero
local stillSince = 0

local function SeedOrbit(mobPos)
    local root = GetRoot()
    if not root then return end
    orbitAngle = math.atan2(
        root.Position.Z - mobPos.Z,
        root.Position.X - mobPos.X)
    seeded = true
end

local function GetOrbitPos(mobPos, radius)
    return Vector3.new(
        mobPos.X + math.cos(orbitAngle) * radius,
        mobPos.Y,
        mobPos.Z + math.sin(orbitAngle) * radius)
end

local function AngleTo(mobPos, radius, a)
    return Vector3.new(mobPos.X + math.cos(a) * radius, mobPos.Y,
                       mobPos.Z + math.sin(a) * radius)
end

-- ============================================================
--  CROWD HANDLING
--  Orbiting was computed blind: advance an angle around the target and
--  walk there, with no idea what else was standing in the way. With a
--  pack chasing you that walks straight through the mobs beside the
--  one being hit, which is free damage taken for nothing.
-- ============================================================

-- Mobs within `radius` of `pos`, and where the pack's centre is.
local function Crowd(pos, radius)
    local list, sum, n = {}, Vector3.zero, 0
    for _, m in ipairs(GetMobs()) do
        if m.Root and m.Root.Parent then
            local d = (m.Root.Position - pos).Magnitude
            if d < radius then
                list[#list + 1] = m
                sum = sum + m.Root.Position
                n = n + 1
            end
        end
    end
    if n == 0 then return list, nil end
    return list, sum / n
end

-- Instead of taking whatever angle the orbit reached, sample around the
-- target and pick the spot that keeps the most room from OTHER mobs,
-- while still preferring to keep circling the way we already were.
local function BestOrbitAngle(mobPos, radius, targetModel, pos, natural)
    local mobs = GetMobs()
    local bestA, bestScore = natural, -math.huge

    for i = 0, 11 do
        local a = natural + (i * math.pi / 6)
        local p = AngleTo(mobPos, radius, a)
        local score = 0

        for _, m in ipairs(mobs) do
            if m.Model ~= targetModel and m.Root and m.Root.Parent then
                local d = (m.Root.Position - p).Magnitude
                if d < CONFIG.MobAvoidRadius then
                    -- The closer that spot puts us to another mob, the worse
                    score = score - (CONFIG.MobAvoidRadius - d) * 3
                end
            end
        end

        -- Prefer continuing the current direction over teleport-jumping
        -- the orbit across the mob, which looks and plays badly.
        score = score - i * 1.5

        -- And prefer somewhere we can actually walk to.
        if not LineClear(pos, p) then score = score - 25 end

        if score > bestScore then bestA, bestScore = a, score end
    end
    return bestA
end

-- ============================================================
--  MAIN FARM LOOP
-- ============================================================
local Farm = {Running = false, Thread = nil, DodgeThread = nil}
local lastFrame = tick()
local currentDest = nil

local function MainLoop()
    seeded = false
    lastFrame = tick()

    -- Start movement engine - reads currentDest every heartbeat
    StartMoving(function() return currentDest end)

    while Farm.Running do
        local now = tick()
        local dt  = math.min(now - lastFrame, 0.1)
        lastFrame = now

        local root  = GetRoot()
        local human = GetHuman()

        if not root or not human or human.Health <= 0 then
            currentDest = nil
            ClearRangeBar()
            StopFacing()
            S(0.5)
            continue
        end

        -- The run has not begun while START is still on screen. Dungeon
        -- Quest freezes players until then, so trying to walk just spams
        -- the stuck detector. Stand still and let StartWatcher press it.
        -- Throttled: AnyVisible walks all of PlayerGui, which is far too
        -- expensive to do 20 times a second.
        if now - lastStartCheck > 1 then
            lastStartCheck = now
            startVisible = (not InLobby())
                and (AnyVisible({{text = "start"}}) ~= nil)
        end
        if startVisible then
            currentDest = nil
            ClearRangeBar()
            S(0.5)
            continue
        end

        local target = GetNearestMob()

        if not target then
            currentDest = nil
            ClearRangeBar()
            StopFacing()
            seeded = false
            S(CONFIG.ScanRate)
            continue
        end

        local mobPos = target.Root.Position
        local dist   = target.Distance
        pathTargetModel = target.Model   -- so the path worker can blacklist it

        -- Positioning uses HORIZONTAL distance. target.Distance is 3D, so
        -- a mob standing on a ledge above reads as far away even when it
        -- is right on top of us - which flipped the range checks on and
        -- off and made the bot pace back and forth under the ledge.
        local flat = (Vector3.new(mobPos.X, 0, mobPos.Z)
                    - Vector3.new(root.Position.X, 0, root.Position.Z)).Magnitude

        -- Always face mob
        if not faceTarget then
            StartFacing(function()
                local t = GetNearestMob()
                return t and t.Root.Position or nil
            end)
        end

        -- MELEE when very close
        if dist <= CONFIG.MeleeRange then
            DoMelee()
        end

        -- SPELLS when in range
        DoSpell(dist)

        -- Seed orbit on new target
        if not seeded then SeedOrbit(mobPos) end

        -- Standing in a telegraphed strip beats every other movement:
        -- there is no point orbiting prettily inside the damage zone.
        local escape = ScanHazards()
        if escape then
            currentDest = Vector3.new(escape.X, root.Position.Y, escape.Z)
            ShowRangeBar(root, mobPos, dist)
            if now - lastTeleWarn > 2 then
                lastTeleWarn = now
                print("[DQR] In a hazard (telegraph/beam) - moving clear.")
            end
            S(CONFIG.ScanRate)
            continue
        end

        -- Dodge - highest movement priority
        local threatened, tOrigin = ScanThreats()
        if threatened and (now - lastDodge) > CONFIG.DodgeCooldown then
            lastDodge = now
            local toward = Vector3.new(
                tOrigin.X - root.Position.X, 0,
                tOrigin.Z - root.Position.Z).Unit
            local perp = Vector3.new(-toward.Z, 0, toward.X)
            local sign = math.cos(orbitAngle) > 0 and 1 or -1
            -- Try the preferred side, then the other, then give up and
            -- keep fighting rather than reverse into a wall.
            local dodge = SafeStep(root.Position, perp * sign, CONFIG.DodgeStep)
                       or SafeStep(root.Position, perp * -sign, CONFIG.DodgeStep)
            if dodge then
                currentDest = dodge
                ShowRangeBar(root, mobPos, dist)
                orbitAngle = orbitAngle + sign * 0.5
                S(CONFIG.ScanRate)
                continue
            end
        end

        -- Inside our own standoff: walk straight back out. The orbit
        -- radius nudge alone (1.25x) was far too gentle - it left the
        -- bot sitting inside the mob's swing arc taking hits while it
        -- slowly drifted outward. Melee keeps firing while retreating,
        -- because DoMelee was already called above on this frame.
        -- Deadband, or it flips between retreating and advancing on
        -- every frame while hovering right at MinRange.
        if retreating then
            if flat >= CONFIG.CircleRadius * 0.95 then retreating = false end
        elseif flat < CONFIG.MinRange then
            retreating = true
        end

        if retreating then
            local away = Vector3.new(root.Position.X - mobPos.X, 0,
                                     root.Position.Z - mobPos.Z)
            if away.Magnitude < 0.5 then
                local b = root.CFrame.LookVector * -1
                away = Vector3.new(b.X, 0, b.Z)
            end
            if away.Magnitude > 0.01 then
                -- Back off only where there is room. If we are against a
                -- wall, stop retreating and fight instead of grinding
                -- into it - otherwise the mob pins us there.
                local spot = SafeStep(root.Position, away,
                                      CONFIG.CircleRadius - flat)
                if spot then
                    currentDest = spot
                    ShowRangeBar(root, mobPos, dist)
                    S(CONFIG.ScanRate)
                    continue
                end
                retreating = false
            end
        end

        -- Mob not moving and we are already in range? Stop shuffling and
        -- just hit it. Orbiting a stationary target only costs uptime.
        if target.Model == stillModel then
            if (mobPos - stillPos).Magnitude > CONFIG.MobMoveEps then
                stillPos, stillSince = mobPos, now
            end
        else
            stillModel, stillPos, stillSince = target.Model, mobPos, now
        end

        -- Only hold once we are actually AT the fighting distance.
        -- Allowing anything inside MaxRange meant the bot could park
        -- itself 20+ studs out - on an obstacle, say - and stand there
        -- "holding" while the mob walked over and hit it.
        if CONFIG.HoldWhenStill
        and (now - stillSince) > CONFIG.MobStillTime
        and flat <= CONFIG.CircleRadius * 1.3 then
            currentDest = nil          -- stand still, keep attacking
            ShowRangeBar(root, mobPos, dist)
            S(CONFIG.ScanRate)
            continue
        end

        -- Surrounded? Then orbiting is the wrong idea entirely - any
        -- circle around one mob runs through the others. Back out to the
        -- edge of the pack and fight from there instead.
        if CONFIG.AvoidOtherMobs then
            local pack, centre = Crowd(root.Position, CONFIG.CrowdRadius)
            if centre and #pack >= CONFIG.CrowdCount then
                local away = Vector3.new(root.Position.X - centre.X, 0,
                                         root.Position.Z - centre.Z)
                if away.Magnitude < 0.5 then
                    -- Dead centre of the pack: any way out will do.
                    away = root.CFrame.LookVector * -1
                    away = Vector3.new(away.X, 0, away.Z)
                end
                if away.Magnitude > 0.01 then
                    local standoff = math.max(CONFIG.CircleRadius,
                                              CONFIG.MobAvoidRadius)
                    local fromCentre = (Vector3.new(root.Position.X, 0, root.Position.Z)
                                      - Vector3.new(centre.X, 0, centre.Z)).Magnitude
                    local spot = SafeStep(root.Position, away,
                                          standoff - fromCentre)
                    if spot then
                        currentDest = spot
                        ShowRangeBar(root, mobPos, dist)
                        if now - lastCrowdWarn > 3 then
                            lastCrowdWarn = now
                            print(("[DQR] %d mobs on me - backing to the edge.")
                                :format(#pack))
                        end
                        S(CONFIG.ScanRate)
                        continue
                    end
                    if now - lastCrowdWarn > 3 then
                        lastCrowdWarn = now
                        print("[DQR] Surrounded with nowhere to back into "
                            .. "- standing and fighting.")
                    end
                end
            end
        end

        -- Advance orbit
        orbitAngle = orbitAngle + CONFIG.CircleSpeed * dt
        if orbitAngle > math.pi * 2 then
            orbitAngle = orbitAngle - math.pi * 2
        end

        -- Closing in from far away: aim a little inside the standoff so
        -- we actually arrive at it. Being too CLOSE is handled by the
        -- retreat branch above, which exits before reaching here.
        local radius = CONFIG.CircleRadius
        if flat > CONFIG.MaxRange then
            radius = CONFIG.CircleRadius * 0.85
        end

        -- Keep the orbit point's own Y (the mob's ground level). This
        -- used to be forced to root.Position.Y, a leftover from the
        -- CFrame-teleport days. On a hilly map that put the pathfinding
        -- goal at OUR elevation - floating above the mob or buried
        -- inside a mountain - so ComputeAsync returned NoPath every time
        -- and the bot fell back to walking straight into the slope.
        -- Pick the orbit spot with the most clearance from other mobs
        -- rather than blindly taking wherever the angle landed.
        if CONFIG.AvoidOtherMobs then
            orbitAngle = BestOrbitAngle(mobPos, radius, target.Model,
                                        root.Position, orbitAngle)
        end

        currentDest = GetOrbitPos(mobPos, radius)
        ShowRangeBar(root, mobPos, dist)

        S(CONFIG.ScanRate)
    end

    currentDest = nil
    StopMoving()
    StopFacing()
    ClearRangeBar()
end

-- ============================================================
--  DODGE WATCHER 20hz
-- ============================================================
local function DodgeWatcher()
    local lastDW = 0
    while Farm.Running do
        S(0.05)
        local root  = GetRoot()
        local human = GetHuman()
        if not root then continue end
        if human and human.Health <= 0 then
            currentDest = nil
            continue
        end

        -- Telegraphs and beams first: being in one is damage incoming.
        local esc = ScanHazards()
        if esc then
            currentDest = Vector3.new(esc.X, root.Position.Y, esc.Z)
            continue
        end

        local ok, origin = ScanThreats()
        local now = tick()
        if ok and (now - lastDW) > CONFIG.DodgeCooldown then
            lastDW = now
            local toward = Vector3.new(
                origin.X - root.Position.X, 0,
                origin.Z - root.Position.Z).Unit
            local perp = Vector3.new(-toward.Z, 0, toward.X)
            local sign = math.cos(orbitAngle) > 0 and 1 or -1
            currentDest =
                   SafeStep(root.Position, perp * sign,  CONFIG.DodgeStep)
                or SafeStep(root.Position, perp * -sign, CONFIG.DodgeStep)
                or currentDest
        end
    end
end

-- ============================================================
--  LOCAL VANITY  (name / level on your own screen only)
--
--  Purely a client-side redraw. The server, every other player and
--  your save file all still see the real values - nothing here sends
--  anything anywhere. The game rewrites these labels constantly, so
--  it has to be re-applied on a loop rather than set once.
-- ============================================================
local spoofSeen = {}

local function CurrentLevel()
    local ls = LP:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            local n = v.Name:lower()
            if (n:find("level") or n:find("lvl")) and v:IsA("ValueBase") then
                return tostring(v.Value)
            end
        end
    end
    for _, n in ipairs({"Level", "level", "Lvl"}) do
        local v = LP:FindFirstChild(n)
        if v and v:IsA("ValueBase") then return tostring(v.Value) end
    end
    return nil
end

local function SpoofPass()
    local real = LP.Name
    local disp = LP.DisplayName
    local lvl  = CurrentLevel()

    local roots = {}
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if pg then roots[#roots + 1] = pg end
    local ch = GetChar()
    if ch then roots[#roots + 1] = ch end

    for _, r in ipairs(roots) do
        for _, o in ipairs(r:GetDescendants()) do
            if (o:IsA("TextLabel") or o:IsA("TextButton"))
            and not (LogGui and o:IsDescendantOf(LogGui)) then
                pcall(function()
                    local t = o.Text
                    if t == "" then return end

                    if CONFIG.SpoofName then
                        if t == real or t == disp then
                            o.Text = CONFIG.FakeName
                        elseif t:find(real, 1, true) then
                            o.Text = t:gsub(
                                (real:gsub("%W", "%%%0")), CONFIG.FakeName)
                        end
                    end

                    if CONFIG.SpoofLevel and t:match("^%d+$") then
                        local nm = o.Name:lower()
                        local pn = (o.Parent and o.Parent.Name or ""):lower()
                        local named = nm:find("level") or nm:find("lvl")
                                   or pn:find("level") or pn:find("lvl")
                        -- Matching the real level value catches the labels
                        -- that are not helpfully named.
                        if named or (lvl and t == lvl) then
                            o.Text = CONFIG.FakeLevel
                            local path = o:GetFullName()
                            if not spoofSeen[path] then
                                spoofSeen[path] = true
                                print("[DQR] Level label: " .. path)
                            end
                        end
                    end
                end)
            end
        end
    end
end

local function VanityWatcher()
    while true do
        S(0.5)
        if CONFIG.SpoofName or CONFIG.SpoofLevel then pcall(SpoofPass) end
        if CONFIG.HideArmour then pcall(HideArmour, GetChar()) end
    end
end

-- ============================================================
--  START / STOP
-- ============================================================
function Farm.Start()
    if Farm.Running then return end
    Farm.Running     = true
    Farm.Thread      = task.spawn(MainLoop)
    Farm.DodgeThread = task.spawn(DodgeWatcher)
    print("[DQR] Farm started.")
end

function Farm.Stop()
    Farm.Running = false
    currentDest  = nil
    StopMoving()
    StopFacing()
    ClearRangeBar()
    print("[DQR] Farm stopped.")
end

LP.CharacterAdded:Connect(function()
    S(2)
    pcall(HideArmour, GetChar())
    if Farm.Running then
        Farm.Stop() S(0.5) Farm.Start()
    end
end)

-- ============================================================
--  DUNGEON COMPLETE WATCHER
-- ============================================================
-- ============================================================
--  IN-DUNGEON START BUTTON
--  The dungeon is a separate place, so its GUI is not in the lobby
--  dump and has no known path. Match it by exact text instead:
--  "START" normalises to "start", and the lobby's own start button
--  can't be confused with it because this only runs outside the lobby.
-- ============================================================
local function StartWatcher()
    while true do
        S(1.5)
        if not InLobby() then
            local b = AnyVisible({
                {text = "start"}, {text = "startdungeon"},
                {name = "startbutton"},
            })
            if b then
                print("[DQR] In-dungeon START visible - clicking.")
                ClickButton(b)
                S(2)
            end
        end
    end
end

-- Only job: notice the run has ended and stop farming. Everything about
-- what to do next belongs to Supervisor, which runs whether or not the
-- farm is going. The old version did both here behind
-- `if not Farm.Running then continue end`, so the moment it stopped the
-- farm it disabled itself permanently - which is why a failed dungeon
-- left the script sitting in the lobby doing nothing.
local function DungeonWatcher()
    local quiet = 0
    while true do
        S(3)
        if not Farm.Running then quiet = 0 continue end

        -- The reliable "run is over" signal is the lobby coming back,
        -- fail screen included. Absence of mobs is not: that happens
        -- constantly between rooms.
        if InLobby() then
            print("[DQR] Lobby is up - run over, stopping farm.")
            Farm.Stop()
            quiet = 0
            continue
        end

        if GetNearestMob() then
            quiet = 0
        else
            quiet = quiet + 1
            if quiet == 40 then   -- 2 minutes
                print("[DQR] No mobs for 2 min and no lobby - still waiting.")
            end
        end
    end
end

-- ============================================================
--  SUPERVISOR
--  Runs forever, farm or no farm. Whenever we are idle it works out
--  where we actually are and gets things moving again, so no single
--  failed transition can park the script for good.
-- ============================================================
local function Supervisor()
    local idleSince, reported = tick(), false
    while true do
        S(4)

        if Farm.Running or lobbyFlowActive then
            idleSince, reported = tick(), false
            continue
        end

        -- End-of-run screen: one click beats redriving the queue flow.
        local replay = PathVisible(UI.Replay)
        if replay and CONFIG.AutoRunDungeon then
            print("[DQR] Replay Dungeon available - clicking it.")
            ClickButton(replay)
            local t = 0
            repeat S(2) t = t + 2 until IsInDungeon() or t > 60
            if IsInDungeon() then Farm.Start() end
            idleSince, reported = tick(), false
            continue
        end

        if InLobby() then
            if CONFIG.AutoRunDungeon then
                print("[DQR] Idle in the lobby - queueing a run.")
                RunLobbyFlow()
                local t = 0
                repeat S(2) t = t + 2 until IsInDungeon() or t > 90
                if IsInDungeon() then Farm.Start() end
                idleSince, reported = tick(), false
            end
            continue
        end

        -- Not the lobby and not farming: we are somewhere worth fighting.
        if not InLobbyPlace() or MobsPresent() then
            print("[DQR] Idle outside the lobby - resuming farm.")
            Farm.Start()
            idleSince, reported = tick(), false
            continue
        end

        -- In the lobby place, but no lobby UI we recognise. Say so once,
        -- with the evidence, rather than sitting silent.
        if tick() - idleSince > 20 and not reported then
            reported = true
            print(("[DQR] Idle and unsure. InLobby=%s InLobbyPlace=%s mobs=%s")
                :format(tostring(InLobby()), tostring(InLobbyPlace()),
                        tostring(MobsPresent())))
            print("[DQR] Dumping buttons so this state can be identified.")
            DumpGui()
        end
    end
end

-- Defined down here so its output goes through the log window.
local function ApplyClass()
    local want = tostring(CONFIG.Class or "")
    if want == "" then
        print("[DQR] Class unset - using the hand-tuned distances.")
        return
    end

    local name, prof
    for k, v in pairs(CLASS_RANGES) do
        if k:lower() == want:lower() then name, prof = k, v break end
    end

    if not prof then
        name, prof = "Warrior", CLASS_RANGES.Warrior
        print("[DQR] Unknown Class '" .. want .. "' - falling back to Warrior.")
    end

    for k, v in pairs(prof) do CONFIG[k] = v end
    print(("[DQR] Class %s: orbit %d, melee under %d, spells under %d.")
        :format(name, prof.CircleRadius, prof.MeleeRange, prof.AttackRange))

    -- These have an ordering requirement that is easy to break by hand,
    -- and both failure modes look like "the bot is behaving oddly"
    -- rather than pointing at the numbers.
    if CONFIG.MinRange >= CONFIG.CircleRadius then
        print(("[DQR] WARNING: MinRange (%d) >= CircleRadius (%d) - the bot "
            .. "will think it is too close the moment it arrives and "
            .. "retreat forever."):format(CONFIG.MinRange, CONFIG.CircleRadius))
    end
    if CONFIG.CircleRadius >= CONFIG.MeleeRange then
        print(("[DQR] WARNING: CircleRadius (%d) >= MeleeRange (%d) - it will "
            .. "hold station outside its own swing and never melee.")
            :format(CONFIG.CircleRadius, CONFIG.MeleeRange))
    end
    if CONFIG.MaxRange <= CONFIG.CircleRadius then
        print("[DQR] WARNING: MaxRange should be well above CircleRadius.")
    end
end

