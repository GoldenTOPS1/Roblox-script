-- The executor's HTTP function, under whichever name it uses. The
-- game's own HttpService cannot be used from a client.
local function HttpRequest(opts)
    for _, name in ipairs({"request", "http_request"}) do
        local fn = Env(name)
        if typeof(fn) == "function" then
            local ok, res = pcall(fn, opts)
            if ok then return res end
            return nil, tostring(res)
        end
    end
    for _, ns in ipairs({"syn", "http", "fluxus"}) do
        local t = Env(ns)
        if typeof(t) == "table" and typeof(t.request) == "function" then
            local ok, res = pcall(t.request, opts)
            if ok then return res end
            return nil, tostring(res)
        end
    end
    return nil, "this executor has no request function"
end

-- Every GUI object actually on screen, at any depth, as a set. Walks
-- down from each enabled ScreenGui and stops at the first invisible
-- frame, since nothing under one can show - far cheaper than testing
-- every descendant's ancestry. Our own log window is left out.
local function VisibleSet()
    local out = {}
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return out end
    local function Walk(o)
        for _, c in ipairs(o:GetChildren()) do
            if c:IsA("GuiObject") then
                if c.Visible and c.AbsoluteSize.X >= 1 then
                    out[c] = true
                    Walk(c)
                end
            else
                Walk(c)
            end
        end
    end
    for _, sg in ipairs(pg:GetChildren()) do
        if sg:IsA("ScreenGui") and sg.Enabled and sg ~= LogGui then Walk(sg) end
    end
    return out
end

-- The Dungeon Quest reward panel, as dumped on 2026-09-21:
--   rewardGuiHolder.holder
--     reward            slot background (x one per item)
--       glow            ImageLabel tinted with the item's rarity colour
--       itemPicture     ImageLabel: the item's icon
--   rewardGuiHolder.Frame.Gold   the gold earned
-- No name labels anywhere, so names cannot be reported; the glow's
-- tint is read as the rarity instead. Returns one record per item.
-- Dungeon Quest's tiers, by colour: Common grey, Uncommon green, Rare
-- blue, Epic purple, Legendary yellow, Ultimate red.
local function ItemSlots(panel)
    local function Rarity(c)
        if not c then return nil end
        local h, s = c:ToHSV()
        if s < 0.25 then return "Common" end          -- grey
        if h < 0.04 or h > 0.93 then return "Ultimate" end  -- red
        if h < 0.2 then return "Legendary" end        -- yellow / orange
        if h < 0.47 then return "Uncommon" end        -- green
        if h < 0.72 then return "Rare" end            -- blue
        return "Epic"                                 -- purple
    end
    local items = {}
    for _, o in ipairs(panel:GetDescendants()) do
        if o.Name == "itemPicture"
        and (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.Image ~= "" then
            local img = tostring(o.Image)
            local id = img:match("id=(%d+)") or img:match("(%d+)%s*$")
            if id then
                local glow = o.Parent and o.Parent:FindFirstChild("glow")
                local col = glow and glow:IsA("ImageLabel") and glow.ImageColor3 or nil
                items[#items + 1] = {id = id, color = col, rarity = Rarity(col)}
            end
        end
    end
    return items
end

-- The candidates for the reward panel, best first: whatever is on
-- screen now that was NOT on screen during the fight (`during`, the
-- set the watcher collected), grouped under the nearest ancestor that
-- WAS - because the panel is either a frame that just appeared, or an
-- old frame that just had its item slots cloned into it - scored by
-- how many item slots each group holds. Looking only at a ScreenGui's
-- direct children missed a panel nested inside an always-on container.
local function LootCandidates(during)
    -- The lobby's own GUIs are hidden during a run and back
    -- afterwards, so they read as "new" too - and the main menu is
    -- full of icons.
    local lobbyGuis = {introGui = true, mainInterface = true, queueGui = true,
                       friendsList = true, leaderboard = true}
    local vis = VisibleSet()
    -- Item slots under a frame: 3D previews and pictures, on screen.
    local function SlotCount(frame)
        local n = 0
        for _, o in ipairs(frame:GetDescendants()) do
            if vis[o] and (o:IsA("ViewportFrame")
               or ((o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.Image ~= "")) then
                n = n + 1
            end
        end
        return n
    end
    local roots, byParent = {}, {}
    for o in pairs(vis) do
        if not (during and during[o]) then
            local p = o.Parent
            local parentNew = p and p:IsA("GuiObject") and vis[p]
                              and not (during and during[p])
            if not parentNew then
                local sg = o
                while sg and not sg:IsA("ScreenGui") do sg = sg.Parent end
                if sg and not lobbyGuis[sg.Name] then
                    roots[#roots + 1] = o
                    if p and p:IsA("GuiObject") then
                        byParent[p] = (byParent[p] or 0) + 1
                    end
                end
            end
        end
    end
    -- Several new siblings under one old frame: that frame is the
    -- panel. A lone new frame is the panel itself.
    local cands, seen = {}, {}
    for _, o in ipairs(roots) do
        local p = o.Parent
        local frame = (p and byParent[p] and byParent[p] >= 2) and p or o
        if not seen[frame] then
            seen[frame] = true
            cands[#cands + 1] = {frame = frame, slots = SlotCount(frame)}
        end
    end
    table.sort(cands, function(a, b) return a.slots > b.slots end)
    return cands
end

local function FindLootPanel(during)
    if CONFIG.LootPanelPath and #CONFIG.LootPanelPath > 0 then
        return PathVisible(CONFIG.LootPanelPath)
    end
    local c = LootCandidates(during)[1]
    if c and c.slots >= 2 then return c.frame end   -- one slot is a button icon
    return nil
end

-- Everything on the panel worth reporting: distinct icon asset ids,
-- distinct bits of text, and how many 3D previews there were. Our own
-- name is left out of the text.
local function CollectLoot(panel)
    local icons, names, seen, viewports = {}, {}, {}, 0
    local me1, me2 = LP.Name:lower(), LP.DisplayName:lower()
    for _, o in ipairs(panel:GetDescendants()) do
        if (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.Image ~= "" then
            local img = tostring(o.Image)
            local id = img:match("id=(%d+)") or img:match("(%d+)%s*$")
            if id and not seen["i" .. id] then
                seen["i" .. id] = true
                icons[#icons + 1] = id
            end
        elseif o:IsA("ViewportFrame") then
            viewports = viewports + 1
        elseif o:IsA("TextLabel") or o:IsA("TextButton") then
            local t = o.Text:gsub("^%s+", ""):gsub("%s+$", "")
            local lt = t:lower()
            if #t > 1 and t:find("%a")
            and not lt:find(me1, 1, true) and not lt:find(me2, 1, true)
            and not seen["t" .. t] then
                seen["t" .. t] = true
                names[#names + 1] = t
            end
        end
    end
    return icons, names, viewports
end

-- Post the panel's contents. With no panel, posts a test message so
-- the URL can be checked without finishing a run.
function ReportLoot(panel)
    local url = CONFIG.DiscordWebhook
    if type(url) ~= "string" or not url:find("^https://") then
        print("[DQR] Loot: no webhook URL set.")
        return false
    end
    local HttpS = game:GetService("HttpService")
    local icons, names, viewports = {}, {}, 0
    local items, color = {}, nil
    local dropped, hidden = 0, 0
    if panel then
        items = ItemSlots(panel)
        dropped = #items

        -- Rarity filter. An item whose rarity could not be read is
        -- kept: a colour the script does not recognise should never
        -- silently swallow a drop.
        if dropped > 0 and type(CONFIG.LootRarities) == "table" then
            local keep = {}
            for _, it in ipairs(items) do
                local want = CONFIG.LootRarities[it.rarity or ""]
                if want == nil then want = true end
                if want then
                    keep[#keep + 1] = it
                else
                    hidden = hidden + 1
                end
            end
            items = keep
        end

        if dropped > 0 then
            -- One embed per item, so each picture carries its own
            -- rarity: a merged gallery puts every icon in one block
            -- with a single caption above it, and there is then no way
            -- to tell which of three items was the Epic one.
            for _, it in ipairs(items) do
                icons[#icons + 1] = it.id
                local c = it.color
                if c and not color then
                    color = math.floor(c.R * 255) * 65536
                          + math.floor(c.G * 255) * 256 + math.floor(c.B * 255)
                end
            end
            -- The gold (and anything else with a number) shown beside
            -- the items, in rewardGuiHolder.Frame.
            local side = panel.Parent and panel.Parent:FindFirstChild("Frame")
            if side then
                local seen = {}
                for _, o in ipairs(side:GetDescendants()) do
                    if o:IsA("TextLabel") and o.Text:find("%d") and not seen[o.Text] then
                        seen[o.Text] = true
                        local label = o.Parent and o.Parent.Name or "Reward"
                        names[#names + 1] = ("%s: %s"):format(label, o.Text)
                        if #names > 12 then break end
                    end
                end
            end
        else
            icons, names, viewports = CollectLoot(panel)
        end
    end

    -- Everything that dropped was a rarity you have switched off.
    -- Bail before the thumbnail lookup and the post: that is the whole
    -- point of the filter, and it keeps the channel for real drops.
    if panel and dropped > 0 and #items == 0 and not CONFIG.LootPostIfEmpty then
        print(("[DQR] Loot: %d item(s) dropped, all filtered out by "
            .. "LootRarities - not posting."):format(hidden))
        return true
    end

    -- Asset id -> a CDN picture URL Discord can fetch. The thumbnail
    -- API answers for decals and images alike; the older
    -- asset-thumbnail endpoint is the fallback if it does not.
    local thumbs = {}
    if #icons > 0 then
        local res = HttpRequest({
            Url = "https://thumbnails.roblox.com/v1/assets?assetIds="
                .. table.concat(icons, ",") .. "&size=420x420&format=Png",
            Method = "GET",
        })
        if res and res.Body then
            local ok, data = pcall(function() return HttpS:JSONDecode(res.Body) end)
            if ok and type(data) == "table" and type(data.data) == "table" then
                for _, e in ipairs(data.data) do
                    if e.imageUrl and e.imageUrl ~= "" then
                        thumbs[tostring(e.targetId)] = e.imageUrl
                    end
                end
            end
        end
        for _, id in ipairs(icons) do
            if not thumbs[id] then
                thumbs[id] = "https://www.roblox.com/asset-thumbnail/image?assetId="
                    .. id .. "&width=420&height=420&format=png"
            end
        end
    end

    local desc = {}
    if panel then
        if #items > 0 then
            desc[#desc + 1] = ("**%d item%s**%s"):format(
                #items, #items == 1 and "" or "s",
                hidden > 0 and (" *(%d hidden by the rarity filter)*"):format(hidden) or "")
        elseif hidden > 0 then
            desc[#desc + 1] = ("*%d item%s dropped, all below your rarity filter.*")
                :format(hidden, hidden == 1 and "" or "s")
        end
        if #names > 0 then
            desc[#desc + 1] = table.concat(names, "\n")
        elseif dropped == 0 then
            desc[#desc + 1] = "(nothing readable on the panel - press F10 on the reward screen)"
        end
        if viewports > 0 and #icons == 0 then
            desc[#desc + 1] = ("(%d item icon(s) are 3D previews - no picture possible)")
                :format(viewports)
        end
    else
        desc[#desc + 1] = "Webhook test from DQR - the URL works."
    end

    local title = panel
        and ("Dungeon complete - %s (%s)"):format(CONFIG.TargetDungeon, CONFIG.Difficulty)
        or "DQR webhook test"
    -- A header embed, then one per item. Deliberately NOT sharing a
    -- `url`: embeds that do are merged into a single gallery, and a
    -- gallery has one caption for all of its pictures.
    local embeds = {{
        title = title,
        description = table.concat(desc, "\n"),
        color = color or 5763719,
    }}
    for i, it in ipairs(items) do
        if i > 9 then break end          -- Discord allows ten embeds
        local c = it.color
        local hex = c and ("#%02X%02X%02X"):format(c.R * 255, c.G * 255, c.B * 255)
                      or "?"
        embeds[#embeds + 1] = {
            title = ("%d.  %s"):format(i, it.rarity or "Unknown rarity"),
            description = hex,
            color = c and (math.floor(c.R * 255) * 65536
                         + math.floor(c.G * 255) * 256
                         + math.floor(c.B * 255)) or 5763719,
            image = thumbs[it.id] and {url = thumbs[it.id]} or nil,
        }
    end
    -- The fallback scan has no per-item rarity, only a pile of icons.
    if #items == 0 then
        for i = 1, math.min(#icons, 4) do
            embeds[#embeds + 1] = {image = {url = thumbs[icons[i]]}}
        end
    end
    embeds[#embeds].footer = {text = os.date("%Y-%m-%d %H:%M:%S") .. "  -  DQR"}

    local body = HttpS:JSONEncode({username = "DQR", embeds = embeds})
    local res, err = HttpRequest({
        Url = url, Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = body,
    })
    if not res then
        print("[DQR] Loot post failed: " .. tostring(err))
        return false
    end
    local code = res.StatusCode or res.Status or "?"
    print(("[DQR] Loot posted (%s): %d item(s) shown, %d hidden, %d icon(s), %d preview(s).")
        :format(tostring(code), #items, hidden, #icons, viewports))
    return true
end

-- Frames seen on screen while the farm was running: whatever is up
-- at the end and NOT in here is new, and the reward panel is new.
local during = {}

-- F10: every frame on screen with its slot count and whether it was
-- up during the fight, then the contents of the one the scan would
-- choose. Run it on the reward screen; if it picks the wrong frame,
-- the right one's path goes in LootPanelPath.
function LootDump()
    print("[DQR] === NEW SINCE THE FIGHT (best first) ===")
    local cands = LootCandidates(during)
    for i, c in ipairs(cands) do
        if i > 15 then break end
        print(("%s | slots=%d"):format(c.frame:GetFullName(), c.slots))
    end
    if #cands == 0 then
        print("[DQR] Nothing on screen is new since the fight.")
    end
    local panel = FindLootPanel(during)
    if not panel then
        print("[DQR] No candidate has 2+ item slots, so none qualifies as the reward panel.")
        return
    end
    print("[DQR] === LOOT PANEL: " .. panel:GetFullName() .. " ===")
    for i, it in ipairs(ItemSlots(panel)) do
        local c = it.color
        print(("[Item %d] icon=%s rarity=%s glow=%s"):format(i, it.id,
            tostring(it.rarity),
            c and ("#%02X%02X%02X"):format(c.R * 255, c.G * 255, c.B * 255) or "none"))
    end
    for _, o in ipairs(panel:GetDescendants()) do
        local extra = ""
        if o:IsA("TextLabel") or o:IsA("TextButton") then
            extra = " text='" .. o.Text .. "'"
        elseif o:IsA("ImageLabel") or o:IsA("ImageButton") then
            extra = " image=" .. o.Image
        elseif o:IsA("ViewportFrame") then
            extra = " (3D preview)"
        end
        if extra ~= "" then
            print(("%s | %s | visible=%s%s"):format(
                o:GetFullName():sub(#panel:GetFullName() + 2), o.ClassName,
                tostring(o:IsA("GuiObject") and VisibleOnScreen(o)), extra))
        end
    end
    print("[DQR] === END LOOT PANEL ===")
end

-- While there is something to fight, remembers what is on screen.
-- The moment there is not - the last mob is down - looks for a frame
-- that is new since, with item slots on it, and posts it. Recording
-- used to run for as long as the FARM was running, but the reward
-- panel comes up before the farm notices the lobby is back, so it
-- was recorded as "seen during the fight" and then ruled out.
function LootWatcher()
    local ran, stoppedAt, warned = false, 0, false
    while true do
        S(0.5)
        local fighting = Farm.Running and Brain.target ~= nil
        if fighting then
            if not ran then
                during, warned = {}, false
                if CONFIG.DiscordWebhook == "" then
                    print("[DQR] Loot: DiscordWebhook is empty - nothing will be posted.")
                end
            end
            ran, stoppedAt = true, 0
            for o in pairs(VisibleSet()) do during[o] = true end
        elseif ran then
            if stoppedAt == 0 then
                stoppedAt = tick()
                print("[DQR] Loot: fighting stopped - watching for the reward panel.")
            end
            if tick() - stoppedAt > 45 then
                -- Give up rather than mistake some later menu for it,
                -- and say what was there so the path can be set.
                ran = false
                print("[DQR] Loot: no reward panel found in 45s. New since the fight now:")
                for i, c in ipairs(LootCandidates(during)) do
                    if i > 15 then break end
                    print(("  %s | slots=%d"):format(c.frame:GetFullName(), c.slots))
                end
            elseif CONFIG.DiscordWebhook ~= "" then
                local ok, panel = pcall(FindLootPanel, during)
                -- `holder` is on screen the whole run; the item slots
                -- are only cloned into it at the end. Until they are,
                -- it is not the reward panel yet - two empty posts
                -- went out between rooms before this check.
                if ok and panel and #ItemSlots(panel) == 0
                and #CONFIG.LootPanelPath > 0 then
                    panel = nil
                end
                if ok and panel then
                    ran = false
                    print("[DQR] Loot: reward panel = " .. panel:GetFullName())
                    local okR, err = pcall(ReportLoot, panel)
                    if not okR then print("[DQR] Loot: post crashed: " .. tostring(err)) end
                elseif not ok and not warned then
                    warned = true
                    print("[DQR] Loot: panel search failed: " .. tostring(panel))
                end
            end
        end
    end
end

-- The three helpers live on one table rather than as three locals,
-- and the two entry points hang off Farm rather than being
-- forward-declared: the main chunk is a handful of locals short of
-- Luau's limit of 200, and this section would have crossed it.
-- (Hud is the module table declared at the top.)

-- 1300000 -> "1.30M", the way the HUD writes it.
function Hud.Short(n)
    n = tonumber(n) or 0
    for _, p in ipairs({{1e12, "T"}, {1e9, "B"}, {1e6, "M"}, {1e3, "K"}}) do
        if n >= p[1] then return ("%.2f%s"):format(n / p[1], p[2]) end
    end
    return ("%d"):format(n)
end

-- A TextLabel under the HUD panel, found by its own name or its
-- parent's - the level one lives at playerStatus.Frame.levelBorder.level,
-- so both halves matter. Returns the text, or nil.
function Hud.Text(frag)
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    local root = pg and pg:FindFirstChild("playerStatus")
    if not root then return nil end
    local hit = nil
    pcall(function()
        for _, o in ipairs(root:GetDescendants()) do
            if o:IsA("TextLabel") and o.Text ~= "" then
                local n  = o.Name:lower()
                local pn = (o.Parent and o.Parent.Name or ""):lower()
                if n:find(frag, 1, true) or pn:find(frag, 1, true) then
                    hit = o.Text
                    return
                end
            end
        end
    end)
    return hit
end

-- leaderstats first (the real value), the HUD label second. The
-- vanity spoofer rewrites HUD text, so a spoofed name or level would
-- otherwise end up in the status post.
function Hud.Real(frag)
    local ls = LP:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            if v.Name:lower():find(frag, 1, true) and v:IsA("ValueBase") then
                return tostring(v.Value)
            end
        end
    end
    return Hud.Text(frag)
end

-- Console helper: every label on the HUD panel, so a number that
-- comes out wrong can be traced to the label it should have used.
function Farm.StatusDump()
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    local root = pg and pg:FindFirstChild("playerStatus")
    if not root then
        print("[DQR] No playerStatus GUI found.")
        return
    end
    print("[DQR] === HUD PANEL ===")
    for _, o in ipairs(root:GetDescendants()) do
        if o:IsA("TextLabel") then
            print(("%s = '%s'"):format(
                o:GetFullName():gsub("^.*playerStatus%.", ""), o.Text))
        end
    end
    print("[DQR] === END HUD PANEL ===")
end

-- The status message id, kept somewhere it survives the script being
-- executed again - a new run, a rejoin, a manual re-execute. Without
-- this every fresh start posts a brand new embed and leaves the last
-- one frozen in the channel. File first (survives anything), then the
-- executor's shared global table (survives a re-execute in the same
-- session). The webhook is stored beside the id, so pointing the
-- script at a different channel does not try to edit a message that
-- lives in the old one.
local STATUS_KEY = "DQR_status.txt"

function Hud.LoadId(url)
    local raw
    local rf = Env("readfile")
    if typeof(rf) == "function" then
        local ok, v = pcall(rf, STATUS_KEY)
        if ok and type(v) == "string" then raw = v end
    end
    if not raw then
        local g = Env("getgenv")
        if typeof(g) == "function" then
            local ok, t = pcall(g)
            if ok and type(t) == "table" and type(t.DQR_Status) == "string" then
                raw = t.DQR_Status
            end
        end
    end
    if type(raw) ~= "string" then return nil end
    local u, id = raw:match("^(.-)\n(.+)$")
    if u == url and id then
        id = id:gsub("%s", "")
        if id ~= "" then return id end
    end
    return nil
end

function Hud.SaveId(url, id)
    local data = tostring(url) .. "\n" .. tostring(id or "")
    local wf = Env("writefile")
    if typeof(wf) == "function" then pcall(wf, STATUS_KEY, data) end
    local g = Env("getgenv")
    if typeof(g) == "function" then
        local ok, t = pcall(g)
        if ok and type(t) == "table" then t.DQR_Status = data end
    end
end

-- Remove a status message we are about to replace, so old embeds do
-- not pile up in the channel.
function Hud.DeleteMsg(url, id)
    if not id or not url then return end
    pcall(function()
        HttpRequest({Url = url .. "/messages/" .. id, Method = "DELETE"})
    end)
end

function Farm.StatusWatcher()
    local msgId, base, startedAt = nil, nil, tick()
    local said, lastErr, loaded = false, 0, false
    while true do
        S(math.max(2, CONFIG.StatusInterval or 5))
        local url = CONFIG.StatusWebhook
        if type(url) ~= "string" or url == "" then
            if not said then
                said = true
                print("[DQR] Status: StatusWebhook is empty - no status posts.")
            end
        elseif not url:find("^https://") then
            if not said then
                said = true
                print("[DQR] Status: StatusWebhook does not look like a URL.")
            end
        else
            -- First tick: pick up the message this script was editing
            -- before it was restarted, so a new run keeps updating the
            -- same embed instead of posting another one.
            if not loaded then
                loaded = true
                msgId  = Hud.LoadId(url)
                if msgId then
                    print("[DQR] Status: continuing the message from the "
                        .. "previous run.")
                end
            end
            -- A different webhook means a different channel. Clear the
            -- old message out rather than orphan it there.
            if base ~= nil and base ~= url then
                Hud.DeleteMsg(base, msgId)
                msgId = nil
            end
            base = url
            -- Errors here used to vanish into the pcall, so a single
            -- nil index meant silence forever with nothing to go on.
            local ok, err = pcall(function()
                local HttpS = game:GetService("HttpService")
                local human = GetHuman()
                local dead  = not human or human.Health <= 0
                local tgt   = (not dead) and Brain.target or nil

                -- What it is doing: the brain's own description.
                local doing
                if dead then                   doing = "Dead - waiting to respawn"
                elseif InLobby() then          doing = "In the lobby"
                elseif lobbyFlowActive then    doing = "Queueing a dungeon"
                elseif not Farm.Running then   doing = "Idle"
                else                           doing = tostring(Brain.state)
                end

                local fields = {}
                local function F(n, v)
                    if v and v ~= "" then
                        fields[#fields + 1] = {name = n, value = tostring(v),
                                               inline = true}
                    end
                end
                -- HP from the Humanoid, not the HUD: always accurate,
                -- and never touched by the vanity spoofer.
                if human then
                    F("HP", ("%s / %s"):format(
                        Hud.Short(human.Health), Hud.Short(human.MaxHealth)))
                end
                F("EXP",   Hud.Text("exp"))
                F("Gold",  Hud.Real("gold"))
                F("Gems",  Hud.Real("gem") or Hud.Real("diamond"))
                local near = 0
                for _, rec in ipairs(Mobs.list) do
                    if rec.Flat <= 150 then near = near + 1 end
                end
                F("Mobs near", near)
                if tgt then
                    local h = tgt.Humanoid
                    F("Target", ("%s%s\n%d%% at %d studs"):format(tgt.Model.Name,
                        tgt.Boss and " [boss]" or "",
                        h.MaxHealth > 0 and h.Health / h.MaxHealth * 100 or 0,
                        tgt.Dist))
                end
                local up = tick() - startedAt
                F("Uptime", ("%dh %02dm"):format(up / 3600, (up % 3600) / 60))

                local lvl = Hud.Real("level") or Hud.Real("lvl")
                local col = 5763719
                if dead then col = 15548997
                elseif human and human.MaxHealth > 0
                and human.Health / human.MaxHealth < 0.4 then col = 16426522 end

                local body = HttpS:JSONEncode({
                    username = "DQR",
                    embeds = {{
                        title = ("%s%s"):format(LP.DisplayName,
                            lvl and ("   -   Level " .. lvl) or ""),
                        description = ("**%s**\n%s (%s)%s"):format(doing,
                            CONFIG.TargetDungeon, CONFIG.Difficulty,
                            Prof.name and ("  -  profile: " .. Prof.name) or ""),
                        color = col,
                        fields = fields,
                        footer = {text = "updated " .. os.date("%H:%M:%S")},
                    }},
                })

                -- Edit the one message when we have its id, else post a
                -- fresh one. ?wait=true makes Discord hand back the
                -- message it created, which is the only way to learn
                -- the id needed to edit it later.
                local res
                if msgId then
                    res = HttpRequest({
                        Url = base .. "/messages/" .. msgId, Method = "PATCH",
                        Headers = {["Content-Type"] = "application/json"},
                        Body = body,
                    })
                    local code = res and (res.StatusCode or res.Status)
                    -- 404 is the ONLY code meaning the message is gone.
                    -- 400 means Discord rejected this particular
                    -- payload, and treating that as "gone" abandoned a
                    -- perfectly good message and started a second one -
                    -- which is why a run ending left one frozen embed
                    -- and a new one beside it. Keep the id and say what
                    -- Discord objected to instead.
                    if code == 404 then
                        msgId = nil
                        Hud.SaveId(base, nil)
                        print("[DQR] Status message is gone - posting a new one.")
                    elseif code == 400 then
                        if tick() - lastErr > 15 then
                            lastErr = tick()
                            print("[DQR] Status: Discord rejected the update: "
                                .. tostring(res and res.Body))
                        end
                    elseif code == 429 then
                        -- Rate limited. Skip a beat rather than hammer.
                        S(2)
                    end
                else
                    res = HttpRequest({
                        Url = base .. "?wait=true", Method = "POST",
                        Headers = {["Content-Type"] = "application/json"},
                        Body = body,
                    })
                    if res and res.Body then
                        local okj, data = pcall(function()
                            return HttpS:JSONDecode(res.Body) end)
                        if okj and type(data) == "table" and data.id then
                            msgId = tostring(data.id)
                            -- Remembered, so the next run edits this
                            -- one instead of posting another.
                            Hud.SaveId(base, msgId)
                            print(("[DQR] Status embed posted - updating "
                                .. "every %ss from now on."):format(
                                tostring(CONFIG.StatusInterval)))
                        else
                            print("[DQR] Status: posted but could not read the "
                                .. "message id - it will repost each tick.")
                        end
                    else
                        print("[DQR] Status: no reply from the webhook - does "
                            .. "this executor have a request function?")
                    end
                end
            end)
            if not ok and tick() - lastErr > 15 then
                lastErr = tick()
                print("[DQR] Status update failed: " .. tostring(err))
            end
        end
    end
end

end -- of the loot block

-- ============================================================
--  AUTO SELL  (lobby)
--  Walk to the sell area, open the shop, click every item whose name
--  is on CONFIG.SellNames, press Sell once. Built to find the pieces by
--  themselves - the sell area by a prompt or part with "sell" in it,
--  the item slots by their icons, the names from the slot's own name,
--  attributes, values or labels - because the shop's layout was never
--  dumped. DQR_SellDump() with the shop open prints what it sees, so
--  anything it cannot find can be pinned down.
-- ============================================================
do
local GENERIC = {imagebutton = true, textbutton = true, frame = true, template = true,
                 slot = true, item = true, button = true, itemslot = true, holder = true}
local CONTROL = {x = true, close = true, exit = true, back = true, cancel = true, no = true,
                 yes = true, ok = true, confirm = true, sell = true, sellall = true,
                 sellselected = true, selectall = true, next = true, prev = true}

-- Does a name match the list?
function Sell.Match(name)
    local n = Norm(name)
    if n == "" then return false end
    for _, want in ipairs(CONFIG.SellNames or {}) do
        local w = Norm(want)
        if w ~= "" then
            if n == w then return true end
            if CONFIG.SellMatch == "contains" and n:find(w, 1, true) then return true end
        end
    end
    return false
end

-- Every name a slot could be carrying: string attributes and string
-- values on it or its frame, its labels, and its own name unless that is
-- a generic one ("ImageButton", "Slot", "12").
local function Candidates(slot)
    local out, seen = {}, {}
    local function Add(s)
        s = tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", "")
        local letters = #s:gsub("[^%a]", "")
        if letters >= 3 and not seen[s] then
            seen[s] = true
            out[#out + 1] = s
        end
    end
    for _, holder in ipairs({slot, slot.Parent}) do
        if holder then
            for _, v in pairs(holder:GetAttributes()) do
                if type(v) == "string" then Add(v) end
            end
            for _, c in ipairs(holder:GetChildren()) do
                if c:IsA("StringValue") then Add(c.Value) end
            end
        end
    end
    for _, d in ipairs(slot:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then Add(d.Text) end
    end
    if slot:IsA("TextButton") then Add(slot.Text) end
    for _, nm in ipairs({slot.Name, slot.Parent and slot.Parent.Name or ""}) do
        local l = Norm(nm)
        if not GENERIC[l] and not l:match("^%d+$") then Add(nm) end
    end
    return out
end
Sell.Candidates = Candidates

-- Item names the game keeps in a data folder, if it keeps them where we
-- can read them (an "Inventory" folder on the player or in
-- ReplicatedStorage). nil when there is none - then only the shop's own
-- screen can tell.
function Sell.InventoryNames()
    local RS = game:GetService("ReplicatedStorage")
    local roots = {LP, RS:FindFirstChild(LP.Name), RS:FindFirstChild(tostring(LP.UserId))}
    local pd = RS:FindFirstChild("PlayerData") or RS:FindFirstChild("Data")
    if pd then
        roots[#roots + 1] = pd:FindFirstChild(LP.Name)
        roots[#roots + 1] = pd:FindFirstChild(tostring(LP.UserId))
    end
    local function Find(node, depth)
        for _, c in ipairs(node:GetChildren()) do
            if (c:IsA("Folder") or c:IsA("Configuration")) and c.Name:lower():find("inventor", 1, true) then
                return c
            end
        end
        if depth <= 0 then return nil end
        for _, c in ipairs(node:GetChildren()) do
            if c:IsA("Folder") or c:IsA("Configuration") then
                local f = Find(c, depth - 1)
                if f then return f end
            end
        end
        return nil
    end
    for _, r in ipairs(roots) do
        local f = r and Find(r, 3)
        if f then
            local names = {}
            for _, c in ipairs(f:GetChildren()) do
                names[#names + 1] = c:IsA("StringValue") and c.Value ~= "" and c.Value or c.Name
            end
            return names, f
        end
    end
    return nil
end

-- The sell area: CONFIG.SellSpot, else a ProximityPrompt that talks about
-- selling, else the nearest part or model with "sell" in its name.
function Sell.FindArea()
    if typeof(CONFIG.SellSpot) == "Vector3" then return CONFIG.SellSpot, nil, "CONFIG.SellSpot" end
    local root = GetRoot()
    local me = root and root.Position or Vector3.zero
    local function PosOf(o)
        if o:IsA("BasePart") then return o.Position end
        if o:IsA("Attachment") then return o.WorldPosition end
        if o:IsA("Model") then
            local ok, p = pcall(function() return o:GetPivot().Position end)
            if ok then return p end
        end
        return nil
    end
    local best, bestD, prompt, what = nil, math.huge, nil, nil
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            local t = (d.ActionText .. " " .. d.ObjectText .. " " .. (d.Parent and d.Parent.Name or "")):lower()
            if t:find("sell", 1, true) then
                local p = d.Parent and PosOf(d.Parent)
                if p then
                    local dist = (p - me).Magnitude
                    -- A prompt always beats a mere name.
                    if not prompt or dist < bestD then best, bestD, prompt, what = p, dist, d, d:GetFullName() end
                end
            end
        end
    end
    if prompt then return best, prompt, what end
    for _, d in ipairs(workspace:GetDescendants()) do
        if (d:IsA("BasePart") or d:IsA("Model")) and d.Name:lower():find("sell", 1, true)
        and not (d:IsA("Model") and IsCreature(d)) then
            local p = PosOf(d)
            if p and (p - me).Magnitude < bestD then best, bestD, what = p, (p - me).Magnitude, d:GetFullName() end
        end
    end
    return best, nil, what
end

-- Walk there with the farm's own mover. True when we got within 6 studs.
function Sell.WalkTo(pos)
    Nav.Start()
    Nav.goal = pos
    local t0, reached = tick(), false
    while tick() - t0 < 40 do
        local root = GetRoot()
        if root and FlatDist(root.Position, pos) < 6 then reached = true break end
        S(0.2)
    end
    Nav.goal = nil
    S(0.3)
    Nav.Stop()
    return reached
end

-- The shop's Sell button, when its screen is up. Never a "Sell All".
function Sell.FindButton()
    for _, b in ipairs(FindButtons({{text = "sell"}, {text = "sellselected"},
                                    {text = "sellitems"}, {name = "sellbutton"}})) do
        local txt = ButtonText(b)
        if VisibleOnScreen(b) and not txt:find("sellall", 1, true) then return b end
    end
    return nil
end

-- Open the shop: already open, or use the prompt (fired directly when
-- the executor can, else its key held down), then wait for the screen.
function Sell.Open(prompt)
    local b = Sell.FindButton()
    if b then return b end
    if prompt then
        local fire = Env("fireproximityprompt")
        if typeof(fire) == "function" then
            pcall(fire, prompt)
        else
            pcall(function()
                VIM:SendKeyEvent(true, prompt.KeyboardKeyCode, false, game)
                S(prompt.HoldDuration + 0.2)
                VIM:SendKeyEvent(false, prompt.KeyboardKeyCode, false, game)
            end)
        end
    end
    local t0 = tick()
    while tick() - t0 < 6 do
        b = Sell.FindButton()
        if b then return b end
        S(0.25)
    end
    return nil
end

-- The item slots on the shop's screen: buttons with an icon (an image,
-- or a 3D preview), not the shop's own controls.
function Sell.Slots(gui, sellBtn)
    local out = {}
    for _, d in ipairs(gui:GetDescendants()) do
        if (d:IsA("ImageButton") or d:IsA("TextButton")) and d ~= sellBtn
        and not d:IsDescendantOf(sellBtn) and VisibleOnScreen(d) then
            local ctrl = false
            for _, tok in ipairs(ButtonTokens(d)) do
                if CONTROL[tok] then ctrl = true break end
            end
            if not ctrl and CONTROL[Norm(d.Name)] then ctrl = true end
            local icon = (d:IsA("ImageButton") and d.Image ~= "")
            if not icon then
                for _, c in ipairs(d:GetDescendants()) do
                    if c:IsA("ViewportFrame") or (c:IsA("ImageLabel") and c.Image ~= "") then icon = true break end
                end
            end
            if not ctrl and icon then out[#out + 1] = d end
        end
    end
    return out
end

-- Close the shop: its X / Close / Back button, if it has one.
function Sell.Close(gui)
    for _, d in ipairs(gui and gui:GetDescendants() or {}) do
        if (d:IsA("TextButton") or d:IsA("ImageButton")) and VisibleOnScreen(d) then
            local n = Norm(d.Name)
            local txt = ButtonText(d)
            if n:find("close", 1, true) or n:find("exit", 1, true) or txt == "x" or txt == "close"
            or txt == "back" or txt == "exit" then
                ClickButton(d)
                return true
            end
        end
    end
    return false
end

function Sell.Flow(force)
    if #(CONFIG.SellNames or {}) == 0 then
        print("[DQR] Sell: SellNames is empty - nothing to look for.")
        return
    end
    -- The title splash first: the lobby is behind it.
    local intro = PathVisible(UI.IntroPlay)
    if intro then
        ClickButton(intro)
        local w = 0
        repeat S(0.5) w = w + 0.5 until PathVisible(UI.LobbyPlay) or w > 15
    end
    -- Nothing to sell? Say so and save the walk.
    local have = Sell.InventoryNames()
    if have then
        local want = {}
        for _, n in ipairs(have) do if Sell.Match(n) then want[#want + 1] = n end end
        if #want == 0 then
            print(("[DQR] Sell: none of the %d item(s) in the inventory is on SellNames."):format(#have))
            return
        end
        print(("[DQR] Sell: %d item(s) to sell: %s"):format(#want, table.concat(want, ", ")))
    end
    local spot, prompt, what = Sell.FindArea()
    if not spot then
        print("[DQR] Sell: could not find the sell area - stand in it, and put your position "
            .. "in CONFIG.SellSpot (DQR_SellDump() prints it).")
        return
    end
    print(("[DQR] Sell: heading to the sell area (%s)."):format(tostring(what)))
    if not Sell.WalkTo(spot) then
        print("[DQR] Sell: could not reach the sell area.")
        return
    end
    local btn = Sell.Open(prompt)
    if not btn then
        print("[DQR] Sell: the shop screen did not open (no Sell button on screen). Open it by "
            .. "hand and run DQR_SellDump(), then send the output.")
        return
    end
    local gui = btn:FindFirstAncestorWhichIsA("ScreenGui") or btn.Parent
    S(0.5)                                  -- let the item list fill in
    local slots = Sell.Slots(gui, btn)
    local picked, named = {}, 0
    for _, s in ipairs(slots) do
        local cands = Candidates(s)
        if #cands > 0 then named = named + 1 end
        for _, c in ipairs(cands) do
            if Sell.Match(c) then picked[#picked + 1] = {slot = s, name = c} break end
        end
    end
    if #picked == 0 then
        if #slots > 0 and named == 0 then
            print(("[DQR] Sell: %d item slot(s) on the shop screen, but none carries a name I "
                .. "can read. Run DQR_SellDump() with the shop open and send the output."):format(#slots))
        else
            print(("[DQR] Sell: nothing on the shop screen is on SellNames (%d slot(s) looked at)."):format(#slots))
        end
        Sell.Close(gui)
        return
    end
    -- Click them all first...
    local list = {}
    for _, p in ipairs(picked) do
        pcall(ScrollIntoView, p.slot)
        ClickButton(p.slot)
        list[#list + 1] = p.name
        S(0.25)
    end
    print(("[DQR] Sell: selected %d item(s): %s"):format(#picked, table.concat(list, ", ")))
    if CONFIG.SellDryRun then
        print("[DQR] Sell: SellDryRun is on - NOT pressing Sell. Check the list above, then set "
            .. "SellDryRun = false.")
        Sell.Close(gui)
        return
    end
    -- ...then sell them all at once, and answer a confirmation if one
    -- comes up (never the Sell button itself a second time).
    ClickButton(btn)
    local t0 = tick()
    while tick() - t0 < 2.5 do
        S(0.3)
        local conf = nil
        for _, b in ipairs(FindButtons({{text = "yes"}, {text = "confirm"}, {text = "ok"}})) do
            if VisibleOnScreen(b) and b ~= btn then conf = b break end
        end
        if conf then ClickButton(conf) break end
    end
    print(("[DQR] Sell: sold %d item(s)."):format(#picked))
    S(0.5)
    Sell.Close(gui)
end

-- Once per lobby visit (and never twice within 30 seconds). `force` runs
-- it even with AutoSell off - that is for DQR_Sell() from the console.
-- SellDryRun is obeyed either way.
function Sell.Run(force)
    if Sell.busy then return end
    if not force and (not CONFIG.AutoSell or tick() - (Sell.lastRun or 0) < 30) then return end
    Sell.busy, Sell.lastRun = true, tick()
    local ok, err = pcall(Sell.Flow, force)
    if not ok then print("[DQR] Sell: failed - " .. tostring(err)) end
    pcall(function() if not Farm.Running then Nav.Stop() end end)
    Sell.busy = false
end

-- DQR_SellDump(): with the shop open, everything it would look at.
function Sell.Dump()
    local root = GetRoot()
    if root then
        local p = root.Position
        print(("[DQR] Your position: Vector3.new(%d, %d, %d)  (for CONFIG.SellSpot)"):format(p.X, p.Y, p.Z))
    end
    local spot, prompt, what = Sell.FindArea()
    print("[DQR] Sell area found: " .. tostring(what) .. (prompt and " (a prompt)" or ""))
    local have, folder = Sell.InventoryNames()
    print("[DQR] Inventory data: " .. (have and (folder:GetFullName() .. " - " .. #have .. " item(s)") or "none readable"))
    local btn = Sell.FindButton()
    print("[DQR] Sell button: " .. (btn and btn:GetFullName() or "not on screen"))
    local gui = btn and (btn:FindFirstAncestorWhichIsA("ScreenGui") or btn.Parent)
    if not gui then return end
    local slots = Sell.Slots(gui, btn)
    print(("[DQR] === %d ITEM SLOT(S) ==="):format(#slots))
    for i, s in ipairs(slots) do
        if i > 60 then break end
        local cands = Candidates(s)
        local m = false
        for _, c in ipairs(cands) do if Sell.Match(c) then m = true break end end
        print(("%s | names: %s | on SellNames: %s"):format(s:GetFullName(),
            #cands > 0 and table.concat(cands, " / ") or "(none)", tostring(m)))
    end
    print("[DQR] === END ===")
end
end

-- ============================================================
--  START / STOP
--  task.spawn swallows errors, so a crash inside the loop used to
--  leave Farm.Running true with nothing running. Guarded reports what
--  went wrong and restarts.
-- ============================================================
-- A crash that repeats is reported once, with a count, and the restart
-- backs off (1s, 2s, 4s... up to 15s): the same error every tick used
-- to flood the log and restart the farm ten times a second.
local crash = {msg = nil, n = 0, at = 0}
local function Guarded(name, fn)
    return function()
        local ok, err = pcall(fn)
        local wait = 0.5
        if not ok then
            local msg, now = tostring(err), tick()
            if msg == crash.msg and now - crash.at < 30 then
                crash.n = crash.n + 1
                wait = math.min(15, 2 ^ math.min(crash.n - 1, 4))
                if crash.n == 2 or crash.n % 10 == 0 then
                    print(("[DQR] %s crashed again (x%d) - same error. Waiting %ds between "
                        .. "restarts. Please send this log."):format(name, crash.n, wait))
                end
            else
                crash.msg, crash.n = msg, 1
                print("[DQR] " .. name .. " CRASHED: " .. msg)
            end
            crash.at = now
        end
        if Farm.Running then
            if crash.n <= 1 then
                print("[DQR] " .. name .. " exited unexpectedly - restarting.")
            end
            Farm.Running = false
            Nav.Stop()
            -- Nobody else may start the farm during the wait (the
            -- supervisor did, every 4 seconds, and each start that
            -- crashed began another restart chain of its own).
            Farm.restartAt = tick() + wait
            task.wait(wait)
            Farm.restartAt = nil
            Farm.Start()
        end
    end
end

function Farm.Start()
    if Farm.Running then return end
    if Farm.restartAt and tick() < Farm.restartAt then return end
    if InLobby() then
        print("[DQR] Refusing to farm - lobby marker '" .. tostring(LobbyMarker())
            .. "' is on screen.")
        return
    end
    if not DungeonConfirmed() then
        print(("[DQR] Not farming yet - lobby only gone %.1fs of %.0fs.")
            :format(NotLobbyFor(), CONFIG.LobbyGrace))
        return
    end
    if lobbyFlowActive then
        print("[DQR] Not farming - still queueing a dungeon.")
        return
    end
    -- This dungeon's settings, fresh: nothing left over from the last.
    Prof.Apply()
    -- The map pass walks the whole workspace: once per dungeon, not on
    -- every farm restart (a restart after a death, or a crash, re-ran it).
    if not Look.mapApplied then Look.ApplyMap() end
    Farm.Running, Farm.beat = true, tick()
    task.spawn(Guarded("Farm loop", Brain.Loop))
    print("[DQR] Farm started.")
end

function Farm.Stop()
    Farm.Running = false
    Nav.Stop()
    Brain.state, Brain.target = "Idle", nil
    print("[DQR] Farm stopped.")
end

LP.CharacterAdded:Connect(function()
    S(2)
    pcall(HideArmour, GetChar())
    if Farm.Running then
        Farm.Stop()
        S(0.5)
        Farm.Start()
    end
end)

-- ============================================================
--  WATCHERS
-- ============================================================
-- The in-dungeon START button has no known path; match it by text.
local function StartWatcher()
    while true do
        S(1.5)
        -- Never the lobby party screen's start: see DungeonStartButton.
        local b = DungeonStartButton()
        if b then
            print("[DQR] In-dungeon START visible - clicking.")
            ClickButton(b)
            S(2)
        end
    end
end

-- Notices the run is over (the lobby is back) and stops the farm.
-- What happens next is the Supervisor's job.
local function DungeonWatcher()
    while true do
        S(3)
        if Farm.Running and InLobby() then
            print("[DQR] Back in the lobby - run over, stopping farm.")
            Look.mapApplied, Look.y0 = false, nil
            Farm.Stop()
        end
    end
end

-- Runs forever, farm or no farm: works out where we are and gets
-- things moving again, so no single failed transition parks the bot.
local function Supervisor()
    while true do
        S(4)
        if Farm.Running and tick() - Farm.beat > CONFIG.LoopStallTime then
            print(("[DQR] Farm loop has not ticked in %.0fs - restarting.")
                :format(tick() - Farm.beat))
            Farm.Stop()
            S(0.5)
            Farm.Start()
            continue
        end
        if Farm.Running or lobbyFlowActive then continue end

        if InLobby() then
            Look.mapApplied, Look.y0 = false, nil     -- the next dungeon gets a fresh map pass
            if not CONFIG.AutoRunDungeon then continue end
            -- Sell first, whichever way the next run starts (Replay skips
            -- the queue screen, and with it the sell step there).
            if PathVisible(UI.Replay) then Sell.Run() end
            local replay = PathVisible(UI.Replay)
            if replay then
                print("[DQR] Replay Dungeon available - clicking it.")
                ClickButton(replay)
                local t = 0
                repeat S(2) t = t + 2 until IsInDungeon() or t > 60
            else
                print("[DQR] Idle in the lobby - queueing a run.")
                RunLobbyFlow()
                local t = 0
                repeat S(2) t = t + 2 until IsInDungeon() or t > 90
            end
            if IsInDungeon() then Farm.Start() end
            continue
        end
        -- Not the lobby - for long enough to believe it.
        if DungeonConfirmed() then
            print("[DQR] Idle outside the lobby - resuming farm.")
            Farm.Start()
        end
    end
end

-- ============================================================
--  BOOT
-- ============================================================
task.spawn(function()
    print("[DQR] v13.11 loaded.  F5 farm  F6 gui dump  F7 log  F8 mob diag  F9 hazard diag  F10 loot panel")
    print("[DQR] DQR_Copy() copies the whole log to the clipboard.")
    -- The status feed first: it is how you check on the bot, so it has
    -- to be running even if the queue stalls.
    task.spawn(Farm.StatusWatcher)
    -- Captures CONFIG as written; every farm start re-applies from it.
    Prof.Apply()
    NukeGraphics()
    -- FPS cap: the executor's setfpscap (Roblox itself offers no way).
    if CONFIG.FpsCap ~= nil then
        local cap = Env("setfpscap")
        if typeof(cap) ~= "function" then
            pcall(function() cap = getgenv().setfpscap end)
        end
        if typeof(cap) == "function" then
            local ok = pcall(cap, CONFIG.FpsCap)
            print(ok and ("[DQR] FPS cap set to %s."):format(CONFIG.FpsCap == 0 and "uncapped"
                or tostring(CONFIG.FpsCap)) or "[DQR] setfpscap failed - FPS cap unchanged.")
        else
            print("[DQR] This executor has no setfpscap - FPS cap unchanged.")
        end
    end
    S(2.5)

    -- Watchers first. They used to start only after the lobby decision
    -- below had finished - which could be two minutes of waiting - so a
    -- wrong call there left nothing pressing START at all.
    task.spawn(DungeonWatcher)
    task.spawn(StartWatcher)
    task.spawn(VanityWatcher)
    task.spawn(LootWatcher)

    -- PlayerGui is still filling in right after injection: sample for
    -- a few seconds before deciding there is no lobby.
    local marker = nil
    for _ = 1, 8 do
        marker = LobbyMarker()
        if marker then break end
        S(0.5)
    end
    -- ...and a lobby marker has to still be there a moment later. A
    -- dungeon's GUI flashes the lobby's Play button while it loads.
    if marker then
        S(1.5)
        if not LobbyMarker() then
            print("[DQR] Lobby UI vanished again - that was a dungeon loading.")
            marker = nil
        end
    end
    print("[DQR] Lobby marker: " .. tostring(marker or "none"))

    if not marker then
        print("[DQR] No lobby UI - assuming we are in a dungeon.")
        Farm.Start()
    elseif not CONFIG.AutoRunDungeon then
        print("[DQR] In the lobby - AutoRunDungeon is off, waiting for a dungeon.")
    end
    -- Queueing from the lobby, restarting the farm, replaying: all the
    -- supervisor's job from here, and it never blocks the watchers.
    task.spawn(Supervisor)
end)

