--  DQR AUTO FARM v4.5
--  Axiom Build — No mouse clicks, CFrame movement,
--  melee + spells, full speed, remote-based dungeon queue
-- ============================================================

local CONFIG = {
    TargetDungeon  = "Desert Temple",
    Difficulty     = "Easy",
    AutoRunDungeon = true,
    UseRemotes     = false,  -- blind-firing guessed remotes; off by default
    LowerGraphics  = true,

    MeleeRange     = 8,      -- swing left click when closer than this
    AttackRange    = 25,     -- cast spells when closer than this
    MinRange       = 10,     -- back off if closer than this
    MaxRange       = 28,     -- close in if farther than this
    DodgeRange     = 40,
    DodgeCooldown  = 0.9,
    DodgeStep      = 18,
    AttackRate     = 0.3,    -- spell cast rate
    MeleeRate      = 0.2,    -- melee swing rate
    WalkSpeed      = 16,
    CircleRadius   = 18,
    CircleSpeed    = 0.85,
    ScanRate       = 0.05,
    AimCamera      = true,   -- point the camera at the mob (DQR aims from camera)
    CameraHeight   = 12,
    CameraBack     = 14,
}

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local VIM              = game:GetService("VirtualInputManager")
