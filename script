local function Notify(title, body, duration, ntype)
    duration = duration or 3.5
    ntype    = ntype or "info"
    local colors = {
        info    = Color3.fromRGB(80,  80,  200),
        success = Color3.fromRGB(50,  180, 80),
        warn    = Color3.fromRGB(200, 160, 30),
        error   = Color3.fromRGB(200, 50,  50),
    }
    local accentC = colors[ntype] or colors.info

    local card = Instance.new("Frame")
    card.Name                    = "Notif"
    card.Size                    = UDim2.new(1, 0, 0, 68)
    card.BackgroundColor3        = CFG.SecondBg
