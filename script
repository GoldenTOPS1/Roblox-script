local function CleanOld()
    for _, gui in ipairs({"DQR_AXM"}) do
        local cg = pcall(function()
            local f = game:GetService("CoreGui"):FindFirstChild(gui)
            if f then f:Destroy() end
        end)
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            local f = pg:FindFirstChild(gui)
            if f then f:Destroy() end
        end
        if gethui then
            local f = gethui():FindFirstChild(gui)
            if f then f:Destroy() end
        end
    end
end
