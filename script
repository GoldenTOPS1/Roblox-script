UserInputService.InputBegan:Connect(function(inp, gpe)
    local k = inp.KeyCode
    local ours = k == Enum.KeyCode.F5 or k == Enum.KeyCode.F6 or k == Enum.KeyCode.F7
              or k == Enum.KeyCode.F8 or k == Enum.KeyCode.F9 or k == Enum.KeyCode.F10
    if gpe and not ours then return end
    if k == Enum.KeyCode.F5 then
        if Farm.Running then Farm.Stop() else Farm.Start() end
    elseif k == Enum.KeyCode.F6 then
        DumpGui()
        print("[DQR] InLobby() = " .. tostring(InLobby())
            .. "  mobs = " .. tostring(#Mobs.Scan(true)))
    elseif k == Enum.KeyCode.F7 then
        if not LogGui or not LogGui.Parent then pcall(BuildLogGui) end
        if LogGui then
            LogGui.Enabled = not LogGui.Enabled
            local main = LogGui:FindFirstChild("main")
            if main and LogGui.Enabled then main.Position = UDim2.new(0, 20, 0, 90) end
            print("[DQR] Log window " .. (LogGui.Enabled and "shown" or "hidden") .. ".")
        else
            print("[DQR] Could not build the log window - use DQR_Copy().")
        end
    elseif k == Enum.KeyCode.F8 then
        Mobs.Diag()
    elseif k == Enum.KeyCode.F9 then
        Haz.Diag()
    elseif k == Enum.KeyCode.F10 then
        LootDump()
    end
end)

-- Console helpers.
getgenv = getgenv or function() return _G end
getgenv().DQR_Dump    = DumpGui
getgenv().DQR_Lobby   = InLobby
getgenv().DQR_Queue   = RunLobbyFlow
getgenv().DQR_Mobs    = Mobs.Diag
getgenv().DQR_Hazards = Haz.Diag
getgenv().DQR_Log     = function() return table.concat(LOG, "\n") end
getgenv().DQR_Copy    = function()
    local all = table.concat(LOG, "\n")
    if Copy(all) then
        print("[DQR] Log copied to the clipboard (" .. #LOG .. " lines).")
    else
        print("[DQR] No clipboard function in this executor.")
    end
    return all
end
getgenv().DQR_LootDump   = LootDump
getgenv().DQR_LootTest   = function() return ReportLoot(nil) end
getgenv().DQR_StatusDump = Farm.StatusDump
getgenv().DQR_State      = function() return Brain.state end
-- DQR_SellDump(): what the auto sell sees (open the shop first).
-- DQR_Sell(): run the sell now, even with AutoSell off (SellDryRun obeyed).
getgenv().DQR_SellDump   = function() Sell.Dump() end
getgenv().DQR_Sell       = function() task.spawn(Sell.Run, true) end
getgenv().DQR_BossBar    = function() return Mobs.BossBar() end
getgenv().DQR_Profile    = function() Prof.Apply() return Prof.name end
-- DQR_Map("off") puts the map back; DQR_Map("flat") / ("hide") applies it.
getgenv().DQR_Map        = function(mode)
    if mode == "off" then Look.RestoreMap() return end
    CONFIG.MapMode = mode or "flat"
    Look.ApplyMap()
end
