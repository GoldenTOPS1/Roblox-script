--  WALK LINE
-- ============================================================
-- Red bar laid out in front of the character, pointing at the current
-- mob. Its length IS the distance to that mob, so it shrinks as you
-- close in and stretches as the mob runs away.
local function ShowRangeBar(root, mobPos, dist)
    if not CONFIG.ShowRangeBar then return end
    if not RangeBarPart or not RangeBarPart.Parent then
        local p = Instance.new("Part")
        p.Name        = "DQR_RangeBar"
        p.Anchored    = true
        p.CanCollide  = false
        p.CanQuery    = false
        p.CanTouch    = false
        p.CastShadow  = false
        p.Material    = Enum.Material.Neon
        p.Color       = Color3.fromRGB(255, 45, 45)
        p.Transparency = 0.3
        p.Parent      = workspace
        RangeBarPart  = p
    end

    local dir = Vector3.new(mobPos.X - root.Position.X, 0,
                            mobPos.Z - root.Position.Z)
    if dir.Magnitude < 0.1 then return end
    dir = dir.Unit

    local len  = math.clamp(dist, 1, CONFIG.BarMaxLen)
    local base = root.Position - Vector3.new(0, 2.6, 0)
    local mid  = base + dir * (len / 2)

    RangeBarPart.Size  = Vector3.new(CONFIG.BarWidth, 0.12, len)
    RangeBarPart.CFrame = CFrame.lookAt(mid, mid + dir)
end

local function ClearRangeBar()
    if RangeBarPart and RangeBarPart.Parent then
        RangeBarPart:Destroy()
    end
    RangeBarPart = nil
end

-- ============================================================
--  REMOTE SCANNER - finds RemoteEvents / RemoteFunctions
--  DQR uses remotes for dungeon queuing under ReplicatedStorage
-- ============================================================
local RS = game:GetService("ReplicatedStorage")

local function FindRemote(name)
    -- Search ReplicatedStorage recursively
    for _, obj in ipairs(RS:GetDescendants()) do
        if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction"))
        and obj.Name:lower():find(name:lower()) then
            return obj
        end
    end
    return nil
end

local function PrintRemotes()
    print("[DQR] === REMOTE SCAN ===")
    for _, obj in ipairs(RS:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            print("[Remote] " .. obj.ClassName .. " | " .. obj:GetFullName())
        end
    end
    print("[DQR] === END ===")
end

-- ============================================================
--  DUNGEON QUEUE - via RemoteEvent fire instead of clicking
--  DQR remote names discovered at runtime via PrintRemotes()
-- ============================================================
local KNOWN_DUNGEON_REMOTES = {
    -- Common patterns in DQR - will match whichever exists
    "CreateDungeon",
    "createDungeon",
    "StartDungeon",
    "startDungeon",
    "JoinDungeon",
    "DungeonCreate",
    "LobbyCreate",
    "CreateLobby",
}

local DIFFICULTY_MAP = {
    Easy      = 1,
    Medium    = 2,
    Hard      = 3,
    Insane    = 4,
    Nightmare = 5,
}

local function TryFireDungeonRemote()
    local diffNum = DIFFICULTY_MAP[CONFIG.Difficulty] or 1

    -- Try each known remote pattern
    for _, name in ipairs(KNOWN_DUNGEON_REMOTES) do
        local remote = FindRemote(name)
        if remote then
            print("[DQR] Found remote: " .. remote:GetFullName())
            if remote:IsA("RemoteEvent") then
                -- Try common argument patterns DQR uses
                pcall(function()
                    remote:FireServer(CONFIG.TargetDungeon, CONFIG.Difficulty)
                end)
                S(0.3)
                pcall(function()
                    remote:FireServer(CONFIG.TargetDungeon, diffNum)
                end)
                S(0.3)
                pcall(function()
                    remote:FireServer({
                        dungeon    = CONFIG.TargetDungeon,
                        difficulty = CONFIG.Difficulty,
                    })
                end)
            elseif remote:IsA("RemoteFunction") then
                pcall(function()
                    remote:InvokeServer(CONFIG.TargetDungeon, CONFIG.Difficulty)
                end)
            end
            return true
        end
    end
    return false
end

-- ============================================================
--  DUNGEON QUEUE - fallback button fire (no click, direct signal)
-- ============================================================
-- ============================================================
--  BUTTON PRESS - the real one.
--  `signal:Fire()` does NOT exist on RBXScriptSignal; every
--  `pcall(function() btn.MouseButton1Click:Fire() end)` in v4.3
--  threw and was silently swallowed, so nothing was ever clicked.
--  Three real strategies, in order of reliability:
--    1. executor firesignal()
--    2. executor getconnections() -> :Fire() on each connection
--    3. VirtualInputManager click at the button's real screen position
-- ============================================================
local function VisibleOnScreen(gui)
    if not gui.Visible or gui.AbsoluteSize.X < 1 then return false end
    local p = gui.Parent
    while p and not p:IsA("PlayerGui") do
        if p:IsA("GuiObject") and not p.Visible then return false end
        if p:IsA("ScreenGui") and not p.Enabled then return false end
        p = p.Parent
    end
    return true
end

local function Norm(s) return (s or ""):lower():gsub("%s+", "") end

-- The label of a Roblox button is very often a child TextLabel, not the
-- button's own .Text. v4.4 only read TextButton.Text, so an ImageButton
-- named "frame" wrapping a TextLabel reading "PLAY" matched nothing -
-- which is exactly why the main-screen Play button was never pressed.
local function ButtonTokens(btn)
    local t = {}
    if btn:IsA("TextButton") then t[#t+1] = Norm(btn.Text) end
    for _, d in ipairs(btn:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            t[#t+1] = Norm(d.Text)
        end
    end
    return t
end

local function ButtonText(btn)
    return table.concat(ButtonTokens(btn), "|")
end

-- EXACT by default. Substring matching is what made "play" match the
-- "Show Players" button in the top-right HUD - which is on screen inside
-- a dungeon too, so InLobby() was always true and the script kept
-- queueing new runs mid-dungeon. Pass contains=true to opt back in.
local function ButtonMatches(btn, m)
    local want = m.text and Norm(m.text) or nil
    if want and want ~= "" then
        for _, tok in ipairs(ButtonTokens(btn)) do
            if m.contains then
                if tok:find(want, 1, true) then return true end
            elseif tok == want then
                return true
            end
        end
    end
    local wn = m.name and Norm(m.name) or nil
    if wn and wn ~= "" then
        local nm = Norm(btn.Name)
        if m.contains then
            if nm:find(wn, 1, true) then return true end
        elseif nm == wn then
            return true
        end
    end
    return false
end

-- AbsolutePosition is measured below the topbar unless the owning
-- ScreenGui sets IgnoreGuiInset. VirtualInputManager wants true viewport
-- coordinates, so the inset must be added *conditionally* - adding it
-- always put the click ~36px below buttons like Create Lobby and missed.
local function ScreenPointOf(gui)
    local ignore = false
    local p = gui.Parent
    while p do
        if p:IsA("ScreenGui") then ignore = p.IgnoreGuiInset break end
        p = p.Parent
    end
    local x = gui.AbsolutePosition.X + gui.AbsoluteSize.X / 2
    local y = gui.AbsolutePosition.Y + gui.AbsoluteSize.Y / 2
    if not ignore then y = y + GuiService:GetGuiInset().Y end
    return x, y
end

-- Which clickable GUI objects sit under a screen point, topmost first.
-- A synthetic click goes to whatever is there, not to whatever we
-- meant - which is how the bot kept opening the Inventory: a click
-- aimed at the world, or at a button whose position had shifted,
-- landed on the HUD button that happened to be under that pixel.
local function ButtonsAtPoint(x, y)
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return {} end
    local out = {}
    local ok, list = pcall(function()
        -- Roblox reports positions WITHOUT the topbar inset, while the
        -- click we send is in viewport coordinates, so take it back off.
        return pg:GetGuiObjectsAtPosition(x, y - GuiService:GetGuiInset().Y)
    end)
    if not ok or not list then return out end
    for _, o in ipairs(list) do
        if (o:IsA("TextButton") or o:IsA("ImageButton"))
        and not (LogGui and o:IsDescendantOf(LogGui)) then
            out[#out + 1] = o
        end
    end
    return out
end

local function ClickButton(btn)
    -- Prefer a genuine click when the button is on screen: it triggers
    -- whatever the game actually listens on (MouseButton1Down, InputBegan
    -- on the frame, TouchTap...), not just MouseButton1Click.
    if VisibleOnScreen(btn) then
        local x, y = ScreenPointOf(btn)
        -- The log window would swallow a click landing underneath it.
        -- Blink it off for the duration rather than making you drag it.
        local wasOpen = LogGui and LogGui.Enabled
        if wasOpen then LogGui.Enabled = false end
        -- Is the button we mean actually under that pixel? If some
        -- other control is on top - or the button has moved since its
        -- position was read - a real click would press THAT instead,
        -- which is how the Inventory kept opening itself. Drive the
        -- signal directly in that case rather than clicking blind.
        local hit = ButtonsAtPoint(x, y)[1]
        local mine = hit and (hit == btn or hit:IsDescendantOf(btn)
                              or btn:IsDescendantOf(hit))
        if hit and not mine then
            if wasOpen then LogGui.Enabled = true end
            print(("[DQR]   %s is under that point, not %s - firing the "
                .. "signal instead."):format(hit.Name, btn.Name))
        else
            local ok = pcall(function()
                VIM:SendMouseMoveEvent(x, y, game)
                S(0.08)
                VIM:SendMouseButtonEvent(x, y, 0, true,  game, 0)
                S(0.08)
                VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
            end)
            if wasOpen then LogGui.Enabled = true end
            print(("[DQR]   click @ %d,%d ok=%s"):format(x, y, tostring(ok)))
            if ok then return true end
        end
    end

    -- Hidden or input blocked - drive the signal directly. getconnections
    -- first because it is verifiable: we can count the handlers we fired.
    local gc = Env("getconnections")
    if typeof(gc) == "function" then
        local fired = 0
        for _, sig in ipairs({btn.MouseButton1Click, btn.Activated,
                              btn.MouseButton1Down, btn.MouseButton1Up}) do
            pcall(function()
                for _, c in ipairs(gc(sig)) do
                    c:Fire()
                    fired = fired + 1
                end
            end)
        end
        if fired > 0 then return true end
    end

    local fs = Env("firesignal")
    if typeof(fs) == "function" then
        local ok = pcall(fs, btn.MouseButton1Click)
        pcall(fs, btn.Activated)
        if ok then return true end
    end

    return false
end

-- Returns every button matching, visible ones first. A hidden "play" in
-- some other closed menu must never win over the one on screen.
local function FindButtons(matches)
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return {} end
    local vis, hid = {}, {}
    for _, obj in ipairs(pg:GetDescendants()) do
        if (obj:IsA("TextButton") or obj:IsA("ImageButton"))
        and not obj.Name:find("DQRui_")
        and not (LogGui and obj:IsDescendantOf(LogGui)) then
            for _, m in ipairs(matches) do
                if ButtonMatches(obj, m) then
                    if VisibleOnScreen(obj) then
                        vis[#vis+1] = obj
                    else
                        hid[#hid+1] = obj
                    end
                    break
                end
            end
        end
    end
    for _, o in ipairs(hid) do vis[#vis+1] = o end
    return vis
end

-- `verify` (optional) returns true once the click has visibly taken
-- effect. Without it a click counts as done the moment input is sent,
-- which is how "Create Lobby" could report success while nothing moved.
local function FindAndFireBtn(matches, timeout, verify)
    timeout = timeout or 8
    local elapsed = 0
    repeat
        local found = FindButtons(matches)
        for _, obj in ipairs(found) do
            print(("[DQR] Clicking %s  text='%s'  visible=%s")
                :format(obj:GetFullName(), ButtonText(obj),
                        tostring(VisibleOnScreen(obj))))
            ClickButton(obj)
            if not verify then return true end
            local w = 0
            repeat S(0.25) w = w + 0.25 until verify() or w >= 1.5
            if verify() then
                print("[DQR]   verified.")
                return true
            end
            print("[DQR]   click had no effect, trying next candidate.")
        end
        if #found == 0 then print("[DQR]   (no candidates yet)") end
        S(0.5)
        elapsed = elapsed + 0.5
    until elapsed >= timeout
    print("[DQR] No button worked after " .. timeout .. "s.")
    return false
end

-- Prints every button in PlayerGui. Run this in the lobby and paste the
-- output if a step still misses - it gives the real names to match on.
local function DumpGui()
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    print("[DQR] === GUI BUTTON DUMP ===")
    for _, obj in ipairs(pg:GetDescendants()) do
        if obj:IsA("TextButton") or obj:IsA("ImageButton") then
            print(("%s | text='%s' | visible=%s")
                :format(obj:GetFullName(), ButtonText(obj),
                        tostring(VisibleOnScreen(obj))))
        end
    end
    print("[DQR] === END DUMP ===")
end

-- Wire the log window's Dump button now that DumpGui exists
if LogGui then
    local b = LogGui:FindFirstChild("DQRui_DumpBtn", true)
    if b then b.MouseButton1Click:Connect(function() task.spawn(DumpGui) end) end
end

-- ============================================================
--  LOBBY DETECTION
--  "Am I in a dungeon?" was inferred from mob count, so any quiet
--  moment in a dungeon (between rooms, mobs not matching the strict
--  filter) read as "not in a dungeon" and the watcher happily started
--  queueing another one mid-run. Seeing the lobby's own Play button on
--  screen is a positive, unambiguous signal - use that instead.
-- ============================================================
local function AnyVisible(matches)
    for _, b in ipairs(FindButtons(matches)) do
        if VisibleOnScreen(b) then return b end
    end
    return nil
end

-- ============================================================
--  EXACT UI PATHS  (taken from a live GUI dump of this game)
--
--  Keyword matching could never work for the dungeon list or the
--  difficulty buttons: every one of them is *named* "TextButton" and
--  has EMPTY text. The identifying name sits on the parent frame -
--  chooseDungeon.backgroundFillLeft.ScrollingFrame["Desert Temple"]
--  .TextButton, chooseDungeon.backgroundFillRight.Easy.TextButton.
--  Exact paths remove all the guessing.
-- ============================================================
local UI = {
    IntroPlay   = {"introGui", "title", "Frame", "TextButton"},
    LobbyPlay   = {"mainInterface", "buttons", "playButton"},
    SelectPanel = {"queueGui", "selectOption"},
    CreateGame  = {"queueGui", "selectOption", "Frame", "createGame"},
    ChoosePanel = {"queueGui", "chooseDungeon"},
    DungeonList = {"queueGui", "chooseDungeon", "backgroundFillLeft",
                   "ScrollingFrame"},
    DiffRoot    = {"queueGui", "chooseDungeon", "backgroundFillRight"},
    Hardcore    = {"queueGui", "chooseDungeon", "backgroundFillRight",
                   "hardcoreSection", "hardcore"},
    CreateLobby = {"queueGui", "chooseDungeon", "backgroundFillMiddle",
                   "startMain", "TextButton"},
    LobbyInfo   = {"queueGui", "lobbyInfo"},
    -- HUD corner buttons that the lobby shows and a dungeon does not.
    ShowFriends = {"friendsList", "buttonMain", "TextButton"},
    ShowPlayers = {"leaderboard", "buttonMain", "TextButton"},
    StartRun    = {"queueGui", "lobbyInfo", "startBackground", "startFrame",
                   "startButton"},
    Replay      = {"ReplayDungeonButton", "Replay"},
}

local function Path(parts)
    local node = LP:FindFirstChildOfClass("PlayerGui")
    if not node then return nil end
    for _, n in ipairs(parts) do
        node = node:FindFirstChild(n)
        if not node then return nil end
    end
    return node
end

local function PathVisible(parts)
    local o = Path(parts)
    if o and VisibleOnScreen(o) then return o end
    return nil
end

-- A dungeon row / difficulty button: the clickable TextButton is a child
-- of a frame named after the dungeon or difficulty. Matched without
-- regard for case or stray spaces - "Insane" in CONFIG should find a
-- frame called "insane" or "INSANE" too, rather than reporting that a
-- difficulty plainly on screen does not exist.
local function RowIn(parent, name)
    if not parent then return nil end
    local row = parent:FindFirstChild(name)
    if not row then
        local want = Norm(name)
        for _, c in ipairs(parent:GetChildren()) do
            if Norm(c.Name) == want then row = c break end
        end
    end
    return row and row:FindFirstChildWhichIsA("TextButton") or nil
end

-- What is actually in there, for a miss message worth reading.
local function NamesIn(parent)
    if not parent then return "(panel not found)" end
    local names = {}
    for _, c in ipairs(parent:GetChildren()) do names[#names + 1] = c.Name end
    if #names == 0 then return "(empty)" end
    return table.concat(names, ", ")
end

local function DungeonBtn(name)
    return RowIn(Path(UI.DungeonList), name)
end

local function DifficultyBtn(name)
    return RowIn(Path(UI.DiffRoot), name)
end

-- Rows live in a ScrollingFrame; a row scrolled out of view has a valid
-- AbsolutePosition but cannot be clicked. Bring it into view first.
local function ScrollIntoView(btn)
    local sf = btn
    while sf and not sf:IsA("ScrollingFrame") do sf = sf.Parent end
    if not sf then return end
    local delta = btn.AbsolutePosition.Y - sf.AbsolutePosition.Y
    if delta < 0 or delta > sf.AbsoluteSize.Y - btn.AbsoluteSize.Y then
        sf.CanvasPosition = Vector2.new(sf.CanvasPosition.X,
            math.max(0, sf.CanvasPosition.Y + delta - sf.AbsoluteSize.Y / 2))
        S(0.35)
    end
end

-- Lobby vs dungeon, by what is ON SCREEN.
--
-- An earlier version tested whether queueGui / mainInterface EXISTED,
-- on the assumption that the dungeon was a separate place with its own
-- GUIs. It is not: the log showed "Lobby place: true" inside a dungeon
-- with playButton "exists but hidden". Both GUIs are present
-- everywhere, so existence proves nothing and only visibility counts.
--
-- Which marker to watch matters too. Cosmetics, Inventory, Player Stats
-- and Hide UI are on screen in BOTH. These four are lobby-only:
--   the Play button, Show Friends, Show Players, and the queue panels.
local LOBBY_MARKERS = {
    "LobbyPlay", "IntroPlay", "SelectPanel", "ChoosePanel",
    "LobbyInfo", "Replay", "ShowFriends", "ShowPlayers",
}

local lobbySeenAt = tick()   -- last moment a lobby marker was on screen

local function LobbyMarker()
    for _, k in ipairs(LOBBY_MARKERS) do
        if PathVisible(UI[k]) then
            lobbySeenAt = tick()
            return k
        end
    end
    return nil
end

local function InLobbyPlace()
    return LobbyMarker() ~= nil
end

-- How long the lobby has been off screen.
--
-- "No lobby marker" is NOT proof of being in a dungeon - it is briefly
-- true at boot before the GUI loads, and again during the queue
-- transition when the panels close. Treating that instant as "must be a
-- dungeon" is what started farm mode in the lobby and sent the bot at
-- an NPC. Anything that begins farming requires the lobby to have been
-- gone for a sustained period, not merely absent right now.
local function NotLobbyFor()
    LobbyMarker()                    -- refreshes lobbySeenAt
    return tick() - lobbySeenAt
end

local function DungeonConfirmed()
    return NotLobbyFor() >= CONFIG.LobbyGrace
end

-- Keep the reading fresh even when nothing else is asking.
task.spawn(function()
    while true do
        S(0.5)
        pcall(LobbyMarker)
    end
end)

-- One definition of "lobby", used everywhere. Keeping two slightly
-- different ones is what let the script believe it was in the lobby and
-- in a dungeon at the same time.
local InLobby = InLobbyPlace

local lobbyFlowActive = false

local function RunLobbyFlow()
    if not CONFIG.AutoRunDungeon then return end

    -- Guard on the PLACE, not on what happens to be visible. After
    -- finishing a run the lobby's buttons can be hidden behind a
    -- rewards popup, and requiring them to be on screen meant the
    -- script refused to queue and sat there instead. Step 1 already
    -- waits for the Play button to appear, which covers the popup.
    if not InLobbyPlace() then
        print("[DQR] Not in the lobby - refusing to queue a dungeon.")
        return
    end
    if lobbyFlowActive then
        print("[DQR] Lobby flow already running.")
        return
    end
    lobbyFlowActive = true

    print("[DQR] Lobby detected. Starting queue flow.")
    if CONFIG.DebugGui then DumpGui() end

    -- Remotes are only a hint here. TryFireDungeonRemote returned true as
    -- soon as it found *any* name-matching remote and blind-fired guessed
    -- arguments at it - and the old code then `return`ed, skipping the whole
    -- button flow. That is why the match never started. Now it is opt-in and
    -- never short-circuits the UI path.
    if CONFIG.UseRemotes then
        print("[DQR] Scanning for dungeon remotes...")
        PrintRemotes()
        S(0.5)
        TryFireDungeonRemote()
        S(2)
    end

    print("[DQR] Driving the lobby UI.")

    -- Waits for a path to become visible, then clicks it.
    local function Step(n, label, parts, wait)
        print(("[DQR] Step %d: %s"):format(n, label))
        local w = 0
        local o = PathVisible(parts)
        while not o and w < (wait or 8) do
            S(0.4) w = w + 0.4
            o = PathVisible(parts)
        end
        if not o then
            local exists = Path(parts)
            print(("[DQR]   MISS - %s (%s)"):format(
                table.concat(parts, "."),
                exists and "exists but hidden" or "does not exist"))
            return false
        end
        ClickButton(o)
        return true
    end

    -- Step 0: the intro/title splash. This is a DIFFERENT Play button
    -- (introGui.title.Frame.TextButton) from the lobby's
    -- mainInterface.buttons.playButton - the flow has to pass both.
    if PathVisible(UI.IntroPlay) then
        Step(0, "Intro splash Play", UI.IntroPlay, 3)
        local w = 0
        repeat S(0.5) w = w + 0.5 until PathVisible(UI.LobbyPlay) or w > 15
    end

    -- Step 1: lobby Play -> opens the Join/Create chooser
    if not Step(1, "Lobby Play", UI.LobbyPlay, 10) then
        lobbyFlowActive = false
        return
    end
    S(1.0)

    -- Step 2: "Create Dungeon" in the Join/Create chooser
    if not Step(2, "Create Dungeon", UI.CreateGame, 8) then
        lobbyFlowActive = false
        return
    end
    S(1.0)

    -- Step 3: pick the dungeon. Named frame, empty-text child button.
    print("[DQR] Step 3: Select " .. CONFIG.TargetDungeon)
    local db, w = DungeonBtn(CONFIG.TargetDungeon), 0
    while not db and w < 8 do
        S(0.4) w = w + 0.4
        db = DungeonBtn(CONFIG.TargetDungeon)
    end
    if db then
        ScrollIntoView(db)
        ClickButton(db)
    else
        print("[DQR]   MISS - no row named '" .. CONFIG.TargetDungeon .. "'.")
        print("[DQR]   Available: " .. NamesIn(Path(UI.DungeonList)))
        lobbyFlowActive = false
        return
    end
    S(0.8)

    -- Step 4: difficulty - same shape, frame named Easy/Medium/Hard/...
    -- Waited for, exactly like the dungeon row above. It used to be
    -- checked ONCE, 0.8s after the dungeon was picked, and the
    -- difficulty buttons are built after that choice - so a difficulty
    -- sitting in plain sight was reported missing purely because the
    -- panel had not finished populating.
    print("[DQR] Step 4: Difficulty " .. CONFIG.Difficulty)
    local fb, dw = DifficultyBtn(CONFIG.Difficulty), 0
    while not fb and dw < 8 do
        S(0.4) dw = dw + 0.4
        fb = DifficultyBtn(CONFIG.Difficulty)
    end
    if fb then
        ClickButton(fb)
    else
        -- Say what IS there. The dungeon step has always done this and
        -- it is how every naming mismatch so far got solved.
        print("[DQR]   MISS - no difficulty frame named '"
            .. CONFIG.Difficulty .. "'.")
        print("[DQR]   Available: " .. NamesIn(Path(UI.DiffRoot)))
    end
    S(0.8)

    -- Step 4b: HARDCORE MODE. Same shape as the difficulty buttons -
    -- a frame named "hardcore" holding the clickable TextButton.
    if CONFIG.Hardcore then
        print("[DQR] Step 4b: Hardcore mode")
        local hcFrame = Path(UI.Hardcore)
        local hc = hcFrame
            and hcFrame:FindFirstChildWhichIsA("TextButton") or nil
        if hc then
            ClickButton(hc)
            -- It is a toggle, not a radio button: if the game remembers
            -- the setting between runs this click could turn it back
            -- OFF. Watch the first couple of queues and say so if it
            -- alternates - the fix is to read its state before clicking.
            print("[DQR]   Hardcore toggled (toggle, not radio - verify).")
        else
            print("[DQR]   MISS - no hardcore button at "
                .. table.concat(UI.Hardcore, "."))
        end
        S(0.6)
    end

    -- Step 5: Create Lobby - verified by the panel actually closing
    print("[DQR] Step 5: Create Lobby")
    local made = false
    for attempt = 1, 4 do
        local cl = PathVisible(UI.CreateLobby)
        if not cl then S(0.5) else
            ClickButton(cl)
            local t = 0
            repeat S(0.3) t = t + 0.3
            until not PathVisible(UI.ChoosePanel) or t > 2.5
            if not PathVisible(UI.ChoosePanel) then made = true break end
            print("[DQR]   attempt " .. attempt .. " did not close the panel.")
        end
    end
    if not made then
        print("[DQR] Create Lobby did not take. Press Copy and send the log.")
        lobbyFlowActive = false
        return
    end
    S(1.2)

    -- Step 6: Start the run from the party screen
    Step(6, "Start run", UI.StartRun, 10)

    print("[DQR] Lobby flow complete.")
    lobbyFlowActive = false
end

-- ============================================================
--  MOB DETECTION - strict, cached
-- ============================================================
local cachedTarget = nil
local cachedMobs   = nil
local lastScan     = 0
local CACHE_TTL    = 0.15
-- Weak keys: entries vanish when the mob model is collected.
local mobShape  = setmetatable({}, {__mode = "k"})
local mobRadius = setmetatable({}, {__mode = "k"})

local function GetNearestMob()
    local root = GetRoot()
    if not root then return nil end
    local now = tick()

    -- Return cache if valid
    if cachedTarget and (now - lastScan) < CACHE_TTL then
        local h = cachedTarget.Humanoid
        if h and h.Health > 0 and cachedTarget.Root.Parent then
            cachedTarget.Distance =
                (cachedTarget.Root.Position - root.Position).Magnitude
            return cachedTarget
        end
    end

    lastScan = now
    local best, bestD = nil, math.huge
    local mobList = {}
    local seen = {}   -- reassigned between passes, so not a local const

    -- Find mobs by their HumanoidRootPart through the broadphase rather
    -- than walking every instance in the map.
    --
    -- Search outward in rings, stopping at the first that finds
    -- anything. A single 300-stud query returns far more than MaxParts
    -- in a dungeon and gets TRUNCATED - and not by distance, so the mob
    -- standing next to you could simply be missing from the results
    -- while one across the room was included. That is why it kept
    -- walking past near groups to reach far ones.
    -- The ring pre-check used looser criteria than the real mob test, so
    -- a ring containing something humanoid-but-not-a-mob would stop the
    -- search and leave us with nothing. Run the real test per ring and
    -- widen until an actual mob turns up.
    -- `deep` walks up from any part to find an owning Humanoid model.
    -- The cheap path keys on a part literally named HumanoidRootPart,
    -- which misses rigs that name their root anything else - bosses in
    -- particular. The deep pass is only used when the cheap one finds
    -- nothing, so the common case stays fast.
    local function Consider(prt, deep)
        local obj = nil
        if prt.Name == "HumanoidRootPart" then
            obj = prt.Parent
        elseif deep then
            local n = prt
            for _ = 1, 3 do
                if not n or n == workspace then break end
                if n:IsA("Model") and n:FindFirstChildOfClass("Humanoid") then
                    obj = n break
                end
                n = n.Parent
            end
        end
        if obj and obj:IsA("Model") and not seen[obj] then
            seen[obj] = true
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local mr  = obj:FindFirstChild("HumanoidRootPart")
                     or obj.PrimaryPart or prt
            -- Anchored used to disqualify a model outright, to skip
            -- static decorative NPCs. But a big boss rig is very often
            -- anchored too - it does not need physics - so the Ice
            -- Elemental was rejected before any other test ran. Keep
            -- the rule for ordinary mobs, waive it for boss-sized
            -- health pools.
            local bossy = hum and hum.MaxHealth >= CONFIG.BossHealthHint
            if hum and hum.Health > 0 and hum.MaxHealth > 0
            and (bossy or not mr.Anchored) then
                local isPlayer = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character == obj then isPlayer = true break end
                end
                if not isPlayer then
                    -- The shape test (health bar present, more than one
                    -- part) never changes for a given model, so do it
                    -- once and remember it. Running GetDescendants on
                    -- every model on every scan was the expensive half.
                    local shape = mobShape[obj]
                    if shape == nil then
                        local hasBB = false
                        for _, c in ipairs(obj:GetDescendants()) do
                            if c:IsA("BillboardGui") or c:IsA("Highlight") then
                                hasBB = true break
                            end
                        end
                        local pc = 0
                        for _, c in ipairs(obj:GetChildren()) do
                            if c:IsA("BasePart") or c:IsA("MeshPart")
                            or c:IsA("UnionOperation") then pc = pc + 1 end
                        end
                        -- A boss usually shows its health in a big GUI
                        -- on screen rather than a BillboardGui over its
                        -- head, so it fails the health-bar test and was
                        -- invisible to the bot. A huge health pool is a
                        -- reliable second signal that it is a real
                        -- enemy and not scenery.
                        shape = {ok = (hasBB and pc >= 2) or (bossy and pc >= 1),
                                 bb = hasBB}
                        mobShape[obj] = shape
                    end
                    local verdict = shape.ok
                    -- A BOSS, as opposed to a big mob: huge health pool
                    -- AND no health bar over its head. Health alone was
                    -- the test, and at this dungeon's level every Frost
                    -- Minion has 9K, so every minion was a "boss" -
                    -- direct approach, hazard backoff, beam-fan standoff
                    -- and all - which is why the bot kept backing off
                    -- ordinary mobs. The minions carry their bars over
                    -- their heads; the Ice Elemental's is at the top of
                    -- the screen.
                    local isBoss = bossy and not shape.bb
                    -- Skip anything the path worker has given up on, so
                    -- we stop pressing into a mountain at a mob on the
                    -- far side of it and go fight something reachable.
                    local blocked = unreachable[obj]
                    if blocked and tick() > blocked then
                        unreachable[obj] = nil
                        blocked = nil
                    end

                    if verdict then
                        -- How wide is it? Measured once per model. An
                        -- Ice Elemental's surface is 15+ studs from its
                        -- root, so every range has to account for that
                        -- or the bot fights a phantom at the centre.
                        local rad = mobRadius[obj]
                        if rad == nil then
                            local okx, sz = pcall(function()
                                return obj:GetExtentsSize() end)
                            rad = (okx and sz)
                                and math.max(0, math.max(sz.X, sz.Z) / 2 - 2)
                                or 0
                            -- Clamped. GetExtentsSize spans everything
                            -- in the model, so one stray part - an
                            -- effect parented to the rig, a projectile
                            -- it fired - makes a mob read as hundreds
                            -- of studs wide. Every range is
                            -- "base + radius", so that turned melee
                            -- range into 300 studs: the bot stood a
                            -- football pitch away swinging at air and
                            -- oscillating around a fighting distance
                            -- that did not exist.
                            rad = math.min(rad, CONFIG.MobRadiusMax)
                            mobRadius[obj] = rad
                        end
                        local d = (mr.Position - root.Position).Magnitude
                        local rec = {Model=obj, Root=mr, Humanoid=hum,
                                     Distance=d, Boss=isBoss, Radius=rad,
                                     Blocked=blocked ~= nil}
                        -- Every live mob goes in the list, blacklisted or
                        -- not: we still need to steer around one we have
                        -- given up on attacking.
                        mobList[#mobList + 1] = rec
                        if not blocked and d < bestD then
                            bestD = d
                            best  = rec
                        end
                    end
                end
            end
        end
    end

    for _, r in ipairs({60, 140, CONFIG.MobScanRadius}) do
        local parts = NearbyParts(root.Position, r)
        for _, prt in ipairs(parts) do Consider(prt, false) end
        if #mobList == 0 then
            -- Nothing by root-part name; look harder before widening.
            seen = {}
            for _, prt in ipairs(parts) do Consider(prt, true) end
        end
        if #mobList > 0 then break end
    end

    -- Last resort: the broadphase found nothing at any radius. Walk the
    -- models directly, which is slow but only happens when the map
    -- genuinely looks empty - and standing idle with a boss still alive
    -- is far worse than one expensive scan.
    if #mobList == 0 then
        seen = {}
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                local anchor = obj:FindFirstChild("HumanoidRootPart")
                            or obj.PrimaryPart
                            or obj:FindFirstChildWhichIsA("BasePart")
                if anchor then Consider(anchor, true) end
            end
        end
        -- Once every few seconds, not every scan: on a big map this
        -- fires on every tick that the nearest mob is beyond the widest
        -- ring, and flooded the log with nothing new. (The timestamp
        -- rides on mobShape under a string key - strings are never
        -- collected from a weak-keyed table - to spare a top-level
        -- local; the main chunk is near Luau's limit of 200.)
        if #mobList > 0 and now - (mobShape.fullScanWarn or 0) > 5 then
            mobShape.fullScanWarn = now
            print(("[DQR] Broadphase missed %d mob(s) - found them by "
                .. "full scan."):format(#mobList))
        end
    end

    -- Failsafe: everything in range is blacklisted. A mob standing next
    -- to us being called "unreachable" means the blacklist is wrong, so
    -- take it anyway. But one across the map is unreachable because it
    -- genuinely is - behind a door, in a room we have not opened - and
    -- wiping the blacklist to chase it again is what produced the loop:
    -- target, fail to path, blacklist, wipe, target the same one. Leave
    -- those entries alone and let them expire on their own clock, so
    -- the retry comes every UnreachableFor seconds instead of every
    -- tick.
    if not best and #mobList > 0 then
        local near = nil
        for _, rec in ipairs(mobList) do
            if rec.Distance < bestD and rec.Distance <= CONFIG.MobRadiusMax * 4 then
                bestD, near = rec.Distance, rec
            end
        end
        if near then
            table.clear(unreachable)
            best = near
            print("[DQR] All targets blacklisted but one is "
                .. math.floor(bestD) .. " studs away - clearing and taking it.")
        elseif now - (mobShape.blockedWarn or 0) > 10 then
            mobShape.blockedWarn = now
            print(("[DQR] All %d mob(s) unreachable and far off - waiting "
                .. "for the blacklist to expire rather than pacing.")
                :format(#mobList))
        end
    end

    -- Prefer the middle of a pack over whatever happens to be nearest.
    -- Standing among four mobs means every swing and every spell hits
    -- four; picking the nearest one repeatedly pulls the bot to the
    -- edge of a group and it fights them one at a time. Each mob is
    -- scored by how many others are within GroupRadius of it, against
    -- the extra walking to reach it. A boss is left alone - it has no
    -- pack, and its ranges are its own.
    if CONFIG.PreferGroups and best and not best.Boss and #mobList > 1 then
        local bestScore = -math.huge
        local pick = best
        for _, rec in ipairs(mobList) do
            if not rec.Blocked and not rec.Boss then
                local mates = 0
                for _, o in ipairs(mobList) do
                    if o ~= rec
                    and (o.Root.Position - rec.Root.Position).Magnitude
                        < CONFIG.GroupRadius then
                        mates = mates + 1
                    end
                end
                local score = mates * CONFIG.GroupWeight - rec.Distance
                if score > bestScore then bestScore, pick = score, rec end
            end
        end
        best = pick
    end

    cachedMobs  = mobList
    cachedTarget = best
    return best
end

-- Everything the last scan saw. Shares the scan with GetNearestMob so
-- crowd avoidance costs nothing extra.
local function GetMobs()
    return cachedMobs or {}
end

-- ============================================================
--  MOB DIAGNOSTIC  (F8)
--  Prints every humanoid model near you and the value of each test
--  the scanner applies, so a boss that is being skipped says WHY
--  rather than leaving us to guess at its rig.
-- ============================================================
local function MobDiag()
    local root = GetRoot()
    if not root then print("[DQR] No character.") return end
    print("[DQR] === MOB DIAG ===")

    local n, noHum = 0, 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local mr  = obj:FindFirstChild("HumanoidRootPart")
                     or obj.PrimaryPart
                     or obj:FindFirstChildWhichIsA("BasePart")
            local d = mr and (mr.Position - root.Position).Magnitude or -1

            if hum and d >= 0 and d < 400 then
                local hasBB = false
                for _, c in ipairs(obj:GetDescendants()) do
                    if c:IsA("BillboardGui") or c:IsA("Highlight") then
                        hasBB = true break
                    end
                end
                local pc = 0
                for _, c in ipairs(obj:GetChildren()) do
                    if c:IsA("BasePart") then pc = pc + 1 end
                end
                n = n + 1
                local shape = mobShape[obj]
                print(("%s | d=%d hp=%d/%d root=%s anchored=%s bb=%s parts=%d cached=%s boss=%s")
                    :format(obj:GetFullName(), d, hum.Health, hum.MaxHealth,
                            mr.Name, tostring(mr.Anchored), tostring(hasBB),
                            pc, tostring(shape and shape.ok),
                            tostring(hum.MaxHealth >= CONFIG.BossHealthHint
                                     and not hasBB)))

            elseif not hum and d >= 0 and d < 250 then
                -- A rig with no Humanoid at all would be invisible to
                -- every test above. Flag the plausible ones.
                local hasBB = false
                for _, c in ipairs(obj:GetChildren()) do
                    if c:IsA("BillboardGui") then hasBB = true break end
                end
                if hasBB then
                    noHum = noHum + 1
                    print(("[NO HUMANOID] %s | d=%d parts=%d")
                        :format(obj:GetFullName(), d,
                                #obj:GetChildren()))
                end
            end
        end
    end
    print(("[DQR] === END (%d humanoid models, %d humanoid-less with a "
        .. "health bar) ==="):format(n, noHum))
end

-- ============================================================
--  DUNGEON DETECTION
-- ============================================================
-- Reuses the mob scan rather than walking the map again. GetNearestMob
-- refreshes the cache when it is stale, so this costs one broadphase
-- query at most, and usually nothing at all.
local function MobsPresent()
    GetNearestMob()
    return #GetMobs() >= 2
end

-- In a dungeon = the lobby UI is gone. Mobs are corroborating evidence,
-- not the test: a cleared room has no mobs but you are still in the run.
local function IsInDungeon()
    if InLobby() then return false end
    -- Back in the lobby place with nothing to fight is not a dungeon,
    -- even when a popup is hiding the lobby's own buttons.
    if InLobbyPlace() and not MobsPresent() then return false end
    return MobsPresent()
end

local function IsInDungeonSafe()
    if not IsInDungeon() then return false end
    S(2) return IsInDungeon()
end

-- ============================================================
--  COMBAT - spells + melee swing
-- ============================================================
-- Block-scoped so only DoMelee and DoSpell reach the main chunk: it is
-- at Luau's limit of 200 live locals (see the note above Footprint).
local DoMelee, DoSpell
do

local spellSlot   = false
local lastSpell   = 0
local lastMelee   = 0

local function FireKey(kc)
    pcall(function() VIM:SendKeyEvent(true,  kc, false, game) end)
    S(0.05)
    pcall(function() VIM:SendKeyEvent(false, kc, false, game) end)
end

-- Where on screen an attack should be aimed. In "camera" mode the bot
-- owns the camera and points it at the mob, so the centre of the
-- viewport IS the mob. In "mouse" mode the camera is yours: the mob is
-- wherever it happens to be on screen, so aim there instead - and fall
-- back to the centre when it is behind you or off screen, where no
-- screen point exists.
local function AimPoint(aimAt)
    local cam = workspace.CurrentCamera
    local vp  = cam and cam.ViewportSize or Vector2.new(800, 600)
    local x, y = vp.X / 2, vp.Y / 2
    if cam and aimAt and CONFIG.AimMode == "mouse" then
        local ok, sp, onScreen = pcall(function()
            local p, v = cam:WorldToViewportPoint(aimAt)
            return p, v
        end)
        if ok and onScreen and sp then x, y = sp.X, sp.Y end
    end
    return x, y
end

-- The equipped weapon, if it is a Tool. Roblox weapons usually are,
-- and a Tool can be swung without touching the mouse at all.
local function EquippedTool()
    local c = GetChar()
    return c and c:FindFirstChildOfClass("Tool")
end

function DoMelee(aimAt)
    -- Left click swing - DQR auto-attacks on left mouse
    local now = tick()
    if now - lastMelee < CONFIG.MeleeRate then return end
    lastMelee = now

    -- Tool:Activate() fires the weapon's Activated event directly. No
    -- cursor, no screen coordinates, nothing for a HUD button to catch
    -- - which removes the whole class of problem where a swing opens
    -- the Inventory. It only works if the game listens on Activated
    -- rather than on the mouse itself, so it is opt-in: see MeleeMode.
    if CONFIG.MeleeMode ~= "click" then
        local tool = EquippedTool()
        if tool then
            task.spawn(function() pcall(function() tool:Activate() end) end)
            if CONFIG.MeleeMode == "tool" then return end
        end
    end

    task.spawn(function()
        pcall(function()
            local x, y = AimPoint(aimAt)
            -- A swing is aimed at the WORLD. If a HUD button happens to
            -- be under that pixel the click presses it instead, and at
            -- five swings a second that is how the Inventory kept
            -- flying open mid-fight. Skip the swing; the next one is
            -- 0.2s away.
            if ButtonsAtPoint(x, y)[1] then return end
            VIM:SendMouseMoveEvent(x, y, game)
            VIM:SendMouseButtonEvent(x, y, 0, true,  game, 0)
            S(0.05)
            VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end)
    end)
end

function DoSpell(dist, range, aimAt)
    if dist > (range or CONFIG.AttackRange) then return end
    local now = tick()
    if now - lastSpell < CONFIG.AttackRate then return end
    lastSpell = now
    spellSlot = not spellSlot
    task.spawn(function()
        -- Put the cursor on the mob first: a spell cast toward the
        -- mouse needs it there, and a spell that ignores the mouse
        -- does not care either way.
        if CONFIG.AimMode == "mouse" and aimAt then
            pcall(function()
                local x, y = AimPoint(aimAt)
                -- Parking the cursor on a HUD button is harmless by
                -- itself, but the next melee swing would click it.
                if not ButtonsAtPoint(x, y)[1] then
                    VIM:SendMouseMoveEvent(x, y, game)
                end
            end)
        end
        FireKey(spellSlot and Enum.KeyCode.Q or Enum.KeyCode.E)
    end)
end

end -- of the combat block

-- ============================================================
--  THREAT DETECTION
--  Projectiles are recognised by how they move, not by what colour
--  they are. A colour list was tried and kept missing things - the
--  Overlords' blue-purple spheres among them.
-- ============================================================

-- Anything this script spawned into the world. The range bar is red,
-- flat and long, i.e. it matches the telegraph test perfectly - and you
-- stand at one end of it, so without this the bot dodges its own line
-- forever.
local function IsOurs(o)
    return o == RangeBarPart or o.Name:sub(1, 4) == "DQR_"
end

-- Projectiles. Two things the old version got wrong, and both were
-- fatal against the Mage Overlord's orbs: it read the part's physics
-- velocity, which is zero for anything moved by CFrame or a tween -
-- which is most projectiles - and it only looked at red or Neon parts.
-- Now the velocity is measured from where the part was last sweep,
-- any small part that has just spawned is a candidate whatever its
-- colour, and only something that will actually pass within a few
-- studs of us counts. Returns hit, the part's position, its time to
-- impact, and its velocity.
-- The farm loop and the dodge watcher both poll ScanThreats at 20Hz;
-- the verdict is cached briefly so the work happens ~10x a second,
-- not 40. `seen` is where each candidate was last sweep (weak keys).
local threatCache = {t = 0, hit = false, pos = nil, tti = nil, vel = nil,
                     seen = setmetatable({}, {__mode = "k"})}

local function ScanThreatsRaw()
    local root = GetRoot()
    if not root then return false, nil end
    local now, me, char = tick(), root.Position, GetChar()
    local threatSeen = threatCache.seen
    local best, bestT, bestV, bestR = nil, math.huge, nil, 0
    local function Consider(obj)
        if not obj:IsA("BasePart") or IsOurs(obj) then return end
        if char and obj:IsDescendantOf(char) then return end
        local s = obj.Size
        -- Big projectiles exist: the Overlords throw purple spheres
        -- twenty-odd studs across. A flat 12-stud cap called those
        -- scenery and they were never dodged.
        if math.max(s.X, s.Y, s.Z) > CONFIG.ThreatMaxSize then return end
        local rad = math.max(s.X, s.Y, s.Z) / 2
        -- Judged by BEHAVIOUR, not by looks. The old gate demanded
        -- Neon, or a red/orange/pink colour, or a part that had just
        -- spawned - and a deep blue-purple ball drawn from an effect
        -- pool (so never "new") matched none of the three and was
        -- dropped before the motion test ever ran. What actually makes
        -- something a projectile is that it is not part of the map,
        -- not a creature, and moving at us; the motion test below
        -- decides, and it is far harder to fool than a colour list.
        if obj.CanCollide then return end        -- map geometry
        local owner = obj:FindFirstAncestorOfClass("Model")
        if owner and owner:FindFirstChildOfClass("Humanoid") then
            return                               -- a mob or a player
        end
        local vel = obj.AssemblyLinearVelocity
        local rec = threatSeen[obj]
        if vel.Magnitude < 8 and rec and now - rec.t > 0.02 then
            vel = (obj.Position - rec.pos) / (now - rec.t)   -- CFrame-driven
        end
        threatSeen[obj] = {pos = obj.Position, t = now}
        local speed = vel.Magnitude
        if speed < 8 or speed > 400 then return end
        local d = me - obj.Position
        if d.Magnitude < 1 then return end
        local u = vel / speed
        local along = d:Dot(u)
        if along <= 0 then return end                     -- moving away
        -- "Passes wide" has to account for how fat the thing is: a
        -- twenty-stud ball missing our centre by ten still swallows us.
        if (d - u * along).Magnitude > 7 + rad then return end
        local tti = along / speed
        if tti > 2.5 then return end                      -- not yet a worry
        if tti < bestT then best, bestT, bestV, bestR = obj, tti, vel, rad end
    end
    for _, obj in ipairs(NearbyParts(me, CONFIG.DodgeRange)) do Consider(obj) end
    -- Spawned parts too: the broadphase skips CanQuery-off effects.
    for p, born in pairs(recentParts) do
        if p.Parent and now - born < CONFIG.RecentWindow and not p.CanQuery
        and (p.Position - me).Magnitude < CONFIG.DodgeRange then
            Consider(p)
        end
    end
    if best then return true, best.Position, bestT, bestV, bestR end
    return false, nil
end

local function ScanThreats()
    local now = tick()
    if now - threatCache.t >= CONFIG.ThreatTTL then
        threatCache.t = now
        threatCache.hit, threatCache.pos, threatCache.tti,
        threatCache.vel, threatCache.rad = ScanThreatsRaw()
    end
    return threatCache.hit, threatCache.pos, threatCache.tti,
           threatCache.vel, threatCache.rad
end

-- ============================================================
--  GROUND TELEGRAPHS
--  The red strips a boss paints on the floor before it strikes are
--  ANCHORED and STATIONARY, so ScanThreats above - which only reacts
--  to parts moving at you faster than 8 studs/s - is blind to them.
--  These need a different test: am I standing inside the rectangle?
--  If so, leave across its NARROW axis, which is the shortest way out.
-- ============================================================
-- Everything from here to the end of HazardDiag sits in one `do` block
-- so its two dozen helpers stop counting against Luau's limit of 200
-- live locals in the main chunk. v8.6 crossed that limit, and an
-- executor reports it as "attempt to call a nil value" on line 1 -
-- loadstring returned nil and the loader called it. Only these three
-- names, plus the forward-declared HazardAt, IsBeamShape and
-- BeamShaped, are visible outside the block.
local hazardCache, ScanHazards, HazardDiag
do

-- Set once per sweep by ScanHazards: is the scanner settled enough
-- that a part first seen well inside its radius must have come to us?
local sweepFresh = false
local settledPos, settledAt = nil, 0
-- The nearest shelter dome this sweep, and how far away it was.
local shelterAt, shelterBest = nil, nil

-- A part's shape in WORLD terms: how tall it stands, and its two
-- horizontal extents with their directions. Reading Size.Y for the
-- height is wrong for anything rotated - a cylinder's axis is its X,
-- so a ring painted on the floor is a cylinder lying on its side, and
-- its Size.Y is the ring's diameter. The old test threw every one of
-- those out as "a prop" for being too tall.
local function Footprint(o)
    local cf, s = o.CFrame, PartSize(o)
    local rx = math.abs(cf.RightVector.Y)
    local uy = math.abs(cf.UpVector.Y)
    local lz = math.abs(cf.LookVector.Y)
    local height = rx * s.X + uy * s.Y + lz * s.Z
    -- Drop the most vertical axis; the other two are the footprint.
    if rx >= uy and rx >= lz then
        return height, s.Y, s.Z, cf.UpVector, cf.LookVector
    elseif uy >= rx and uy >= lz then
        return height, s.X, s.Z, cf.RightVector, cf.LookVector
    else
        return height, s.X, s.Y, cf.RightVector, cf.UpVector
    end
end

-- The long axis of a part, as a segment plus a radius. For anything
-- beam-shaped that is the beam; for anything else it is just its
-- longest side, which NearDist below still finds useful.
local function BeamSegment(o)
    local s = PartSize(o)
    local axis, half
    if s.X >= s.Y and s.X >= s.Z then
        axis = o.CFrame:VectorToWorldSpace(Vector3.new(1, 0, 0))
        half = s.X / 2
    elseif s.Y >= s.X and s.Y >= s.Z then
        axis = o.CFrame:VectorToWorldSpace(Vector3.new(0, 1, 0))
        half = s.Y / 2
    else
        axis = o.CFrame:VectorToWorldSpace(Vector3.new(0, 0, 1))
        half = s.Z / 2
    end
    local thin = math.min(s.X, s.Y, s.Z)
    return axis, half, thin / 2 + CONFIG.BeamPad
end

-- Horizontal distance from `p` to the segment a-b.
local function SegDistFlat(p, a, b)
    local ab = b - a
    local len2 = ab:Dot(ab)
    local t = len2 > 0.01 and math.clamp((p - a):Dot(ab) / len2, 0, 1) or 0
    local n = a + ab * t
    local dx, dz = p.X - n.X, p.Z - n.Z
    return math.sqrt(dx * dx + dz * dz)
end

-- How near a part really is: distance to the closest point of its long
-- axis, not to its centre. The centre of a 150-stud spoke sits 80
-- studs off while the spoke itself runs under our feet, so every gate
-- that compared centres was throwing the spokes away.
local function NearDist(o, pos)
    local axis, half = BeamSegment(o)
    return SegDistFlat(pos, o.Position - axis * half, o.Position + axis * half)
end

-- The game's warning colours, or nil. Red is the classic; The King
-- paints orange strips, some mobs paint the same rectangle a red one
-- would in purple, and Samurai Palace paints huge green circles.
-- Cyan/blue are handled by the beam tests.
local function WarnColor(c)
    local r, g, b = c.R, c.G, c.B
    if r > 0.55 and g < 0.45 and b < 0.45 then return "red" end
    -- Paint, not wood. Judged by saturation: attack orange - bright,
    -- yellow-orange, or a translucent part whose Color is still vivid
    -- - is saturated, while the dojo's orange-tan planks are muted
    -- (a plank is about 0.55 saturated; paint is 0.8 and up).
    local h, s, v = c:ToHSV()
    -- Through to YELLOW, not just orange: Pirate Island paints golden
    -- ellipses on the deck and they sat a hair outside a 0.15 ceiling.
    -- Saturation and brightness stay strict, which is what keeps sand
    -- and wood - muted, whatever their hue - out of the list.
    if h >= 0.04 and h <= 0.19 and s >= 0.65 and v >= 0.8 then
        return "orange"
    end
    -- Purple through magenta and pink. Loose on saturation on purpose:
    -- Enchanted Forest's markers run from vivid magenta strips to pale
    -- washed-out pink ellipses, and a 0.45 floor threw the pale ones
    -- away. What keeps the purple GROUND of that dungeon out is not
    -- the colour test but the solid-and-never-moved guard below.
    if h >= 0.70 and h <= 0.97 and s >= 0.18 and v >= 0.35 then
        return "purple"
    end
    -- Green, by hue. The old test demanded r < 0.55, and the bright
    -- lime discs sit above that - so the bot backed into one while
    -- dodging something else.
    if h >= 0.20 and h <= 0.45 and s >= 0.30 and v >= 0.45 then
        return "green"
    end
    return nil
end

-- HazardDebug: a warning-coloured part the size caps threw out, named
-- once every few seconds, so a ring the bot walked through can be
-- traced to the cap that rejected it.
local warnRejectAt = setmetatable({}, {__mode = "k"})
local function WarnReject(o, warn, why)
    if warn and CONFIG.HazardDebug then
        local now = tick()
        if not warnRejectAt[o] or now - warnRejectAt[o] > 5 then
            warnRejectAt[o] = now
            print(("[DQR] %s part rejected (%s): %s size=%s")
                :format(warn, why, o:GetFullName(), tostring(PartSize(o))))
        end
    end
    return false
end

-- `pos`/`radius` (optional) enable the first-sight rule in LooksActive:
-- scenery enters the scan at its edge as we walk, so a part first seen
-- well inside the radius appeared there.
local function IsTelegraph(o, pos, radius)
    if not o:IsA("BasePart") then return false end
    if IsOurs(o) then return false end
    -- Warning colours are trusted past the size caps; nothing else is.
    -- Giving every non-solid part the relaxed caps was too generous -
    -- a dungeon full of moving holograms and light panels then had
    -- room-sized "hazards" in it that nobody could see. An unknown
    -- colour still counts (see the bottom of this function), but it
    -- has to be marker-sized: thin, and not wider than a strip.
    local warn = WarnColor(o.Color)
    local maxY    = warn and CONFIG.RedMaxY    or CONFIG.TelegraphMaxY
    local maxWide = warn and CONFIG.RedMaxWide or CONFIG.TelegraphMaxWide
    local s = PartSize(o)
    -- Cheap rejections before touching the CFrame: nothing whose
    -- smallest side is taller than the limit can lie flat any way up.
    if math.min(s.X, s.Y, s.Z) > maxY then return WarnReject(o, warn, "too thick") end
    if math.max(s.X, s.Y, s.Z) < CONFIG.TelegraphMinLen then return false end
    local height, a, b = Footprint(o)
    if height > maxY then return WarnReject(o, warn, "too tall") end   -- a prop
    if math.max(a, b) < CONFIG.TelegraphMinLen then return false end
    -- A marker is a strip or a ring: narrow one way, or small. Wide
    -- both ways is a floor, and a whole room floor was being flagged.
    if math.min(a, b) > maxWide then return WarnReject(o, warn, "too wide") end

    -- Colour alone is not enough: the Ice Elemental paints CYAN rings,
    -- and cyan is also the colour of half the Winter Outpost scenery.
    -- What separates them is behaviour - the map is already there when
    -- we arrive and never moves; an attack marker either spawns or gets
    -- moved into place mid-fight. Asked BEFORE the visibility test, so
    -- a ring that fades in from invisible has a parked reading on
    -- record to be compared against.
    local fresh = sweepFresh and pos ~= nil
                  and NearDist(o, pos) < radius * 0.6
    local active, why = LooksActive(o, fresh)
    if o.Transparency > 0.95 then return false end

    if warn == "red" then return true end

    -- SOLID parts are the dangerous case for false positives: they are
    -- the floor you are standing on. One only counts if it has MOVED,
    -- FADED IN or GROWN, which floors never do. "Just spawned" is not
    -- enough - the game builds each room's floor as you reach it, so
    -- for eight seconds every plank of the dojo was a freshly spawned
    -- orange hazard and the bot stood on it waiting for an exit.
    if o.CanCollide then
        if why == "moved" or why == "faded" or why == "grew" then return true end
        return WarnReject(o, warn, "solid and never moved - scenery")
    end

    -- NON-SOLID and doing something: a marker, whatever colour it is.
    --
    -- Colour used to be required here, and it meant chasing a new
    -- palette every dungeon - red, then orange, then purple, then
    -- green, then yellow - while blue had to stay excluded because
    -- half of Winter Outpost is blue scenery. Behaviour separates them
    -- far better than colour ever did: scenery is solid, or it never
    -- changes. A flat, non-solid, walk-through part that just appeared
    -- or moved or faded in is a telegraph in any dungeon, in any
    -- colour, including the ones nobody has shown me yet.
    if active then return true end
    return false
end

-- ============================================================
--  HAZARD FOOTPRINTS
--  The scanners below already walk every nearby hazard part to answer
--  "am I standing in one". Recording the shape while they are there
--  costs nothing extra, and lets us also answer "would walking to X
--  put me in one" - without a second sweep and without any per-frame
--  work, which is what made the previous attempt at this unusable.
--
--  Everything stored here is plain numbers captured at sweep time, so
--  the lookup is pure maths with no instance access.
-- ============================================================
local hazardShapes = {}

-- A footprint this far across in its narrow direction cannot be
-- stepped out of within an escape's reach, and while it is in the
-- list every point around us reads as "inside", which hides the
-- hazards that CAN be dodged. Kept, but skipped when that happens.
-- Radius, so 100 is a ring 200 studs across. Samurai Palace's rings
-- are big - Musashi's covers half the arena - and still worth
-- stepping out of from anywhere near the edge, so the bar is high.
local HUGE = 100

-- HazardDebug: a census. Every footprint names the instance it came
-- from, once every few seconds per instance, so a slab on screen that
-- matches nothing visible can be traced to what produced it. Copy the
-- log while the slab is there, or press F9 for the current list.
local censusAt = setmetatable({}, {__mode = "k"})
local function Census(src, what)
    if not CONFIG.HazardDebug or not src then return end
    local now = tick()
    if censusAt[src] and now - censusAt[src] < 5 then return end
    censusAt[src] = now
    print(("[DQR] Hazard %s <- %s (%s)")
        :format(what, src:GetFullName(), src.ClassName))
end

local function Describe(h)
    if h.kind == "disc" then
        return ("disc r=%d"):format(h.r)
    elseif h.kind == "box" then
        return ("box %dx%d"):format(h.hx * 2, h.hz * 2)
    end
    return ("line len=%d r=%d"):format((h.b - h.a).Magnitude, h.r)
end

-- How long a source has been producing a footprint without a break.
-- An attack marker lasts seconds; something still there after
-- HazardMaxAge is decoration - a neon light strip, a lantern's Beam -
-- and treating it as a hazard forever is how the bot came to stand
-- all night "waiting out" a decoration between it and its target.
-- A break of a few seconds resets the clock, so a pooled effect that
-- fires again later is fresh again.
local srcFirst = setmetatable({}, {__mode = "k"})
local srcLast  = setmetatable({}, {__mode = "k"})
local function TooOld(src)
    if not src then return false end
    local now  = tick()
    local last = srcLast[src]
    if not last or now - last > 3 then srcFirst[src] = now end
    srcLast[src] = now
    if now - srcFirst[src] > CONFIG.HazardMaxAge then
        if CONFIG.HazardDebug and now - srcFirst[src] < CONFIG.HazardMaxAge + 0.2 then
            print("[DQR] Hazard aged out - decoration: " .. src:GetFullName())
        end
        return true
    end
    return false
end

local function NoteDisc(cx, cy, cz, r, src)
    if TooOld(src) then return end
    local h = {kind = "disc", x = cx, y = cy, z = cz, r = r,
               huge = r > HUGE, src = src}
    hazardShapes[#hazardShapes + 1] = h
    Census(src, Describe(h))
end

local function NoteBox(cf, hx, hz, cy, src)
    if TooOld(src) then return end
    local h = {kind = "box", cf = cf, hx = hx, hz = hz, y = cy,
               huge = math.min(hx, hz) > HUGE, src = src}
    hazardShapes[#hazardShapes + 1] = h
    Census(src, Describe(h))
end

local function NoteLine(a, b, r, src)
    if TooOld(src) then return end
    local h = {kind = "line", a = a, b = b, r = r, huge = r > HUGE, src = src}
    hazardShapes[#hazardShapes + 1] = h
    Census(src, Describe(h))
end

-- How far this world point is from the nearest hazard edge: negative
-- means inside one, by that much. Pure maths over a short list -
-- typically a handful of entries.
local function HazardClearance(p, ignoreHuge)
    local best = math.huge
    for _, h in ipairs(hazardShapes) do
        local c = nil
        -- The vertical tolerance is a body's worth: a ring sits at
        -- foot level, a laser at chest height. Fourteen studs also
        -- took in effect parts parked under the floor between casts.
        if ignoreHuge and h.huge then
            -- skip
        elseif h.kind == "disc" then
            if math.abs(p.Y - h.y) < 8 then
                local dx, dz = p.X - h.x, p.Z - h.z
                c = math.sqrt(dx * dx + dz * dz) - h.r
            end
        elseif h.kind == "box" then
            local rel = h.cf:PointToObjectSpace(p)
            if math.abs(rel.Y) < 8 then
                c = math.max(math.abs(rel.X) - h.hx, math.abs(rel.Z) - h.hz)
            end
        else
            local ab = h.b - h.a
            local len2 = ab:Dot(ab)
            if len2 > 0.01 then
                local t = math.clamp((p - h.a):Dot(ab) / len2, 0, 1)
                local n = h.a + ab * t
                if math.abs(p.Y - n.Y) < 8 then
                    local dx, dz = p.X - n.X, p.Z - n.Z
                    c = math.sqrt(dx * dx + dz * dz) - h.r
                end
            end
        end
        if c and c < best then best = c end
    end
    return best
end

-- Is this world point inside a known hazard?
function HazardAt(p)
    return HazardClearance(p) < 0
end

-- Our own character and other players' throw off parts constantly -
-- weapon trails, spell effects - and none of it is a thing to run from.
local function PlayerOwned(o)
    for _, pl in ipairs(Players:GetPlayers()) do
        local c = pl.Character
        if c and o:IsDescendantOf(c) then return true end
    end
    return false
end

-- Everything near `pos` that could be a hazard. The broadphase never
-- returns a part with CanQuery off - and effect parts very often have
-- it off so they stay out of the game's own raycasts - but the spawn
-- registry saw those arrive regardless, so add them to what it found.
local function HazardCandidates(pos, radius)
    -- The wide query is capped at MaxQueryParts and truncates
    -- arbitrarily past that, so in a busy arena the ring under our
    -- feet could be missing from it for a sweep - which stopped an
    -- escape dead in the middle of the ring. A small query cannot
    -- overflow, so anything actually touching us is guaranteed.
    local list = NearbyParts(pos, 10)
    local done = {}
    for _, o in ipairs(list) do done[o] = true end
    for _, o in ipairs(NearbyParts(pos, radius)) do
        if not done[o] then
            done[o] = true
            list[#list + 1] = o
        end
    end
    local now = tick()
    for p, born in pairs(recentParts) do
        if not p.Parent or now - born > CONFIG.RecentWindow then
            recentParts[p] = nil
        elseif not done[p] and not p.CanQuery and NearDist(p, pos) < radius then
            list[#list + 1] = p
        end
    end
    return list
end

-- Records the footprint of every ground telegraph near `pos`. Just the
-- shapes: deciding where to go is done afterwards, over all of them.
-- A big green DOME is shelter, not a hazard. The Crystal Golem drops
-- a crystal on your head and standing inside the dome is what saves
-- you - so it has to be told apart from Samurai Palace's flat green
-- discs, which are the opposite. Height does it: a dome is tall for
-- its width, a painted disc is not.
local function IsShelter(o)
    if not o:IsA("BasePart") or IsOurs(o) then return false end
    if o.CanCollide or o.Transparency > 0.9 then return false end
    local s = PartSize(o)
    local w = math.max(s.X, s.Z)
    if w < CONFIG.ShelterMinSize then return false end
    if s.Y < w * 0.25 then return false end        -- flat: a disc, not a dome
    local h, sat, v = o.Color:ToHSV()
    return h >= 0.20 and h <= 0.45 and sat >= 0.30 and v >= 0.45
end

-- A ball of damage sitting on the floor. Not flat, so the telegraph
-- test throws it out; not moving, so the projectile test never sees
-- it. The Overlords' purple spheres park on the ground and tick, and
-- nothing in the script looked at them.
local function IsBlob(o)
    if not o:IsA("BasePart") or IsOurs(o) then return false end
    if o.CanCollide or o.Transparency > 0.9 then return false end
    local s = PartSize(o)
    local w, d = s.X, s.Z
    if math.max(w, d) < CONFIG.TelegraphMinLen then return false end
    if math.max(w, d) > CONFIG.RedMaxWide then return false end
    -- Round seen from above, and tall enough that it is a body rather
    -- than a painted marker (those are handled by IsTelegraph).
    if math.abs(w - d) > math.max(w, d) * 0.35 then return false end
    if s.Y < math.max(w, d) * 0.3 then return false end
    -- Colour is not required - the balls come in green, blue, purple
    -- and yellow depending on the dungeon. Being a walk-through blob
    -- that just appeared, moved or lit up is the whole test.
    return LooksActive(o) or WarnColor(o.Color) ~= nil
end

local function CollectTelegraphs(pos)
    if not CONFIG.DodgeTelegraph then return end
    local radius = CONFIG.DodgeRange
    for _, o in ipairs(HazardCandidates(pos, radius)) do
        -- Shelter is recorded, never treated as something to avoid.
        if CONFIG.ShelterRescue and IsShelter(o) then
            local d = (o.Position - pos).Magnitude
            if d < (shelterBest or math.huge) then
                shelterBest, shelterAt = d, o.Position
            end
        elseif IsBlob(o) and not PlayerOwned(o)
        and math.abs(o.Position.Y - pos.Y) < 20 then
            local s = PartSize(o)
            NoteDisc(o.Position.X, o.Position.Y, o.Position.Z,
                     math.max(s.X, s.Z) / 2 + CONFIG.TelegraphPad, o)
        elseif IsTelegraph(o, pos, radius) and not PlayerOwned(o) then
            local _, a, b, va = Footprint(o)
            -- A ring AoE is as wide as it is long. Treating it as a box
            -- would pick one of its axes and walk us along a chord;
            -- the way out of a circle is straight outward from the
            -- centre, and that is also the shortest exit.
            -- Judged by the footprint alone. "A cylinder Part is a
            -- ring" used to short-circuit this, and the Frost Wizard's
            -- laser hitbox is a cylinder lying along the beam - 50 long,
            -- 2 across - which became a ring 56 studs wide: the huge
            -- slab that covered the room every time a wizard fired.
            if math.abs(a - b) < 2 then
                NoteDisc(o.Position.X, o.Position.Y, o.Position.Z,
                         math.max(a, b) / 2 + CONFIG.TelegraphPad, o)
            else
                -- A level frame whose X runs along the strip's first
                -- horizontal axis, so the box test can use it directly
                -- whichever way up the part happens to be built.
                local ax = Vector3.new(va.X, 0, va.Z)
                if ax.Magnitude < 0.01 then ax = Vector3.new(1, 0, 0) end
                local cf = CFrame.fromMatrix(o.Position, ax.Unit,
                                             Vector3.new(0, 1, 0))
                NoteBox(cf, a / 2 + CONFIG.TelegraphPad,
                        b / 2 + CONFIG.TelegraphPad, o.Position.Y, o)
            end
        end
    end
end

-- ============================================================
--  BEAMS / LASERS
--  A beam is a LINE, not a footprint, so neither of the scanners
--  above fits: ScanThreats wants something flying at you, and the
--  telegraph test wants you inside a rectangle. What matters here is
--  perpendicular distance to the line - and the way out of a laser is
--  sideways, never backwards along it.
--
--  Shape is what separates a laser from scenery: a beam is long in
--  EXACTLY ONE axis and thin in the other two. A wall is long in two.
--  That matters in Winter Outpost, where half the map is blue.
-- ============================================================
local function ColorIsBeam(c)
    -- cyan / blue, but not pale blue ice (which has high red too)
    if c.B > 0.5 and c.R < 0.5 and c.G > 0.35 then return true end   -- cyan
    if c.B > 0.55 and c.R < 0.45 and c.G < 0.55 then return true end -- blue
    return false
end

-- A real beam passes through your body; painted floor markings lie flat
-- on the ground. Without this, the cyan path stripes in Winter Outpost
-- match the beam test exactly - long in one axis, thin in the other
-- two, cyan - and the bot spends the whole dungeon dodging the scenery.
local function AtBodyHeight(o)
    local root = GetRoot()
    if not root then return true end
    local height = Footprint(o)
    local top  = o.Position.Y + height / 2
    local foot = root.Position.Y - CONFIG.FootOffset
    return top > foot + CONFIG.BeamMinHeight
end

-- Geometry only: long in exactly one axis, thin in the other two.
-- Declared at the top of the file: the spawn watcher and SurfaceRadius
-- use it too.
function BeamShaped(o)
    if not o:IsA("BasePart") then return false end
    if IsOurs(o) then return false end
    local s = PartSize(o)
    local x, y, z = s.X, s.Y, s.Z
    local minLen, maxThick = CONFIG.BeamMinLen, CONFIG.BeamMaxThick
    local long = (x >= minLen and 1 or 0) + (y >= minLen and 1 or 0)
               + (z >= minLen and 1 or 0)
    local thin = (x <= maxThick and 1 or 0) + (y <= maxThick and 1 or 0)
               + (z <= maxThick and 1 or 0)
    return long == 1 and thin >= 2
end

-- Shape and look - no height rule, and no visibility rule either: this
-- is what the spawn watcher at the top of the file uses to register
-- hidden (CanQuery off) beams, and a pooled beam is parked at
-- Transparency 1 until the moment it fires.
function IsBeamShape(o)
    if not BeamShaped(o) then return false end
    local c = o.Color
    return o.Material == Enum.Material.Neon or ColorIsBeam(c)
        or WarnColor(c) ~= nil   -- Musashi's lightning is orange
end

-- For a part that has JUST appeared, "it is long and thin and it was
-- not here a moment ago" is all the evidence needed. The colour test
-- exists to tell a laser from the scenery, and scenery does not spawn
-- mid-fight - which is also why a pale blue or white laser was being
-- ignored. An invisible one is a hitbox and counts too, unless it is
-- solid, in which case it is a wall that has just gone up.
local function IsNewBeam(o)
    if not BeamShaped(o) then return false end
    -- Solid means a bar, a rail, a gate that has just closed: map.
    if o.CanCollide then return false end
    -- Invisible used to count too, as a hitbox. But an attack also
    -- spawns invisible helpers - aim guides, sound carriers - and one
    -- of those became a hazard with nothing on screen to match it.
    -- Every beam that has actually hit us has been visible.
    if o.Transparency > 0.9 then return false end
    return true
end

local function NoteBeamPart(o)
    local axis, half, r = BeamSegment(o)
    NoteLine(o.Position - axis * half, o.Position + axis * half, r, o)
end

-- A Beam instance that could actually be a laser. Games use Beams for
-- all sorts - a wide flat texture strip under a mob, an invisible one
-- left Enabled with its transparency at 1 - and taking every Beam's
-- Width as a laser's thickness produced a hazard many times the size
-- of anything on screen. A laser is thin, visible and not absurdly
-- long.
local function BeamIsLaser(beam, a, b)
    local w = math.max(beam.Width0, beam.Width1)
    -- Up to 16 wide: a boss's strip drawn as a Beam is wider than a
    -- wizard's laser. (The "huge slab" of old was a cylinder hitbox,
    -- not a Beam, so this cap can afford to be generous.)
    if w <= 0 or w > 16 then return false end
    if (b - a).Magnitude > 300 then return false end
    local ok, visible = pcall(function()
        local minT = 1
        for _, k in ipairs(beam.Transparency.Keypoints) do
            if k.Value < minT then minT = k.Value end
        end
        return minT < 0.9
    end)
    return ok and visible
end

-- Records every beam near `pos` as a line footprint. Shapes only, no
-- decisions: an exit chosen while only half the beams were known was
-- an exit straight into the other half.
local function CollectBeams(pos)
    if not CONFIG.DodgeBeams then return end
    local now   = tick()
    local reach = CONFIG.DodgeRange

    -- 1. Every Beam object in the world, from the live registry.
    --
    -- The old code looked for Beams hanging off parts near US. But a
    -- Beam's attachments belong to the CASTER and its target, so a
    -- wizard firing from across the room has no part near us at all -
    -- the beam line passes through us while its owner is 100 studs
    -- away and out of the query. That is why real beams were missed.
    for beam in pairs(beamObjects) do
        if beam.Parent and beam.Enabled
        and beam.Attachment0 and beam.Attachment1
        and not PlayerOwned(beam) then
            local okA, a = pcall(function() return beam.Attachment0.WorldPosition end)
            local okB, b = pcall(function() return beam.Attachment1.WorldPosition end)
            if okA and okB and (b - a).Magnitude > 1
            and SegDistFlat(pos, a, b) < reach and BeamIsLaser(beam, a, b) then
                local w = math.max(beam.Width0, beam.Width1) / 2
                NoteLine(a, b, w + CONFIG.BeamPad, beam)
            end
        end
    end

    -- 2. Parts that APPEARED recently. Scenery loads with the map;
    --    an attack spawns during the fight. That timing is a far better
    --    signal than colour or height, and it is what separates a real
    --    beam from the painted floor stripes.
    for p, born in pairs(recentParts) do
        if not p.Parent or now - born > CONFIG.RecentWindow then
            recentParts[p] = nil
        elseif IsNewBeam(p) and NearDist(p, pos) < reach
        and not PlayerOwned(p) then
            NoteBeamPart(p)
        end
    end

    -- 3. Everything beam-shaped that has been sitting there, plus the
    --    ones the broadphase cannot see. Two ways in:
    --      * it has just been moved, resized, faded in or has turned up
    --        beside us - a pooled effect being fired, whatever colour
    --        it is. The Ice Elemental's telegraph spokes are hairline
    --        and near-white, and the blue test threw them all away;
    --      * or it is a standing laser at body height, which DOES have
    --        to look like one, since a blue ice crystal is the same
    --        shape and never moves.
    --    The activity test runs before the visibility one so a parked,
    --    invisible spoke is on record when it fades in.
    local done = {}
    local function Consider(o)
        if done[o] or not BeamShaped(o) or PlayerOwned(o) then return end
        done[o] = true
        -- Solid means a bar, a rail, a floor strip you stand on: map.
        if o.CanCollide then return end
        -- Scenery enters the scan at its edge as we walk; a part first
        -- seen well inside it appeared there.
        local fresh  = sweepFresh and NearDist(o, pos) < reach * 0.6
        local active = LooksActive(o, fresh)
        if recentParts[o] then return end           -- noted above already
        if o.Transparency > 0.9 then return end     -- parked, not firing
        if active or (IsBeamShape(o) and AtBodyHeight(o)) then
            NoteBeamPart(o)
        end
    end
    -- The broadphase query is CAPPED at MaxQueryParts and truncates
    -- arbitrarily past that - not by distance - so in a busy arena a
    -- spoke under our feet could simply be missing from the wide query
    -- while a pillar 70 studs off was included. A small query first
    -- cannot overflow, so anything actually touching us is guaranteed.
    -- The wide one is as far as we plan escapes; a long spoke is
    -- returned by either as long as any part of it is inside, since
    -- the query is against bounds, not centres.
    for _, o in ipairs(NearbyParts(pos, 10)) do Consider(o) end
    for _, o in ipairs(NearbyParts(pos, reach)) do Consider(o) end
    for o in pairs(hiddenBeams) do
        if not o.Parent then
            hiddenBeams[o] = nil
        elseif NearDist(o, pos) < reach then
            Consider(o)
        end
    end

    -- 4. Handle adornments - drawn, not built, so nothing above can see
    --    them. World placement is the adornee's frame times the
    --    adornment's own. A line runs from its origin along its
    --    LookVector for Length studs (CFrame.new(from, to) plus
    --    Length = distance is the idiom everyone uses to draw one); a
    --    cylinder is centred, along the same axis; a sphere or a flat
    --    image is a ring on the floor; a box is a beam if it is thin
    --    and a strip or ring telegraph if it is flat.
    for ad in pairs(adornObjects) do
        pcall(function()
            local adornee = ad.Adornee
            if not ad.Parent or not ad.Visible or not adornee
            or ad.Transparency > 0.9 then return end
            local acf = adornee:IsA("Model") and adornee:GetPivot()
                     or adornee.CFrame
            local cf = acf * ad.CFrame
            local a, b, r
            if ad:IsA("LineHandleAdornment") then
                a = cf.Position
                b = cf.Position + cf.LookVector * ad.Length
                r = CONFIG.BeamPad
            elseif ad:IsA("CylinderHandleAdornment") then
                local h = ad.Height / 2
                if math.abs(cf.LookVector.Y) > 0.7 then
                    -- Standing on end: a disc painted on the floor -
                    -- the ring under the boss that the spokes fan out
                    -- across. As a "line" this covered the whole
                    -- arena in one footprint.
                    if (cf.Position - pos).Magnitude < reach + ad.Radius then
                        NoteDisc(cf.Position.X, cf.Position.Y, cf.Position.Z,
                                 ad.Radius + CONFIG.TelegraphPad, ad)
                    end
                    return
                end
                a = cf.Position - cf.LookVector * h
                b = cf.Position + cf.LookVector * h
                r = ad.Radius + CONFIG.BeamPad
            elseif ad:IsA("SphereHandleAdornment") then
                -- A ring on the floor drawn as a squashed sphere.
                if ad.Radius * 2 >= CONFIG.TelegraphMinLen
                and (cf.Position - pos).Magnitude < reach + ad.Radius then
                    NoteDisc(cf.Position.X, cf.Position.Y, cf.Position.Z,
                             ad.Radius + CONFIG.TelegraphPad, ad)
                end
                return
            elseif ad:IsA("ImageHandleAdornment") then
                -- A picture in the adornment's XY plane: on the floor
                -- when its Z axis points up. Ring or strip by shape.
                if math.abs(cf.LookVector.Y) < 0.7 then return end
                local sx, sy = ad.Size.X, ad.Size.Y
                if math.max(sx, sy) < CONFIG.TelegraphMinLen
                or SegDistFlat(pos, cf.Position - cf.RightVector * sx / 2,
                                    cf.Position + cf.RightVector * sx / 2)
                   > reach + sy then return end
                if math.abs(sx - sy) < 2 then
                    NoteDisc(cf.Position.X, cf.Position.Y, cf.Position.Z,
                             math.max(sx, sy) / 2 + CONFIG.TelegraphPad, ad)
                else
                    local ax = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
                    if ax.Magnitude < 0.01 then ax = Vector3.new(1, 0, 0) end
                    NoteBox(CFrame.fromMatrix(cf.Position, ax.Unit,
                                              Vector3.new(0, 1, 0)),
                            sx / 2 + CONFIG.TelegraphPad,
                            sy / 2 + CONFIG.TelegraphPad, cf.Position.Y, ad)
                end
                return
            else
                local s = ad.Size
                local axis, half, thin
                if s.X >= s.Y and s.X >= s.Z then
                    axis, half = cf.RightVector, s.X / 2
                elseif s.Y >= s.X and s.Y >= s.Z then
                    axis, half = cf.UpVector, s.Y / 2
                else
                    axis, half = cf.LookVector, s.Z / 2
                end
                thin = math.min(s.X, s.Y, s.Z)
                if thin > CONFIG.BeamMaxThick or half * 2 < CONFIG.BeamMinLen then
                    -- Not a beam. A flat wide box lying on the floor is
                    -- a strip or a ring telegraph, same as a flat part.
                    local height = math.abs(cf.RightVector.Y) * s.X
                                 + math.abs(cf.UpVector.Y) * s.Y
                                 + math.abs(cf.LookVector.Y) * s.Z
                    if height > CONFIG.RedMaxY then return end
                    local fa, fb, va
                    if math.abs(cf.RightVector.Y) >= 0.7 then
                        fa, fb, va = s.Y, s.Z, cf.UpVector
                    elseif math.abs(cf.UpVector.Y) >= 0.7 then
                        fa, fb, va = s.X, s.Z, cf.RightVector
                    else
                        fa, fb, va = s.X, s.Y, cf.RightVector
                    end
                    if math.max(fa, fb) < CONFIG.TelegraphMinLen
                    or (cf.Position - pos).Magnitude > reach + math.max(fa, fb) then
                        return
                    end
                    if math.abs(fa - fb) < 2 then
                        NoteDisc(cf.Position.X, cf.Position.Y, cf.Position.Z,
                                 math.max(fa, fb) / 2 + CONFIG.TelegraphPad, ad)
                    else
                        local ax = Vector3.new(va.X, 0, va.Z)
                        if ax.Magnitude < 0.01 then ax = Vector3.new(1, 0, 0) end
                        NoteBox(CFrame.fromMatrix(cf.Position, ax.Unit,
                                                  Vector3.new(0, 1, 0)),
                                fa / 2 + CONFIG.TelegraphPad,
                                fb / 2 + CONFIG.TelegraphPad, cf.Position.Y, ad)
                    end
                    return
                end
                a = cf.Position - axis * half
                b = cf.Position + axis * half
                r = thin / 2 + CONFIG.BeamPad
            end
            if (b - a).Magnitude >= CONFIG.BeamMinLen
            and SegDistFlat(pos, a, b) < reach then
                NoteLine(a, b, r, ad)
            end
        end)
    end
end

-- Are the line hazards spokes radiating from `c`? Returns how many
-- are, the smallest angle between two neighbouring spokes (nil when
-- there are fewer than three to measure), and the widest spoke's
-- radius, pad included.
local function RadialSpokes(c)
    local angs = {}
    local rMax = CONFIG.BeamPad
    local function Spoke(a, b, r)
        if r and r > rMax then rMax = r end
        local ab = b - a
        local len2 = ab:Dot(ab)
        if len2 < 0.01 then return end
        local t = (c - a):Dot(ab) / len2
        if t < -0.3 or t > 1.3 then return end      -- c is off the end
        local n = a + ab * t
        local dx, dz = c.X - n.X, c.Z - n.Z
        if dx * dx + dz * dz > 49 then return end   -- misses c by > 7
        local ra = Vector3.new(a.X - c.X, 0, a.Z - c.Z)
        local rb = Vector3.new(b.X - c.X, 0, b.Z - c.Z)
        if ra:Dot(rb) < 0 then
            -- Straight through the centre: a spoke each way.
            if ra.Magnitude > 4 then angs[#angs + 1] = math.atan2(ra.Z, ra.X) end
            if rb.Magnitude > 4 then angs[#angs + 1] = math.atan2(rb.Z, rb.X) end
        else
            local far = ra.Magnitude > rb.Magnitude and ra or rb
            if far.Magnitude > 4 then angs[#angs + 1] = math.atan2(far.Z, far.X) end
        end
    end
    for _, h in ipairs(hazardShapes) do
        if h.kind == "line" and not h.huge then
            Spoke(h.a, h.b, h.r)
        elseif h.kind == "box"
        and math.max(h.hx, h.hz) > 3 * math.min(h.hx, h.hz) then
            -- A long strip is a beam painted on the floor.
            local axis = h.hx >= h.hz and h.cf.RightVector
                       or h.cf:VectorToWorldSpace(Vector3.new(0, 0, 1))
            local half = math.max(h.hx, h.hz)
            Spoke(h.cf.Position - axis * half, h.cf.Position + axis * half,
                  math.min(h.hx, h.hz))
        end
    end
    if #angs < 3 then return #angs, nil, rMax end
    table.sort(angs)
    -- Drop duplicates: the same beam seen as both a Beam and a part.
    local u = {angs[1]}
    for i = 2, #angs do
        if angs[i] - u[#u] > 0.05 then u[#u + 1] = angs[i] end
    end
    if #u > 1 and u[1] + 2 * math.pi - u[#u] <= 0.05 then table.remove(u) end
    if #u < 3 then return #u, nil, rMax end
    local minGap = u[1] + 2 * math.pi - u[#u]
    for i = 2, #u do
        local g = u[i] - u[i - 1]
        if g < minGap then minGap = g end
    end
    return #u, minGap, rMax
end

local ESCAPE_DIRS = {}
for i = 0, 15 do
    local a = i * math.pi / 8
    ESCAPE_DIRS[i + 1] = Vector3.new(math.cos(a), 0, math.sin(a))
end

-- Somewhere near `pos` that is outside every known hazard, with room to
-- spare, and reachable without walking through another one on the way.
-- The old escape stepped sideways out of ONE beam with no idea what
-- else was on the floor, which between two radial beams meant stepping
-- straight into the next one - and back, and forth. `mobPos` biases the
-- pick outward when the hazards radiate from the mob (the gaps widen
-- with distance) and keeps it inside `keepWithin` of the mob so we can
-- go on casting.
-- `ignoreHuge` drops footprints too big to step out of (see HUGE):
-- with one of those under everything, every sample reads "inside" and
-- the spokes that CAN be dodged are invisible behind it. The last
-- resort is the least-bad point: still inside something, but deeper
-- into a gap than where we stand.
-- `prevDir`, if given, is the heading of the exit chosen a moment ago:
-- a re-pick prefers to keep going that way. Without it, when a new
-- line landed across the chosen route the re-pick had no memory and
-- could flip to the other side, then back - dithering between two
-- exits while the beam it stood in went off.
local function FindEscape(pos, mobPos, keepWithin, outward, ignoreHuge, prevDir)
    local clean, narrow, crossing = {}, {}, {}
    local bestBad, bestBadC = nil, HazardClearance(pos, ignoreHuge) + 2
    local flatNow = 0
    if mobPos then
        flatNow = Vector3.new(pos.X - mobPos.X, 0, pos.Z - mobPos.Z).Magnitude
    end
    for _, dir in ipairs(ESCAPE_DIRS) do
        local wasClear, crossed = false, false
        local keep = prevDir and dir:Dot(prevDir) * 4 or 0
        for d = 3, CONFIG.EscapeMaxDist, 3 do
            local p = pos + dir * d
            local c = HazardClearance(p, ignoreHuge)
            if c <= 0 then
                -- Back inside something after having been clear: this
                -- heading crosses a second hazard to get anywhere.
                if wasClear then crossed = true end
                if c > bestBadC then bestBad, bestBadC = p, c end
            else
                wasClear = true
                local score = math.min(c, CONFIG.EscapeClearWant) * 2 - d * 0.5 + keep
                if mobPos then
                    local flatNew = Vector3.new(p.X - mobPos.X, 0,
                                                p.Z - mobPos.Z).Magnitude
                    if outward then
                        score = score + math.clamp(flatNew - flatNow, -10, 15) * 0.6
                    end
                    if keepWithin and flatNew > keepWithin then
                        score = score - (flatNew - keepWithin)
                    end
                end
                -- A spot squeezed between two pads is a last resort.
                local list = crossed and crossing
                          or c < CONFIG.ExitMinClear and narrow
                          or clean
                list[#list + 1] = {p = p, score = score}
            end
        end
    end
    -- Maths first, raycasts only for the front-runners.
    local function ByScore(a, b) return a.score > b.score end
    for _, list in ipairs({clean, narrow, crossing}) do
        table.sort(list, ByScore)
        for i = 1, math.min(#list, 6) do
            local p = list[i].p
            if LineClear(pos, p) and HasGround(p) and GroundOnPath(pos, p) then
                return p
            end
        end
    end
    if bestBad and LineClear(pos, bestBad) and HasGround(bestBad)
    and GroundOnPath(pos, bestBad) then
        return bestBad
    end
    return nil
end

-- When the last hop happened and which way it went: TryHop sets them,
-- NearestClear and TryHop read them to refuse a quick reversal.
local lastBlink, lastBlinkDir = 0, nil

-- Can a hop from `from` land at `to`? A hop is not a walk: physics
-- will not stop it at a wall or drop it at a ledge, so everything a
-- walk discovers by bumping has to be checked beforehand. Nothing
-- solid between here and there at shin, hip and head height, body
-- wide; a floor there, flat enough to stand on and within a short
-- step up or down of ours; and nothing solid in the space a body
-- takes up at the landing. Returns the landing point, floor height
-- included, or nil.
local function HopClear(from, to)
    local char = GetChar()
    local rp = RaycastParams.new()
    rp.FilterType = EXCLUDE
    rp.FilterDescendantsInstances = {char, RangeBarPart}

    local d = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
    if d.Magnitude < 0.5 then return nil end
    -- Heights are relative to the root, which sits FootOffset above the
    -- feet: the lowest ray runs two studs off the ground, low enough
    -- for a crate or a fence, high enough not to graze a gentle slope.
    local side = Vector3.new(-d.Unit.Z, 0, d.Unit.X) * CONFIG.AgentWidth
    for _, h in ipairs({-1, 1, 2.5}) do
        for _, off in ipairs({Vector3.zero, side, -side}) do
            local hit = workspace:Raycast(from + off + Vector3.new(0, h, 0), d, rp)
            if hit and hit.Instance.CanCollide then return nil end
        end
    end

    local flat = Vector3.new(to.X, from.Y, to.Z)
    local hit = workspace:Raycast(flat + Vector3.new(0, 4, 0),
                                  Vector3.new(0, -12, 0), rp)
    if not hit or not hit.Instance.CanCollide then return nil end  -- a pit
    if hit.Normal.Y < 0.6 then return nil end                      -- a slope
    local y = hit.Position.Y + CONFIG.FootOffset
    if math.abs(y - from.Y) > 5 then return nil end                -- a ledge

    local op = OverlapParams.new()
    op.FilterType = EXCLUDE
    op.FilterDescendantsInstances = {char, RangeBarPart}
    op.MaxParts = 20
    local body = CFrame.new(to.X, y + 0.5, to.Z)
    for _, p in ipairs(workspace:GetPartBoundsInBox(body, Vector3.new(3, 4, 3), op)) do
        if p.CanCollide then return nil end                        -- inside something
    end
    return Vector3.new(to.X, y, to.Z)
end

-- Where a hop lands: the closest point outside every footprint, in
-- whichever direction that is, that HopClear will allow. Fine-grained,
-- unlike FindEscape's coarse samples, and shortest-first rather than
-- best-scored - a hop should land just clear, not a stride further
-- along a heading that happened to have more room. nil when nothing
-- within TeleportMax is both safe and reachable.
local function NearestClear(pos, ignoreHuge)
    local found = {}
    for _, dir in ipairs(ESCAPE_DIRS) do
        for d = 1, CONFIG.TeleportMax do
            local p = pos + dir * d
            if HazardClearance(p, ignoreHuge) >= CONFIG.TeleportClear then
                -- Shortest first, but a hop that would double back on
                -- the last one counts as three studs longer.
                local cost = d
                if lastBlinkDir and tick() - lastBlink < 2
                and dir:Dot(lastBlinkDir) < -0.3 then
                    cost = cost + 3
                end
                found[#found + 1] = {p = p, d = cost}
                break
            end
        end
    end
    table.sort(found, function(a, b) return a.d < b.d end)
    for _, f in ipairs(found) do
        local land = HopClear(pos, f.p)
        if land then return land, f.d end
    end
    return nil
end

-- The hop itself, to a point HopClear has already passed. One CFrame
-- write: rotation kept, velocity zeroed so physics does not carry us
-- on. Gated: never inside the cooldown, and never a hop that reverses
-- the one before it within two seconds - that is how the bot came to
-- flick left, right, left between two strips and get hit anyway. A
-- reversal is walked instead. (lastBlink / lastBlinkDir are declared
-- above HopClear, since NearestClear reads them too.)
local hopTimes = {}
local function TryHop(root, land)
    -- The one gate every hop passes through, so turning the switch
    -- off is enough on its own - no call site can hop around it.
    if not CONFIG.HazardTeleport then return false end
    local now = tick()
    if now - lastBlink < CONFIG.TeleportCooldown then return false end
    -- Budget: at most TeleportsPerMin in any rolling minute. The
    -- cooldown alone allowed about ninety a minute in a busy fight,
    -- and that volume of CFrame writes is what an anti-cheat notices.
    while hopTimes[1] and now - hopTimes[1] > 60 do table.remove(hopTimes, 1) end
    if #hopTimes >= CONFIG.TeleportsPerMin then
        if CONFIG.HazardDebug then
            print("[DQR] Hop budget spent for this minute - walking.")
        end
        return false
    end
    local pos = root.Position
    local dir = Vector3.new(land.X - pos.X, 0, land.Z - pos.Z)
    -- Too short to be worth a CFrame write: walk it.
    if dir.Magnitude < CONFIG.TeleportMinDist then return false end
    dir = dir.Unit
    if lastBlinkDir and now - lastBlink < 2 and dir:Dot(lastBlinkDir) < -0.3 then
        return false
    end
    local ok = pcall(function()
        local rot = root.CFrame - root.CFrame.Position
        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = CFrame.new(land) * rot
    end)
    if ok then
        lastBlink, lastBlinkDir = now, dir
        hopTimes[#hopTimes + 1] = now
    end
    return ok
end

-- HazardDebug only: draws every footprint from the last sweep as a red
-- slab on the floor, so what the bot thinks is dangerous can be held
-- up against what is actually on screen. Named DQR_ so the scanners
-- ignore them; CanQuery off so no query or raycast sees them.
local drawPool = {}
local function DrawHazards()
    local n = 0
    for _, h in ipairs(hazardShapes) do
        if n >= 40 then break end
        n = n + 1
        local p = drawPool[n]
        if not p or not p.Parent then
            p = Instance.new("Part")
            p.Name         = "DQR_Hz"
            p.Anchored     = true
            p.CanCollide   = false
            p.CanQuery     = false
            p.CanTouch     = false
            p.CastShadow   = false
            p.Material     = Enum.Material.Neon
            p.Color        = Color3.fromRGB(255, 60, 60)
            p.Transparency = 0.45
            p.Parent       = workspace
            drawPool[n] = p
        end
        -- Drawn at the hazard's own height (a touch above, so it is
        -- not z-fighting with the floor) - not ours, or it bobs about
        -- every time the character jumps.
        if h.kind == "line" then
            local a, b = h.a, h.b
            local d = (b - a).Magnitude
            if d > 0.1 then
                p.Size   = Vector3.new(h.r * 2, 0.3, d)
                p.CFrame = CFrame.lookAt((a + b) / 2 + Vector3.new(0, 0.3, 0), b)
            end
        elseif h.kind == "disc" then
            p.Size   = Vector3.new(h.r * 2, 0.3, h.r * 2)
            p.CFrame = CFrame.new(h.x, h.y + 0.3, h.z)
        else
            local c = h.cf.Position
            p.Size   = Vector3.new(h.hx * 2, 0.3, h.hz * 2)
            p.CFrame = CFrame.new(c.X, h.y + 0.3, c.Z) * (h.cf - h.cf.Position)
        end
    end
    -- Park the rest out of sight rather than churn instances.
    for i = n + 1, #drawPool do
        local p = drawPool[i]
        if p and p.Parent and p.Position.Y > -400 then
            p.CFrame = CFrame.new(0, -500, 0)
        end
    end
end

-- One call for every "get out of the way" test. Cached: two 20Hz
-- threads poll this, and re-running the scans 40 times a second was a
-- large part of the in-combat lag.
hazardCache = {t = 0, escape = nil, radial = false, radialN = 0,
               backoffR = nil, backoffFor = nil,
               holdP = nil, holdUntil = 0, commitUntil = 0,
               restUntil = 0, resting = false, sheltering = false,
               waitSince = 0, waitBlock = 0}

-- A sidestep out of a projectile's way, shared by the main loop and
-- the dodge watcher: to whichever side the thing is NOT drifting
-- toward (`fallback` decides when it is coming dead straight), by
-- DodgeStep, somewhere walkable and clear of hazards - and when it is
-- about to land, a hop there instead of a walk. Returns the spot.
-- Lives on hazardCache rather than as a local: the main chunk is at
-- Luau's local limit.
hazardCache.Dodge = function(root, origin, vel, urgent, fallback, rad)
    local pos = root.Position
    local toward = Vector3.new(origin.X - pos.X, 0, origin.Z - pos.Z)
    if toward.Magnitude < 0.5 then return nil end
    toward = toward.Unit
    local perp = Vector3.new(-toward.Z, 0, toward.X)
    local lat = vel and perp:Dot(Vector3.new(vel.X, 0, vel.Z)) or 0
    local sign = lat > 1 and -1 or lat < -1 and 1 or fallback
    -- Step far enough to actually clear the thing. Eight studs is
    -- plenty beside a dart and useless beside a twenty-stud ball.
    local step = math.max(CONFIG.DodgeStep, (rad or 0) + 6)
    local p = SafeStep(pos, perp * sign, step)
           or SafeStep(pos, perp * -sign, step)
    if not p then return nil end
    if urgent and CONFIG.HazardTeleport then
        local land = HopClear(pos, p)
        if land then TryHop(root, land) end
    end
    return p
end

function ScanHazards()
    local now = tick()
    if now - hazardCache.t < CONFIG.HazardTTL then
        return hazardCache.escape
    end
    local lastSweep = hazardCache.t
    hazardCache.t = now
    local root = GetRoot()
    if not root then
        hazardCache.escape = nil
        return nil
    end
    local pos = root.Position

    -- Muted by the combat-stall watchdog: no footprints, no escapes,
    -- fight on. See StallTime.
    if now < (hazardCache.muteUntil or 0) then
        table.clear(hazardShapes)
        hazardCache.escape, hazardCache.holdP = nil, nil
        hazardCache.resting, hazardCache.radialN = false, 0
        return nil
    end

    -- First-sight activity (see LooksActive) is off for a few seconds
    -- after the scanner starts or resumes, and after any teleport - a
    -- respawn, a room change - because then EVERYTHING is new, at
    -- every distance.
    if not settledPos or (pos - settledPos).Magnitude > 30
    or now - lastSweep > 2 then
        settledAt = now
    end
    settledPos = pos
    sweepFresh = (now - settledAt) > 3

    -- Rebuilt every sweep, and completely, before anything is decided.
    table.clear(hazardShapes)
    shelterAt, shelterBest = nil, nil
    CollectTelegraphs(pos)
    CollectBeams(pos)

    -- Something dropping on our head - the Crystal Golem marks you
    -- with a crystal, and the only answer is to get under the dome.
    -- This outranks every other movement: a hazard on the floor costs
    -- a fraction of what the crystal does.
    if CONFIG.ShelterRescue and shelterAt then
        local overhead = false
        for _, o in ipairs(NearbyParts(pos + Vector3.new(0, 16, 0), 12)) do
            if not IsOurs(o) and not o.CanCollide and recentParts[o]
            and o.Position.Y > pos.Y + CONFIG.OverheadHeight
            and not PlayerOwned(o) then
                overhead = true
                break
            end
        end
        hazardCache.sheltering = overhead
        if overhead then
            hazardCache.escape = shelterAt
            hazardCache.holdP, hazardCache.commitUntil = shelterAt, now + 3
            if CONFIG.HazardDebug then
                print(("[DQR] Marked from above - running for the dome (%d studs).")
                    :format(shelterBest or 0))
            end
            return shelterAt
        end
    else
        hazardCache.sheltering = false
    end
    if CONFIG.HazardDebug then pcall(DrawHazards) end

    -- Is the target fanning beams out around itself? Measured every
    -- sweep, not only once we are hit: the main loop keeps its
    -- distance for as long as the spokes are on the floor, and the
    -- old "six seconds after the last hit" walked the bot back into a
    -- fan that was still there.
    local mobPos, keep = nil, nil
    local tgt = cachedTarget
    hazardCache.radialN = 0
    if tgt and tgt.Root and tgt.Root.Parent then
        mobPos = tgt.Root.Position
        keep   = CONFIG.AttackRange + (tgt.Radius or 0) - 3
        -- A standoff measured against one boss says nothing about the
        -- next one.
        if hazardCache.backoffFor ~= tgt.Model then
            hazardCache.backoffFor, hazardCache.backoffR = tgt.Model, nil
        end
        if #hazardShapes > 0 then
            local n, gap, rMax = RadialSpokes(mobPos)
            hazardCache.radialN = n
            if gap then
                -- Far enough out that neighbouring beams leave
                -- BeamGapWant studs of floor between their pads - the
                -- pads of the beams as they actually are, since the
                -- thick ones need more room than the hairlines.
                hazardCache.backoffR = math.min(CONFIG.BeamBackoffMax,
                    (2 * rMax + CONFIG.BeamGapWant) / gap)
            end
        end
    end
    -- Outward bias for the exit only against a boss's fan; a wizard's
    -- beam is left sideways, and the fight stays where it was.
    local outward = hazardCache.radialN >= 2 and tgt ~= nil and tgt.Boss == true
    hazardCache.radial = outward

    local esc = nil
    local held = hazardCache.holdP
    hazardCache.resting = false
    if #hazardShapes > 0 and HazardAt(pos) then
        hazardCache.restUntil = 0
        -- Keep a chosen exit for a moment rather than re-picking every
        -- sweep and zig-zagging between two equally good ones - unless
        -- the walk to it now crosses something that was not there when
        -- it was picked.
        if held and now < hazardCache.holdUntil
        and HazardClearance(held, true) > 0
        and not HazardOnPath(pos, held) then
            esc = held
        else
            -- The heading we were already escaping along, if any, so
            -- a re-pick keeps going rather than flipping sides.
            local prevDir = nil
            if held then
                local d = Vector3.new(held.X - pos.X, 0, held.Z - pos.Z)
                if d.Magnitude > 1 then prevDir = d.Unit end
            end
            local how, tier2 = "clear", false
            esc = FindEscape(pos, mobPos, keep, outward, false, prevDir)
            if not esc then
                how, tier2 = "clear of what can be dodged", true
                esc = FindEscape(pos, mobPos, keep, outward, true, prevDir)
            end
            hazardCache.holdP, hazardCache.holdUntil = esc, now + 1.2
            hazardCache.commitUntil = now + 2.5

            -- A safe spot within hopping range? Straight there, and
            -- that is the whole escape: land just clear, then rest
            -- (below). Otherwise it is a walk from the start.
            if esc and CONFIG.HazardTeleport
            and now - lastBlink > CONFIG.TeleportCooldown then
                local near, hop = NearestClear(pos, tier2)
                if near and TryHop(root, near) then
                    esc = near
                    hazardCache.holdP, hazardCache.commitUntil = near, now
                    hazardCache.restUntil = now + CONFIG.RestMaxTime
                    how = ("hopped %d studs"):format(hop)
                end
            end

            if CONFIG.HazardDebug then
                print(("[DQR] In a hazard (%d footprint(s), %d spokes) - %s")
                    :format(#hazardShapes, hazardCache.radialN,
                            esc and how:find("hopped") and how
                            or esc and ("moving " .. how)
                            or "NO EXIT FOUND"))
            end
        end
    elseif held and now < hazardCache.commitUntil
    and Vector3.new(held.X - pos.X, 0, held.Z - pos.Z).Magnitude > 2.5
    and HazardClearance(held, true) > 0
    and not HazardOnPath(pos, held) then
        -- Out of the footprint but not yet at the exit: see it
        -- through. The footprint ends where the PART ends, which is
        -- not necessarily where the damage does, and stopping the
        -- instant the root crossed the padded edge left the bot
        -- standing on the rim of a ring it had all but escaped. (But
        -- not through a hazard that has since landed across the way.)
        esc = held
    else
        if held then
            -- An escape just finished, on foot: rest here too.
            hazardCache.holdP = nil
            hazardCache.restUntil = now + CONFIG.RestMaxTime
        end

        -- Cramped: standing clear, but only just, with markers around.
        -- Waiting here until one of them closes the gap means escaping
        -- from inside it, with less room and less time; going now is
        -- the same move made early. Only for a meaningfully roomier
        -- spot, or the bot shuffles between equally tight gaps.
        if #hazardShapes > 0 then
            local room = HazardClearance(pos, true)
            if room < CONFIG.SafeMargin then
                local better = FindEscape(pos, mobPos, keep, outward, true)
                if better
                and HazardClearance(better, true) > room + CONFIG.RepositionGain then
                    esc = better
                    hazardCache.holdP     = better
                    hazardCache.holdUntil = now + 1.0
                    hazardCache.commitUntil = now + 2.0
                    hazardCache.restUntil = 0
                    if CONFIG.HazardDebug then
                        print(("[DQR] Cramped (%d studs of room) - moving to open ground.")
                            :format(room))
                    end
                end
            end
        end
        -- Resting: the hazard we just left is still beside us, this
        -- spot is safe, the target is still in reach. Stand here and
        -- keep hitting rather than walk back toward the ring - the
        -- hold logic would otherwise close in the moment the escape
        -- ended, straight back into whatever we had just left. Ends
        -- when the hazard goes, the spot stops being safe (the
        -- normal escape then runs), the target moves off, or the
        -- clock runs out. Skipped when the reposition above already
        -- decided to move.
        if not esc and now < hazardCache.restUntil then
            local c = HazardClearance(pos, true)
            -- "In reach" is the class's own fighting distance, not
            -- spell range: a Warrior resting thirty studs out was
            -- standing idle between spell cooldowns while the boss
            -- stood there. Further out than this, the normal approach
            -- closes in - by a route that crosses no hazard.
            local fightR = math.max(CONFIG.MeleeRange,
                                    CONFIG.CircleRadius + CONFIG.HoldSlack)
                         + (tgt and tgt.Radius or 0)
            local inReach = mobPos == nil
                or Vector3.new(mobPos.X - pos.X, 0, mobPos.Z - pos.Z).Magnitude <= fightR
            if c > 0 and c < CONFIG.RestNearHazard and inReach then
                esc = pos
                hazardCache.resting = true
            else
                hazardCache.restUntil = 0
            end
        end
    end
    hazardCache.escape = esc
    return esc
end

-- ============================================================
--  HAZARD DIAGNOSTIC  (F9)
--  Lists what the beam and telegraph scanners can see near you and
--  the verdict each test gives, so an attack that is NOT being dodged
--  says why instead of leaving us to guess at how it is built.
-- ============================================================
function HazardDiag()
    local root = GetRoot()
    if not root then print("[DQR] No character.") return end
    local pos, now = root.Position, tick()
    local reach = CONFIG.DodgeRange * 2
    print("[DQR] === HAZARD DIAG ===")

    -- What the last sweep is treating as dangerous right now, and
    -- what each footprint was made from. The first thing to read when
    -- a red slab matches nothing on screen.
    for i, h in ipairs(hazardShapes) do
        if i > 40 then break end
        local src = h.src
        print(("[Hazard] %s <- %s"):format(Describe(h),
            src and (src:GetFullName() .. " (" .. src.ClassName .. ")")
                or "?"))
    end
    print(("[DQR] %d footprint(s) in the last sweep."):format(#hazardShapes))

    local function Line(tag, o, extra)
        local height = Footprint(o)
        print(("[%s] %s | size=%s drawn=%s h=%.1f near=%d | col=%s mat=%s tr=%.2f | query=%s collide=%s anch=%s | shape=%s look=%s tele=%s active=%s%s")
            :format(tag, o:GetFullName(), tostring(o.Size),
                    tostring(PartSize(o)), height, NearDist(o, pos),
                    tostring(o.Color),
                    (tostring(o.Material):gsub("Enum%.Material%.", "")),
                    o.Transparency, tostring(o.CanQuery),
                    tostring(o.CanCollide), tostring(o.Anchored),
                    tostring(BeamShaped(o)), tostring(IsBeamShape(o)),
                    tostring(IsTelegraph(o)), tostring(LooksActive(o)),
                    extra or ""))
    end

    local n = 0
    for p, born in pairs(recentParts) do
        if p.Parent and NearDist(p, pos) < reach then
            n = n + 1
            if n <= 40 then Line(("new %.1fs"):format(now - born), p) end
        end
    end
    print(("[DQR] %d part(s) spawned in the last %ds within %d studs.")
        :format(n, CONFIG.RecentWindow, reach))

    n = 0
    for beam in pairs(beamObjects) do
        if beam.Parent and beam.Attachment0 and beam.Attachment1 then
            local okA, a = pcall(function() return beam.Attachment0.WorldPosition end)
            local okB, b = pcall(function() return beam.Attachment1.WorldPosition end)
            if okA and okB and SegDistFlat(pos, a, b) < reach then
                n = n + 1
                print(("[Beam] %s | enabled=%s len=%d w=%.1f/%.1f dist=%d")
                    :format(beam:GetFullName(), tostring(beam.Enabled),
                            (b - a).Magnitude, beam.Width0, beam.Width1,
                            SegDistFlat(pos, a, b)))
            end
        end
    end
    print(("[DQR] %d Beam object(s) within %d studs."):format(n, reach))

    n = 0
    for ad in pairs(adornObjects) do
        pcall(function()
            local adornee = ad.Adornee
            if not ad.Parent or not adornee then return end
            local acf = adornee:IsA("Model") and adornee:GetPivot()
                     or adornee.CFrame
            local cf = acf * ad.CFrame
            local len = ad:IsA("LineHandleAdornment") and ad.Length
                     or ad:IsA("CylinderHandleAdornment") and ad.Height
                     or ad.Size.Magnitude
            local a = cf.Position
            local b = cf.Position + cf.LookVector * len
            local near = math.min(SegDistFlat(pos, a, b),
                                  (a - pos).Magnitude)
            if near < reach then
                n = n + 1
                print(("[Adorn] %s | %s | adornee=%s visible=%s tr=%.2f len=%d from=%s look=%s near=%d")
                    :format(ad:GetFullName(), ad.ClassName,
                            adornee:GetFullName(), tostring(ad.Visible),
                            ad.Transparency, len, tostring(a),
                            tostring(cf.LookVector), near))
            end
        end)
    end
    print(("[DQR] %d handle adornment(s) within %d studs."):format(n, reach))

    -- Beam-shaped parts that were here before we were: pooled effects,
    -- and the scenery that looks like one. Full walk - it is a keypress.
    n = 0
    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("BasePart") and not recentParts[o] and BeamShaped(o)
        and NearDist(o, pos) < reach then
            n = n + 1
            if n <= 40 then
                Line("old", o, " body=" .. tostring(AtBodyHeight(o)))
            end
        end
    end
    print(("[DQR] %d older beam-shaped part(s) within %d studs.")
        :format(n, reach))
    print("[DQR] === END HAZARD DIAG ===")
end

end -- of the hazard block (see the note above Footprint)

-- ============================================================
--  CIRCULAR ORBIT
-- ============================================================
local orbitAngle = 0
local seeded     = false
local lastDodge  = 0
local lastTeleWarn = 0
local lastCrowdWarn = 0
local retreating   = false
local lastStartCheck = 0
local startVisible = false
local lastNoTarget = 0
local lastLobbyWarn = 0
local hazardBackoff = 0   -- fight from further out until this tick()
local bossSeen = setmetatable({}, {__mode = "k"})  -- model -> logged

-- Tracks how long the current target has held position
local stillModel = nil
local stillPos   = Vector3.zero
local stillSince = 0

-- How far the target's BODY sits from its root, along the line from us.
-- GetExtentsSize spans everything in the model - a boss's own beam and
-- ring effects included, if they were parented to it when it was first
-- seen - so the cached radius can be far bigger than the body, and the
-- bot then fights a phantom well outside it. One ray at the root says
-- where the body actually begins. Smoothed, since the ray lands on a
-- different limb from frame to frame.
-- (Block-scoped for the same local-count reason as the hazard section.)
local SurfaceRadius
do

-- Renamed from Whitelist in 2022; support both.
local INCLUDE = (function()
    local ok, v = pcall(function() return Enum.RaycastFilterType.Include end)
    if ok and v then return v end
    return Enum.RaycastFilterType.Whitelist
end)()

local bodyRadius = setmetatable({}, {__mode = "k"})  -- model -> studs

function SurfaceRadius(target, from)
    local model, mroot = target.Model, target.Root
    local ok, r = pcall(function()
        local p = RaycastParams.new()
        p.FilterType = INCLUDE
        p.FilterDescendantsInstances = {model}
        local to  = mroot.Position
        local hit = workspace:Raycast(from, to - from, p)
        if not hit then return nil end
        -- A beam effect parented to the boss sits nearer than its body,
        -- and an invisible hitbox may be far bigger than it.
        local inst = hit.Instance
        if inst.Transparency > 0.5 or BeamShaped(inst) then return nil end
        return math.max(0, (to - from).Magnitude
                           - (hit.Position - from).Magnitude - 1)
    end)
    if not ok or not r then return bodyRadius[model] end
    local prev = bodyRadius[model]
    r = prev and (prev * 0.7 + r * 0.3) or r
    bodyRadius[model] = r
    return r
end

end -- of the SurfaceRadius block

local function SeedOrbit(mobPos)
    local root = GetRoot()
    if not root then return end
    orbitAngle = math.atan2(
        root.Position.Z - mobPos.Z,
        root.Position.X - mobPos.X)
    seeded = true
end

local function GetOrbitPos(mobPos, radius)
    return Vector3.new(
        mobPos.X + math.cos(orbitAngle) * radius,
        mobPos.Y,
        mobPos.Z + math.sin(orbitAngle) * radius)
end

local function AngleTo(mobPos, radius, a)
    return Vector3.new(mobPos.X + math.cos(a) * radius, mobPos.Y,
                       mobPos.Z + math.sin(a) * radius)
end

-- The ring angle nearest `natural` whose spot - and the walk to it
-- from `from` - is clear of every known hazard, trying either side in
-- turn. nil when the whole ring is covered.
local function ClearRingAngle(mobPos, r, natural, from)
    for k = 1, 12 do
        for _, s in ipairs({1, -1}) do
            local a = natural + s * k * math.pi / 12
            local p = AngleTo(mobPos, r, a)
            if not HazardOnPath(from, p) then return a end
        end
    end
    return nil
end

-- ============================================================
--  CROWD HANDLING
--  Orbiting was computed blind: advance an angle around the target and
--  walk there, with no idea what else was standing in the way. With a
--  pack chasing you that walks straight through the mobs beside the
--  one being hit, which is free damage taken for nothing.
-- ============================================================

-- Mobs within `radius` of `pos`, and where the pack's centre is.
local function Crowd(pos, radius)
    local list, sum, n = {}, Vector3.zero, 0
    for _, m in ipairs(GetMobs()) do
        if m.Root and m.Root.Parent then
            local d = (m.Root.Position - pos).Magnitude
            if d < radius then
                list[#list + 1] = m
                sum = sum + m.Root.Position
                n = n + 1
            end
        end
    end
    if n == 0 then return list, nil end
    return list, sum / n
end

-- Instead of taking whatever angle the orbit reached, sample around the
-- target and pick the spot that keeps the most room from OTHER mobs,
-- while still preferring to keep circling the way we already were.
local function BestOrbitAngle(mobPos, radius, targetModel, pos, natural)
    local mobs = GetMobs()
    local bestA, bestScore = natural, -math.huge

    for i = 0, 11 do
        local a = natural + (i * math.pi / 6)
        local p = AngleTo(mobPos, radius, a)
        local score = 0

        for _, m in ipairs(mobs) do
            if m.Model ~= targetModel and m.Root and m.Root.Parent then
                local d = (m.Root.Position - p).Magnitude
                if d < CONFIG.MobAvoidRadius then
                    -- The closer that spot puts us to another mob, the worse
                    score = score - (CONFIG.MobAvoidRadius - d) * 3
                end
            end
        end

        -- Prefer continuing the current direction over teleport-jumping
        -- the orbit across the mob, which looks and plays badly.
        score = score - i * 1.5

        -- And prefer somewhere we can actually walk to.
        if not LineClear(pos, p) then score = score - 25 end

        -- Do not circle INTO a beam, and do not cross one on the way.
        -- Maths against a short list - no raycasts, no instance
        -- access, and nothing added to the frame handler.
        if CONFIG.AvoidHazardPaths then
            if HazardAt(p) then
                score = score - 300
            elseif HazardOnPath(pos, p) then
                score = score - 200
            end
        end

        if score > bestScore then bestA, bestScore = a, score end
    end
    return bestA
end

-- ============================================================
--  MAIN FARM LOOP
-- ============================================================
local Farm = {Running = false, Thread = nil, DodgeThread = nil}
local lastFrame = tick()
local currentDest = nil
local loopBeat = 0   -- bumped every iteration; stale = the loop is gone

local function MainLoop()
    seeded = false
    lastFrame = tick()
    loopBeat  = tick()

    -- Start movement engine - reads currentDest every heartbeat
    StartMoving(function() return currentDest end)

    while Farm.Running do
        local now = tick()
        local dt  = math.min(now - lastFrame, 0.1)
        lastFrame = now
        loopBeat  = now

        local root  = GetRoot()
        local human = GetHuman()

        if not root or not human or human.Health <= 0 then
            currentDest = nil
            ClearRangeBar()
            StopFacing()
            S(0.5)
            continue
        end

        -- Never fight in the lobby. Its NPCs have humanoids and name
        -- tags, so they pass every mob test - the only thing that tells
        -- them apart from real enemies is that we are in the lobby.
        if InLobbyPlace() then
            currentDest = nil
            ClearRangeBar()
            StopFacing()
            if now - lastLobbyWarn > 5 then
                lastLobbyWarn = now
                print("[DQR] In the lobby (" .. tostring(LobbyMarker())
                    .. ") - not farming. Stopping.")
            end
            Farm.Running = false
            S(0.5)
            continue
        end

        -- The run has not begun while START is still on screen. Dungeon
        -- Quest freezes players until then, so trying to walk just spams
        -- the stuck detector. Stand still and let StartWatcher press it.
        -- Throttled: AnyVisible walks all of PlayerGui, which is far too
        -- expensive to do 20 times a second.
        if now - lastStartCheck > 1 then
            lastStartCheck = now
            startVisible = (not InLobby())
                and (AnyVisible({{text = "start"}}) ~= nil)
        end
        if startVisible then
            currentDest = nil
            ClearRangeBar()
            S(0.5)
            continue
        end

        local target = GetNearestMob()

        if not target then
            currentDest = nil
            ClearRangeBar()
            StopFacing()
            seeded = false
            if now - lastNoTarget > 5 then
                lastNoTarget = now
                print(("[DQR] No target. %d mob(s) in the scan, radius %d.")
                    :format(#GetMobs(), CONFIG.MobScanRadius))
            end
            S(CONFIG.ScanRate)
            continue
        end

        local mobPos = target.Root.Position
        local dist   = target.Distance
        pathTargetModel = target.Model   -- so the path worker can blacklist it

        -- Combat-stall watchdog. A live target whose health has not
        -- dropped, and a bot that has not moved, for StallTime: it is
        -- standing there deciding not to fight - waiting on a hazard
        -- that will not clear, resting beside one that will not go,
        -- boxed in by footprints - and left alone it stands all night.
        -- Mute the hazard scanner for a while and get on with it.
        local hp = target.Humanoid.Health
        local st = hazardCache.stall
        if not st or st.model ~= target.Model
        or hp < st.hp - 1
        or (root.Position - st.pos).Magnitude > 3 then
            hazardCache.stall = {model = target.Model, hp = hp,
                                 pos = root.Position, since = now}
        elseif now - st.since > CONFIG.StallTime then
            hazardCache.muteUntil = now + CONFIG.StallMute
            hazardCache.stall = nil
            print(("[DQR] Combat stall: %s untouched and no movement for %ds - "
                .. "ignoring hazards for %ds."):format(target.Model.Name,
                CONFIG.StallTime, CONFIG.StallMute))
        end

        -- Distance is measured root-to-root, so for a big model its
        -- SURFACE is much nearer than its centre. Add the target's own
        -- radius to every range so they stay consistent.
        --
        -- The previous version added a flat +10 to the orbit, the
        -- retreat threshold and the approach range - but NOT to
        -- MeleeRange. So against a boss it held station at 19 studs
        -- while the swing only fired inside 16: it circled forever and
        -- never actually hit anything.
        local tRad = target.Radius or 0
        -- Never trust a radius bigger than where the body actually is.
        local surf = SurfaceRadius(target, root.Position)
        if surf and surf < tRad then tRad = surf end
        target.Radius = tRad   -- the hazard scanner reads this record too
        if target.Boss and not bossSeen[target.Model] then
            bossSeen[target.Model] = true
            print(("[DQR] Boss %s: body radius %d (extents said %d) - fighting from %d.")
                :format(target.Model.Name, tRad, mobRadius[target.Model] or 0,
                        CONFIG.CircleRadius + tRad))
        end

        local ringR  = CONFIG.CircleRadius + tRad
        local minR   = CONFIG.MinRange     + tRad
        local maxR   = CONFIG.MaxRange     + tRad
        local meleeR = CONFIG.MeleeRange   + tRad
        local spellR = CONFIG.AttackRange  + tRad

        -- Radial beams fan out from a BOSS, so the gaps between them
        -- are narrow up close and wide further out. While the spokes
        -- are on the floor - and for a moment after - fight from where
        -- there is room to step between them, and raise MinRange with
        -- it so the retreat branch below actually walks us out there.
        -- Not capped at spell range: with twenty spokes the first
        -- clear ring can lie outside it, and capping walked the bot
        -- straight back into the fan. Standing safe and idle beats
        -- casting from inside a beam.
        -- Bosses only, and a real fan: one beam straight through a
        -- mob's root reads as a spoke each way, so two "spokes" is a
        -- single laser, not something to stand back from.
        if target.Boss and hazardCache.radialN >= 3 then
            hazardBackoff = now + CONFIG.BeamBackoffTime
        end
        if hazardBackoff > now then
            local want = math.min(
                hazardCache.backoffR or (ringR + CONFIG.BeamSpread),
                CONFIG.BeamBackoffMax)
            if want > ringR then
                ringR = want
                maxR  = math.max(maxR, ringR + 6)
                minR  = math.max(minR, ringR - 4)
            end
        end
        engageRing = ringR

        -- Positioning uses HORIZONTAL distance. target.Distance is 3D, so
        -- a mob standing on a ledge above reads as far away even when it
        -- is right on top of us - which flipped the range checks on and
        -- off and made the bot pace back and forth under the ledge.
        local flat = (Vector3.new(mobPos.X, 0, mobPos.Z)
                    - Vector3.new(root.Position.X, 0, root.Position.Z)).Magnitude

        -- Always face mob
        if not faceTarget then
            StartFacing(function()
                local t = GetNearestMob()
                return t and t.Root.Position or nil
            end)
        end

        -- MELEE when very close
        if dist <= meleeR then
            DoMelee(mobPos)
        end

        -- SPELLS when in range
        DoSpell(dist, spellR, mobPos)

        -- Seed orbit on new target
        if not seeded then SeedOrbit(mobPos) end

        -- Standing in a telegraphed strip beats every other movement:
        -- there is no point orbiting prettily inside the damage zone.
        local escape = ScanHazards()
        if escape then
            -- Any hazard at all from a boss: for the next few seconds
            -- fight from further back. (A beam fan keeps the backoff
            -- alive by itself, above, for as long as it is there.)
            -- Without this the hold branch walked us straight back
            -- into the hazard the moment the escape had us clear of it.
            -- Not while merely resting beside one: that spot is safe,
            -- and backing further off it costs attacks for nothing.
            -- Running for shelter is not backing off a hazard, and
            -- must not push the fighting distance out: the dome is
            -- where it is.
            if target.Boss and not hazardCache.resting
            and not hazardCache.sheltering then
                hazardBackoff = now + CONFIG.BeamBackoffTime
            end
            currentDest = Vector3.new(escape.X, root.Position.Y, escape.Z)
            ShowRangeBar(root, mobPos, dist)
            if now - lastTeleWarn > 2 then
                lastTeleWarn = now
                print(hazardCache.sheltering
                    and "[DQR] Marked from above - getting under the dome."
                    or hazardCache.resting
                    and "[DQR] Clear of the hazard - holding here until it goes."
                    or hazardCache.radial
                    and "[DQR] In a beam fan - stepping clear and backing out."
                    or  "[DQR] In a hazard - moving clear.")
            end
            S(CONFIG.ScanRate)
            continue
        end

        -- Dodge - highest movement priority
        local threatened, tOrigin, tti, tVel, tRad = ScanThreats()
        if threatened and (now - lastDodge) > CONFIG.DodgeCooldown then
            lastDodge = now
            local sign = math.cos(orbitAngle) > 0 and 1 or -1
            local dodge = hazardCache.Dodge(root, tOrigin, tVel,
                                            tti ~= nil and tti < 0.6, sign, tRad)
            if dodge then
                currentDest = dodge
                ShowRangeBar(root, mobPos, dist)
                orbitAngle = orbitAngle + sign * 0.5
                S(CONFIG.ScanRate)
                continue
            end
        end

        -- Inside our own standoff: walk straight back out. The orbit
        -- radius nudge alone (1.25x) was far too gentle - it left the
        -- bot sitting inside the mob's swing arc taking hits while it
        -- slowly drifted outward. Melee keeps firing while retreating,
        -- because DoMelee was already called above on this frame.
        -- Deadband, or it flips between retreating and advancing on
        -- every frame while hovering right at MinRange.
        if retreating then
            if flat >= ringR * 0.95 then retreating = false end
        elseif flat < minR then
            retreating = true
        end

        if retreating then
            local away = Vector3.new(root.Position.X - mobPos.X, 0,
                                     root.Position.Z - mobPos.Z)
            if away.Magnitude < 0.5 then
                local b = root.CFrame.LookVector * -1
                away = Vector3.new(b.X, 0, b.Z)
            end
            if away.Magnitude > 0.01 then
                -- Back off only where there is room. If we are against a
                -- wall, stop retreating and fight instead of grinding
                -- into it - otherwise the mob pins us there.
                local spot = SafeStep(root.Position, away,
                                      ringR - flat)
                if spot then
                    currentDest = spot
                    ShowRangeBar(root, mobPos, dist)
                    S(CONFIG.ScanRate)
                    continue
                end
                retreating = false
            end
        end

        -- Mob not moving and we are already in range? Stop shuffling and
        -- just hit it. Orbiting a stationary target only costs uptime.
        if target.Model == stillModel then
            if (mobPos - stillPos).Magnitude > CONFIG.MobMoveEps then
                stillPos, stillSince = mobPos, now
            end
        else
            stillModel, stillPos, stillSince = target.Model, mobPos, now
        end

        local still = CONFIG.HoldWhenStill
                  and (now - stillSince) > CONFIG.MobStillTime

        -- A target that is going nowhere - a boss, or any mob that has
        -- stopped - gets walked up to in a straight line and hit from a
        -- standstill. The orbit is for mobs that move.
        --
        -- Against a boss the orbit point itself travels at
        -- CircleSpeed * ringR studs a second, which for a 15-stud-wide
        -- model is faster than we walk: the bot chased a spot it could
        -- never catch, round and round, and never settled at fighting
        -- distance at all. The old hold only kicked in once "close
        -- enough", which the chase never was.
        --
        -- Hazard escapes have already run above and outrank this, so
        -- standing still only ever lasts until something is incoming.
        if still or target.Boss then
            if flat > ringR + CONFIG.HoldSlack then
                -- Walk in to the nearest point on the ring - or to the
                -- nearest one the walk to which crosses no hazard. If
                -- there is none, stand here: after a hop had put a
                -- ring between us and the boss, this walked straight
                -- back through it.
                local ang = math.atan2(root.Position.Z - mobPos.Z,
                                       root.Position.X - mobPos.X)
                local spot = AngleTo(mobPos, ringR, ang)
                local waiting = false
                if CONFIG.AvoidHazardPaths and HazardOnPath(root.Position, spot) then
                    local clear = ClearRingAngle(mobPos, ringR, ang,
                                                 root.Position)
                    if clear then
                        ang, spot = clear, AngleTo(mobPos, ringR, clear)
                    elseif now < (hazardCache.waitBlock or 0) then
                        -- Already waited this one out and gave up.
                        -- Walk through it; `spot` keeps its value.
                        if now - lastTeleWarn > 3 then
                            lastTeleWarn = now
                            print("[DQR] Hazard still in the way - walking through it.")
                        end
                    else
                        -- Wait for it to go - but not forever. A
                        -- hazard that never goes is not one, and the
                        -- bot once stood all night behind a decoration.
                        local since = hazardCache.waitSince or 0
                        if since == 0 then
                            since = now
                            hazardCache.waitSince = now
                        end
                        if now - since < CONFIG.WaitGiveUp then
                            waiting, spot = true, nil
                            if now - lastTeleWarn > 2 then
                                lastTeleWarn = now
                                print("[DQR] Hazard between us and the target - waiting it out.")
                            end
                        else
                            -- Giving up has to STICK. Clearing the
                            -- timer here and nothing else meant the
                            -- next tick started a fresh ten-second
                            -- wait: the bot walked for one frame every
                            -- ten seconds, which from outside is
                            -- standing still forever. Block waiting
                            -- entirely for a while so it actually goes.
                            hazardCache.waitSince = 0
                            hazardCache.waitBlock = now + CONFIG.WaitGiveUp * 3
                            -- Not throttled by lastTeleWarn: the
                            -- waiting message keeps that timer hot, so
                            -- this one never got printed and the give-up
                            -- was invisible in the log.
                            print(("[DQR] Waited %ds on that hazard - walking "
                                .. "through it now."):format(now - since))
                        end
                    end
                end
                -- Only a genuinely clear route resets the clock.
                if not waiting and spot and now >= (hazardCache.waitBlock or 0) then
                    hazardCache.waitSince = 0
                end
                orbitAngle  = ang
                currentDest = spot
            else
                currentDest = nil      -- stand still, keep attacking
                hazardCache.waitSince = 0
                hazardCache.waitBlock = 0
            end
            ShowRangeBar(root, mobPos, dist)
            S(CONFIG.ScanRate)
            continue
        end

        -- Surrounded? Then orbiting is the wrong idea entirely - any
        -- circle around one mob runs through the others. Back out to the
        -- edge of the pack and fight from there instead.
        --
        -- Not while PreferGroups is on: that deliberately walks us into
        -- the middle of a pack so every swing hits several mobs, and
        -- this would walk us straight back out again. The two rules
        -- want opposite things, and the group one is the newer intent.
        if CONFIG.AvoidOtherMobs and not CONFIG.PreferGroups then
            local pack, centre = Crowd(root.Position, CONFIG.CrowdRadius)
            if centre and #pack >= CONFIG.CrowdCount then
                local away = Vector3.new(root.Position.X - centre.X, 0,
                                         root.Position.Z - centre.Z)
                if away.Magnitude < 0.5 then
                    -- Dead centre of the pack: any way out will do.
                    away = root.CFrame.LookVector * -1
                    away = Vector3.new(away.X, 0, away.Z)
                end
                if away.Magnitude > 0.01 then
                    local standoff = math.max(ringR,
                                              CONFIG.MobAvoidRadius)
                    local fromCentre = (Vector3.new(root.Position.X, 0, root.Position.Z)
                                      - Vector3.new(centre.X, 0, centre.Z)).Magnitude
                    local spot = SafeStep(root.Position, away,
                                          standoff - fromCentre)
                    if spot then
                        currentDest = spot
                        ShowRangeBar(root, mobPos, dist)
                        if now - lastCrowdWarn > 3 then
                            lastCrowdWarn = now
                            print(("[DQR] %d mobs on me - backing to the edge.")
                                :format(#pack))
                        end
                        S(CONFIG.ScanRate)
                        continue
                    end
                    if now - lastCrowdWarn > 3 then
                        lastCrowdWarn = now
                        print("[DQR] Surrounded with nowhere to back into "
                            .. "- standing and fighting.")
                    end
                end
            end
        end

        -- Advance orbit
        orbitAngle = orbitAngle + CONFIG.CircleSpeed * dt
        if orbitAngle > math.pi * 2 then
            orbitAngle = orbitAngle - math.pi * 2
        end

        -- Closing in from far away: aim a little inside the standoff so
        -- we actually arrive at it. Being too CLOSE is handled by the
        -- retreat branch above, which exits before reaching here.
        local radius = ringR
        if flat > maxR then
            radius = ringR * 0.85
        end

        -- Keep the orbit point's own Y (the mob's ground level). This
        -- used to be forced to root.Position.Y, a leftover from the
        -- CFrame-teleport days. On a hilly map that put the pathfinding
        -- goal at OUR elevation - floating above the mob or buried
        -- inside a mountain - so ComputeAsync returned NoPath every time
        -- and the bot fell back to walking straight into the slope.
        -- Pick the orbit spot with the most clearance from other mobs
        -- rather than blindly taking wherever the angle landed.
        if CONFIG.AvoidOtherMobs then
            orbitAngle = BestOrbitAngle(mobPos, radius, target.Model,
                                        root.Position, orbitAngle)
        end

        currentDest = GetOrbitPos(mobPos, radius)
        -- Every angle penalised for crossing a hazard still leaves one
        -- as the "best": if that one crosses too, stand instead.
        if CONFIG.AvoidHazardPaths
        and HazardOnPath(root.Position, currentDest) then
            currentDest = nil
        end
        ShowRangeBar(root, mobPos, dist)

        S(CONFIG.ScanRate)
    end

    currentDest = nil
    StopMoving()
    StopFacing()
    ClearRangeBar()
end

-- ============================================================
--  DODGE WATCHER 20hz
-- ============================================================
local function DodgeWatcher()
    local lastDW = 0
    while Farm.Running do
        S(0.05)
        local root  = GetRoot()
        local human = GetHuman()
        if not root then continue end
        if human and human.Health <= 0 then
            currentDest = nil
            continue
        end

        -- Telegraphs and beams first: being in one is damage incoming.
        local esc = ScanHazards()
        if esc then
            currentDest = Vector3.new(esc.X, root.Position.Y, esc.Z)
            continue
        end

        local ok, origin, tti, vel, rad = ScanThreats()
        local now = tick()
        if ok and (now - lastDW) > CONFIG.DodgeCooldown then
            lastDW = now
            local sign = math.cos(orbitAngle) > 0 and 1 or -1
            currentDest = hazardCache.Dodge(root, origin, vel,
                                            tti ~= nil and tti < 0.6, sign, rad)
                       or currentDest
        end
    end
end

-- ============================================================
--  LOCAL VANITY  (name / level on your own screen only)
--
--  Purely a client-side redraw. The server, every other player and
--  your save file all still see the real values - nothing here sends
--  anything anywhere. The game rewrites these labels constantly, so
--  it has to be re-applied on a loop rather than set once.
-- ============================================================
local spoofSeen = {}

local function CurrentLevel()
    local ls = LP:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            local n = v.Name:lower()
            if (n:find("level") or n:find("lvl")) and v:IsA("ValueBase") then
                return tostring(v.Value)
            end
        end
    end
    for _, n in ipairs({"Level", "level", "Lvl"}) do
        local v = LP:FindFirstChild(n)
        if v and v:IsA("ValueBase") then return tostring(v.Value) end
    end
    return nil
end

local function SpoofPass()
    local real = LP.Name
    local disp = LP.DisplayName
    local lvl  = CurrentLevel()

    local roots = {}
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if pg then roots[#roots + 1] = pg end
    local ch = GetChar()
    if ch then roots[#roots + 1] = ch end

    for _, r in ipairs(roots) do
        for _, o in ipairs(r:GetDescendants()) do
            if (o:IsA("TextLabel") or o:IsA("TextButton"))
            and not (LogGui and o:IsDescendantOf(LogGui)) then
                pcall(function()
                    local t = o.Text
                    if t == "" then return end

                    if CONFIG.SpoofName then
                        if t == real or t == disp then
                            o.Text = CONFIG.FakeName
                        elseif t:find(real, 1, true) then
                            o.Text = t:gsub(
                                (real:gsub("%W", "%%%0")), CONFIG.FakeName)
                        end
                    end

                    if CONFIG.SpoofLevel and t:match("^%d+$") then
                        local nm = o.Name:lower()
                        local pn = (o.Parent and o.Parent.Name or ""):lower()
                        local named = nm:find("level") or nm:find("lvl")
                                   or pn:find("level") or pn:find("lvl")
                        -- Matching the real level value catches the labels
                        -- that are not helpfully named.
                        if named or (lvl and t == lvl) then
                            o.Text = CONFIG.FakeLevel
                            local path = o:GetFullName()
                            if not spoofSeen[path] then
                                spoofSeen[path] = true
                                print("[DQR] Level label: " .. path)
                            end
                        end
                    end
                end)
            end
        end
    end
end

local function VanityWatcher()
    while true do
        S(0.5)
        if CONFIG.SpoofName or CONFIG.SpoofLevel then pcall(SpoofPass) end
        if CONFIG.HideArmour then pcall(HideArmour, GetChar()) end
    end
end

-- ============================================================
--  START / STOP
-- ============================================================
-- task.spawn swallows errors: a runtime error inside MainLoop killed the
-- thread silently while Farm.Running stayed true, so every watcher went
-- on believing the farm was fine and the bot stood still forever. Run
-- them under pcall, report what actually went wrong, and recover.
local function Guarded(name, fn)
    return function()
        local ok, err = pcall(fn)
        if not ok then
            print("[DQR] " .. name .. " CRASHED: " .. tostring(err))
        end
        if Farm.Running then
            print("[DQR] " .. name .. " exited unexpectedly - restarting.")
            Farm.Running = false
            task.wait(0.5)
            Farm.Start()
        end
    end
end

function Farm.Start()
    if Farm.Running then return end
    if InLobbyPlace() then
        print("[DQR] Refusing to farm - lobby marker '"
            .. tostring(LobbyMarker()) .. "' is on screen.")
        return
    end
    -- The lobby UI vanishing for an instant is not a dungeon. It happens
    -- while the queue panels close and at boot before the GUI loads,
    -- and farming in that window sent the bot at the lobby's NPCs.
    if not DungeonConfirmed() then
        print(("[DQR] Not farming yet - lobby only gone %.1fs of %.0fs.")
            :format(NotLobbyFor(), CONFIG.LobbyGrace))
        return
    end
    if lobbyFlowActive then
        print("[DQR] Not farming - still queueing a dungeon.")
        return
    end
    Farm.Running     = true
    loopBeat         = tick()
    Farm.Thread      = task.spawn(Guarded("Main loop", MainLoop))
    Farm.DodgeThread = task.spawn(Guarded("Dodge watcher", DodgeWatcher))
    print("[DQR] Farm started.")
end

function Farm.Stop()
    Farm.Running = false
    currentDest  = nil
    StopMoving()
    StopFacing()
    ClearRangeBar()
    print("[DQR] Farm stopped.")
end

LP.CharacterAdded:Connect(function()
    S(2)
    pcall(HideArmour, GetChar())
    if Farm.Running then
        Farm.Stop() S(0.5) Farm.Start()
    end
end)

-- ============================================================
--  DUNGEON COMPLETE WATCHER
-- ============================================================
-- ============================================================
--  IN-DUNGEON START BUTTON
--  The dungeon is a separate place, so its GUI is not in the lobby
--  dump and has no known path. Match it by exact text instead:
--  "START" normalises to "start", and the lobby's own start button
--  can't be confused with it because this only runs outside the lobby.
-- ============================================================
local function StartWatcher()
    while true do
        S(1.5)
        if not InLobby() then
            local b = AnyVisible({
                {text = "start"}, {text = "startdungeon"},
                {name = "startbutton"},
            })
            if b then
                print("[DQR] In-dungeon START visible - clicking.")
                ClickButton(b)
                S(2)
            end
        end
    end
end

-- Only job: notice the run has ended and stop farming. Everything about
-- what to do next belongs to Supervisor, which runs whether or not the
-- farm is going. The old version did both here behind
-- `if not Farm.Running then continue end`, so the moment it stopped the
-- farm it disabled itself permanently - which is why a failed dungeon
-- left the script sitting in the lobby doing nothing.
local function DungeonWatcher()
    local quiet = 0
    while true do
        S(3)
        if not Farm.Running then quiet = 0 continue end

        -- The reliable "run is over" signal is the lobby coming back,
        -- fail screen included. Absence of mobs is not: that happens
        -- constantly between rooms.
        -- Require mobs to be gone as well. A lobby-only GUI reading as
        -- visible mid-run (the Replay button, say) would otherwise stop
        -- the farm while there was still a room full of things to kill.
        if InLobbyPlace() then
            print("[DQR] Back in the lobby - run over, stopping farm.")
            Farm.Stop()
            quiet = 0
            continue
        end

        if GetNearestMob() then
            quiet = 0
        else
            quiet = quiet + 1
            if quiet == 40 then   -- 2 minutes
                print("[DQR] No mobs for 2 min and no lobby - still waiting.")
            end
        end
    end
end

-- ============================================================
--  DISCORD LOOT WEBHOOK
--  When the reward panel comes up at the end of a run, read what is
--  on it and post it to the webhook in CONFIG.DiscordWebhook. A script
--  cannot take a screenshot, so this is the next best thing: the item
--  names as text, and the item icons as pictures when they are image
--  assets - resolved through Roblox's thumbnail API to URLs Discord
--  can show. Up to four go in one embed gallery.
-- ============================================================
local ReportLoot, LootDump, LootWatcher
do

-- The executor's HTTP function, under whichever name it uses. The
-- game's own HttpService cannot be used from a client.
local function HttpRequest(opts)
    for _, name in ipairs({"request", "http_request"}) do
        local fn = Env(name)
        if typeof(fn) == "function" then
            local ok, res = pcall(fn, opts)
            if ok then return res end
            return nil, tostring(res)
        end
    end
    for _, ns in ipairs({"syn", "http", "fluxus"}) do
        local t = Env(ns)
        if typeof(t) == "table" and typeof(t.request) == "function" then
            local ok, res = pcall(t.request, opts)
            if ok then return res end
            return nil, tostring(res)
        end
    end
    return nil, "this executor has no request function"
end

-- Every GUI object actually on screen, at any depth, as a set. Walks
-- down from each enabled ScreenGui and stops at the first invisible
-- frame, since nothing under one can show - far cheaper than testing
-- every descendant's ancestry. Our own log window is left out.
local function VisibleSet()
    local out = {}
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return out end
    local function Walk(o)
        for _, c in ipairs(o:GetChildren()) do
            if c:IsA("GuiObject") then
                if c.Visible and c.AbsoluteSize.X >= 1 then
                    out[c] = true
                    Walk(c)
                end
            else
                Walk(c)
            end
        end
    end
    for _, sg in ipairs(pg:GetChildren()) do
        if sg:IsA("ScreenGui") and sg.Enabled and sg ~= LogGui then Walk(sg) end
    end
    return out
end

-- The Dungeon Quest reward panel, as dumped on 2026-09-21:
--   rewardGuiHolder.holder
--     reward            slot background (x one per item)
--       glow            ImageLabel tinted with the item's rarity colour
--       itemPicture     ImageLabel: the item's icon
--   rewardGuiHolder.Frame.Gold   the gold earned
-- No name labels anywhere, so names cannot be reported; the glow's
-- tint is read as the rarity instead. Returns one record per item.
-- Dungeon Quest's tiers, by colour: Common grey, Uncommon green, Rare
-- blue, Epic purple, Legendary yellow, Ultimate red.
local function ItemSlots(panel)
    local function Rarity(c)
        if not c then return nil end
        local h, s = c:ToHSV()
        if s < 0.25 then return "Common" end          -- grey
        if h < 0.04 or h > 0.93 then return "Ultimate" end  -- red
        if h < 0.2 then return "Legendary" end        -- yellow / orange
        if h < 0.47 then return "Uncommon" end        -- green
        if h < 0.72 then return "Rare" end            -- blue
        return "Epic"                                 -- purple
    end
    local items = {}
    for _, o in ipairs(panel:GetDescendants()) do
        if o.Name == "itemPicture"
        and (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.Image ~= "" then
            local img = tostring(o.Image)
            local id = img:match("id=(%d+)") or img:match("(%d+)%s*$")
            if id then
                local glow = o.Parent and o.Parent:FindFirstChild("glow")
                local col = glow and glow:IsA("ImageLabel") and glow.ImageColor3 or nil
                items[#items + 1] = {id = id, color = col, rarity = Rarity(col)}
            end
        end
    end
    return items
end

-- The candidates for the reward panel, best first: whatever is on
-- screen now that was NOT on screen during the fight (`during`, the
-- set the watcher collected), grouped under the nearest ancestor that
-- WAS - because the panel is either a frame that just appeared, or an
-- old frame that just had its item slots cloned into it - scored by
-- how many item slots each group holds. Looking only at a ScreenGui's
-- direct children missed a panel nested inside an always-on container.
local function LootCandidates(during)
    -- The lobby's own GUIs are hidden during a run and back
    -- afterwards, so they read as "new" too - and the main menu is
    -- full of icons.
    local lobbyGuis = {introGui = true, mainInterface = true, queueGui = true,
                       friendsList = true, leaderboard = true}
    local vis = VisibleSet()
    -- Item slots under a frame: 3D previews and pictures, on screen.
    local function SlotCount(frame)
        local n = 0
        for _, o in ipairs(frame:GetDescendants()) do
            if vis[o] and (o:IsA("ViewportFrame")
               or ((o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.Image ~= "")) then
                n = n + 1
            end
        end
        return n
    end
    local roots, byParent = {}, {}
    for o in pairs(vis) do
        if not (during and during[o]) then
            local p = o.Parent
            local parentNew = p and p:IsA("GuiObject") and vis[p]
                              and not (during and during[p])
            if not parentNew then
                local sg = o
                while sg and not sg:IsA("ScreenGui") do sg = sg.Parent end
                if sg and not lobbyGuis[sg.Name] then
                    roots[#roots + 1] = o
                    if p and p:IsA("GuiObject") then
                        byParent[p] = (byParent[p] or 0) + 1
                    end
                end
            end
        end
    end
    -- Several new siblings under one old frame: that frame is the
    -- panel. A lone new frame is the panel itself.
    local cands, seen = {}, {}
    for _, o in ipairs(roots) do
        local p = o.Parent
        local frame = (p and byParent[p] and byParent[p] >= 2) and p or o
        if not seen[frame] then
            seen[frame] = true
            cands[#cands + 1] = {frame = frame, slots = SlotCount(frame)}
        end
    end
    table.sort(cands, function(a, b) return a.slots > b.slots end)
    return cands
end

local function FindLootPanel(during)
    if CONFIG.LootPanelPath and #CONFIG.LootPanelPath > 0 then
        return PathVisible(CONFIG.LootPanelPath)
    end
    local c = LootCandidates(during)[1]
    if c and c.slots >= 2 then return c.frame end   -- one slot is a button icon
    return nil
end

-- Everything on the panel worth reporting: distinct icon asset ids,
-- distinct bits of text, and how many 3D previews there were. Our own
-- name is left out of the text.
local function CollectLoot(panel)
    local icons, names, seen, viewports = {}, {}, {}, 0
    local me1, me2 = LP.Name:lower(), LP.DisplayName:lower()
    for _, o in ipairs(panel:GetDescendants()) do
        if (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.Image ~= "" then
            local img = tostring(o.Image)
            local id = img:match("id=(%d+)") or img:match("(%d+)%s*$")
            if id and not seen["i" .. id] then
                seen["i" .. id] = true
                icons[#icons + 1] = id
            end
        elseif o:IsA("ViewportFrame") then
            viewports = viewports + 1
        elseif o:IsA("TextLabel") or o:IsA("TextButton") then
            local t = o.Text:gsub("^%s+", ""):gsub("%s+$", "")
            local lt = t:lower()
            if #t > 1 and t:find("%a")
            and not lt:find(me1, 1, true) and not lt:find(me2, 1, true)
            and not seen["t" .. t] then
                seen["t" .. t] = true
                names[#names + 1] = t
            end
        end
    end
    return icons, names, viewports
end

-- Post the panel's contents. With no panel, posts a test message so
-- the URL can be checked without finishing a run.
function ReportLoot(panel)
    local url = CONFIG.DiscordWebhook
    if type(url) ~= "string" or not url:find("^https://") then
        print("[DQR] Loot: no webhook URL set.")
        return false
    end
    local HttpS = game:GetService("HttpService")
    local icons, names, viewports = {}, {}, 0
    local items, color = {}, nil
    local dropped, hidden = 0, 0
    if panel then
        items = ItemSlots(panel)
        dropped = #items

        -- Rarity filter. An item whose rarity could not be read is
        -- kept: a colour the script does not recognise should never
        -- silently swallow a drop.
        if dropped > 0 and type(CONFIG.LootRarities) == "table" then
            local keep = {}
            for _, it in ipairs(items) do
                local want = CONFIG.LootRarities[it.rarity or ""]
                if want == nil then want = true end
                if want then
                    keep[#keep + 1] = it
                else
                    hidden = hidden + 1
                end
            end
            items = keep
        end

        if dropped > 0 then
            -- One embed per item, so each picture carries its own
            -- rarity: a merged gallery puts every icon in one block
            -- with a single caption above it, and there is then no way
            -- to tell which of three items was the Epic one.
            for _, it in ipairs(items) do
                icons[#icons + 1] = it.id
                local c = it.color
                if c and not color then
                    color = math.floor(c.R * 255) * 65536
                          + math.floor(c.G * 255) * 256 + math.floor(c.B * 255)
                end
            end
            -- The gold (and anything else with a number) shown beside
            -- the items, in rewardGuiHolder.Frame.
            local side = panel.Parent and panel.Parent:FindFirstChild("Frame")
            if side then
                local seen = {}
                for _, o in ipairs(side:GetDescendants()) do
                    if o:IsA("TextLabel") and o.Text:find("%d") and not seen[o.Text] then
                        seen[o.Text] = true
                        local label = o.Parent and o.Parent.Name or "Reward"
                        names[#names + 1] = ("%s: %s"):format(label, o.Text)
                        if #names > 12 then break end
                    end
                end
            end
        else
            icons, names, viewports = CollectLoot(panel)
        end
    end

    -- Everything that dropped was a rarity you have switched off.
    -- Bail before the thumbnail lookup and the post: that is the whole
    -- point of the filter, and it keeps the channel for real drops.
    if panel and dropped > 0 and #items == 0 and not CONFIG.LootPostIfEmpty then
        print(("[DQR] Loot: %d item(s) dropped, all filtered out by "
            .. "LootRarities - not posting."):format(hidden))
        return true
    end

    -- Asset id -> a CDN picture URL Discord can fetch. The thumbnail
    -- API answers for decals and images alike; the older
    -- asset-thumbnail endpoint is the fallback if it does not.
    local thumbs = {}
    if #icons > 0 then
        local res = HttpRequest({
            Url = "https://thumbnails.roblox.com/v1/assets?assetIds="
                .. table.concat(icons, ",") .. "&size=420x420&format=Png",
            Method = "GET",
        })
        if res and res.Body then
            local ok, data = pcall(function() return HttpS:JSONDecode(res.Body) end)
            if ok and type(data) == "table" and type(data.data) == "table" then
                for _, e in ipairs(data.data) do
                    if e.imageUrl and e.imageUrl ~= "" then
                        thumbs[tostring(e.targetId)] = e.imageUrl
                    end
                end
            end
        end
        for _, id in ipairs(icons) do
            if not thumbs[id] then
                thumbs[id] = "https://www.roblox.com/asset-thumbnail/image?assetId="
                    .. id .. "&width=420&height=420&format=png"
            end
        end
    end

    local desc = {}
    if panel then
        if #items > 0 then
            desc[#desc + 1] = ("**%d item%s**%s"):format(
                #items, #items == 1 and "" or "s",
                hidden > 0 and (" *(%d hidden by the rarity filter)*"):format(hidden) or "")
        elseif hidden > 0 then
            desc[#desc + 1] = ("*%d item%s dropped, all below your rarity filter.*")
                :format(hidden, hidden == 1 and "" or "s")
        end
        if #names > 0 then
            desc[#desc + 1] = table.concat(names, "\n")
        elseif dropped == 0 then
            desc[#desc + 1] = "(nothing readable on the panel - press F10 on the reward screen)"
        end
        if viewports > 0 and #icons == 0 then
            desc[#desc + 1] = ("(%d item icon(s) are 3D previews - no picture possible)")
                :format(viewports)
        end
    else
        desc[#desc + 1] = "Webhook test from DQR - the URL works."
    end

    local title = panel
        and ("Dungeon complete - %s (%s)"):format(CONFIG.TargetDungeon, CONFIG.Difficulty)
        or "DQR webhook test"
    -- A header embed, then one per item. Deliberately NOT sharing a
    -- `url`: embeds that do are merged into a single gallery, and a
    -- gallery has one caption for all of its pictures.
    local embeds = {{
        title = title,
        description = table.concat(desc, "\n"),
        color = color or 5763719,
    }}
    for i, it in ipairs(items) do
        if i > 9 then break end          -- Discord allows ten embeds
        local c = it.color
        local hex = c and ("#%02X%02X%02X"):format(c.R * 255, c.G * 255, c.B * 255)
                      or "?"
        embeds[#embeds + 1] = {
            title = ("%d.  %s"):format(i, it.rarity or "Unknown rarity"),
            description = hex,
            color = c and (math.floor(c.R * 255) * 65536
                         + math.floor(c.G * 255) * 256
                         + math.floor(c.B * 255)) or 5763719,
            image = thumbs[it.id] and {url = thumbs[it.id]} or nil,
        }
    end
    -- The fallback scan has no per-item rarity, only a pile of icons.
    if #items == 0 then
        for i = 1, math.min(#icons, 4) do
            embeds[#embeds + 1] = {image = {url = thumbs[icons[i]]}}
        end
    end
    embeds[#embeds].footer = {text = os.date("%Y-%m-%d %H:%M:%S") .. "  -  DQR"}

    local body = HttpS:JSONEncode({username = "DQR", embeds = embeds})
    local res, err = HttpRequest({
        Url = url, Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = body,
    })
    if not res then
        print("[DQR] Loot post failed: " .. tostring(err))
        return false
    end
    local code = res.StatusCode or res.Status or "?"
    print(("[DQR] Loot posted (%s): %d item(s) shown, %d hidden, %d icon(s), %d preview(s).")
        :format(tostring(code), #items, hidden, #icons, viewports))
    return true
end

-- Frames seen on screen while the farm was running: whatever is up
-- at the end and NOT in here is new, and the reward panel is new.
local during = {}

-- F10: every frame on screen with its slot count and whether it was
-- up during the fight, then the contents of the one the scan would
-- choose. Run it on the reward screen; if it picks the wrong frame,
-- the right one's path goes in LootPanelPath.
function LootDump()
    print("[DQR] === NEW SINCE THE FIGHT (best first) ===")
    local cands = LootCandidates(during)
    for i, c in ipairs(cands) do
        if i > 15 then break end
        print(("%s | slots=%d"):format(c.frame:GetFullName(), c.slots))
    end
    if #cands == 0 then
        print("[DQR] Nothing on screen is new since the fight.")
    end
    local panel = FindLootPanel(during)
    if not panel then
        print("[DQR] No candidate has 2+ item slots, so none qualifies as the reward panel.")
        return
    end
    print("[DQR] === LOOT PANEL: " .. panel:GetFullName() .. " ===")
    for i, it in ipairs(ItemSlots(panel)) do
        local c = it.color
        print(("[Item %d] icon=%s rarity=%s glow=%s"):format(i, it.id,
            tostring(it.rarity),
            c and ("#%02X%02X%02X"):format(c.R * 255, c.G * 255, c.B * 255) or "none"))
    end
    for _, o in ipairs(panel:GetDescendants()) do
        local extra = ""
        if o:IsA("TextLabel") or o:IsA("TextButton") then
            extra = " text='" .. o.Text .. "'"
        elseif o:IsA("ImageLabel") or o:IsA("ImageButton") then
            extra = " image=" .. o.Image
        elseif o:IsA("ViewportFrame") then
            extra = " (3D preview)"
        end
        if extra ~= "" then
            print(("%s | %s | visible=%s%s"):format(
                o:GetFullName():sub(#panel:GetFullName() + 2), o.ClassName,
                tostring(o:IsA("GuiObject") and VisibleOnScreen(o)), extra))
        end
    end
    print("[DQR] === END LOOT PANEL ===")
end

-- While there is something to fight, remembers what is on screen.
-- The moment there is not - the last mob is down - looks for a frame
-- that is new since, with item slots on it, and posts it. Recording
-- used to run for as long as the FARM was running, but the reward
-- panel comes up before the farm notices the lobby is back, so it
-- was recorded as "seen during the fight" and then ruled out.
function LootWatcher()
    local ran, stoppedAt, warned = false, 0, false
    while true do
        S(0.5)
        local fighting = Farm.Running and GetNearestMob() ~= nil
        if fighting then
            if not ran then
                during, warned = {}, false
                if CONFIG.DiscordWebhook == "" then
                    print("[DQR] Loot: DiscordWebhook is empty - nothing will be posted.")
                end
            end
            ran, stoppedAt = true, 0
            for o in pairs(VisibleSet()) do during[o] = true end
        elseif ran then
            if stoppedAt == 0 then
                stoppedAt = tick()
                print("[DQR] Loot: fighting stopped - watching for the reward panel.")
            end
            if tick() - stoppedAt > 45 then
                -- Give up rather than mistake some later menu for it,
                -- and say what was there so the path can be set.
                ran = false
                print("[DQR] Loot: no reward panel found in 45s. New since the fight now:")
                for i, c in ipairs(LootCandidates(during)) do
                    if i > 15 then break end
                    print(("  %s | slots=%d"):format(c.frame:GetFullName(), c.slots))
                end
            elseif CONFIG.DiscordWebhook ~= "" then
                local ok, panel = pcall(FindLootPanel, during)
                -- `holder` is on screen the whole run; the item slots
                -- are only cloned into it at the end. Until they are,
                -- it is not the reward panel yet - two empty posts
                -- went out between rooms before this check.
                if ok and panel and #ItemSlots(panel) == 0
                and #CONFIG.LootPanelPath > 0 then
                    panel = nil
                end
                if ok and panel then
                    ran = false
                    print("[DQR] Loot: reward panel = " .. panel:GetFullName())
                    local okR, err = pcall(ReportLoot, panel)
                    if not okR then print("[DQR] Loot: post crashed: " .. tostring(err)) end
                elseif not ok and not warned then
                    warned = true
                    print("[DQR] Loot: panel search failed: " .. tostring(panel))
                end
            end
        end
    end
end

-- ============================================================
--  LIVE STATUS EMBED
--  The HUD panel in the top-left corner, mirrored into one Discord
--  message that edits itself every few seconds. (A Roblox script
--  cannot screenshot itself - no engine or executor API exists for
--  it - but every number on that panel is readable text, which gets
--  you the same information.)
-- ============================================================

-- The three helpers live on one table rather than as three locals,
-- and the two entry points hang off Farm rather than being
-- forward-declared: the main chunk is a handful of locals short of
-- Luau's limit of 200, and this section would have crossed it.
local Hud = {}

-- 1300000 -> "1.30M", the way the HUD writes it.
function Hud.Short(n)
    n = tonumber(n) or 0
    for _, p in ipairs({{1e12, "T"}, {1e9, "B"}, {1e6, "M"}, {1e3, "K"}}) do
        if n >= p[1] then return ("%.2f%s"):format(n / p[1], p[2]) end
    end
    return ("%d"):format(n)
end

-- A TextLabel under the HUD panel, found by its own name or its
-- parent's - the level one lives at playerStatus.Frame.levelBorder.level,
-- so both halves matter. Returns the text, or nil.
function Hud.Text(frag)
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    local root = pg and pg:FindFirstChild("playerStatus")
    if not root then return nil end
    local hit = nil
    pcall(function()
        for _, o in ipairs(root:GetDescendants()) do
            if o:IsA("TextLabel") and o.Text ~= "" then
                local n  = o.Name:lower()
                local pn = (o.Parent and o.Parent.Name or ""):lower()
                if n:find(frag, 1, true) or pn:find(frag, 1, true) then
                    hit = o.Text
                    return
                end
            end
        end
    end)
    return hit
end

-- leaderstats first (the real value), the HUD label second. The
-- vanity spoofer rewrites HUD text, so a spoofed name or level would
-- otherwise end up in the status post.
function Hud.Real(frag)
    local ls = LP:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            if v.Name:lower():find(frag, 1, true) and v:IsA("ValueBase") then
                return tostring(v.Value)
            end
        end
    end
    return Hud.Text(frag)
end

-- Console helper: every label on the HUD panel, so a number that
-- comes out wrong can be traced to the label it should have used.
function Farm.StatusDump()
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    local root = pg and pg:FindFirstChild("playerStatus")
    if not root then
        print("[DQR] No playerStatus GUI found.")
        return
    end
    print("[DQR] === HUD PANEL ===")
    for _, o in ipairs(root:GetDescendants()) do
        if o:IsA("TextLabel") then
            print(("%s = '%s'"):format(
                o:GetFullName():gsub("^.*playerStatus%.", ""), o.Text))
        end
    end
    print("[DQR] === END HUD PANEL ===")
end

-- The status message id, kept somewhere it survives the script being
-- executed again - a new run, a rejoin, a manual re-execute. Without
-- this every fresh start posts a brand new embed and leaves the last
-- one frozen in the channel. File first (survives anything), then the
-- executor's shared global table (survives a re-execute in the same
-- session). The webhook is stored beside the id, so pointing the
-- script at a different channel does not try to edit a message that
-- lives in the old one.
local STATUS_KEY = "DQR_status.txt"

function Hud.LoadId(url)
    local raw
    local rf = Env("readfile")
    if typeof(rf) == "function" then
        local ok, v = pcall(rf, STATUS_KEY)
        if ok and type(v) == "string" then raw = v end
    end
    if not raw then
        local g = Env("getgenv")
        if typeof(g) == "function" then
            local ok, t = pcall(g)
            if ok and type(t) == "table" and type(t.DQR_Status) == "string" then
                raw = t.DQR_Status
            end
        end
    end
    if type(raw) ~= "string" then return nil end
    local u, id = raw:match("^(.-)\n(.+)$")
    if u == url and id then
        id = id:gsub("%s", "")
        if id ~= "" then return id end
    end
    return nil
end

function Hud.SaveId(url, id)
    local data = tostring(url) .. "\n" .. tostring(id or "")
    local wf = Env("writefile")
    if typeof(wf) == "function" then pcall(wf, STATUS_KEY, data) end
    local g = Env("getgenv")
    if typeof(g) == "function" then
        local ok, t = pcall(g)
        if ok and type(t) == "table" then t.DQR_Status = data end
    end
end

-- Remove a status message we are about to replace, so old embeds do
-- not pile up in the channel.
function Hud.DeleteMsg(url, id)
    if not id or not url then return end
    pcall(function()
        HttpRequest({Url = url .. "/messages/" .. id, Method = "DELETE"})
    end)
end

function Farm.StatusWatcher()
    local msgId, base, startedAt = nil, nil, tick()
    local said, lastErr, loaded = false, 0, false
    while true do
        S(math.max(2, CONFIG.StatusInterval or 5))
        local url = CONFIG.StatusWebhook
        if type(url) ~= "string" or url == "" then
            if not said then
                said = true
                print("[DQR] Status: StatusWebhook is empty - no status posts.")
            end
        elseif not url:find("^https://") then
            if not said then
                said = true
                print("[DQR] Status: StatusWebhook does not look like a URL.")
            end
        else
            -- First tick: pick up the message this script was editing
            -- before it was restarted, so a new run keeps updating the
            -- same embed instead of posting another one.
            if not loaded then
                loaded = true
                msgId  = Hud.LoadId(url)
                if msgId then
                    print("[DQR] Status: continuing the message from the "
                        .. "previous run.")
                end
            end
            -- A different webhook means a different channel. Clear the
            -- old message out rather than orphan it there.
            if base ~= nil and base ~= url then
                Hud.DeleteMsg(base, msgId)
                msgId = nil
            end
            base = url
            -- Errors here used to vanish into the pcall, so a single
            -- nil index meant silence forever with nothing to go on.
            local ok, err = pcall(function()
                local HttpS = game:GetService("HttpService")
                local human = GetHuman()
                local dead  = not human or human.Health <= 0
                local tgt   = (not dead) and GetNearestMob() or nil

                -- What it is doing, in the order the main loop decides.
                local doing
                if dead then                   doing = "Dead - waiting to respawn"
                elseif InLobbyPlace() then     doing = "In the lobby"
                elseif lobbyFlowActive then    doing = "Queueing a dungeon"
                elseif not Farm.Running then   doing = "Idle"
                elseif hazardCache.escape then
                    doing = hazardCache.resting and "Holding clear of a hazard"
                                                or "Escaping a hazard"
                elseif not tgt then            doing = "No target in range"
                elseif currentDest == nil then doing = "Standing and attacking"
                else                           doing = "Moving to target"
                end

                local fields = {}
                local function F(n, v)
                    if v and v ~= "" then
                        fields[#fields + 1] = {name = n, value = tostring(v),
                                               inline = true}
                    end
                end
                -- HP from the Humanoid, not the HUD: always accurate,
                -- and never touched by the vanity spoofer.
                if human then
                    F("HP", ("%s / %s"):format(
                        Hud.Short(human.Health), Hud.Short(human.MaxHealth)))
                end
                F("EXP",   Hud.Text("exp"))
                F("Gold",  Hud.Real("gold"))
                F("Gems",  Hud.Real("gem") or Hud.Real("diamond"))
                F("Mobs near", #GetMobs())
                if tgt then
                    local h = tgt.Humanoid
                    F("Target", ("%s\n%d%% at %d studs"):format(tgt.Model.Name,
                        h.MaxHealth > 0 and h.Health / h.MaxHealth * 100 or 0,
                        tgt.Distance))
                end
                local up = tick() - startedAt
                F("Uptime", ("%dh %02dm"):format(up / 3600, (up % 3600) / 60))

                local lvl = Hud.Real("level") or Hud.Real("lvl")
                local col = 5763719
                if dead then col = 15548997
                elseif human and human.MaxHealth > 0
                and human.Health / human.MaxHealth < 0.4 then col = 16426522 end

                local body = HttpS:JSONEncode({
                    username = "DQR",
                    embeds = {{
                        title = ("%s%s"):format(LP.DisplayName,
                            lvl and ("   -   Level " .. lvl) or ""),
                        description = ("**%s**\n%s (%s)"):format(doing,
                            CONFIG.TargetDungeon, CONFIG.Difficulty),
                        color = col,
                        fields = fields,
                        footer = {text = "updated " .. os.date("%H:%M:%S")},
                    }},
                })

                -- Edit the one message when we have its id, else post a
                -- fresh one. ?wait=true makes Discord hand back the
                -- message it created, which is the only way to learn
                -- the id needed to edit it later.
                local res
                if msgId then
                    res = HttpRequest({
                        Url = base .. "/messages/" .. msgId, Method = "PATCH",
                        Headers = {["Content-Type"] = "application/json"},
                        Body = body,
                    })
                    local code = res and (res.StatusCode or res.Status)
                    -- 404 is the ONLY code meaning the message is gone.
                    -- 400 means Discord rejected this particular
                    -- payload, and treating that as "gone" abandoned a
                    -- perfectly good message and started a second one -
                    -- which is why a run ending left one frozen embed
                    -- and a new one beside it. Keep the id and say what
                    -- Discord objected to instead.
                    if code == 404 then
                        msgId = nil
                        Hud.SaveId(base, nil)
                        print("[DQR] Status message is gone - posting a new one.")
                    elseif code == 400 then
                        if tick() - lastErr > 15 then
                            lastErr = tick()
                            print("[DQR] Status: Discord rejected the update: "
                                .. tostring(res and res.Body))
                        end
                    elseif code == 429 then
                        -- Rate limited. Skip a beat rather than hammer.
                        S(2)
                    end
                else
                    res = HttpRequest({
                        Url = base .. "?wait=true", Method = "POST",
                        Headers = {["Content-Type"] = "application/json"},
                        Body = body,
                    })
                    if res and res.Body then
                        local okj, data = pcall(function()
                            return HttpS:JSONDecode(res.Body) end)
                        if okj and type(data) == "table" and data.id then
                            msgId = tostring(data.id)
                            -- Remembered, so the next run edits this
                            -- one instead of posting another.
                            Hud.SaveId(base, msgId)
                            print(("[DQR] Status embed posted - updating "
                                .. "every %ss from now on."):format(
                                tostring(CONFIG.StatusInterval)))
                        else
                            print("[DQR] Status: posted but could not read the "
                                .. "message id - it will repost each tick.")
                        end
                    else
                        print("[DQR] Status: no reply from the webhook - does "
                            .. "this executor have a request function?")
                    end
                end
            end)
            if not ok and tick() - lastErr > 15 then
                lastErr = tick()
                print("[DQR] Status update failed: " .. tostring(err))
            end
        end
    end
end

end -- of the loot block

-- ============================================================
--  SUPERVISOR
--  Runs forever, farm or no farm. Whenever we are idle it works out
--  where we actually are and gets things moving again, so no single
--  failed transition can park the script for good.
-- ============================================================
local function Supervisor()
    local idleSince, reported = tick(), false
    while true do
        S(4)

        -- A farm that claims to be running but has not ticked in a while
        -- is a dead or wedged thread. Restart it rather than leaving the
        -- bot standing there.
        if Farm.Running and tick() - loopBeat > CONFIG.LoopStallTime then
            print(("[DQR] Farm loop has not ticked in %.0fs - restarting.")
                :format(tick() - loopBeat))
            Farm.Stop()
            S(0.5)
            Farm.Start()
            idleSince, reported = tick(), false
            continue
        end

        if Farm.Running or lobbyFlowActive then
            idleSince, reported = tick(), false
            continue
        end

        -- WHERE we are decides what to do, not what is on screen and not
        -- whether anything nearby happens to have a humanoid. The old
        -- order ended with "not InLobbyPlace() OR MobsPresent() -> farm",
        -- so standing in the lobby next to its NPCs started the farm and
        -- the bot went and attacked them.
        if InLobbyPlace() then
            if not CONFIG.AutoRunDungeon then continue end

            -- End-of-run screen: one click beats redriving the flow.
            local replay = PathVisible(UI.Replay)
            if replay then
                print("[DQR] Replay Dungeon available - clicking it.")
                ClickButton(replay)
                local t = 0
                repeat S(2) t = t + 2 until IsInDungeon() or t > 60
                if IsInDungeon() then Farm.Start() end
                idleSince, reported = tick(), false
                continue
            end

            print("[DQR] Idle in the lobby - queueing a run.")
            RunLobbyFlow()
            local t = 0
            repeat S(2) t = t + 2 until IsInDungeon() or t > 90
            if IsInDungeon() then Farm.Start() end
            idleSince, reported = tick(), false
            continue
        end

        -- Not the lobby. Wait for that to be true for a while before
        -- calling it a dungeon - during the queue transition the lobby
        -- panels close for a moment and this branch would fire.
        if not DungeonConfirmed() then continue end

        print("[DQR] Idle outside the lobby - resuming farm.")
        Farm.Start()
        idleSince, reported = tick(), false
    end
end

-- Defined down here so its output goes through the log window.
local function ApplyClass()
    local want = tostring(CONFIG.Class or "")
    if want == "" then
        print("[DQR] Class unset - using the hand-tuned distances.")
        return
    end

    local name, prof
    for k, v in pairs(CLASS_RANGES) do
        if k:lower() == want:lower() then name, prof = k, v break end
    end

    if not prof then
        name, prof = "Warrior", CLASS_RANGES.Warrior
        print("[DQR] Unknown Class '" .. want .. "' - falling back to Warrior.")
    end

    for k, v in pairs(prof) do CONFIG[k] = v end
    print(("[DQR] Class %s: orbit %d, melee under %d, spells under %d.")
        :format(name, prof.CircleRadius, prof.MeleeRange, prof.AttackRange))

    -- These have an ordering requirement that is easy to break by hand,
    -- and both failure modes look like "the bot is behaving oddly"
    -- rather than pointing at the numbers.
    if CONFIG.MinRange >= CONFIG.CircleRadius then
        print(("[DQR] WARNING: MinRange (%d) >= CircleRadius (%d) - the bot "
            .. "will think it is too close the moment it arrives and "
            .. "retreat forever."):format(CONFIG.MinRange, CONFIG.CircleRadius))
    end
    if CONFIG.CircleRadius >= CONFIG.MeleeRange then
        print(("[DQR] WARNING: CircleRadius (%d) >= MeleeRange (%d) - it will "
            .. "hold station outside its own swing and never melee.")
            :format(CONFIG.CircleRadius, CONFIG.MeleeRange))
    end
    if CONFIG.MaxRange <= CONFIG.CircleRadius then
        print("[DQR] WARNING: MaxRange should be well above CircleRadius.")
    end
end

