-- ============================================================
--  WORLD REGISTRIES  (event driven)
--  When a part APPEARED is the best evidence of whether it is an
--  attack or the map. Beam instances belong to the caster and its
--  target, so a search near us never finds the one passing through
--  us - track them all. Handle adornments are drawn, not built, and
--  can live anywhere (PlayerGui, Camera), so watch the whole game.
-- ============================================================
local recentParts  = {}  -- part -> born
local streamed     = setmetatable({}, {__mode = "k"})  -- arrived far away: scenery
local playerBorn   = {}  -- appeared right on a player: their spell, not an attack
local beamObjects  = {}  -- Beam -> true
local adornObjects = {}  -- adornment -> true
local hiddenParts  = {}  -- CanQuery-off effects

local function IsAdorn(o)
    return o:IsA("LineHandleAdornment") or o:IsA("CylinderHandleAdornment")
        or o:IsA("BoxHandleAdornment") or o:IsA("SphereHandleAdornment")
        or o:IsA("ImageHandleAdornment")
end

-- STREAMING. The game loads the map in around us as we walk, and every
-- part it loads fires DescendantAdded exactly like an attack spawning.
-- An orange lava crack that had just streamed in read as a brand-new
-- orange telegraph for eight seconds - the hitbox went red on bare
-- floor, the bot "stepped out of hazards" that were not there, and
-- every approach path "crossed" one. Streamed parts arrive far away
-- (at the edge of the streaming radius); attacks appear near us. So a
-- new part is checked a moment after it arrives, once whatever made it
-- has had a frame to put it in place: if its nearest point is more than
-- StreamFar studs from us, it is scenery, not new.
do
local bornQ = {}
-- Named attack volumes ("<attack>.precast" / ".hitBox", tornadoes...),
-- wherever they are, however long they live, CanQuery or not. They used
-- to be reached only through the spatial query (CanQuery on), the
-- recently-born list (eight seconds, and emptied of anything that
-- appeared far away) or the hidden-part list (which skipped anything
-- inside a creature's model) - a whirlpool that is spawned beside the
-- boss and then travels to us passed through none of them.
Haz.named = {}
-- OUR SPELLS. When any player's character starts a spell animation
-- (anything the Animate script does not play), parts that appear
-- around that player in the next second are that spell - the bot's
-- own ice fan and red rings read as hazards and set the hitbox off.
-- Marked parts, and everything later added under the same model, are
-- never hazards (see IsOurs).
Haz.spell = {}                                   -- part -> true
-- LEARNED SPELL NAMES. A spell is the same effect every cast, so once a
-- part NAME has been ours three separate times it is ours for good -
-- every part of it, every cast, even the red ones that look like a
-- telegraph (the Q buff's ring flickered ATTACK / NOT ATTACK because
-- only some of its parts were recognised). A name that has ever been
-- seen appearing far from every player is a mob's, and is never learned.
-- Generic names (Part, Ring, hitBox...) are never learned.
Haz.spellNames, Haz.spellCount, Haz.spellFar = {}, {}, {}
Haz.spellCounted = setmetatable({}, {__mode = "k"})
Haz.GENERIC = {part = true, meshpart = true, union = true, unionoperation = true,
    effect = true, effects = true, fx = true, vfx = true, ring = true, circle = true,
    model = true, folder = true, attachment = true, handle = true, base = true,
    main = true, center = true, centre = true, root = true, core = true,
    hitbox = true, precast = true, debris = true, projectile = true, ball = true,
    sphere = true, beam = true, wedge = true, cylinder = true, block = true}
-- v13.4: never a 3D-modelling default ("Cube.013", "Plane", "Circle.001",
-- "NurbsPath.015") or a body part ("RightUpperArm.008") - armour is made
-- of those, and a respawn taught it dozens of them; a boss mesh with
-- the same default name would then have been ignored.
Haz.GENERIC_PATTERNS = {
    "^cube", "^plane", "^circle", "^cylinder", "^sphere", "^icosphere", "^uvsphere",
    "^cone", "^torus", "^nurbs", "^bezier", "^mesh", "^text", "^curve", "^object",
    "^left", "^right", "^upper", "^lower", "^head", "^torso", "^hand", "^foot",
    "^arm", "^leg", "^accessory", "^hat", "^hair", "^spawn", "^dqr_", "^%w+%.%d+$",
}
function Haz.LearnableName(n)
    if not n or #n < 5 then return false end
    local l = n:lower()
    if Haz.GENERIC[(l:gsub("%d", ""))] then return false end
    for _, pat in ipairs(Haz.GENERIC_PATTERNS) do
        if l:find(pat) then return false end
    end
    for _, frag in ipairs(CONFIG.HazardNames) do
        if l:find(frag, 1, true) then return false end
    end
    -- A player's name: those are already caught by name.
    for _, pl in ipairs(Players:GetPlayers()) do
        if l:find(pl.Name:lower(), 1, true) then return false end
    end
    return true
end
function Haz.LearnSpell(o)
    if not o then return end
    local n = o.Name
    if Haz.spellNames[n] or Haz.spellFar[n] or not Haz.LearnableName(n) then return end
    if Haz.spellCounted[o] then return end            -- this part already counted
    -- Not in the first seconds after a respawn or teleport: armour and
    -- the like appear around the new body then, looking like a cast.
    if tick() - (Haz.jumpAt or 0) < 4 then return end
    -- Part of someone's character (armour, accessories): not a spell.
    local m = o:FindFirstAncestorOfClass("Model")
    if m and Players:GetPlayerFromCharacter(m) then return end
    Haz.spellCounted[o] = true
    -- Counted once per CAST, not per part: one cast is often a dozen
    -- parts with the same name, which reached "3" in one go.
    Haz.spellLastAt = Haz.spellLastAt or {}
    local now = tick()
    if now - (Haz.spellLastAt[n] or 0) < 0.6 then return end
    Haz.spellLastAt[n] = now
    Haz.spellCount[n] = (Haz.spellCount[n] or 0) + 1
    if Haz.spellCount[n] >= 3 then
        Haz.spellNames[n] = true
        print(("[DQR] Learned '%s' as a player's spell - never a hazard from now on."):format(n))
    end
end
-- A part born far from every player: its name is never a spell's.
function Haz.SeenFar(o)
    local n = o.Name
    if Haz.LearnableName(n) and not Haz.spellFar[n] then
        Haz.spellFar[n] = true
        if Haz.spellNames[n] then
            Haz.spellNames[n] = nil
            print(("[DQR] '%s' appeared far from every player - not a spell after all."):format(n))
        end
    end
end
local spellModel = {}                            -- model -> true
local castAt = {}                                -- player -> last spell cast
local pending = {}                               -- parts to ask again: {o, pl, t, m}
-- 10 studs: a spell's parts are born on or beside the caster. At 20, a
-- mob's attack landing near us in the same second counted as ours.
local CAST_WINDOW, CAST_RADIUS = 1.0, 10
local MOVE_WORDS = {"idle", "walk", "run", "jump", "fall", "climb", "swim", "sit", "land", "toolnone"}
-- Cast signal 1: an animation starts on a player's character that is
-- not one of its Animate script's moves (walk, idle, jump...). Any
-- priority - spells are not always played at Action.
local function HookAnimator(pl, a, char)
    local core = {}
    local function Core()
        local animate = char:FindFirstChild("Animate")
        if animate then
            for _, v in ipairs(animate:GetDescendants()) do
                if v:IsA("Animation") and v.AnimationId ~= "" then core[v.AnimationId] = true end
            end
        end
    end
    pcall(Core)
    a.AnimationPlayed:Connect(function(track)
        local anim = track.Animation
        if next(core) == nil then pcall(Core) end      -- Animate loads late
        if anim and core[anim.AnimationId] then return end
        -- Walking and idling play at Core / Idle priority. A name is only
        -- trusted when it IS a move word ("Run2"), not when it merely
        -- contains one - "run" is in "Rune", "land" in "Island".
        local pr = track.Priority
        if pr == Enum.AnimationPriority.Core or pr == Enum.AnimationPriority.Idle then return end
        for _, nm in ipairs({anim and anim.Name or "", track.Name}) do
            local w = nm:lower():gsub("%d", ""):gsub("%s", "")
            for _, mw in ipairs(MOVE_WORDS) do
                if w == mw then return end
            end
        end
        -- A looping track is a stance or a hold, not a cast.
        if track.Looped then return end
        -- For us, the cooldown number on the Q / E slots is the proof,
        -- once it has been seen working: a hit reaction or any other
        -- one-off animation would otherwise open the "our spell" window
        -- and hide the mobs' attacks landing around us.
        if pl == LP and Haz.cdWorks then return end
        castAt[pl] = tick()
        if pl == LP then Haz.castVia = "animation" end
    end)
end
local function HookCharacter(pl, char)
    local function Try(d)
        if d:IsA("Animator") then pcall(HookAnimator, pl, d, char) end
    end
    for _, d in ipairs(char:GetDescendants()) do Try(d) end
    char.DescendantAdded:Connect(Try)
end
local function HookPlayer(pl)
    if pl.Character then HookCharacter(pl, pl.Character) end
    pl.CharacterAdded:Connect(function(c)
        if pl == LP then Haz.jumpAt = tick() end    -- respawn: no spell learning for a moment
        HookCharacter(pl, c)
    end)
end
for _, pl in ipairs(Players:GetPlayers()) do HookPlayer(pl) end
Players.PlayerAdded:Connect(HookPlayer)
Players.PlayerRemoving:Connect(function(pl) castAt[pl] = nil end)

-- Cast signal 2 (us only): a cooldown number appearing on the Q / E
-- slots. When the text there goes from nothing (spell ready) to a
-- number, or jumps back up, a spell has just gone off - whatever the
-- animation did.
task.spawn(function()
    local labels, last, scanAt = {}, {}, 0
    local logged, shown = nil, 0
    while true do
        S(0.1)
        local now = tick()
        if now - scanAt > 3 then
            scanAt = now
            table.clear(labels)
            local pg = LP:FindFirstChildOfClass("PlayerGui")
            local cam = workspace.CurrentCamera
            local vp = cam and cam.ViewportSize
            if pg and vp then
                for _, o in ipairs(pg:GetDescendants()) do
                    if (o:IsA("TextLabel") or o:IsA("TextButton"))
                    and not (LogGui and o:IsDescendantOf(LogGui)) then
                        local p, s = o.AbsolutePosition, o.AbsoluteSize
                        local cx = p.X + s.X / 2
                        if p.Y > vp.Y * 0.6 and cx > vp.X * 0.2 and cx < vp.X * 0.8 then
                            labels[#labels + 1] = o
                        end
                    end
                end
            end
        end
        for _, o in ipairs(labels) do
            local v = o.Parent and o.Visible and tonumber((o.Text:gsub("%s", ""))) or nil
            local was = last[o]
            if v and v > 0.5 and v < 60 and (was == nil or v > was + 0.5) then
                castAt[LP] = now
                Haz.castVia, Haz.cdWorks = "cooldown", true
            end
            last[o] = v
        end
        -- Say so for the first few casts, so a log shows at once whether
        -- casts are being noticed at all.
        local c = castAt[LP]
        if c and c ~= logged then
            logged, shown = c, shown + 1
            if shown <= 3 then
                print(("[DQR] Your spell cast noticed (by %s) - parts it makes near you "
                    .. "are not hazards."):format(tostring(Haz.castVia)))
            end
        end
    end
end)
Haz.castAt = castAt

workspace.DescendantAdded:Connect(function(o)
    if o:IsA("Beam") then
        beamObjects[o] = true
    elseif o:IsA("BasePart") then
        recentParts[o] = tick()
        bornQ[#bornQ + 1] = o
        -- The broadphase never returns CanQuery-off parts, and effect
        -- parts very often have it off. Haz.Track filters out the map
        -- decor so this stays a short list.
        if not o.CanQuery and Haz.Track and Haz.Track(o) then
            hiddenParts[o] = true
        end
    end
end)
task.spawn(function()
    local trimAt = 0
    while true do
        S(0.1)
        -- Old entries out, farm or no farm (the hazard scan trims them
        -- too, but only runs while farming).
        local t = tick()
        if t - trimAt > 2 then
            trimAt = t
            for p, born in pairs(recentParts) do
                if t - born > CONFIG.RecentWindow then recentParts[p] = nil end
            end
        end
        if #bornQ > 0 or #pending > 0 then
            local q = bornQ
            bornQ = {}
            -- The re-check: a cast by that player from half a second
            -- before the part appeared to a second after makes it theirs.
            if #pending > 0 then
                local keep = {}
                for _, e in ipairs(pending) do
                    if t - e.t < 1.0 then
                        keep[#keep + 1] = e
                    elseif e.o.Parent then
                        local c = castAt[e.pl]
                        if c and c > e.t - 0.5 and c < e.t + 1.0 then
                            Haz.spell[e.o] = true
                            Haz.LearnSpell(e.o)
                            if e.m and e.m.Parent and not IsCreature(e.m)
                            and not Players:GetPlayerFromCharacter(e.m) then
                                spellModel[e.m] = true
                            end
                        end
                    end
                end
                pending = keep
            end
            local root = GetRoot()
            local me = root and root.Position
            -- Every player: where they are, their names, and whether
            -- they cast a spell a moment ago.
            local people, names = {}, {}
            for _, pl in ipairs(Players:GetPlayers()) do
                local r = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
                if r then
                    people[#people + 1] = {p = r.Position, pl = pl,
                        cast = castAt[pl] ~= nil and t - castAt[pl] < CAST_WINDOW}
                end
                names[#names + 1] = pl.Name:lower()
                if pl.DisplayName ~= pl.Name then names[#names + 1] = pl.DisplayName:lower() end
            end
            for _, o in ipairs(q) do
                if o.Parent then
                    -- Settings are often filled in just after parenting,
                    -- so these are asked here rather than on arrival.
                    if Haz.NameHas and Haz.NameHas(o, CONFIG.HazardNames) then Haz.named[o] = true end
                    if not o.CanQuery and not hiddenParts[o] and Haz.Track and Haz.Track(o) then
                        hiddenParts[o] = true
                    end
                    -- A spell: born beside a player who just cast, or
                    -- under a model already known to be one, or named
                    -- after a player.
                    local spell = false
                    local m = o:FindFirstAncestorOfClass("Model")
                    -- An attack's warning is never our spell, however close
                    -- to us it lands or whenever: aimed at us, it lands on
                    -- us, often just as we cast.
                    local tele = Haz.TelegraphLook and Haz.TelegraphLook(o)
                    if not tele and m and spellModel[m] then spell = true end
                    if not spell and not tele then
                        for _, pp in ipairs(people) do
                            if pp.cast and (o.Position - pp.p).Magnitude < CAST_RADIUS then
                                spell = true break
                            end
                        end
                    end
                    if not spell and not tele then
                        local n = o.Name:lower() .. " " .. (o.Parent.Name:lower())
                        for _, nm in ipairs(names) do
                            if #nm >= 3 and n:find(nm, 1, true) then spell = true break end
                        end
                    end
                    if spell then
                        Haz.spell[o] = true
                        Haz.LearnSpell(o)
                        if m and not IsCreature(m) and not Players:GetPlayerFromCharacter(m) then
                            spellModel[m] = true
                        end
                    elseif not tele then
                        -- Near a player but no cast yet: the effect often
                        -- arrives a moment BEFORE the cast signal (the
                        -- server spawns it, the HUD and animation follow).
                        -- Asked again shortly.
                        for _, pp in ipairs(people) do
                            if (o.Position - pp.p).Magnitude < CAST_RADIUS then
                                pending[#pending + 1] = {o = o, pl = pp.pl, t = t, m = m}
                                break
                            end
                        end
                    end
                    local nearest = math.huge
                    for _, pp in ipairs(people) do
                        local d = (o.Position - pp.p).Magnitude
                        if d < nearest then nearest = d end
                        if d < 8 then playerBorn[o] = true end
                    end
                    -- Born well away from everyone: a mob's, never a spell.
                    if nearest > 30 and nearest < math.huge then Haz.SeenFar(o) end
                    -- Streaming: arrived far away. Kept in the recent list
                    -- (effects with CanQuery off are found through it), but
                    -- never counted as "new".
                    if me and recentParts[o] then
                        local ok, d = pcall(function()
                            local h = o.Size / 2
                            local rel = o.CFrame:PointToObjectSpace(me)
                            return (rel - Vector3.new(math.clamp(rel.X, -h.X, h.X),
                                math.clamp(rel.Y, -h.Y, h.Y), math.clamp(rel.Z, -h.Z, h.Z))).Magnitude
                        end)
                        if ok and d > CONFIG.StreamFar then streamed[o] = true end
                    end
                end
            end
        end
    end
end)
-- Named attack volumes already in the game when the script starts.
task.spawn(function()
    S(1.5)
    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("BasePart") and Haz.NameHas and Haz.NameHas(o, CONFIG.HazardNames) then
            Haz.named[o] = true
        end
    end
end)
-- These registries hold their parts strongly and are emptied here. They
-- used to be weak tables, and a weak table keyed by Roblox objects
-- drops an entry whenever the script holds no other reference to that
-- object - even though it is still in the game. A beam or a laser part
-- nobody had looked at for a moment simply fell out of the list.
workspace.DescendantRemoving:Connect(function(o)
    beamObjects[o], recentParts[o], hiddenParts[o], playerBorn[o] = nil, nil, nil, nil
    Haz.named[o], Haz.spell[o], spellModel[o] = nil, nil, nil
    if Haz.followModel then Haz.followModel[o] = nil end
end)
end
pcall(function()
    game.DescendantAdded:Connect(function(o)
        if IsAdorn(o) then adornObjects[o] = true end
    end)
    game.DescendantRemoving:Connect(function(o) adornObjects[o] = nil end)
end)
task.spawn(function()
    S(1)
    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("Beam") then
            beamObjects[o] = true
        elseif o:IsA("BasePart") and not o.CanQuery
        and Haz.Track and Haz.Track(o) then
            hiddenParts[o] = true
        elseif IsAdorn(o) then
            adornObjects[o] = true
        end
    end
    for _, name in ipairs({"PlayerGui", "CoreGui"}) do pcall(function()
        local root = LP:FindFirstChildOfClass(name) or game:FindFirstChildOfClass(name)
        for _, o in ipairs(root and root:GetDescendants() or {}) do
            if IsAdorn(o) then adornObjects[o] = true end
        end
    end) end
end)

-- ============================================================
--  PART BEHAVIOUR
--  Games pool their effects: a ring is built once and CFramed into
--  place each cast, so it is never "new". What gives it away is that
--  it moves, grows, fades in or lights up - scenery does none of those.
-- ============================================================
local PartSize, LooksActive, VisTrans
do
local seen   = setmetatable({}, {__mode = "k"})
local meshOf = setmetatable({}, {__mode = "k"})

-- Size as drawn: older effects scale a SpecialMesh and leave the Part
-- itself at 1x1x1.
function PartSize(o)
    local m = meshOf[o]
    if m == nil then
        m = o:IsA("Part") and o:FindFirstChildOfClass("SpecialMesh") or false
        meshOf[o] = m
    end
    if m and m.Parent then return o.Size * m.Scale end
    return o.Size
end

-- How see-through a part LOOKS: its own Transparency, unless it is
-- invisible and a decal, texture or surface picture on it shows - a
-- marker drawn as an image on an invisible part was rejected by every
-- rule as "invisible". Re-read at most once a second per part.
local visMemo = setmetatable({}, {__mode = "k"})
function VisTrans(o)
    -- What you actually see: the part's own transparency combined with
    -- LocalTransparencyModifier (the game hiding it on your screen only).
    local v = o.Transparency
    local ltm = o.LocalTransparencyModifier
    if ltm > 0 then v = 1 - (1 - v) * (1 - ltm) end
    if v <= 0.95 then return v end
    local now, m = tick(), visMemo[o]
    if m and now - m.t < 1 then return m.v end
    for _, c in ipairs(o:GetChildren()) do
        if (c:IsA("Decal") or c:IsA("Texture")) and c.Transparency < v then
            v = c.Transparency
        elseif c:IsA("SurfaceGui") and c.Enabled then
            for _, g in ipairs(c:GetDescendants()) do
                -- Only something with an actual size on the surface: an
                -- empty or zero-sized frame drew nothing, but used to make
                -- an invisible part count as visible.
                if g:IsA("GuiObject") and g.Visible and g.AbsoluteSize.X > 1
                and g.AbsoluteSize.Y > 1 then
                    local t = g.BackgroundTransparency
                    if g:IsA("ImageLabel") or g:IsA("ImageButton") then
                        t = math.min(t, g.ImageTransparency)
                    end
                    if t < v then v = t end
                end
            end
        end
    end
    visMemo[o] = {t = now, v = v}
    return v
end

-- Returns active?, why ("new", "moved", "faded", "grew", "lit", "fresh").
-- `fresh`: the caller saw it first well inside the scan radius, where
-- scenery never enters (it always comes in at the edge as we walk).
-- `force` lets `fresh` count even with FreshSightRule off: the flat-
-- marker rule passes it for non-solid parts, so a marker the game keeps
-- and moves into place beside us (never "new", never seen moving) still
-- counts the moment it shows up.
function LooksActive(o, fresh, force)
    local now  = tick()
    local born = recentParts[o]
    local new  = born ~= nil and now - born < CONFIG.RecentWindow and not streamed[o]
    fresh = fresh == true and (CONFIG.FreshSightRule == true or force == true)

    local rec = seen[o]
    -- Out of sight for a while and back: a pooled spoke fired at the
    -- same angle as last time would otherwise read as "never moved".
    if rec and now - rec.seen > 3 then rec = nil end
    -- Seen in the moment before it was found to have streamed in: it
    -- was never new.
    if rec and rec.why == "new" and streamed[o] then rec.why, rec.moved = nil, 0 end
    if not rec then
        local why = new and "new" or fresh and "fresh" or nil
        seen[o] = {pos = o.Position, tr = o.Transparency, size = PartSize(o),
                   col = o.Color, moved = why and now or 0, why = why, seen = now}
        return why ~= nil, why
    end
    rec.seen = now
    local size, tr, col = PartSize(o), o.Transparency, o.Color
    local why = nil
    if (o.Position - rec.pos).Magnitude > 1 then
        why = "moved"
    elseif rec.tr > 0.9 and tr <= 0.9 then
        why = "faded"
    elseif (size - rec.size).Magnitude > 1 then
        why = "grew"
    -- A floor panel that turns lethal does not move - it lights up.
    -- (Aquatic Temple's second boss walkway.)
    elseif math.abs(col.R - rec.col.R) + math.abs(col.G - rec.col.G)
         + math.abs(col.B - rec.col.B) > 0.2 then
        why = "lit"
    end
    if why then rec.moved, rec.why = now, why end
    rec.pos, rec.tr, rec.size, rec.col = o.Position, tr, size, col
    if new then return true, "new" end
    -- A live telegraph keeps changing; one that has stopped is over.
    if now - rec.moved < CONFIG.ActiveLinger then return true, rec.why end
    return false, nil
end
end

-- ============================================================
--  BUTTONS
--  A synthetic click goes to whatever is under the pixel, so every
--  click checks first that the button we mean is actually there -
--  otherwise it drives the button's signal directly. That is what
--  stopped the Inventory opening itself.
-- ============================================================
local function VisibleOnScreen(gui)
    if not gui.Visible or gui.AbsoluteSize.X < 1 then return false end
    local p = gui.Parent
    while p and not p:IsA("PlayerGui") do
        if p:IsA("GuiObject") and not p.Visible then return false end
        if p:IsA("ScreenGui") and not p.Enabled then return false end
        p = p.Parent
    end
    return true
end

local function Norm(s) return (s or ""):lower():gsub("%s+", "") end

-- A button's label is very often a child TextLabel, not its own .Text.
local function ButtonTokens(btn)
    local t = {}
    if btn:IsA("TextButton") then t[#t + 1] = Norm(btn.Text) end
    for _, d in ipairs(btn:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then t[#t + 1] = Norm(d.Text) end
    end
    return t
end
local function ButtonText(btn) return table.concat(ButtonTokens(btn), "|") end

-- EXACT match by default: substring "play" matched "Show Players".
local function ButtonMatches(btn, m)
    local want = m.text and Norm(m.text) or nil
    if want and want ~= "" then
        for _, tok in ipairs(ButtonTokens(btn)) do
            if (m.contains and tok:find(want, 1, true)) or tok == want then
                return true
            end
        end
    end
    local wn = m.name and Norm(m.name) or nil
    if wn and wn ~= "" then
        local nm = Norm(btn.Name)
        if (m.contains and nm:find(wn, 1, true)) or nm == wn then return true end
    end
    return false
end

-- Viewport coordinates: the topbar inset only applies when the owning
-- ScreenGui does not ignore it.
local function ScreenPointOf(gui)
    local ignore, p = false, gui.Parent
    while p do
        if p:IsA("ScreenGui") then ignore = p.IgnoreGuiInset break end
        p = p.Parent
    end
    local x = gui.AbsolutePosition.X + gui.AbsoluteSize.X / 2
    local y = gui.AbsolutePosition.Y + gui.AbsoluteSize.Y / 2
    if not ignore then y = y + GuiService:GetGuiInset().Y end
    return x, y
end

local function ButtonsAtPoint(x, y)
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return {} end
    local out = {}
    local ok, list = pcall(function()
        return pg:GetGuiObjectsAtPosition(x, y - GuiService:GetGuiInset().Y)
    end)
    for _, o in ipairs((ok and list) or {}) do
        if (o:IsA("TextButton") or o:IsA("ImageButton"))
        and not (LogGui and o:IsDescendantOf(LogGui)) then
            out[#out + 1] = o
        end
    end
    return out
end

local function ClickButton(btn)
    if VisibleOnScreen(btn) then
        local x, y = ScreenPointOf(btn)
        local wasOpen = LogGui and LogGui.Enabled
        if wasOpen then LogGui.Enabled = false end
        local hit  = ButtonsAtPoint(x, y)[1]
        local mine = hit and (hit == btn or hit:IsDescendantOf(btn)
                              or btn:IsDescendantOf(hit))
        if hit and not mine then
            if wasOpen then LogGui.Enabled = true end
            print(("[DQR]   %s is under that point, not %s - firing the "
                .. "signal instead."):format(hit.Name, btn.Name))
        else
            local ok = pcall(function()
                VIM:SendMouseMoveEvent(x, y, game)
                S(0.08)
                VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
                S(0.08)
                VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
            end)
            if wasOpen then LogGui.Enabled = true end
            print(("[DQR]   click @ %d,%d ok=%s"):format(x, y, tostring(ok)))
            if ok then return true end
        end
    end
    local gc = Env("getconnections")
    if typeof(gc) == "function" then
        local fired = 0
        for _, sig in ipairs({btn.MouseButton1Click, btn.Activated,
                              btn.MouseButton1Down, btn.MouseButton1Up}) do
            pcall(function()
                for _, c in ipairs(gc(sig)) do c:Fire() fired = fired + 1 end
            end)
        end
        if fired > 0 then return true end
    end
    local fs = Env("firesignal")
    if typeof(fs) == "function" then
        local ok = pcall(fs, btn.MouseButton1Click)
        pcall(fs, btn.Activated)
        if ok then return true end
    end
    return false
end

-- Every matching button, visible ones first.
local function FindButtons(matches)
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return {} end
    local vis, hid = {}, {}
    for _, obj in ipairs(pg:GetDescendants()) do
        if (obj:IsA("TextButton") or obj:IsA("ImageButton"))
        and not obj.Name:find("DQRui_")
        and not (LogGui and obj:IsDescendantOf(LogGui)) then
            for _, m in ipairs(matches) do
                if ButtonMatches(obj, m) then
                    if VisibleOnScreen(obj) then vis[#vis + 1] = obj
                    else hid[#hid + 1] = obj end
                    break
                end
            end
        end
    end
    for _, o in ipairs(hid) do vis[#vis + 1] = o end
    return vis
end

local function AnyVisible(matches)
    for _, b in ipairs(FindButtons(matches)) do
        if VisibleOnScreen(b) then return b end
    end
    return nil
end

local function DumpGui()
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    print("[DQR] === GUI BUTTON DUMP ===")
    for _, obj in ipairs(pg:GetDescendants()) do
        if obj:IsA("TextButton") or obj:IsA("ImageButton") then
            print(("%s | text='%s' | visible=%s"):format(obj:GetFullName(),
                ButtonText(obj), tostring(VisibleOnScreen(obj))))
        end
    end
    print("[DQR] === END DUMP ===")
end

