task.spawn(function()
    print("[DQR] v6.9 loaded.  F5 farm  F6 dump  F7 show/hide log")
    ApplyClass()
    NukeGraphics()
    S(2.5)

    if not InLobby() then
        -- Not at the main screen: we are already in a run (or loading).
        -- Never queue from here.
        print("[DQR] Lobby UI not present - assuming already in a dungeon.")
        Farm.Start()
    elseif CONFIG.AutoRunDungeon then
        RunLobbyFlow()
        local w = 0
        repeat S(2) w = w + 2 until IsInDungeon() or w > 120
        if IsInDungeon() then
            Farm.Start()
        else
            print("[DQR] Timed out. Press F5 when inside dungeon.")
        end
    else
        print("[DQR] Waiting for dungeon...")
        repeat S(3) until IsInDungeon()
        Farm.Start()
    end

    task.spawn(DungeonWatcher)
    task.spawn(Supervisor)
    task.spawn(StartWatcher)
    task.spawn(VanityWatcher)
end)

