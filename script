-- Simpler key fire using the executor's built-in if VIM fails
local function FireSpell(slot)
    -- slot: "Q" or "E"
    local keymap = {
        Q = Enum.KeyCode.Q,
        E = Enum.KeyCode.E,
    }
    local kc = keymap[slot]
    if not kc then return end

    -- Method 1: VirtualInputManager
    pcall(function()
        game:GetService("VirtualInputManager"):SendKeyEvent(true,  kc, false, game)
        task.wait(0.06)
        game:GetService("VirtualInputManager"):SendKeyEvent(false, kc, false, game)
    end)
end

-- ============================================================
--  MOB DETECTION
-- ============================================================
local MOB_TAGS = {
    -- DQR mob folders / model naming patterns
    "Enemy", "Mob", "Monster", "Boss",
    "Skeleton", "Zombie", "Golem", "Dragon",
    "Slime", "Spider", "Demon", "Undead",
    "Guard", "Warrior", "Mage", "Archer",
}

local function IsMob(model)
    if not model:IsA("Model") then return false end
    -- Must have a Humanoid and HumanoidRootPart
    local hum  = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return false end
    -- Must be alive
    if hum.Health <= 0 then return false end
    -- Must not be a player
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character == model then return false end
    end
    return true
end

local function GetAllMobs()
    local mobs = {}
    local root = GetRoot()
    if not root then return mobs end

    -- Scan Workspace recursively (DQR keeps mobs in workspace)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and IsMob(obj) then
            local mobRoot = obj:FindFirstChild("HumanoidRootPart")
            if mobRoot then
                table.insert(mobs, {
                    Model    = obj,
                    Root     = mobRoot,
                    Humanoid = obj:FindFirstChildOfClass("Humanoid"),
                    Distance = (mobRoot.Position - root.Position).Magnitude,
                })
            end
        end
    end

    -- Sort by distance
    table.sort(mobs, function(a, b) return a.Distance < b.Distance end)
    return mobs
end

local function GetNearestMob()
    local mobs = GetAllMobs()
    return mobs[1]  -- already sorted nearest first
end

-- ============================================================
--  MOVEMENT HELPERS
-- ============================================================
local PathfindingService = game:GetService("PathfindingService")

-- Direct HRP move (fast, no pathfinding overhead for simple cases)
local function WalkTo(position)
    local hum = GetHuman()
    if hum then
        hum:MoveTo(position)
    end
end

local function StopWalking()
    local root = GetRoot()
    local hum  = GetHuman()
    if hum and root then
        hum:MoveTo(root.Position)
    end
end

-- Get a strafe position perpendicular to threat direction
local function GetStrafePosition(awayFrom, stepSize)
    local root = GetRoot()
    if not root then return nil end

    local toThreat = (awayFrom - root.Position)
    toThreat = Vector3.new(toThreat.X, 0, toThreat.Z).Unit

    -- Perpendicular (rotate 90 degrees on Y)
    local perp = Vector3.new(-toThreat.Z, 0, toThreat.X)

    -- Pick left or right randomly, bias away from other mobs
    local sign = math.random() > 0.5 and 1 or -1
    local strafeTarget = root.Position + (perp * sign * stepSize)
        + (toThreat * -stepSize * 0.5)  -- also step back a little

    -- Ground clamp
    strafeTarget = Vector3.new(strafeTarget.X, root.Position.Y, strafeTarget.Z)
    return strafeTarget
end

local function BackUp(fromPosition)
    local root = GetRoot()
    if not root then return end
    local dir = (root.Position - fromPosition)
    dir = Vector3.new(dir.X, 0, dir.Z).Unit
    local backPos = root.Position + dir * AutoFarm.BackupDist
    WalkTo(backPos)
end

-- ============================================================
--  PROJECTILE / SPELL BEAM DETECTION
--  DQR spells show as Part beams or neon cylinders/blocks
--  aimed toward the player — we detect by checking
--  if any fast-moving neon part is heading our way
-- ============================================================
local THREAT_COLORS = {
    -- BrickColors DQR uses for hostile projectiles / beams
    [Color3.fromRGB(255, 0,   0  )] = true,   -- red
    [Color3.fromRGB(255, 50,  50 )] = true,
    [Color3.fromRGB(220, 0,   0  )] = true,
    [Color3.fromRGB(255, 100, 0  )] = true,   -- orange warning
    [Color3.fromRGB(180, 0,   255)] = true,   -- purple boss beam
}

local function ColorIsThreat(c3)
    -- Check exact or approximate match
    for tc, _ in pairs(THREAT_COLORS) do
        if math.abs(c3.R - tc.R) < 0.15
        and math.abs(c3.G - tc.G) < 0.15
        and math.abs(c3.B - tc.B) < 0.15 then
            return true
        end
    end
    -- Also catch neon material beams by checking material + direction
    return false
end

local function IsPartHeadingToUs(part)
    local root = GetRoot()
    if not root then return false, nil end

    -- Must be close enough to matter
    local dist = (part.Position - root.Position).Magnitude
    if dist > AutoFarm.DodgeRange then return false, nil end

    -- Check velocity direction — is it pointing toward us?
    local vel = part.AssemblyLinearVelocity
    if vel.Magnitude < 5 then return false, nil end   -- static part, skip

    local velDir   = vel.Unit
    local toPlayer = (root.Position - part.Position).Unit
    local dot      = velDir:Dot(toPlayer)

    -- dot > 0.6 means roughly aimed at us
    if dot > 0.6 then
        return true, part.Position
    end
    return false, nil
end

-- Scan for hostile beams / projectiles heading at the player
local function ScanForThreats()
    local root = GetRoot()
    if not root then return false, nil end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(LP.Character) then
            -- Neon material = likely a spell effect
            local isNeon = obj.Material == Enum.Material.Neon
            local isThreatColor = ColorIsThreat(obj.Color)

            if isNeon or isThreatColor then
                local heading, origin = IsPartHeadingToUs(obj)
                if heading then
                    return true, origin
                end
            end

            -- Also detect beam instances (DQR uses Beam for some spells)
            -- Beams are Attachments, check parent parts near mobs
            for _, child in ipairs(obj:GetChildren()) do
                if child:IsA("Beam") then
                    -- If a beam exists on a part near us, treat as threat
                    local dist = (obj.Position - root.Position).Magnitude
                    if dist < AutoFarm.DodgeRange then
                        return true, obj.Position
                    end
                end
            end
        end
    end
    return false, nil
end

-- ============================================================
--  LOOK AT TARGET (face the mob before casting)
-- ============================================================
local function FaceTarget(targetPos)
    local root = GetRoot()
    if not root then return end
    local dir = (targetPos - root.Position)
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.1 then return end
    root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
end

-- ============================================================
--  ATTACK SEQUENCE
--  DQR spells: Q = first skill, E = second skill
--  We alternate them with a small delay so both go on cooldown
-- ============================================================
local spellToggle = false
local lastAttack  = 0

local function DoAttack()
    local now = tick()
    if now - lastAttack < AutoFarm.AttackRate then return end
    lastAttack = now

    spellToggle = not spellToggle
    if spellToggle then
        FireSpell("Q")
    else
        FireSpell("E")
    end
end

-- ============================================================
--  MAIN AUTO FARM LOOP
-- ============================================================
local lastDodge = 0

local function AutoFarmLoop()
    while AutoFarm.Running do
        local root  = GetRoot()
        local hum   = GetHuman()

        if not root or not hum or hum.Health <= 0 then
            task.wait(0.5)
            continue
        end

        -- 1. Check for incoming threats FIRST (highest priority)
        local threatened, threatOrigin = ScanForThreats()
        local now = tick()

        if threatened and (now - lastDodge) > AutoFarm.DodgeCooldown then
            lastDodge = now
            local strafePos = GetStrafePosition(threatOrigin, AutoFarm.DodgeStepSize)
            if strafePos then
                WalkTo(strafePos)
                task.wait(0.4)   -- brief move before re-evaluating
                continue
            end
        end

        -- 2. Find nearest mob
        local target = GetNearestMob()

        if not target then
            -- No mobs — idle
            StopWalking()
            task.wait(AutoFarm.ScanRate)
            continue
        end

        AutoFarm.TargetMob = target
        local dist = target.Distance

        -- 3. Too close — back up
        if dist < AutoFarm.BackupDist then
            BackUp(target.Root.Position)
            task.wait(0.15)
            continue
        end

        -- 4. In attack range — face and cast
        if dist <= AutoFarm.AttackRange then
            StopWalking()
            FaceTarget(target.Root.Position)
            DoAttack()
            task.wait(AutoFarm.AttackRate)
            continue
        end

        -- 5. Out of range — walk toward mob
        --    Stop slightly before AttackRange so we don't overshoot
        local dir     = (target.Root.Position - root.Position).Unit
        local walkTo  = target.Root.Position - dir * (AutoFarm.AttackRange - 3)
        WalkTo(walkTo)

        task.wait(AutoFarm.ScanRate)
    end
end

-- ============================================================
--  DODGE WATCHER — runs on its own thread at higher frequency
--  Dedicated thread so dodge response isn't gated by farm loop timing
-- ============================================================
local function DodgeWatchLoop()
    local lastDodgeW = 0
    while AutoFarm.Running do
        task.wait(0.05)   -- 20hz threat scan

        local root = GetRoot()
        if not root then continue end

        local threatened, threatOrigin = ScanForThreats()
        local now = tick()

        if threatened and (now - lastDodgeW) > AutoFarm.DodgeCooldown then
            lastDodgeW = now
            local strafePos = GetStrafePosition(threatOrigin, AutoFarm.DodgeStepSize)
            if strafePos then
                WalkTo(strafePos)
            end
        end
    end
end

-- ============================================================
--  START / STOP
-- ============================================================
function AutoFarm.Start()
    if AutoFarm.Running then return end
    AutoFarm.Running = true

    AutoFarm.Thread = task.spawn(AutoFarmLoop)
    AutoFarm.DodgeThread = task.spawn(DodgeWatchLoop)

    Notify("Auto Farm", "Started — hunting mobs", 2.5, "success")
end

function AutoFarm.Stop()
    AutoFarm.Running    = false
    AutoFarm.TargetMob  = nil
    StopWalking()

    Notify("Auto Farm", "Stopped", 2, "warn")
end

