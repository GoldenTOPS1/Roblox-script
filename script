-- ============================================================
--  IN-MAP DETECTION
--  DQR separates lobby from dungeon — we detect by checking
--  if mob models exist in workspace (they only spawn in dungeons)
-- ============================================================
local function IsInDungeon()
    -- If mobs exist we're inside a dungeon instance
    local mobs = GetAllMobs()
    if #mobs > 0 then return true end

    -- Fallback: check workspace name or map-specific folders
    local wsName = workspace.Name:lower()
    for mapName, _ in pairs(DUNGEON_DATA) do
        for _, kw in ipairs(DUNGEON_DATA[mapName].Keywords) do
            if wsName:find(kw:lower()) then return true end
        end
    end

    -- Check for a folder named after map keywords
    for _, obj in ipairs(workspace:GetChildren()) do
        for mapName, data in pairs(DUNGEON_DATA) do
            for _, kw in ipairs(data.Keywords) do
                if obj.Name:lower():find(kw:lower()) then return true end
            end
        end
    end

    return false
end

-- ============================================================
--  LOBBY NAVIGATOR — finds and clicks the dungeon button
-- ============================================================
local function FindDungeonButton(mapName)
    local data = DUNGEON_DATA[mapName]
    if not data then return nil end

    -- DQR lobby has a ScreenGui with dungeon selection frames
    -- Try PlayerGui first then CoreGui
    local function SearchGui(parent)
        for _, obj in ipairs(parent:GetDescendants()) do
            if obj:IsA("TextButton") or obj:IsA("TextLabel") or obj:IsA("Frame") then
                local txt = (obj:IsA("TextButton") or obj:IsA("TextLabel"))
                    and obj.Text:lower() or obj.Name:lower()
                local matchCount = 0
                for _, kw in ipairs(data.Keywords) do
                    if txt:find(kw:lower()) then
                        matchCount = matchCount + 1
                    end
                end
                if matchCount >= 1 and obj:IsA("TextButton") then
                    return obj
                end
            end
        end
        return nil
    end

    local btn = SearchGui(LP:WaitForChild("PlayerGui"))
    if not btn then
        pcall(function()
            btn = SearchGui(game:GetService("CoreGui"))
        end)
    end
    return btn
end

local function ClickButton(btn)
    if not btn then return false end
    pcall(function()
        local ms = game:GetService("VirtualInputManager")
        local pos = btn.AbsolutePosition + btn.AbsoluteSize / 2
        ms:SendMouseButtonEvent(pos.X, pos.Y, 0, true,  game, 0)
        task.wait(0.08)
        ms:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
    end)
    -- Fallback: fire MouseButton1Click directly
    pcall(function() btn:FireClientSignal() end)
    pcall(function()
        local event = btn.MouseButton1Click
        if event then event:Fire() end
    end)
    return true
end

-- ============================================================
--  AUTO QUEUE SYSTEM
-- ============================================================
local function TryQueueDungeon()
    local function TryQueueDungeon()
    if not CONFIG.AutoRunDungeon then return end
    local mapName = CONFIG.TargetDungeon
    print("[DQR] Looking for dungeon button: " .. mapName)

    -- ── STEP 1: find & click the dungeon tile ──────────────────
    local attempts = 0
    local btn = nil
    repeat
        btn = FindDungeonButton(mapName)
        if not btn then task.wait(2) end
        attempts = attempts + 1
    until btn or attempts > 15

    if not btn then
        print("[DQR] Could not find dungeon button for: " .. mapName)
        return
    end

    print("[DQR] Found dungeon tile, clicking...")
    ClickButton(btn)
    task.wait(1.5)

    -- ── STEP 2: find & click ANY Start / Play button ───────────
    -- Keeps retrying for up to 10s because DQR's lobby screen
    -- sometimes takes a moment to slide in after tile click
    local function FindStartBtn(parent)
        for _, obj in ipairs(parent:GetDescendants()) do
            if obj:IsA("TextButton") and obj.Visible then
                local t = obj.Text:lower():gsub("%s+", "")
                if t == "start"
                or t == "play"
                or t == "startgame"
                or t == "playgame"
                or t == "vote"
                or t == "ready"
                or t == "begin" then
                    return obj
                end
            end
        end
        return nil
    end

    local startBtn  = nil
    local startWait = 0
    repeat
        task.wait(0.6)
        startWait = startWait + 0.6
        startBtn  = FindStartBtn(LP:WaitForChild("PlayerGui"))
        if not startBtn then
            pcall(function()
                startBtn = FindStartBtn(game:GetService("CoreGui"))
            end)
        end
    until startBtn or startWait > 10

    if startBtn then
        print("[DQR] Found start button — pressing it.")
        ClickButton(startBtn)
        task.wait(1)

        -- ── STEP 3: spam it a couple more times ────────────────
        -- Some DQR lobbies need a vote from every player,
        -- or the button stays up and needs re-clicking
        for i = 1, 3 do
            task.wait(0.8)
            local again = FindStartBtn(LP:WaitForChild("PlayerGui"))
            if again then
                print("[DQR] Re-pressing start (" .. i .. ")")
                ClickButton(again)
            end
        end
    else
        print("[DQR] No start button found — dungeon may auto-start.")
    end
end
-- ============================================================
--  MAIN AUTO FARM STATE
-- ============================================================
local Farm = {
    Running      = false,
    MainThread   = nil,
    DodgeThread  = nil,
}

-- ============================================================
--  COMBAT LOOP
--  - Always faces the mob
--  - Attacks while kiting / running
--  - Backs up if too close
--  - Dodges beams / projectiles
-- ============================================================
local lastAttack = 0
local spellSlot  = false

local function TryCast()
    local now = tick()
    if now - lastAttack < CONFIG.AttackRate then return end
    lastAttack  = now
    spellSlot   = not spellSlot
    FireSpell(spellSlot and "Q" or "E")
end

local lastDodge = 0

local function MainLoop()
    while Farm.Running do
        task.wait(CONFIG.ScanRate)

        local root  = GetRoot()
        local hum   = GetHuman()
        if not root or not hum or hum.Health <= 0 then
            ClearWalkLine()
            task.wait(0.5)
            continue
        end

        -- Always try to cast regardless of movement state
        local mobs = GetAllMobs()

        if #mobs == 0 then
            StopWalk()
            ClearWalkLine()
            continue
        end

        local target = mobs[1]
        local dist   = target.Distance
        local mobPos = target.Root.Position

        -- ALWAYS face the mob, every tick
        FacePosition(mobPos)

        -- ALWAYS try to attack
        TryCast()

        -- Check for dodge (highest movement priority)
        local threatened, threatOrigin = ScanThreats()
        local now = tick()

        if threatened and (now - lastDodge) > CONFIG.DodgeCooldown then
            lastDodge = now
            local strafePos = GetStrafePos(threatOrigin)
            if strafePos then
                ShowWalkLine(root.Position, strafePos)
                WalkTo(strafePos)
                -- Still face mob while strafing
                FacePosition(mobPos)
            end
            continue
        end

        -- Maintain kite distance
        if dist < CONFIG.BackupDist then
            -- Too close — run directly away while still facing mob
            local away = root.Position + (root.Position - mobPos).Unit * CONFIG.KiteRange
            away = Vector3.new(away.X, root.Position.Y, away.Z)
            ShowWalkLine(root.Position, away)
            WalkTo(away)
            -- FacePosition already called above — mob stays in sight

        elseif dist < CONFIG.KiteRange then
            -- In backup zone but not critical — shuffle back slightly
            local backDir = (root.Position - mobPos).Unit
            local backPos = root.Position + backDir * 6
            ShowWalkLine(root.Position, backPos)
            WalkTo(backPos)

        elseif dist > CONFIG.AttackRange then
            -- Too far — walk toward mob to attack range edge
            local dir    = (mobPos - root.Position).Unit
            local walkTo = mobPos - dir * (CONFIG.AttackRange - 3)
            ShowWalkLine(root.Position, walkTo)
            WalkTo(walkTo)

        else
            -- Perfect range — stand still, just attack and face
            StopWalk()
            ClearWalkLine()
        end
    end

    ClearWalkLine()
end

-- ============================================================
--  DEDICATED DODGE WATCHER — 20hz, independent of main loop
-- ============================================================
local function DodgeWatcher()
    local lastDodgeW = 0
    while Farm.Running do
        task.wait(0.05)
        local root = GetRoot()
        if not root then continue end

        local mobs = GetAllMobs()
        local mobPos = mobs[1] and mobs[1].Root.Position or nil

        local threatened, origin = ScanThreats()
        local now = tick()

        if threatened and (now - lastDodgeW) > CONFIG.DodgeCooldown then
            lastDodgeW = now
            local s = GetStrafePos(origin)
            if s then
                ShowWalkLine(root.Position, s)
                WalkTo(s)
                if mobPos then FacePosition(mobPos) end
            end
        end
    end
end

-- ============================================================
--  START / STOP
-- ============================================================
function Farm.Start()
    if Farm.Running then return end
    Farm.Running     = true
    Farm.MainThread  = task.spawn(MainLoop)
    Farm.DodgeThread = task.spawn(DodgeWatcher)
    print("[DQR] Auto Farm started.")
end

function Farm.Stop()
    Farm.Running = false
    ClearWalkLine()
    StopWalk()
    print("[DQR] Auto Farm stopped.")
end

