local function Tween(obj, props, duration, style, dir)
    style = style or Enum.EasingStyle.Quart
    dir   = dir   or Enum.EasingDirection.Out
    local t = TweenService:Create(obj, TweenInfo.new(duration, style, dir), props)
    t:Play()
    return t
end

local function MakeCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 6)
    c.Parent = parent
    return c
end

local function MakeStroke(parent, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color     = color or CFG.BorderColor
    s.Thickness = thickness or 1
    s.Parent    = parent
    return s
end

local function MakeGradient(parent, c0, c1, rotation)
    local g = Instance.new("UIGradient")
    g.Color    = ColorSequence.new(c0, c1)
    g.Rotation = rotation or 90
    g.Parent   = parent
    return g
end

local function MakePadding(parent, top, bot, left, right)
    local p = Instance.new("UIPadding")
    p.PaddingTop    = UDim.new(0, top   or 6)
    p.PaddingBottom = UDim.new(0, bot   or 6)
    p.PaddingLeft   = UDim.new(0, left  or 6)
    p.PaddingRight  = UDim.new(0, right or 6)
    p.Parent = parent
    return p
end

local function MakeLabel(parent, text, size, color, bold, xalign)
    local l = Instance.new("TextLabel")
    l.Text           = text
    l.TextSize       = size or 13
    l.TextColor3     = color or CFG.TextColor
    l.Font           = bold and Enum.Font.GothamBold or Enum.Font.Gotham
    l.TextXAlignment = xalign or Enum.TextXAlignment.Left
    l.BackgroundTransparency = 1
    l.Size           = UDim2.new(1, 0, 0, (size or 13) + 4)
    l.Parent         = parent
    return l
end

