--  MARKERS  (green ball = where we are going; small one = next step)
-- ============================================================
local ShowDest, ClearDest
do
local DestBall, StepBall = nil, nil
local function Ball(name, size, color, tr)
    local p = Instance.new("Part")
    p.Name, p.Shape = name, Enum.PartType.Ball
    p.Size = Vector3.new(size, size, size)
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
    p.CastShadow, p.Material = false, Enum.Material.SmoothPlastic
    p.Color, p.Transparency = color, tr
    p.Parent = workspace
    return p
end
local FAR = CFrame.new(0, -500, 0)
function ShowDest(dest, step)
    if not CONFIG.ShowDest then return end
    if not DestBall or not DestBall.Parent then
        DestBall = Ball("DQR_Dest", 3, Color3.fromRGB(40, 230, 90), 0.45)
    end
    if not StepBall or not StepBall.Parent then
        StepBall = Ball("DQR_Step", 1.8, Color3.fromRGB(170, 240, 60), 0.5)
    end
    DestBall.CFrame = dest and CFrame.new(dest.X, dest.Y + 1, dest.Z) or FAR
    if step and (not dest or (step - dest).Magnitude > 1.5) then
        StepBall.CFrame = CFrame.new(step.X, step.Y + 1, step.Z)
    else
        StepBall.CFrame = FAR
    end
end
function ClearDest()
    if DestBall and DestBall.Parent then DestBall:Destroy() end
    if StepBall and StepBall.Parent then StepBall:Destroy() end
    DestBall, StepBall = nil, nil
end
end

