local function HideArmour(char)
    if not CONFIG.HideArmour or not char then return end
    for _, o in ipairs(char:GetDescendants()) do pcall(function()
        if o:IsA("Accessory") or o:IsA("Hat") then
            for _, d in ipairs(o:GetDescendants()) do pcall(function()
                if d:IsA("BasePart") then
                    d.Transparency = 1
                    d.LocalTransparencyModifier = 1
                elseif d:IsA("Decal") or d:IsA("Texture") then
                    d.Transparency = 1
                elseif d:IsA("ParticleEmitter") or d:IsA("Trail") then
                    d.Enabled = false
                end
            end) end
        elseif o:IsA("BasePart") and not BODY_PARTS[o.Name] then
            -- Armour meshes are extra parts welded onto the rig.
            if CONFIG.HideWeapon or not InsideTool(o) then
                o.Transparency = 1
                o.LocalTransparencyModifier = 1
            end
        elseif o:IsA("Decal") or o:IsA("Texture") then
            o.Transparency = 1
        elseif o:IsA("ParticleEmitter") or o:IsA("Trail")
            or o:IsA("Fire") or o:IsA("Sparkles") then
            o.Enabled = false
        end
    end) end
end

-- ============================================================
--  MOVEMENT - real humanoid walking + PathfindingService
--
--  Up to v4.7 this wrote root.CFrame directly every heartbeat. That is a
--  teleport, not a walk, and it explains two bugs at once:
--    * no walk animation - the Humanoid never gets a MoveDirection, so
--      the animation state machine has nothing to play;
--    * getting stuck on walls - each step is only WalkSpeed*dt (~0.27
--      studs), so the character grinds into geometry and physics shoves
--      it straight back out, forever.
--  Humanoid:Move drives the real character controller: animation,
--  collision and wall-sliding all work. PathfindingService then routes
--  around geometry instead of walking face-first into it.
-- ============================================================
local PathfindingService = game:GetService("PathfindingService")

local moveConn   = nil
local faceTarget = nil   -- function returning the Vector3 to look at, or nil
local pathQueue  = {}    -- waypoints still to walk
local pathGoal   = nil   -- what pathQueue was computed for
local pathFail   = 0
local stuckAt    = nil
local stuckSince = 0
local forceRepath = false
local steerDir   = nil   -- fallback heading when no path exists
local steerUntil = 0     -- keep that heading at least this long
local wpStuck    = 0     -- seconds spent failing to reach pathQueue[1]
local clearStreak = 0    -- consecutive "line is clear" readings
local stuckCount  = 0    -- consecutive stuck events at one spot
local unstickDir  = nil  -- temporary "get out of here" heading
local unstickUntil = 0
local bestFar    = math.huge  -- closest we have got to the target
local bestFarAt  = 0     -- ...and when
local unreachable = {}   -- model -> tick() until which to ignore it
local pathTargetModel = nil  -- what MainLoop is currently chasing

local function ClearPath()
    pathQueue = {}
    pathGoal  = nil
end

-- Straight line clear? Cheap check so we only pay for a path when a wall
-- is actually in the way.
-- Renamed from Blacklist in 2022; support both.
local EXCLUDE = (function()
    local ok, v = pcall(function() return Enum.RaycastFilterType.Exclude end)
    if ok and v then return v end
    return Enum.RaycastFilterType.Blacklist
end)()

-- Body-width clearance, not a hairline. One thin ray from the centre
-- squeaks past a wall corner that the character itself cannot fit
-- through - and since a "clear line" makes the path worker throw away
-- its computed path, that false positive is what produced the pacing
-- at walls: path around, ray clears, drop path, walk into wall, repeat.
-- Three parallel rays at body width, at two heights.
local function LineClear(from, to)
    local char = GetChar()
    local p = RaycastParams.new()
    p.FilterType = EXCLUDE
    p.FilterDescendantsInstances = {char, RangeBarPart}

    local d = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
    if d.Magnitude < 1 then return true end

    -- Sideways offset, perpendicular to travel
    local side = Vector3.new(-d.Unit.Z, 0, d.Unit.X) * CONFIG.AgentWidth
    local full = to - from

    for _, h in ipairs({1.5, 3.5}) do
        for _, off in ipairs({Vector3.zero, side, -side}) do
            local a = from + off + Vector3.new(0, h, 0)
            local hit = workspace:Raycast(a, full, p)
            -- Things a walking character passes through anyway don't count
            if hit and hit.Instance.CanCollide then return false end
        end
    end
    return true
end

-- ============================================================
--  SPATIAL QUERY
--  Every scanner used to walk workspace:GetDescendants(), which visits
--  the whole map - tens of thousands of instances - to find things
--  within ~40 studs. With the farm loop and the dodge watcher both at
--  20Hz that was over a hundred full traversals a second, and it is
--  what made the game crawl while fighting.
--  GetPartBoundsInRadius asks the physics broadphase instead and
--  returns only what is actually near us.
-- ============================================================
local function NearbyParts(pos, radius)
    local op = OverlapParams.new()
    op.FilterType = EXCLUDE
    op.FilterDescendantsInstances = {GetChar(), RangeBarPart}
    op.MaxParts = CONFIG.MaxQueryParts
    local ok, parts = pcall(function()
        return workspace:GetPartBoundsInRadius(pos, radius, op)
    end)
    if ok and parts then return parts end
    return {}
end

-- Is there floor under this spot? Stops an escape from sending the bot
-- off a ledge or out over a pit.
local function HasGround(p)
    local char = GetChar()
    local rp = RaycastParams.new()
    rp.FilterType = EXCLUDE
    rp.FilterDescendantsInstances = {char, RangeBarPart}
    return workspace:Raycast(p + Vector3.new(0, 6, 0),
        Vector3.new(0, -CONFIG.GroundProbe, 0), rp) ~= nil
end

-- The nearest heading to `dir` that is actually walkable for `dist`
-- studs, or nil if the bot is boxed in. Every evasive move goes through
-- this: dodges, retreats and hazard escapes all used to be plain
-- "position + direction * distance" with no check that anything was
-- there, which is how the bot kept reversing into walls and pillars.
local function SafeStep(pos, dir, dist)
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.01 then return nil end
    dir = dir.Unit
    dist = math.max(dist, 3)

    for _, deg in ipairs({0, 20, -20, 40, -40, 65, -65,
                          90, -90, 120, -120, 150, -150, 180}) do
        local a = math.rad(deg)
        local d = Vector3.new(
            dir.X * math.cos(a) - dir.Z * math.sin(a), 0,
            dir.X * math.sin(a) + dir.Z * math.cos(a))
        local p = pos + d * dist
        if LineClear(pos, p) and HasGround(p) then return p end
    end

    -- Boxed in at full range: settle for a shorter hop.
    local half = pos + dir * (dist * 0.5)
    if LineClear(pos, half) and HasGround(half) then return half end
    return nil
end

-- When there is no usable path and the direct line is blocked, fan out
-- and take the most target-ward heading that is actually clear. Beats
-- grinding into a mountainside at walking pace.
local function ClearDirection(pos, target)
    local base = Vector3.new(target.X - pos.X, 0, target.Z - pos.Z)
    if base.Magnitude < 1 then return nil end
    base = base.Unit
    for _, deg in ipairs({0, 25, -25, 50, -50, 75, -75, 100, -100, 135, -135}) do
        local a = math.rad(deg)
        local d = Vector3.new(
            base.X * math.cos(a) - base.Z * math.sin(a), 0,
            base.X * math.sin(a) + base.Z * math.cos(a))
        if LineClear(pos, pos + d * CONFIG.ProbeDist) then return d end
    end
    return nil
end

local function ComputePath(from, to)
    local path = PathfindingService:CreatePath({
        AgentRadius   = 3,
        AgentHeight   = 5,
        AgentCanJump  = true,
        -- 60 let it try to climb mountainsides. 45 makes the pathfinder
        -- route around steep terrain instead of up it.
        AgentMaxSlope = CONFIG.AgentMaxSlope,
    })
    local ok = pcall(function() path:ComputeAsync(from, to) end)
    if not ok or path.Status ~= Enum.PathStatus.Success then return nil end
    local wps, out = path:GetWaypoints(), {}
    for i = 2, #wps do out[#out + 1] = wps[i] end  -- [1] is where we stand
    if #out == 0 then return nil end
    return out
end

-- Runs on its own thread: ComputeAsync yields and must never be called
-- from inside a Heartbeat handler.
local function PathWorker(getDestFn)
    task.spawn(function()
        while moveConn do
            S(0.4)
            local root  = GetRoot()
            local human = GetHuman()
            local dest  = getDestFn()
            -- No pathing while dead: ComputeAsync against a corpse or a
            -- half-loaded respawn is what produces the stuck glitches.
            if human and human.Health <= 0 then
                ClearPath()
                dest = nil
            end
            if root and dest then
                local flat = (Vector3.new(dest.X, 0, dest.Z)
                            - Vector3.new(root.Position.X, 0, root.Position.Z)).Magnitude
                local needPath = forceRepath
                    or (flat > CONFIG.PathMinDist and not LineClear(root.Position, dest))

                if needPath then
                    local moved = pathGoal and (dest - pathGoal).Magnitude or 1e9
                    if forceRepath or moved > CONFIG.RepathDist or #pathQueue == 0 then
                        local wps = ComputePath(root.Position, dest)
                        forceRepath = false
                        if wps then
                            pathQueue = wps
                            pathGoal  = dest
                            pathFail  = 0
                        else
                            pathFail = pathFail + 1
                            ClearPath()
                            -- Do NOT just walk straight: that is what makes
                            -- it grind along a mountainside. Steer around.
                            -- Hold a heading for a moment once chosen.
                            -- Re-probing every 0.4s let it flip between
                            -- two equally-good directions and shuffle.
                            if not steerDir or tick() > steerUntil
                            or not LineClear(root.Position,
                                    root.Position + steerDir * CONFIG.ProbeDist) then
                                steerDir   = ClearDirection(root.Position, dest)
                                steerUntil = tick() + CONFIG.SteerDwell
                            end
                            if pathFail % 5 == 1 then
                                print("[DQR] No path to target ("
                                    .. pathFail .. ") - "
                                    .. (steerDir and "steering around it."
                                                  or "no clear heading."))
                            end
                            -- Give up on this mob and let the scanner
                            -- pick another one it can actually reach -
                            -- but never one that is already close. If it
                            -- is next to us the answer is to fight it,
                            -- not to walk off to something further away.
                            local mk = pathTargetModel
                                and pathTargetModel:FindFirstChild("HumanoidRootPart")
                            local howFar = mk
                                and (mk.Position - root.Position).Magnitude
                                or math.huge
                            if pathFail >= CONFIG.PathGiveUp
                            and pathTargetModel
                            and howFar > CONFIG.MaxRange * 1.5 then
                                unreachable[pathTargetModel] =
                                    tick() + CONFIG.UnreachableFor
                                print(("[DQR] %s unreachable at %d studs - switching.")
                                    :format(pathTargetModel.Name, howFar))
                                pathFail = 0
                            end
                        end
                    end
                else
                    steerDir = nil
                    -- Don't throw a working path away on one clear
                    -- reading. Near a corner that flickers, and dropping
                    -- the path means walking straight back into the wall.
                    if #pathQueue > 0 then
                        clearStreak = clearStreak + 1
                        if clearStreak >= CONFIG.PathHoldClear then
                            ClearPath()
                            clearStreak = 0
                        end
                    else
                        clearStreak = 0
                    end
                end

                -- Progress watchdog, for travel only.
                --
                -- This must NOT run while we are in engagement range. A
                -- bot standing its ground to hit a stationary mob, or
                -- holding a standoff, or circling, is not "closing
                -- distance" - and the first version counted that as
                -- failure, so it eventually blacklisted the very mob it
                -- was busy killing and wandered off to a distant one.
                local mark = pathTargetModel
                    and pathTargetModel:FindFirstChild("HumanoidRootPart")
                local far = mark
                    and (mark.Position - root.Position).Magnitude
                    or (dest - root.Position).Magnitude

                if far <= CONFIG.MaxRange + 5 then
                    -- In range: we are fighting, not travelling.
                    bestFar, bestFarAt = far, tick()
                elseif far < bestFar - 3 then
                    bestFar, bestFarAt = far, tick()
                elseif tick() - bestFarAt > CONFIG.NoProgressTime then
                    bestFar, bestFarAt = far, tick()
                    forceRepath = true
                    pathFail = pathFail + 1
                    print("[DQR] No progress toward target - repathing.")
                    -- Never abandon something standing right next to us.
                    if pathFail >= CONFIG.PathGiveUp and pathTargetModel
                    and far > CONFIG.MaxRange * 1.5 then
                        unreachable[pathTargetModel] =
                            tick() + CONFIG.UnreachableFor
                        print(("[DQR] %s unreachable at %d studs - switching.")
                            :format(pathTargetModel.Name, far))
                        pathFail = 0
                    end
                end
            else
                bestFar, bestFarAt = math.huge, tick()
            end
        end
    end)
end

-- ============================================================
--  WHY Humanoid:Move ALONE DID NOTHING
--  Roblox's default control module calls Humanoid:Move() itself every
--  frame - with a ZERO vector when no key is held - from a
--  BindToRenderStep that runs after our Heartbeat. So our command was
--  being wiped before the physics step ever saw it: no walking, and
--  no jump either, because the same module owns the jump state.
--  Disabling the control module hands movement back to us.
-- ============================================================
--  ...and it does not stay disabled. Roblox's ControlModule listens for
--  UserInputService.LastInputTypeChanged and, when the input type
--  changes, swaps in a different controller and ENABLES it again. On a
--  phone or an Android emulator a tap is Touch input, so one click
--  while the bot is running re-enables the module, it resumes zeroing
--  Humanoid:Move, and the character freezes for good. So the disable
--  has to be re-asserted, not set once.
local Controls     = nil
local controlsOff  = false
local wantDisabled = false

local function SetDefaultControls(enabled)
    pcall(function()
        if not Controls then
            local pm = LP:FindFirstChild("PlayerScripts")
            pm = pm and pm:FindFirstChild("PlayerModule")
            if not pm then return end
            Controls = require(pm):GetControls()
        end
        if not Controls then return end
        if enabled then Controls:Enable() else Controls:Disable() end
        controlsOff = not enabled
    end)
end

local function ReassertControls()
    if not wantDisabled then return end
    -- Character respawn builds a new PlayerModule, so re-fetch it.
    local pm = LP:FindFirstChild("PlayerScripts")
    pm = pm and pm:FindFirstChild("PlayerModule")
    if not pm then Controls = nil end
    SetDefaultControls(false)
end

-- Any input-type change is the module's cue to re-enable itself.
UserInputService.LastInputTypeChanged:Connect(function()
    if wantDisabled then
        task.defer(ReassertControls)
    end
end)

-- Belt and braces: a slow ticker in case something else re-enables it.
task.spawn(function()
    while true do
        S(0.5)
        if wantDisabled then ReassertControls() end
    end
end)

-- One-line snapshot of everything that can stop a humanoid moving.
local function Diag()
    local r, h = GetRoot(), GetHuman()
    if not r or not h then return "no character" end
    return ("state=%s ws=%.1f md=%.2f vel=%.1f anchored=%s platform=%s sit=%s floor=%s jumpOK=%s ctrlOff=%s")
        :format(tostring(h:GetState()):gsub("Enum.HumanoidStateType%.", ""),
                h.WalkSpeed, h.MoveDirection.Magnitude,
                r.AssemblyLinearVelocity.Magnitude,
                tostring(r.Anchored), tostring(h.PlatformStand),
                tostring(h.Sit), tostring(h.FloorMaterial),
                tostring(h:GetStateEnabled(Enum.HumanoidStateType.Jumping)),
                tostring(controlsOff))
end

local moveMode     = "humanoid"  -- or "velocity"
local commandSince = 0
local diagCount    = 0

local function StartMoving(getDestFn)
    if moveConn then moveConn:Disconnect() end
    ClearPath()
    forceRepath = false
    stuckAt, stuckSince = nil, 0
    moveMode, commandSince, diagCount = "humanoid", 0, 0
    clearStreak, wpStuck = 0, 0
    stuckCount, unstickDir, unstickUntil = 0, nil, 0
    bestFar, bestFarAt = math.huge, tick()

    wantDisabled = true
    SetDefaultControls(false)

    local h0 = GetHuman()
    if h0 then
        -- AutoRotate re-orients the character from its own move direction
        -- every frame and would overwrite our facing.
        pcall(function() h0.AutoRotate = false end)
        if CONFIG.SetWalkSpeed then
            pcall(function() h0.WalkSpeed = CONFIG.WalkSpeed end)
        end
        pcall(function()
            h0:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        end)
    end
    print("[DQR] Move start: " .. Diag())

    moveConn = RunService.Heartbeat:Connect(function(dt)
        local root  = GetRoot()
        local human = GetHuman()
        if not root or not human then return end

        -- Dead: drop everything. A stale path plus a ragdolling or
        -- respawning character is where the movement glitches come from.
        if human.Health <= 0 then
            if #pathQueue > 0 then ClearPath() end
            stuckAt, commandSince = nil, 0
            return
        end

        if human.AutoRotate then human.AutoRotate = false end
        if CONFIG.SetWalkSpeed and human.WalkSpeed ~= CONFIG.WalkSpeed then
            human.WalkSpeed = CONFIG.WalkSpeed
        end

        local pos  = root.Position
        local dest = getDestFn()

        -- Follow the path queue when we have one, else head straight
        local step = dest

        -- An unstick manoeuvre outranks the path and the destination:
        -- the whole point is to stop heading where we were heading.
        if unstickDir and tick() < unstickUntil then
            step = pos + unstickDir * CONFIG.UnstickDist
        elseif #pathQueue > 0 then
            local wp = pathQueue[1]
            local flatD = (Vector3.new(wp.Position.X, 0, wp.Position.Z)
                         - Vector3.new(pos.X, 0, pos.Z)).Magnitude
            local dy = wp.Position.Y - pos.Y

            -- A waypoint counts as reached only when we are close in
            -- BOTH axes. Judging on X/Z alone popped waypoints stacked
            -- on top of a ledge the instant we stood underneath them -
            -- so the bot kept re-aiming at the one behind it and walked
            -- back and forth on the spot without ever climbing up.
            if flatD < CONFIG.WaypointReach
            and math.abs(dy) < CONFIG.WaypointReachY then
                table.remove(pathQueue, 1)
                wpStuck = 0
                wp = pathQueue[1]
            else
                wpStuck = wpStuck + dt
                if wpStuck > CONFIG.WaypointTimeout then
                    -- Cannot get to this one. Drop it and recompute
                    -- instead of grinding at it forever.
                    wpStuck = 0
                    table.remove(pathQueue, 1)
                    forceRepath = true
                    wp = pathQueue[1]
                end
            end

            if wp then
                step = wp.Position
                -- Jump for a flagged waypoint, and for any real step up:
                -- the pathfinder does not always mark a ledge.
                if wp.Action == Enum.PathWaypointAction.Jump
                or (wp.Position.Y - pos.Y) > 3 then
                    human.Jump = true
                end
            end
        elseif steerDir then
            -- No path and the direct line is blocked: follow the clear
            -- heading the path worker probed instead of pressing into it.
            step = pos + steerDir * CONFIG.ProbeDist
        end

        -- Walk. This is what makes the animation play.
        local dir = nil
        if step then
            local d = Vector3.new(step.X - pos.X, 0, step.Z - pos.Z)
            if d.Magnitude > 1 then dir = d.Unit end
        end

        if dir then
            if commandSince == 0 then commandSince = tick() end

            if moveMode == "humanoid" then
                human:Move(dir, false)
                -- If we have been commanding movement for a full second
                -- and the humanoid still reports no MoveDirection, then
                -- something is still eating the command. Switch to
                -- driving the assembly velocity instead, which physics
                -- applies directly and which still fires Humanoid.Running
                -- so the walk animation keeps playing.
                if tick() - commandSince > 1
                and human.MoveDirection.Magnitude < 0.1 then
                    -- Most likely the control module woke back up.
                    ReassertControls()
                    moveMode = "velocity"
                    print("[DQR] Humanoid:Move is being overridden - "
                        .. "switching to velocity mode. " .. Diag())
                end
            else
                -- Recover: if the humanoid is responding again, go back
                -- to real walking (better collision and animation).
                if human.MoveDirection.Magnitude > 0.1 then
                    moveMode     = "humanoid"
                    commandSince = tick()
                    print("[DQR] Humanoid responding again - back to walk mode.")
                end
                local spd = human.WalkSpeed > 0 and human.WalkSpeed or 16
                local v   = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity =
                    Vector3.new(dir.X * spd, v.Y, dir.Z * spd)
                human:Move(dir, false)  -- keep the animation state in sync
            end
        else
            commandSince = 0
            if moveMode == "humanoid" then
                human:Move(Vector3.zero, false)
            else
                local v = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
            end
        end

        -- Stuck detection: real walking can be blocked, so notice it and
        -- ask for a fresh path (plus a hop to clear small ledges).
        if dest and (dest - pos).Magnitude > CONFIG.WaypointReach then
            local now = tick()
            if not stuckAt or (pos - stuckAt).Magnitude > CONFIG.StuckDist then
                stuckAt, stuckSince = pos, now
            elseif now - stuckSince > CONFIG.StuckTime then
                stuckAt, stuckSince = pos, now
                stuckCount = stuckCount + 1

                human.Jump = true
                pcall(function()
                    human:ChangeState(Enum.HumanoidStateType.Jumping)
                end)

                -- Jumping and repathing alone is not enough on a corner:
                -- the new path starts from where we are wedged and aims
                -- through the same gap, so we re-wedge immediately.
                -- Back out and go round, alternating sides each attempt
                -- so two bad corners cannot trap us in one direction.
                ClearPath()
                forceRepath = true

                local back = root.CFrame.LookVector * -1
                back = Vector3.new(back.X, 0, back.Z)
                if back.Magnitude < 0.01 then back = Vector3.new(1, 0, 0) end
                back = back.Unit
                local sign = (stuckCount % 2 == 0) and 1 or -1
                local side = Vector3.new(-back.Z, 0, back.X) * sign
                local want = (back * 0.7 + side).Unit

                -- Prefer a direction with real room; fall back to
                -- straight back out if we are boxed in entirely.
                local spot = SafeStep(pos, want, CONFIG.UnstickDist)
                unstickDir = spot
                    and (Vector3.new(spot.X - pos.X, 0, spot.Z - pos.Z)).Unit
                    or back
                unstickUntil = now + CONFIG.UnstickTime

                if diagCount < 3 then
                    diagCount = diagCount + 1
                    print("[DQR] Stuck - backing out. " .. Diag())
                elseif diagCount == 3 then
                    diagCount = 4
                    print("[DQR] Stuck (further diagnostics suppressed).")
                end
            end
        else
            stuckAt = nil
            stuckCount = 0
        end

        -- Rotation only: position is the Humanoid's business now.
        local look = nil
        local fp = faceTarget and faceTarget() or nil
        if fp then
            local d = Vector3.new(fp.X - pos.X, 0, fp.Z - pos.Z)
            if d.Magnitude > 0.5 then look = d.Unit end
        end
        if not look and step then
            local d = Vector3.new(step.X - pos.X, 0, step.Z - pos.Z)
            if d.Magnitude > 0.5 then look = d.Unit end
        end
        if look then
            root.CFrame = CFrame.lookAt(pos, pos + look)
        end

        -- Aim the camera at the mob too - DQR resolves attacks from the
        -- camera/mouse ray, not from the character's own facing.
        local cam = workspace.CurrentCamera
        if cam then
            if CONFIG.AimCamera and fp and look then
                if cam.CameraType ~= Enum.CameraType.Scriptable then
                    cam.CameraType = Enum.CameraType.Scriptable
                end
                local back = Vector3.new(-look.X, 0, -look.Z) * CONFIG.CameraBack
                cam.CFrame = CFrame.lookAt(
                    pos + back + Vector3.new(0, CONFIG.CameraHeight, 0), fp)
            elseif cam.CameraType == Enum.CameraType.Scriptable then
                -- No target to aim at. Without this the camera stayed
                -- Scriptable at whatever CFrame it last had and simply
                -- stopped following the character - it only got restored
                -- when the farm stopped entirely.
                cam.CameraType = Enum.CameraType.Custom
                pcall(function() cam.CameraSubject = human end)
            end
        end
    end)

    PathWorker(getDestFn)
end

local function StopMoving()
    if moveConn then
        moveConn:Disconnect()
        moveConn = nil
    end
    ClearPath()
    local hm = GetHuman()
    if hm then pcall(function() hm:Move(Vector3.zero, false) end) end
    -- Hand the controls back so you can move the character yourself.
    wantDisabled = false
    SetDefaultControls(true)
    local h = GetHuman()
    if h then pcall(function() h.AutoRotate = true end) end
    local cam = workspace.CurrentCamera
    if cam and cam.CameraType == Enum.CameraType.Scriptable then
        cam.CameraType = Enum.CameraType.Custom
        pcall(function() cam.CameraSubject = GetHuman() end)
    end
end

