    bar.Parent           = card
    MakeCorner(bar, 3)

    local content = Instance.new("Frame")
    content.Size                 = UDim2.new(1, -12, 1, 0)
    content.Position             = UDim2.new(0, 10, 0, 0)
    content.BackgroundTransparency = 1
    content.Parent               = card

    local tl = MakeLabel(content, title, 12, accentC, true)
    tl.Position = UDim2.new(0, 0, 0, 8)
    tl.Size     = UDim2.new(1, 0, 0, 16)

    local bl = MakeLabel(content, body, 11, CFG.SubText)
    bl.Position    = UDim2.new(0, 0, 0, 28)
    bl.Size        = UDim2.new(1, 0, 0, 30)
    bl.TextWrapped = true

    Tween(card, {BackgroundTransparency = 0}, 0.25)
    task.wait(duration)
    Tween(card, {BackgroundTransparency = 1}, 0.3)
    task.wait(0.32)
    card:Destroy()
end

