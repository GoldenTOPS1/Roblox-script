--  EXACT UI PATHS  (from a live GUI dump of this game)
--  The dungeon rows and difficulty buttons are all named "TextButton"
--  with empty text; the identifying name is on the parent frame.
-- ============================================================
UI.IntroPlay   = {"introGui", "title", "Frame", "TextButton"}
UI.LobbyPlay   = {"mainInterface", "buttons", "playButton"}
UI.SelectPanel = {"queueGui", "selectOption"}
UI.CreateGame  = {"queueGui", "selectOption", "Frame", "createGame"}
UI.ChoosePanel = {"queueGui", "chooseDungeon"}
UI.DungeonList = {"queueGui", "chooseDungeon", "backgroundFillLeft", "ScrollingFrame"}
UI.DiffRoot    = {"queueGui", "chooseDungeon", "backgroundFillRight"}
UI.Hardcore    = {"queueGui", "chooseDungeon", "backgroundFillRight",
                  "hardcoreSection", "hardcore"}
UI.CreateLobby = {"queueGui", "chooseDungeon", "backgroundFillMiddle",
                  "startMain", "TextButton"}
